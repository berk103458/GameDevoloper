[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_029"
ad = "Basri"
sinif = &"esnaf"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Refah < 8"
secere_matrisi = {"Doğum_Yeri": "Örslü, Çivi Ocağı", "Aile_Bağı": "Bekâr, çırağı ocakta kaldı", "Kırılma_Olayı": "Halis'in yüz çivilik siparişini eksik bırakınca sayımda utanıp gece yola çıkması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Çivi Ocağı binasında çivi dövme ve menteşe yapma", "Gece_Döngüsü": "Çivi Ocağı'nda günün çivisini tek tek sayıp eksik bırakmama."}
persona_maskesi = "Ocağı sönmüş, çivi dövmeye gelmiş yorgun bir çivi ustası."
gizlenen_gercek = "Köy siparişinden esirgediği çivi kesesi ve başparmağındaki çekiç çukurları."
gorsel_hata = "Sol başparmakta on taze çekiç çukuru ve kese ağzındaki isli dikiş."
sir_baglantisi = "Bu çukurlar günlük örs izi değildir; eksik çiviyi sayıp keseyi gizlice dikerken kalan izdir."
sfx = "Çivi şıkırtısı, isli öksürük, çekiçsiz elin önlüğe sürtmesi."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Kuşağındaki sipariş çubuğu. Tıklandığında yüz çivi yazılı, teslim kertiği eksik durur.", "uretilen_ipucu": &"Clue_CHR029_SiparisCubugu"}
obje_2 = {"aciklama": "Önlük altında küçük çivi kesesi. Tıklandığında ağızı yeniden dikilmiş, içinde esirgenen çiviler şıkırdar.", "uretilen_ipucu": &"Clue_CHR029_EksikCivi"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR029_ParmakCokugu"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; keseyi önlüğe sokar, parmağını ovar, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; sipariş çubuğunu avuçlar, başparmağı gizler.", "Panic": "Tansiyon 8-10; eli yumruk yapar, diz çöker, Halis'in adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR029_SIPARISCUBUGU_BASLIK": "Kuşağındaki sipariş çubuğu", "CLUE_CHR029_SIPARISCUBUGU_TANIM": "Kuşağındaki sipariş çubuğu. Tıklandığında yüz çivi yazılı, teslim kertiği eksik durur.", "CLUE_CHR029_EKSIKCIVI_BASLIK": "Önlük altında küçük çivi kesesi", "CLUE_CHR029_EKSIKCIVI_TANIM": "Önlük altında küçük çivi kesesi. Tıklandığında ağızı yeniden dikilmiş, içinde esirgenen çiviler şıkırdar.", "CHR_029_DUGUM_00_REPLIK": "Parmaklarım şiş bekçi. Çivi döğerim, menteşe yaparım. Ocağın bir köşesinde dururum.", "CHR_029_DUGUM_00_SEC_1_METIN": "Çivi ustası örste durur. Sen niye tek başına bu kapıdasın?", "CHR_029_DUGUM_00_SEC_2_METIN": "Elin çekiç tutmuş ama başparmağın taze çukur. Hangi ocaktan koptun?", "CHR_029_DUGUM_00_SEC_3_METIN": "Kuşağındaki sipariş çubuğu , önlükteki eksik çivi kesesi ve başparmaktaki çekiç çukurları ! Sen iş arayan değil, siparişi eksik bırakıp kaçan ustasın!", "CHR_029_DUGUM_1_1_REPLIK": "Örslü'de iş bitti bekçi. Sipariş kapandı. Boş duracağıma burada çivi döğerim dedim.", "CHR_029_DUGUM_1_1_SEC_1_METIN": "Doğrudur, sipariş bitince usta yer arar.", "CHR_029_DUGUM_1_1_SEC_2_METIN": "Sipariş bittiyse önlüğünün altı niye şıkırdıyor?", "CHR_029_DUGUM_1_2_REPLIK": "Bir avuç çivi işte. Yoldan kaldı. Köye yük olmayayım diye sakladım.", "CHR_029_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_029_DUGUM_1_2_SEC_2_METIN": "Yol çivisi sipariş çubuğundaki eksikle bir tutulur!", "CHR_029_DUGUM_1_2_BASK__REPLIK": "(Parmağını yumar) Ne karıştırırsın bekçi? Parmak örsten çöktü. Eksik çivi saklayan adam güpegündüz kapıya çıkar mı?", "CHR_029_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_029_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Başparmağındaki on çukur duruyor, doğruyu söyle!", "CHR_029_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Eksik saydım. Halis yüz çivi istedi. Bir keseyi ayırdım. Utandım, kaçtım. Kimseye kaldırmadım.", "CHR_029_DUGUM_1_3_SEC_1_METIN": "Demek siparişi eksik bıraktın... Şimdi geçmişini anlat.", "CHR_029_DUGUM_2_1_REPLIK": "Örslü çivi ocağındanım. Çivi döğerim, menteşe yaparım, sayıyı eksiksiz veririm.", "CHR_029_DUGUM_2_1_SEC_1_METIN": "Madem çivi ustasısın, çivi kaç vuruşta biter, menteşe kaç kanat ister?", "CHR_029_DUGUM_2_2_REPLIK": "(Eli rahatlar) Çivi dört vuruş, beşincisi ezer. Menteşe iki kanat, pimi gevşek kalmaz. Utanç düşünce sayım şaşar ama örs şaşmaz.", "CHR_029_DUGUM_2_2_SEC_1_METIN": "Bir eksik sayım insanı yer bitirir. İş bilen adama kapımız açık.", "CHR_029_DUGUM_2_2_SEC_2_METIN": "Eksik bıraktığını ağzınla söyledin. Sipariş sahibi arkandan gelir, adın ne?", "CHR_029_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Basri. Hırsız değilim. O kese utancımdan kaldı. Çivi Ocağı'nda çivi döğerim, menteşe yaparım. Yeter ki Halis'e teslim etmeyin.", "CHR_029_DUGUM_2_3_SEC_1_METIN": "Basri olduğunu bildik. Şimdi o keseye bakalım.", "CHR_029_DUGUM_2_3_AGRESIF_REPLIK": "(Parmağını saklar) Evet, Basri'yim ben. Siparişi eksik bıraktım. Başparmaktaki çukur ondan. Bu el bir menteşeyi tutar. Geri çevirirseniz dağda aç kalırım.", "CHR_029_DUGUM_3_1_REPLIK": "(Keseyi yere kor, parmağını açar) Görmüşsün bekçi. İnkar etmem.", "CHR_029_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Basri. Şimdi niyetini söyle.", "CHR_029_DUGUM_3_2_REPLIK": "", "CHR_029_DUGUM_3_3_REPLIK": "(Çivileri sayar, eksiktir) Halis'in hakkı bu kadardı, ben kaçırdım. Çivi Ocağı'nda döğerim, sayıyı tam veririm. Bir daha eksik kese dikmem. Beni içeri al. Halis gelirse sakla beni.", "CHR_029_DUGUM_3_3_SEC_1_METIN": "Elin de utancın da belli Basri. Şimdi hükmün verilecek.", "CHR_029_DUGUM_FINAL_RET_REPLIK": "(Keseyi önlüğe sokar, parmağını yumar) Siz de o siparişçi gibisiniz. Menteşeniz düşsün.", "CHR_029_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_029_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız eksik çivi kesesine ve başparmaktaki çukurlara bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_029_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Çivi ustası örste durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_029_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin çekiç tutmuş ama başparmağın taze çukur. Hangi ocaktan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_029_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR029_SiparisCubugu], [Clue_CHR029_EksikCivi] veya [Clue_Görsel_CHR029_ParmakCokugu] ipuçlarına dikkatle bakılır: Kuşağındaki sipariş çubuğu [Clue_CHR029_SiparisCubugu], önlükteki eksik çivi kesesi [Clue_CHR029_EksikCivi] ve başparmaktaki çekiç çukurları [Clue_Görsel_CHR029_ParmakCokugu]! Sen iş arayan değil, siparişi eksik bırakıp kaçan ustasın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR029_SiparisCubugu", "Clue_CHR029_EksikCivi", "Clue_Görsel_CHR029_ParmakCokugu", "Clue_CHR029_SiparisCubugu", "Clue_CHR029_EksikCivi", "Clue_Görsel_CHR029_ParmakCokugu"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_029_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Parmaklarım şiş bekçi. Çivi döğerim, menteşe yaparım. Ocağın bir köşesinde dururum.\"", "Seçenek 1 (Dal 1 yol): \"Çivi ustası örste durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin çekiç tutmuş ama başparmağın taze çukur. Hangi ocaktan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR029_SiparisCubugu], [Clue_CHR029_EksikCivi] veya [Clue_Görsel_CHR029_ParmakCokugu] ipuçlarına dikkatle bakılır: Kuşağındaki sipariş çubuğu [Clue_CHR029_SiparisCubugu], önlükteki eksik çivi kesesi [Clue_CHR029_E
sonraki_spawns = {"on_accept": {"entity_id": &"CHR_116", "offset": 3, "kaynak": "on accept: [CHR_116] - Menteşe kalfası Tevfik, Basri'nin çivi ocağına yardım etmek için gelen, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_117", "offset": 2, "kaynak": "on reject: [CHR_117] - Sipariş sahibi Halis, eksik çivinin hesabını soran köy adamı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_118", "offset": 2, "kaynak": "on bribe: [CHR_118] - Çivi sayıcısı Ragıp, muhafızın elindeki avuç çiviyi saymaya gelen, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_119", "offset": 3, "kaynak": "on jail: [CHR_119] - Örs çırağı Şinasi, zindandaki Basri'den menteşeyi teslim almak için gelen, +3 tur sonra kapıyı çalar."}}

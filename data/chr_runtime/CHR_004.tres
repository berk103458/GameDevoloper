[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_004"
ad = "İlyas \"Kızıl Karga\""
sinif = &"esnaf"
fraksiyon = &"Kızıl Karga Dağ Haramilere"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Güvenlik < 5"
secere_matrisi = {"Doğum_Yeri": "Karaboran Boğazı, Taşlıbel Dağ Köyü", "Aile_Bağı": "Hamza'nın ağabeyi, babası asılmış eski bir sancak leventi", "Kırılma_Olayı": "Sancak beyinin köylerini yakıp babasını asması üzerine dağa çıkıp intikam yemini etmesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Han ve Köy Meydanı önünde post açıp köylüyle pazarlık etme bahanesiyle nöbet yerlerini ve kilit mandallarını gözetleme", "Gece_Döngüsü": "Muhafız Kışlası çevresinde dolanıp tutsakları arama ve dışarıdaki adamlarına meşaleyle işaret verme."}
persona_maskesi = "Dağ yaylalarından kürk toplayıp şehre götüren, parası bol, kibirli ve cömert bir kürk tüccarı."
gizlenen_gercek = "Kürk balyalarının içine gizlenmiş eğri kılıçlar, demir kesme keskisi ve gece köy kapısını zorlayacak çeteye baskın işareti verme niyeti."
gorsel_hata = "Sol elinin işaret ve orta parmağında yay kirişi çekmekten oluşmuş derin yara izi ve sağ avucunda ağır kılıç kabzası nasırı."
sir_baglantisi = "Tüccar adam hesap tahtası tutar; bu eldeki kiriş çentiği ve kılıç nasırı yıllardır dağda savaşan bir harami reisinin kanıtıdır."
sfx = "Kamçı şakırtısı, at nalı sesi, deriden kürk hışırtısı."
baslangic_tansiyonu = 3
zar = "d6"
sorgu_degeri = 3
obje_1 = {"aciklama": "Boynunda asılı gümüş kakmalı kemik düdük. Tıklandığında sıradan çoban düdüğü olmadığı, dağ haydutlarının gece haberleşmede kullandığı çift perdeli şahin düdüğü olduğu görülür.", "uretilen_ipucu": &"Clue_CHR004_SahinDudugu"}
obje_2 = {"aciklama": "Atının terkisindeki kalın samur ve tilki kürk dengi. Tıklandığında kürklerin arasına yağlı bezle sarılmış demir keskisi ve ağır çelik zincir gizlendiği fark edilir.", "uretilen_ipucu": &"Clue_CHR004_GizliZincir"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR004_OkcuYarigi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; kamçısıyla oynar, atının dizginini tutar, kendinden emin ve alaycı konuşur.", "Stressed": "Tansiyon 4-7; çenesi gerilir, sağ eli kaftanının altına kayar, ses tonu sertleşir ve buyurganlaşır.", "Panic": "Tansiyon 8-10; atını kapıya sürer gibi diklenir, dişlerini sıkar, tehditkâr bir öfkeyle parmaklıklara asılır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR004_SAHINDUDUGU_BASLIK": "Boynunda asılı gümüş kakmalı kemik düdük", "CLUE_CHR004_SAHINDUDUGU_TANIM": "Boynunda asılı gümüş kakmalı kemik düdük. Tıklandığında sıradan çoban düdüğü olmadığı, dağ haydutlarının gece haberleşmede kullandığı çift perdeli şahin düdüğü olduğu görülür.", "CLUE_CHR004_GIZLIZINCIR_BASLIK": "Atının terkisindeki kalın samur ve tilki kürk dengi", "CLUE_CHR004_GIZLIZINCIR_TANIM": "Atının terkisindeki kalın samur ve tilki kürk dengi. Tıklandığında kürklerin arasına yağlı bezle sarılmış demir keskisi ve ağır çelik zincir gizlendiği fark edilir.", "CHR_004_DUGUM_00_REPLIK": "Aç şu kapıyı nöbetçi. Şehre giden kürk tüccarıyım. Dağda fırtına patlayacak, atlarımı köyün hanına çekip geceliğine iyi para ödeyeceğim.", "CHR_004_DUGUM_00_SEC_1_METIN": "Karaboran boğazı eşkıyadan geçilmezken sırtında bunca kıymetli kürkle hangi yoldan geçtin?", "CHR_004_DUGUM_00_SEC_2_METIN": "Tüccarım dersin ama duruşun sancak sipahisi gibi sert. Kimin kervanındansın?", "CHR_004_DUGUM_00_SEC_3_METIN": "Boynundaki şahin düdüğü , kürklerin altındaki çelik keski ve elindeki kiriş izi ! Sen tüccar değil, Kızıl Karga'nın ta kendisisin!", "CHR_004_DUGUM_1_1_REPLIK": "Paran varsa yol bulunur nöbetçi. Boğazdaki haydutlara haraçlarını verdim, geçtim. Tüccar adam kan dökmez, kesesini açar.", "CHR_004_DUGUM_1_1_SEC_1_METIN": "Akıllıca. Eşkıyaya para vermek can vermekten yeğdir.", "CHR_004_DUGUM_1_1_SEC_2_METIN": "Yalan bu! Kızıl Karga tüccardan haraç alıp sağ bırakmaz, yükünü de atını da alıp uçuruma atar!", "CHR_004_DUGUM_1_2_REPLIK": "Öyle ya... Benim arkam sağlamdır. Sancakta da hatırım sayılır. Beni fazla oyalamasan iyi edersin.", "CHR_004_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri girince bakarız.", "CHR_004_DUGUM_1_2_SEC_2_METIN": "Arkan sağlamsa niye kervansız, tek atla kaçar gibi geldin?", "CHR_004_DUGUM_1_2_BASK__REPLIK": "(Kaşları çatılır, kamçısını sıkar) Haddini aşma kapıcı! Yolumu kime sorduğumu sana mı hesap vereceğim?", "CHR_004_DUGUM_1_2_BASK__SEC_1_METIN": "Sakin ol ağa, vazifemi yapıyorum.", "CHR_004_DUGUM_1_2_BASK__SEC_2_METIN": "Sert yapma! Boğazda kiminle anlaştın, kimi arıyorsun bu köyde?", "CHR_004_DUGUM_1_3_REPLIK": "(Sesini alçaltır, parmaklıklara sokulur) Tamam, uzatma. Buraya önden yolladığım kardeşim Hamza için geldim. Sağ mı ölü mü, onu söyle bana.", "CHR_004_DUGUM_1_3_SEC_1_METIN": "Demek Hamza'nın peşindesin... Şimdi baştan konuşalım.", "CHR_004_DUGUM_2_1_REPLIK": "Taşlıbel eşrafındanım. Babam sancak leventiydi, biz de tüccarlığa soyunduk. Dağda büyüsek de töre biliriz.", "CHR_004_DUGUM_2_1_SEC_1_METIN": "Madem Taşlıbel tüccarısın, sancak beyine hangi vergiyi ödersiniz, kürk damgası nerede basılır?", "CHR_004_DUGUM_2_2_REPLIK": "(Bıyığını burkar, gözleri kararır) Beyin damgasını sorarsan, o damgayı babamın sırtına vurdular. Biz bey tanımayız muhafız.", "CHR_004_DUGUM_2_2_SEC_1_METIN": "Babanın acısını bilirim. Dağda canı yanan çok. Doğruyu söyle, derdin ne?", "CHR_004_DUGUM_2_2_SEC_2_METIN": "Kardeşin Hamza'yı köyü yakmaya yolladın! Sen Taşlıbel tüccarı değil, Kızıl Karga İlyas'sın!", "CHR_004_DUGUM_2_3_REPLIK": "(Dik durur, sesini alçaltır) Adım İlyas. Kızıl Karga derler bana. Kardeşimi almaya geldim. Bana Hamza'yı verin, köyünüze tek bir çakıl taşı bile fırlatmadan çeker giderim.", "CHR_004_DUGUM_2_3_SEC_1_METIN": "Kimliğini öğrendik İlyas. Şimdi o yüküne bakalım.", "CHR_004_DUGUM_2_3_AGRESIF_REPLIK": "(Gözleri parlar, kılıcın kabzasına vurur) Evet, İlyas'ım ben! Bu dağların efendisiyim! Kardeşimin kılına zarar geldiyse bu köyü çıra gibi yakarım! Açın kapıyı!", "CHR_004_DUGUM_3_1_REPLIK": "(Gözleri kısılır, kamçısını yere atar) Gözün açıkmış muhafız. Beni tanıdın demek.", "CHR_004_DUGUM_3_1_SEC_1_METIN": "Yalan bitti İlyas. Şimdi niyetini dökül!", "CHR_004_DUGUM_3_2_REPLIK": "", "CHR_004_DUGUM_3_3_REPLIK": "(Balyaların ipini çözer) Kardeşim Hamza içeride. Gece kapıyı dışarıdan kırmak için getirdim bu keskileri. Ama beni içeri alırsan köyünle cenk etmem. Hamza'yı alır, yayladan çeker giderim. Size de bir kese altın bırakırım.", "CHR_004_DUGUM_3_3_SEC_1_METIN": "Planın anlaşıldı harami başı. Şimdi senin hükmün verilecek.", "CHR_004_DUGUM_FINAL_RET_REPLIK": "(Atını şaha kaldırır, kılıcını sıyırır gibi yapar) Kapıyı açmazsanız bu gece elli atlıyla geleceğim! Surları başınıza yıkarım, hiçbirinizi sağ koymam!", "CHR_004_DUGUM_FINAL_RET_SEC_1_METIN": "Haddini bildirme vakti geldi.", "CHR_004_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız kapı mandalını tutar, harami reisinin yüzüne bakar. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_004_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Karaboran boğazı eşkıyadan geçilmezken sırtında bunca kıymetli kürkle hangi yoldan geçtin?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Tüccarım dersin ama duruşun sancak sipahisi gibi sert. Kimin kervanındansın?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR004_SahinDudugu], [Clue_CHR004_GizliZincir] veya [Clue_Görsel_CHR004_OkcuYarigi] ipuçlarına dikkatle bakılır: Boynundaki şahin düdüğü [Clue_CHR004_SahinDudugu], kürklerin altındaki çelik keski [Clue_CHR004_GizliZincir] ve elindeki kiriş izi [Clue_Görsel_CHR004_OkcuYarigi]! Sen tüccar değil, Kızıl Karga'nın ta kendisisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR004_SahinDudugu", "Clue_CHR004_GizliZincir", "Clue_Görsel_CHR004_OkcuYarigi", "Clue_CHR004_SahinDudugu", "Clue_CHR004_GizliZincir", "Clue_Görsel_CHR004_OkcuYarigi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Aç şu kapıyı nöbetçi. Şehre giden kürk tüccarıyım. Dağda fırtına patlayacak, atlarımı köyün hanına çekip geceliğine iyi para ödeyeceğim.\"", "Seçenek 1 (Dal 1 yol): \"Karaboran boğazı eşkıyadan geçilmezken sırtında bunca kıymetli kürkle hangi yoldan geçtin?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Tüccarım dersin ama duruşun sancak sipahisi gibi sert. Kimin kervanındansın?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR004_SahinDudugu], [Clue_CHR004_GizliZincir] veya [Clue_Görsel_CHR004_OkcuYarigi] ipuçlarına dikkatle bakılır: Boynundaki şahin düdüğü [Clue_CHR004_SahinDudugu], kürklerin altındaki çelik keski [Clue_CHR004_GizliZincir] ve elindeki kiriş izi [Clue_Görsel_CHR004_OkcuYarigi]! Sen tüccar değil, Kızıl Karga'nın ta kendisisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_004_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Akıllıca. Eşkıyaya para vermek can vermekten yeğdir.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Yalan bu! Kızıl Karga tüccardan haraç alıp sağ bırakmaz, yükünü de atını da alıp uçuruma atar!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Paran varsa yol bulunur nöbetçi. Boğazdaki haydutlara haraçlarını verdim, geçtim. Tüccar adam kan dökmez, kesesini açar.\"", "Seçenek inan: \"Akıllıca. Eşkıyaya para vermek can vermekten yeğdir.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Yalan bu! Kızıl Karga tüccardan haraç alıp sağ bırakmaz, yükünü de atını da alıp uçuruma atar!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_004_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Pekala, içeri girince bakarız.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Arkan sağlamsa niye kervansız, tek atla kaçar gibi geldin? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyle ya... Benim arkam sağlamdır. Sancakta da hatırım sayılır. Beni fazla oyalamasan iyi edersin.\"", "Seçenek kapat: \"Pekala, içeri girince bakarız.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Arkan sağlamsa niye kervansız, tek atla kaçar gibi geldin? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_004_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Sakin ol ağa, vazifemi yapıyorum.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Sert yapma! Boğazda kiminle anlaştın, kimi arıyorsun bu köyde? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Kaşları çatılır, kamçısını sıkar) Haddini aşma kapıcı! Yolumu kime sorduğumu sana mı hesap vereceğim?\"", "Seçenek geri çekil: \"Sakin ol ağa, vazifemi yapıyorum.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Sert yapma! Boğazda kiminle anlaştın, kimi arıyorsun bu köyde? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_004_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek Hamza'nın peşindesin... Şimdi baştan konuşalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Sesini alçaltır, parmaklıklara sokulur) Tamam, uzatma. Buraya önden yolladığım kardeşim Hamza için geldim. Sağ mı ölü mü, onu söyle bana.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek Hamza'nın peşindesin... Şimdi baştan konuşalım.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_004_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem Taşlıbel tüccarısın, sancak beyine hangi vergiyi ödersiniz, kürk damgası nerede basılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Taşlıbel eşrafındanım. Babam sancak leventiydi, biz de tüccarlığa soyunduk. Dağda büyüsek de töre biliriz.\"", "Test sorusu: \"Madem Taşlıbel tüccarısın, sancak beyine hangi vergiyi ödersiniz, kürk damgası nerede basılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_004_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Babanın acısını bilirim. Dağda canı yanan çok. Doğruyu söyle, derdin ne?\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Kardeşin Hamza'yı köyü yakmaya yolladın! Sen Taşlıbel tüccarı değil, Kızıl Karga İlyas'sın! (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_004_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Bıyığını burkar, gözleri kararır) Beyin damgasını sorarsan, o damgayı babamın sırtına vurdular. Biz bey tanımayız muhafız.\"", "Seçenek empati: \"Babanın acısını bilirim. Dağda canı yanan çok. Doğruyu söyle, derdin ne?\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Kardeşin Hamza'yı köyü yakmaya yolladın! Sen Taşlıbel tüccarı değil, Kızıl Karga İlyas'sın! (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_004_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kimliğini öğrendik İlyas. Şimdi o yüküne bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Dik durur, sesini alçaltır) Adım İlyas. Kızıl Karga derler bana. Kardeşimi almaya geldim. Bana Hamza'yı verin, köyünüze tek bir çakıl taşı bile fırlatmadan çeker giderim.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Kimliğini öğrendik İlyas. Şimdi o yüküne bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_004_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Gözleri parlar, kılıcın kabzasına vurur) Evet, İlyas'ım ben! Bu dağların efendisiyim! Kardeşimin kılına zarar geldiyse bu köyü çıra gibi yakarım! Açın kapıyı!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_004_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti İlyas. Şimdi niyetini dökül!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR004_SahinDudugu], [Clue_CHR004_GizliZincir] veya [Clue_Görsel_CHR004_OkcuYarigi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Boynundaki şahin düdüğü [Clue_CHR004_SahinDudugu], kürklerin altına sakladığın keski ile zincir [Clue_CHR004_GizliZincir] ve elindeki okçu yarası [Clue_Görsel_CHR004_OkcuYarigi]! Sen tüccar değil, harami reisi İlyas'sın!\"", "NPC Replik: \"(Gözleri kısılır, kamçısını yere atar) Gözün açıkmış muhafız. Beni tanıdın demek.\"", "Seçenek: \"Yalan bitti İlyas. Şimdi niyetini dökül!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_004_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_004_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Planın anlaşıldı harami başı. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Balyaların ipini çözer) Kardeşim Hamza içeride. Gece kapıyı dışarıdan kırmak için getirdim bu keskileri. Ama beni içeri alırsan köyünle cenk etmem. Hamza'yı alır, yayladan çeker giderim. Size de bir kese altın bırakırım.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Planın anlaşıldı harami başı. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_004_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_004_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Atını şaha kaldırır, kılıcını sıyırır gibi yapar) Kapıyı açmazsanız bu gece elli atlıyla geleceğim! Surları başınıza yıkarım, hiçbirinizi sağ koymam!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_004_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız kapı mandalını tutar, harami reisinin yüzüne bakar. Karar menüsü açılır.", ""]}}

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_016", "offset": 3, "kaynak": "on accept: [CHR_016] - Demirci Rüstem, İlyas'ın bıraktığı çelik keskileri işlemek isteyen köy demircisi, +3 tur sonra belirir."}, "on_reject": {"entity_id": &"CHR_017", "offset": 2, "kaynak": "on reject: [CHR_017] - Deli Kurt, reisi kovulduğu için intikam yemini eden harami çavuşu, +2 tur sonra kapıya dayanır."}, "on_bribe": {"entity_id": &"CHR_018", "offset": 2, "kaynak": "on bribe: [CHR_018] - Karagöz İshak, İlyas'ın verdiği rüşveti koklayıp pay isteyen han odacısı, +2 tur sonra gelir."}, "on_jail": {"entity_id": &"CHR_019", "offset": 4, "kaynak": "on jail: [CHR_019] - Süvari Alaybeyi Ferhat, tutsak çete reisini teslim almak üzere sancaktan gelen komutan, +4 tur sonra teşrif eder."}}

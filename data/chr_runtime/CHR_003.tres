sonraki_spawns = {"on_accept": {"entity_id": &"CHR_012", "offset": 4, "kaynak": "on accept: [CHR_012] - Çırak Mahmut, Haydar Usta'nın köye yerleştiğini duyup Taşlık Hisar'dan kaçan genç demirci kalfası, +4 tur sonra kapıya varır."}, "on_reject": {"entity_id": &"CHR_013", "offset": 3, "kaynak": "on reject: [CHR_013] - Binbaşı Cengiz, kaçağın izini süren Taşlık Hisar sancak süvari komutanı, +3 tur sonra hududa dayanır."}, "on_bribe": {"entity_id": &"CHR_014", "offset": 2, "kaynak": "on bribe: [CHR_014] - Kuyumcu Agop, muhafızın elindeki cerrah gümüşünü satın almak için sinsice yaklaşan gezgin tefeci, +2 tur sonra kapıda biter."}, "on_jail": {"entity_id": &"CHR_015", "offset": 5, "kaynak": "on jail: [CHR_015] - Çavuş Battal, tutsak Haydar Usta'yı teslim almak üzere sancaktan gelen zırhlı muhafız çavuşu, +5 tur sonra teşrif eder."}}

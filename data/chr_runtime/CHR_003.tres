[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_003"
ad = "Cerrah Haydar Usta"
sinif = &"esnaf"
fraksiyon = &"Bağımsız Zanaatkarlar"
en_erken_tur = 6
spawn_kosulu = "Tur > 5 ve Refah < 5"
secere_matrisi = {"Doğum_Yeri": "Taşlık Hisar, Madenboğazı", "Aile_Bağı": "Çırağı olan tek oğlu beyin maden ocağındaki göçükte can vermiş, gelini ve torunları esir tutulurken kaçırılmıştır", "Kırılma_Olayı": "Sancak beyinin gizli sefere hazırlanırken yaralı esirlerin uzuvlarını kesip zehirli mızrak uçları dökmeye zorlaması üzerine aletlerini saklayıp kaçması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Demirhane ocağında köylünün aşınmış saban demirlerini, oraklarını dövme ve bakır kazan kalaylama işi", "Gece_Döngüsü": "Demirhane körüğünü gizlice harlayarak kömür sepetine gizlediği neşterleri, kemik testerelerini bileme ve dağlama kıskaçlarını tavlama."}
persona_maskesi = "Dilsiz gibi az konuşan, saçı sakalı külden ağarmış, köylünün tencere tavasını iki lokma kuru ekmeğe kalaylayan zavallı bir gezgin kalaycı."
gizlenen_gercek = "Yanındaki kalay körüğü ve kömür sepetlerinin tabanına gizlenmiş, ince cerrahi aletler, kemik testereleri, damar dağlama maşaları ve efsanevi su verilmiş ak çelik döküm kalıpları."
gorsel_hata = "Sağ el başparmağı ile işaret parmağı arasında cerrah neşteri ve hassas mengene tutmaktan kemikleşmiş derin nasır çizgisi ile ön kolundaki akkor maden sıçramasından kalma hilal biçimli eski pota yanığı."
sir_baglantisi = "Bu derin nasır ve yanık kaba tencere kalaycısının yumuşak kurşun isiyle oluşmaz; yüksek hararetli çelik potası döken ve ince cerrah aleti tutan usta bir hekim-dökümcünün fiziksel kanıtıdır."
sfx = "Bakır kap tıngırtısı, eşek çıngırağının tok madeni sesi, ustanın derinden gelen boğuk ve temkinli öksürüğü."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 3
obje_1 = {"aciklama": "Boynunda asılı deri kalaycı önlüğü ve kösele kılıf. Tıklandığında kılıfın içinde kalay çubuğu yerine som gümüş işlemeli sapı olan, olağanüstü keskin ve ince uçlu bir cerrah neşteri saklandığı görülür.", "uretilen_ipucu": &"Clue_CHR003_GumusNester"}
obje_2 = {"aciklama": "Eşeğinin sırtındaki çifte kömür sepeti ve dikişli manda derisinden körük takımı. Tıklandığında körüğün hava haznesine tıkıştırılmış bez ruloların içinden ince kemik testereleri, diş kıskaçları ve çelik döküm potaları çıkar.", "uretilen_ipucu": &"Clue_CHR003_CerrahiKoruk"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR003_CelikYanigiNasir"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; ağırbaşlı bir sükunetle eşeğinin yularını tutar, başını hafifçe eğip kısık sesle köylüce konuşur.", "Stressed": "Tansiyon 4-7; kaşları çatılır, hekim gözleri muhafızın duruşundaki açıkları süzer, eli kömür sepetinin kapağına kilitlenir.", "Panic": "Tansiyon 8-10; yüzü kaskatı kesilir, alet sandığını sertçe örter, geri çekilip gururla ve tehditkâr bir vakarla dikleşir."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR003_GUMUSNESTER_BASLIK": "Boynunda asılı deri kalaycı önlüğü ve kösele kılıf", "CLUE_CHR003_GUMUSNESTER_TANIM": "Boynunda asılı deri kalaycı önlüğü ve kösele kılıf. Tıklandığında kılıfın içinde kalay çubuğu yerine som gümüş işlemeli sapı olan, olağanüstü keskin ve ince uçlu bir cerrah neşteri saklandığı görülür.", "CLUE_CHR003_CERRAHIKORUK_BASLIK": "Eşeğinin sırtındaki çifte kömür sepeti ve dikişli manda derisinden körük takımı", "CLUE_CHR003_CERRAHIKORUK_TANIM": "Eşeğinin sırtındaki çifte kömür sepeti ve dikişli manda derisinden körük takımı. Tıklandığında körüğün hava haznesine tıkıştırılmış bez ruloların içinden ince kemik testereleri, diş kıskaçları ve çelik döküm potaları çıkar.", "CHR_003_DUGUM_00_REPLIK": "Selamunaleyküm muhafız oğul. Taşlık Hisar'dan gelirim, adım derviş kalaycı derler. Köyünüzün tenceresi tavası delikse lehimlerim, saban demirini bilerim. Başımı sokacak bir samanlık, bir tas sıcak aşa razıyım.", "CHR_003_DUGUM_00_SEC_1_METIN": "Taşlık Hisar yolu çetelerle ve sancak süvarileriyle tutulmuşken ihtiyar halinle bu koca körükle o dağları nasıl tek başına aştın?", "CHR_003_DUGUM_00_SEC_2_METIN": "Kalaycıyım dersin lakin dilinde saray ocağı görmüş bir edep var. Kimin tezgahında yetiştin ihtiyar?", "CHR_003_DUGUM_00_SEC_3_METIN": "Kılıfındaki o parlak maden kalay çubuğu değil, has gümüş cerrah neşteri! Göster o körüğü!", "CHR_003_DUGUM_1_1_REPLIK": "Dağ yollarının kurduyum oğul. Kervan yoluna çıkmam, keçi patikalarından yürürüm. Eşkıya da kalaycı sepetine tenezzül etmez; iki delik tencere için kimse yay kirişini germez.", "CHR_003_DUGUM_1_1_SEC_1_METIN": "Doğru dersin, hırsız bile zengine bakar; fakirin canından gayrı nesi var.", "CHR_003_DUGUM_1_1_SEC_2_METIN": "Keçi patikasında eşekle bu ağırlık taşınmaz ihtiyar! Körüğünün ağırlığı eşeğin belini bükmüş, taşıdığın şey tencere kalayı değil!", "CHR_003_DUGUM_1_2_REPLIK": "Gözün keskinmiş muhafız... Eşek yaşlıdır, yüküm de kömür doludur. Maden kömürü ağır çeker, ocak harlansın diye dağ meşesi taşırım.", "CHR_003_DUGUM_1_2_SEC_1_METIN": "Eh, madem kömürdür, kapıda fazla oyalanma.", "CHR_003_DUGUM_1_2_SEC_2_METIN": "Dağ meşesi kömürü böyle madeni çınlamaz ihtiyar! O sepetlerin dibinde ne saklıyorsun?", "CHR_003_DUGUM_1_2_BASK__REPLIK": "(Gözleri kısılır, sesindeki gevşek köylü tavrı aniden kaybolur, omurgası dikleşir) Şüphe etmek vazifendir oğul, lakin her ağır yükün altında fenalık arama. Taşlık Hisar'ın cellatlarından kaçan bir biçareyim ben.", "CHR_003_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkeni dizginle ihtiyar, niyetim seni hırpalamak değil.", "CHR_003_DUGUM_1_2_BASK__SEC_2_METIN": "Cellat lafı çıktı ağzından! Taşlık Hisar beyinin cellatları kimi arar da bu sınıra kadar kovalar?", "CHR_003_DUGUM_1_3_REPLIK": "(İçini çeker, etrafı süzerek fısıldar) Beyin süvarileri ardımdadır. Taşlık Hisar'ın gizli cephanesinden firar ettim. Yakalarlarsa diri diri derimi yüzerler. Sırf demiri ve insan etini bildiğim için kement attılar boynuma.", "CHR_003_DUGUM_1_3_SEC_1_METIN": "Demek arkanda sancak süvarileri var... Şimdi kim olduğunu dosdoğru anlat.", "CHR_003_DUGUM_2_1_REPLIK": "Taşlık Hisar çarşısında elli yıl kalay çaldım, nal dövdüm oğul. Çok paşa gördüm, çok bey sofrasının artığını topladım. Dilimiz terbiyeliyse ondandır.", "CHR_003_DUGUM_2_1_SEC_1_METIN": "Madem elli yıllık nalbantsın, atın tırnağına mıh çakarken can damarı nerededir, söve nasıl tesviye edilir söyle bakalım?", "CHR_003_DUGUM_2_2_REPLIK": "(Hafifçe tebessüm eder, ellerine bakar) Mıhı tırnağın beyaz çizgisine çalarsın, ete kaçarsa hayvan topallar... Lakin ben at tırnağından ziyade insan kemiğini bilirim oğul. Can damarını da etin derinini de...", "CHR_003_DUGUM_2_2_SEC_1_METIN": "Demek yaralı saran, can kurtaran birisin. Gözlerindeki keder de bundan. Çekinme benden usta.", "CHR_003_DUGUM_2_2_SEC_2_METIN": "Sancak beyinin cephanesinden kaçtığını kendi ağzınla söyledin! Sıradan nalbant insan etinden ne anlar? Kimsin sen Haydar Usta?", "CHR_003_DUGUM_2_3_REPLIK": "(Ağırbaşlı bir vakarla başını eğer) Adım Haydar'dır. Taşlık Hisar'ın başcerrahı ve döküm ustasıydım. Savaş meydanında yüzlerce leventin bacağını diktim, okunu çıkardım. Bey zalimdi; yaralı esirleri zehirlememi ve gizli hançerler dövmemi emretti. Reddedip kaçtım.", "CHR_003_DUGUM_2_3_SEC_1_METIN": "Böyle bir zanaat ehli başımızın tacıdır. Lakin yükündeki kanıtları da görelim.", "CHR_003_DUGUM_2_3_AGRESIF_REPLIK": "(Gözleri parlar, sesini yükseltir) Evet! Ben Başcerrah Haydar'ım! O zalim beyin ordusuna canımı satmadım diye kaçak ilan edildim! Bu ellerle bin can kurtardım ben; eşkıya değilim, hırsız değilim! Bu kapıyı açarsan köyüne hekim olurum, ocakçı olurum; açmazsan boynumu cellada uzatırım!", "CHR_003_DUGUM_3_1_REPLIK": "(Şaşkınlıkla geri çekilir, sakalını sıvazlar) Vay canına... Bir sınır muhafızının cerrah neşterini ve pota yanığını ilk bakışta teşhis edeceğini hiç ummazdım.", "CHR_003_DUGUM_3_1_SEC_1_METIN": "Gözümüzden kaçmaz usta. Şimdi sakladığın hünerin aslını dökül.", "CHR_003_DUGUM_3_2_REPLIK": "", "CHR_003_DUGUM_3_3_REPLIK": "(Körüğün kapağını aralar, parıldayan çelik aletleri gösterir) Madem gördün, inkâr etmem. Yanımda kırk yıllık cerrah takımım ve çeliğe su verme kalıplarım var. Köyünüzün Şifahane'sinde kangrenli bacak keser, yaralı dikerim. Demirhane'nizde orakları kırılmaz çelikten dökerim. Yeter ki beni o zalim beye teslim etmeyin.", "CHR_003_DUGUM_3_3_SEC_1_METIN": "Hünerin köyümüzün yarasına merhemdir Haydar Usta. Şimdi hükmün verilecek.", "CHR_003_DUGUM_FINAL_RET_REPLIK": "(Yüzü kaskatı kesilir, alet sandığını sertçe kilitler) Yeter! Gözlerindeki açgözlülüğü gördüm muhafız! Sen beni beye satıp başına ödül alacaksın! Tek kelime daha etmem, ister vur ister zindana at, Haydar Usta celladın ayağına kendi rızasıyla gitmez!", "CHR_003_DUGUM_FINAL_RET_SEC_1_METIN": "İhtiyarın inadı tuttu, kapılar kapandı.", "CHR_003_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız ustanın hüneri ile sancak beyinin gazabı arasında bir karara varır; kapı kolu elde bekler. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_003_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Taşlık Hisar yolu çetelerle ve sancak süvarileriyle tutulmuşken ihtiyar halinle bu koca körükle o dağları nasıl tek başına aştın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Kalaycıyım dersin lakin dilinde saray ocağı görmüş bir edep var. Kimin tezgahında yetiştin ihtiyar?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR003_GumusNester], [Clue_CHR003_CerrahiKoruk] veya [Clue_Görsel_CHR003_CelikYanigiNasir] ipuçlarına dikkatle bakılır: Kılıfındaki o parlak maden kalay çubuğu değil, has gümüş cerrah neşteri! Göster o körüğü!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR003_GumusNester", "Clue_CHR003_CerrahiKoruk", "Clue_Görsel_CHR003_CelikYanigiNasir"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Selamunaleyküm muhafız oğul. Taşlık Hisar'dan gelirim, adım derviş kalaycı derler. Köyünüzün tenceresi tavası delikse lehimlerim, saban demirini bilerim. Başımı sokacak bir samanlık, bir tas sıcak aşa razıyım.\"", "Seçenek 1 (Dal 1 yol): \"Taşlık Hisar yolu çetelerle ve sancak süvarileriyle tutulmuşken ihtiyar halinle bu koca körükle o dağları nasıl tek başına aştın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Kalaycıyım dersin lakin dilinde saray ocağı görmüş bir edep var. Kimin tezgahında yetiştin ihtiyar?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR003_GumusNester], [Clue_CHR003_CerrahiKoruk] veya [Clue_Görsel_CHR003_CelikYanigiNasir] ipuçlarına dikkatle bakılır: Kılıfındaki o parlak maden kalay çubuğu değil, has gümüş cerrah neşteri! Göster o körüğü!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_003_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğru dersin, hırsız bile zengine bakar; fakirin canından gayrı nesi var.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Keçi patikasında eşekle bu ağırlık taşınmaz ihtiyar! Körüğünün ağırlığı eşeğin belini bükmüş, taşıdığın şey tencere kalayı değil!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Dağ yollarının kurduyum oğul. Kervan yoluna çıkmam, keçi patikalarından yürürüm. Eşkıya da kalaycı sepetine tenezzül etmez; iki delik tencere için kimse yay kirişini germez.\"", "Seçenek inan: \"Doğru dersin, hırsız bile zengine bakar; fakirin canından gayrı nesi var.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Keçi patikasında eşekle bu ağırlık taşınmaz ihtiyar! Körüğünün ağırlığı eşeğin belini bükmüş, taşıdığın şey tencere kalayı değil!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_003_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Eh, madem kömürdür, kapıda fazla oyalanma.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Dağ meşesi kömürü böyle madeni çınlamaz ihtiyar! O sepetlerin dibinde ne saklıyorsun? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Gözün keskinmiş muhafız... Eşek yaşlıdır, yüküm de kömür doludur. Maden kömürü ağır çeker, ocak harlansın diye dağ meşesi taşırım.\"", "Seçenek kapat: \"Eh, madem kömürdür, kapıda fazla oyalanma.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Dağ meşesi kömürü böyle madeni çınlamaz ihtiyar! O sepetlerin dibinde ne saklıyorsun? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_003_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkeni dizginle ihtiyar, niyetim seni hırpalamak değil.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Cellat lafı çıktı ağzından! Taşlık Hisar beyinin cellatları kimi arar da bu sınıra kadar kovalar? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri kısılır, sesindeki gevşek köylü tavrı aniden kaybolur, omurgası dikleşir) Şüphe etmek vazifendir oğul, lakin her ağır yükün altında fenalık arama. Taşlık Hisar'ın cellatlarından kaçan bir biçareyim ben.\"", "Seçenek geri çekil: \"Öfkeni dizginle ihtiyar, niyetim seni hırpalamak değil.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Cellat lafı çıktı ağzından! Taşlık Hisar beyinin cellatları kimi arar da bu sınıra kadar kovalar? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_003_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek arkanda sancak süvarileri var... Şimdi kim olduğunu dosdoğru anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(İçini çeker, etrafı süzerek fısıldar) Beyin süvarileri ardımdadır. Taşlık Hisar'ın gizli cephanesinden firar ettim. Yakalarlarsa diri diri derimi yüzerler. Sırf demiri ve insan etini bildiğim için kement attılar boynuma.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek arkanda sancak süvarileri var... Şimdi kim olduğunu dosdoğru anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_003_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem elli yıllık nalbantsın, atın tırnağına mıh çakarken can damarı nerededir, söve nasıl tesviye edilir söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Taşlık Hisar çarşısında elli yıl kalay çaldım, nal dövdüm oğul. Çok paşa gördüm, çok bey sofrasının artığını topladım. Dilimiz terbiyeliyse ondandır.\"", "Test sorusu: \"Madem elli yıllık nalbantsın, atın tırnağına mıh çakarken can damarı nerededir, söve nasıl tesviye edilir söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_003_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Demek yaralı saran, can kurtaran birisin. Gözlerindeki keder de bundan. Çekinme benden usta.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Sancak beyinin cephanesinden kaçtığını kendi ağzınla söyledin! Sıradan nalbant insan etinden ne anlar? Kimsin sen Haydar Usta? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_003_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Hafifçe tebessüm eder, ellerine bakar) Mıhı tırnağın beyaz çizgisine çalarsın, ete kaçarsa hayvan topallar... Lakin ben at tırnağından ziyade insan kemiğini bilirim oğul. Can damarını da etin derinini de...\"", "Seçenek empati: \"Demek yaralı saran, can kurtaran birisin. Gözlerindeki keder de bundan. Çekinme benden usta.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Sancak beyinin cephanesinden kaçtığını kendi ağzınla söyledin! Sıradan nalbant insan etinden ne anlar? Kimsin sen Haydar Usta? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_003_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Böyle bir zanaat ehli başımızın tacıdır. Lakin yükündeki kanıtları da görelim.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Ağırbaşlı bir vakarla başını eğer) Adım Haydar'dır. Taşlık Hisar'ın başcerrahı ve döküm ustasıydım. Savaş meydanında yüzlerce leventin bacağını diktim, okunu çıkardım. Bey zalimdi; yaralı esirleri zehirlememi ve gizli hançerler dövmemi emretti. Reddedip kaçtım.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Böyle bir zanaat ehli başımızın tacıdır. Lakin yükündeki kanıtları da görelim.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_003_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Gözleri parlar, sesini yükseltir) Evet! Ben Başcerrah Haydar'ım! O zalim beyin ordusuna canımı satmadım diye kaçak ilan edildim! Bu ellerle bin can kurtardım ben; eşkıya değilim, hırsız değilim! Bu kapıyı açarsan köyüne hekim olurum, ocakçı olurum; açmazsan boynumu cellada uzatırım!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_003_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Gözümüzden kaçmaz usta. Şimdi sakladığın hünerin aslını dökül.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR003_GumusNester], [Clue_CHR003_CerrahiKoruk] veya [Clue_Görsel_CHR003_CelikYanigiNasir] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kılıfındaki gümüş neşter [Clue_CHR003_GumusNester], körüğün içine gizlenmiş cerrahi aletler [Clue_CHR003_CerrahiKoruk] ve kolundaki pota yanığı ile parmaklarındaki cerrah nasırı [Clue_Görsel_CHR003_CelikYanigiNasir]! Sen basit bir kalaycı değil, usta bir cerrah ve çelik dökümcüsüsün!\"", "NPC Replik: \"(Şaşkınlıkla geri çekilir, sakalını sıvazlar) Vay canına... Bir sınır muhafızının cerrah neşterini ve pota yanığını ilk bakışta teşhis edeceğini hiç ummazdım.\"", "Seçenek: \"Gözümüzden kaçmaz usta. Şimdi sakladığın hünerin aslını dökül.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_003_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_003_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Hünerin köyümüzün yarasına merhemdir Haydar Usta. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Körüğün kapağını aralar, parıldayan çelik aletleri gösterir) Madem gördün, inkâr etmem. Yanımda kırk yıllık cerrah takımım ve çeliğe su verme kalıplarım var. Köyünüzün Şifahane'sinde kangrenli bacak keser, yaralı dikerim. Demirhane'nizde orakları kırılmaz çelikten dökerim. Yeter ki beni o zalim beye teslim etmeyin.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Hünerin köyümüzün yarasına merhemdir Haydar Usta. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_003_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İhtiyarın inadı tuttu, kapılar kapandı.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_003_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Yüzü kaskatı kesilir, alet sandığını sertçe kilitler) Yeter! Gözlerindeki açgözlülüğü gördüm muhafız! Sen beni beye satıp başına ödül alacaksın! Tek kelime daha etmem, ister vur ister zindana at, Haydar Usta celladın ayağına kendi rızasıyla gitmez!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İhtiyarın inadı tuttu, kapılar kapandı.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_003_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız ustanın hüneri ile sancak beyinin gazabı arasında bir karara varır; kapı kolu elde bekler. Karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Saglik": 3, "Refah": 3, "Guvenlik": 1}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise Haydar Usta Şifahane'de başcerrah ve Demirhane'de çelik ustası yapılır. Hastalar şifa bulur, aletler kaliteli çelikle yenilenir: derhal Sağlık +3, Refah +3 ve Güvenlik +1 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 6'da Demirhane binasında Taşlık Hisar süvarileri baskın yapar; çıkan çatışmada Demirhane ateşe verilir, Güvenlik -4, Refah -3 ve Moral -2 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Sancak beyinin cellatları ve intikamcı süvarileri köye uğramadan geçer, beylikle çıkacak çatışma engellenir. Debuff: 3 tur boyunca Muhafız Kışlası nöbetçileri sınır boyunda devriye gezme işi yürütür, Güvenlik +2 artarken yorgunluktan Moral -1 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Usta bir hekim ve çelik dökümcüsü kapıdan çevrilir. Debuff: 4 tur boyunca Şifahane binasında yaralı ve hastaların bakımı işi aksar; Sağlık -4 ve Moral -2 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": ["Gümüş makas ve çelik külçeler"], "varyantlar": [], "kosullar": {}, "kaynak": "Muhafız ustanın heybesindeki saf gümüş cerrah makasını ve iki parça ak çelik külçesini alır (Kişisel Kazanç: Gümüş makas ve çelik külçeler). Tur 5'te Demirhane binasında eksik alet yüzünden ocakta patlama olur; Refah -2 ve Güvenlik -1 çürümesi gerçekleşir."}, "kisla": {"stat_etkisi": {"Guvenlik": 2, "Moral": -3}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Usta kışla zindanına kapatılır ve sancak beyine haber salınır. Sancakla ilişkiler düzelir fakat hünerli bir hekimin hapsedilmesine köylü isyan eder: Muhafız Kışlası binasında Güvenlik +2 kazanılırken, Moral -3 kaybedilir."}}
gecikmeli_etkiler = Array[Dictionary]([{"tur_offset": 5, "hedef_sistem": "bar", "alan": "Guvenlik", "deger": -2, "hedef_bina": "Muhafız Kışlası", "olay_id": "Süvari Devriyesi", "stat_etkisi": {"Guvenlik": -2}, "karar": "", "kosullar": {"Flag_Yol_Sirri_Acik": false}, "sure": 1, "kaynak": "Tur 5'te Muhafız Kışlası binasında 'Süvari Devriyesi' olayı yaşanır; Taşlık Hisar sancak süvarileri kaçağın izini sürerek köyün çitlerine dayanır, hudutta gerginlik sebebiyle Güvenlik -2 kaybı gerçekleşir."}, {"tur_offset": 7, "hedef_sistem": "dedikodu", "alan": "Refah", "deger": -2, "hedef_bina": "Demirhane", "olay_id": "Kırık Saban", "stat_etkisi": {"Refah": -2}, "karar": "", "kosullar": {"Flag_Kimlik_Cozuldu": false}, "sure": 1, "kaynak": "Tur 7'de Demirhane binasında 'Kırık Saban' olayı meydana gelir; Haydar Usta kimliğini saklayıp sıradan kalaycılık yaptığından köyün tarım aletleri dövülemez, Refah -2 azalır."}, {"tur_offset": 6, "hedef_sistem": "bar", "alan": "Guvenlik", "deger": -4, "hedef_bina": "Demirhane", "olay_id": "CHR_003_Kabul and secret hidden", "stat_etkisi": {"Guvenlik": -4, "Refah": -3, "Moral": -2}, "karar": "kabul", "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "sure": 1, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 6'da Demirhane binasında Taşlık Hisar süvarileri baskın yapar; çıkan çatışmada Demirhane ateşe verilir, Güvenlik -4, Refah -3 ve Moral -2 kaybedilir."}, {"tur_offset": 1, "hedef_sistem": "bar", "alan": "Guvenlik", "deger": 2, "hedef_bina": "Muhafız Kışlası", "olay_id": "CHR_003_Zorunlu ret", "stat_etkisi": {"Guvenlik": 2, "Moral": -1}, "karar": "zorunlu_ret", "kosullar": {}, "sure": 3, "kaynak": "Sancak beyinin cellatları ve intikamcı süvarileri köye uğramadan geçer, beylikle çıkacak çatışma engellenir. Debuff: 3 tur boyunca Muhafız Kışlası nöbetçileri sınır boyunda devriye gezme işi yürütür, Güvenlik +2 artarken yorgunluktan Moral -1 düşer."}, {"tur_offset": 1, "hedef_sistem": "bar", "alan": "Saglik", "deger": -4, "hedef_bina": "Şifahane", "olay_id": "CHR_003_Gönüllü ret", "stat_etkisi": {"Saglik": -4, "Moral": -2}, "karar": "gonullu_ret", "kosullar": {}, "sure": 4, "kaynak": "Usta bir hekim ve çelik dökümcüsü kapıdan çevrilir. Debuff: 4 tur boyunca Şifahane binasında yaralı ve hastaların bakımı işi aksar; Sağlık -4 ve Moral -2 kaybedilir."}, {"tur_offset": 5, "hedef_sistem": "bar", "alan": "Refah", "deger": -2, "hedef_bina": "Demirhane", "olay_id": "CHR_003_Rüşvet", "stat_etkisi": {"Refah": -2, "Guvenlik": -1}, "karar": "rusvet", "kosullar": {}, "sure": 1, "kaynak": "Muhafız ustanın heybesindeki saf gümüş cerrah makasını ve iki parça ak çelik külçesini alır (Kişisel Kazanç: Gümüş makas ve çelik külçeler). Tur 5'te Demirhane binasında eksik alet yüzünden ocakta patlama olur; Refah -2 ve Güvenlik -1 çürümesi gerçekleşir."}])

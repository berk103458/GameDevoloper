secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem değirmen kalfasısın, taş ne zaman sıkılır, kile nasıl dolar?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Unluköy değirmen başındanım. Taş döndürürüm, kile ölçerim, unu nemden korurum.\"", "Test sorusu: \"Madem değirmen kalfasısın, taş ne zaman sıkılır, kile nasıl dolar?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_030_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Baban hasta ise insan dayanamıyor. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Un ayırdığını ağzınla söyledin. Emin arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_030_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Taş öğle sıcağında sıkılmaz, sabah serininde döner. Kile ağzına kadar, üstü bıçakla silinir. Babam aklıma düşünce kertik şaşar ama taş şaşmaz.\"", "Seçenek empati: \"Baban hasta ise insan dayanamıyor. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Un ayırdığını ağzınla söyledin. Emin arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_030_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Latif olduğunu bildik. Şimdi o keseye bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Latif. Hırsız değilim. O avuç babam Saffet içindi. Değirmen'de taşı döndürürüm, kileyi doğru ölçerim. Yeter ki Cevat'a teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Latif olduğunu bildik. Şimdi o keseye bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_030_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Tırnağını saklar) Evet, Latif'im ben. Babam için az un ayırdım. Tırnaktaki hilal ondan. Bu el bir taşı döndürür. Geri çevirirseniz babam aç kalır.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_030_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Latif. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR030_KisaOlcu], [Clue_CHR030_BabaUnu] veya [Clue_Görsel_CHR030_UnTirnak] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kuşağındaki kısa ölçü [Clue_CHR030_KisaOlcu], astardaki baba unu [Clue_CHR030_BabaUnu] ve tırnaktaki un hilali [Clue_Görsel_CHR030_UnTirnak]! Sen babasına un ayıran Latif'sin!\"", "NPC Replik: \"(Keseyi söker, unu gösterir) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Latif. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_030_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_030_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Taşın da derdin de belli Latif. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Kısa kertiği gösterir) Şurası eğelenmiş. Babam Saffet için azıcık ayırdım. Değirmen'de taşı döndürürüm, kileyi tam silerim. Bir daha kısa ölçmem. Beni içeri al. Cevat gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Taşın da derdin de belli Latif. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_030_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Çubuğu kuşağa sokar, tırnağını yumar) Siz de o emin gibisiniz. Ununuz kesilsin.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_030_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız kısa ölçüye ve tırnaktaki un hilaline bakar; karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Erzak": 3, "Saglik": 1}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise Latif Değirmen binasında taş döndürme ve doğru kile ölçme işine geçirilir; derhal Erzak +3 ve Sağlık +1 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te Değirmen'de kısa ölçü yine ortaya çıkar; Erzak -2 ve Moral -1 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Un ayıran kalfa kovulur, eminle kapı kavgası önlenir. Debuff: 3 tur boyunca Değirmen binasında taş döndürme işi aksar; Erzak -2 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "İş bilen değirmen kalfası sebepsiz yere kovulur. Debuff: 4 tur boyunca Değirmen binasında dürüst kile ölçme işi aksar; Erzak -2 ve Moral -1 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 1, "esyalar": ["1 küçük un kesesi"], "varyantlar": [], "kosullar": {}, "kaynak": "Latif un kesesini ve kuşağındaki tek bakır akçeyi muhafıza verir (Kişisel Kazanç: 1 küçük un kesesi, 1 bakır akçe). İz: Tur 4'te Değirmen binasında un eksiği baş gösterir; Erzak -1 ve Sağlık -1 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 1, "Saglik": -1, "Moral": -2}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Latif kışla zindanına atılır ve değirmen eminine haber salınır. İz: Değirmen'de doğru ölçme boş kalır, babasının unu kesilir. Güvenlik +1 kazanılırken Sağlık -1 ve Moral -2 kaybedilir."}}

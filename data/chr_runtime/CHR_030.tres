[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_030"
ad = "Latif"
sinif = &"esnaf"
fraksiyon = &"Babasına bağlı"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Erzak < 5"
secere_matrisi = {"Doğum_Yeri": "Unluköy, Değirmen Başı", "Aile_Bağı": "Babası Saffet hasta, eşi yok", "Kırılma_Olayı": "Değirmen emini Cevat sayımı sıkınca babaya ayrılan unun ortaya çıkması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Değirmen binasında taş döndürme ve kileyi doğru ölçme", "Gece_Döngüsü": "Değirmen sundurmasında unu nemden koruyup sabah tartısını hazırlama."}
persona_maskesi = "Taşın tozu sinmiş, değirmende çalışmaya gelmiş yorgun bir kalfa."
gizlenen_gercek = "Hasta babası için ayırdığı az un ve ölçme çubuğundaki kısa kertik."
gorsel_hata = "Ölçen elin tırnağı altında beyaz un hilali."
sir_baglantisi = "Bu un yol tozu değildir; kısa ölçüyle babasına un ayırırken tırnağa dolan izdir."
sfx = "Un hışırtısı, ölçme çubuğunun tıkırtısı, yorgun öksürük."
baslangic_tansiyonu = 1
zar = "d6"
sorgu_degeri = 3
obje_1 = {"aciklama": "Kuşağındaki ölçme çubuğu. Tıklandığında bir kertik eğelenmiş, kile kısa düşer.", "uretilen_ipucu": &"Clue_CHR030_KisaOlcu"}
obje_2 = {"aciklama": "Ceket astarına dikili küçük un kesesi. Tıklandığında ağızda \"Saffet\" dikişi ve ince un çıkar.", "uretilen_ipucu": &"Clue_CHR030_BabaUnu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR030_UnTirnak"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; çubuğu kuşağa sokar, tırnağını siler, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; kısa ölçüyü avuçlar, tırnak hilalini gizler.", "Panic": "Tansiyon 8-10; eli yumruk olur, diz çöker, Cevat'ın adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR030_KISAOLCU_BASLIK": "Kuşağındaki ölçme çubuğu", "CLUE_CHR030_KISAOLCU_TANIM": "Kuşağındaki ölçme çubuğu. Tıklandığında bir kertik eğelenmiş, kile kısa düşer.", "CLUE_CHR030_BABAUNU_BASLIK": "Ceket astarına dikili küçük un kesesi", "CLUE_CHR030_BABAUNU_TANIM": "Ceket astarına dikili küçük un kesesi. Tıklandığında ağızda \"Saffet\" dikişi ve ince un çıkar.", "CHR_030_DUGUM_00_REPLIK": "Un doldu ciğerime bekçi. Taş döndürürüm, kile ölçerim. Değirmende dururum, doğru tartarım.", "CHR_030_DUGUM_00_SEC_1_METIN": "Değirmenci taşın başında durur. Sen niye tek başına bu kapıdasın?", "CHR_030_DUGUM_00_SEC_2_METIN": "Elin un tutmuş ama çubuğun kısa. Hangi değirmenden koptun?", "CHR_030_DUGUM_00_SEC_3_METIN": "Kuşağındaki kısa ölçü , astardaki baba unu ve tırnaktaki un hilali ! Sen doğru tartan değil, un ayıran kalfasın!", "CHR_030_DUGUM_1_1_REPLIK": "Unluköy'de taş durdu bekçi. İş kalmadı. Boş duracağıma burada döndürürüm dedim.", "CHR_030_DUGUM_1_1_SEC_1_METIN": "Doğrudur, taş durunca kalfa yer arar.", "CHR_030_DUGUM_1_1_SEC_2_METIN": "Taş durduysa astarındaki un kesesi neyin nesi?", "CHR_030_DUGUM_1_2_REPLIK": "Bir avuç yol azığı işte. Kendim için aldım. Köye yük olmayayım diye diktim.", "CHR_030_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_030_DUGUM_1_2_SEC_2_METIN": "Yol azığının ağzında babanın adı dikili!", "CHR_030_DUGUM_1_2_BASK__REPLIK": "(Tırnağını yumar) Ne karıştırırsın bekçi? Tırnağım taş tozu. Un ayıran adam güpegündüz kapıya çıkar mı?", "CHR_030_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_030_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Tırnağındaki un hilali duruyor, doğruyu söyle!", "CHR_030_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Ayırdım. Babam Saffet hasta. Kısa ölçüyle az un aldım. Cevat sayınca kaçtım. Keseyi astara diktim.", "CHR_030_DUGUM_1_3_SEC_1_METIN": "Demek babana un ayırdın... Şimdi geçmişini anlat.", "CHR_030_DUGUM_2_1_REPLIK": "Unluköy değirmen başındanım. Taş döndürürüm, kile ölçerim, unu nemden korurum.", "CHR_030_DUGUM_2_1_SEC_1_METIN": "Madem değirmen kalfasısın, taş ne zaman sıkılır, kile nasıl dolar?", "CHR_030_DUGUM_2_2_REPLIK": "(Eli rahatlar) Taş öğle sıcağında sıkılmaz, sabah serininde döner. Kile ağzına kadar, üstü bıçakla silinir. Babam aklıma düşünce kertik şaşar ama taş şaşmaz.", "CHR_030_DUGUM_2_2_SEC_1_METIN": "Baban hasta ise insan dayanamıyor. İş bilen adama kapımız açık.", "CHR_030_DUGUM_2_2_SEC_2_METIN": "Un ayırdığını ağzınla söyledin. Emin arkandan gelir, adın ne?", "CHR_030_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Latif. Hırsız değilim. O avuç babam Saffet içindi. Değirmen'de taşı döndürürüm, kileyi doğru ölçerim. Yeter ki Cevat'a teslim etmeyin.", "CHR_030_DUGUM_2_3_SEC_1_METIN": "Latif olduğunu bildik. Şimdi o keseye bakalım.", "CHR_030_DUGUM_2_3_AGRESIF_REPLIK": "(Tırnağını saklar) Evet, Latif'im ben. Babam için az un ayırdım. Tırnaktaki hilal ondan. Bu el bir taşı döndürür. Geri çevirirseniz babam aç kalır.", "CHR_030_DUGUM_3_1_REPLIK": "(Keseyi söker, unu gösterir) Görmüşsün bekçi. İnkar etmem.", "CHR_030_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Latif. Şimdi niyetini söyle.", "CHR_030_DUGUM_3_2_REPLIK": "", "CHR_030_DUGUM_3_3_REPLIK": "(Kısa kertiği gösterir) Şurası eğelenmiş. Babam Saffet için azıcık ayırdım. Değirmen'de taşı döndürürüm, kileyi tam silerim. Bir daha kısa ölçmem. Beni içeri al. Cevat gelirse sakla beni.", "CHR_030_DUGUM_3_3_SEC_1_METIN": "Taşın da derdin de belli Latif. Şimdi hükmün verilecek.", "CHR_030_DUGUM_FINAL_RET_REPLIK": "(Çubuğu kuşağa sokar, tırnağını yumar) Siz de o emin gibisiniz. Ununuz kesilsin.", "CHR_030_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_030_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız kısa ölçüye ve tırnaktaki un hilaline bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_030_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Değirmenci taşın başında durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin un tutmuş ama çubuğun kısa. Hangi değirmenden koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR030_KisaOlcu], [Clue_CHR030_BabaUnu] veya [Clue_Görsel_CHR030_UnTirnak] ipuçlarına dikkatle bakılır: Kuşağındaki kısa ölçü [Clue_CHR030_KisaOlcu], astardaki baba unu [Clue_CHR030_BabaUnu] ve tırnaktaki un hilali [Clue_Görsel_CHR030_UnTirnak]! Sen doğru tartan değil, un ayıran kalfasın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR030_KisaOlcu", "Clue_CHR030_BabaUnu", "Clue_Görsel_CHR030_UnTirnak", "Clue_CHR030_KisaOlcu", "Clue_CHR030_BabaUnu", "Clue_Görsel_CHR030_UnTirnak"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Un doldu ciğerime bekçi. Taş döndürürüm, kile ölçerim. Değirmende dururum, doğru tartarım.\"", "Seçenek 1 (Dal 1 yol): \"Değirmenci taşın başında durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin un tutmuş ama çubuğun kısa. Hangi değirmenden koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR030_KisaOlcu], [Clue_CHR030_BabaUnu] veya [Clue_Görsel_CHR030_UnTirnak] ipuçlarına dikkatle bakılır: Kuşağındaki kısa ölçü [Clue_CHR030_KisaOlcu], astardaki baba unu [Clue_CHR030_BabaUnu] ve tırnaktaki un hilali [Clue_Görsel_CHR030_UnTirnak]! Sen doğru tartan değil, un ayıran kalfasın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_030_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, taş durunca kalfa yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Taş durduysa astarındaki un kesesi neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Unluköy'de taş durdu bekçi. İş kalmadı. Boş duracağıma burada döndürürüm dedim.\"", "Seçenek inan: \"Doğrudur, taş durunca kalfa yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Taş durduysa astarındaki un kesesi neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_030_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yol azığının ağzında babanın adı dikili! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_030_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bir avuç yol azığı işte. Kendim için aldım. Köye yük olmayayım diye diktim.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yol azığının ağzında babanın adı dikili! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_030_DUGUM_1_2_BASK__REPLIK", "sec
[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_027"
ad = "Rasim"
sinif = &"esnaf"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Sağlık < 7"
secere_matrisi = {"Doğum_Yeri": "Testiköy, Çömlek Ocağı", "Aile_Bağı": "Bekâr, çırağı ocakta kaldı", "Kırılma_Olayı": "Sağlam diye verdiği testinin yolda çatlayıp kuyu evi fark etmeden kaçması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Kuyu Evi binasında kuyu duvarını sıvama ve çatlak testi onarma", "Gece_Döngüsü": "Kuyu Evi sundurmasında çanağı nemli bezle sarıp sabaha kadar çatlamasın diye bekleme."}
persona_maskesi = "Ocağı sönmüş, testi onarmaya gelmiş yorgun bir çömlekçi."
gizlenen_gercek = "Kuyu evine bıraktığı çatlak su testisi ve baldırındaki kil izi."
gorsel_hata = "Sol baldırda yukarıdan aşağı inen ıslak kil çizgisi."
sir_baglantisi = "Bu iz yol çamuru değildir; çatlak testiden yürürken sızan suyun baldırda bıraktığı izdir."
sfx = "Çatlak çanak tıkırtısı, kil hışırtısı, yorgun öksürük."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 3
obje_1 = {"aciklama": "Çuvalındaki çatlak testi dibi. Tıklandığında dip yarık, içinden su değil kil suyu sızar.", "uretilen_ipucu": &"Clue_CHR027_CatlakDip"}
obje_2 = {"aciklama": "Kuşağındaki teslim çubuğu. Tıklandığında \"sağlam testi\" diye kendi eliyle attığı yalan kertik durur.", "uretilen_ipucu": &"Clue_CHR027_TeslimCubugu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR027_CamurCizgi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; çuvalı yere kor, baldırını örter, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; teslim çubuğunu avuçlar, kil çizgisini gizler.", "Panic": "Tansiyon 8-10; paçayı indirir, diz çöker, Şevki'nin adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR027_CATLAKDIP_BASLIK": "Çuvalındaki çatlak testi dibi", "CLUE_CHR027_CATLAKDIP_TANIM": "Çuvalındaki çatlak testi dibi. Tıklandığında dip yarık, içinden su değil kil suyu sızar.", "CLUE_CHR027_TESLIMCUBUGU_BASLIK": "Kuşağındaki teslim çubuğu", "CLUE_CHR027_TESLIMCUBUGU_TANIM": "Kuşağındaki teslim çubuğu. Tıklandığında \"sağlam testi\" diye kendi eliyle attığı yalan kertik durur.", "CHR_027_DUGUM_00_REPLIK": "Kil kurudu elimde bekçi. Testi onarırım, kuyu sıvarım. Bir köşe verseniz çamuru çözerim.", "CHR_027_DUGUM_00_SEC_1_METIN": "Çömlekçi ocağında durur. Sen niye tek başına bu kapıdasın?", "CHR_027_DUGUM_00_SEC_2_METIN": "Elin kil tutmuş ama paçan ıslak. Hangi ocaktan koptun?", "CHR_027_DUGUM_00_SEC_3_METIN": "Çuvalındaki çatlak dip , kuşağındaki yalan teslim çubuğu ve baldırındaki kil çizgisi ! Sen testi onaran değil, çatlak kaçıran çömlekçisin!", "CHR_027_DUGUM_1_1_REPLIK": "Testiköy'de iş bitti bekçi. Ocak söndü. Boş duracağıma burada testi onarırım dedim.", "CHR_027_DUGUM_1_1_SEC_1_METIN": "Doğrudur, ocak sönünce çömlekçi yer arar.", "CHR_027_DUGUM_1_1_SEC_2_METIN": "Ocak söndüyse çuvalındaki dip niye hâlâ ıslak?", "CHR_027_DUGUM_1_2_REPLIK": "Eski bir dip işte. Yoldan aldım. Köye yük olmayayım diye çuvala koydum.", "CHR_027_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_027_DUGUM_1_2_SEC_2_METIN": "Yoldan aldığın dip senin ocağının kili!", "CHR_027_DUGUM_1_2_BASK__REPLIK": "(Paçayı indirir) Ne karıştırırsın bekçi? Baldırım yoldan ıslandı. Çatlak testi bırakan adam güpegündüz kapıya çıkar mı?", "CHR_027_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_027_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Baldırındaki kil çizgisi duruyor, doğruyu söyle!", "CHR_027_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Çatlaktı. Kuyu evine sağlam diye bıraktım. Şevki fark etmeden kaçtım. Dip bende kaldı.", "CHR_027_DUGUM_1_3_SEC_1_METIN": "Demek çatlak testiyi bırakıp kaçtın... Şimdi geçmişini anlat.", "CHR_027_DUGUM_2_1_REPLIK": "Testiköy çömlek ocağındanım. Testi onarırım, kuyu duvarını sıvarım, çatlağı kille kapatırım.", "CHR_027_DUGUM_2_1_SEC_1_METIN": "Madem çömlekçisin, testi çatlağı nasıl kapanır, kuyu sıvası neyle tutulur?", "CHR_027_DUGUM_2_2_REPLIK": "(Eli rahatlar) Çatlak kuru kil tutmaz, nemli şerbetle içten sıvanır. Kuyu sıvası saman karışık, güneşte birden kurutulmaz. Utanç düşünce el titrer ama çanak şaşmaz.", "CHR_027_DUGUM_2_2_SEC_1_METIN": "Bir çatlak insanı bitirmez. İş bilen adama kapımız açık.", "CHR_027_DUGUM_2_2_SEC_2_METIN": "Çatlak bıraktığını ağzınla söyledin. Kuyu eri arkandan gelir, adın ne?", "CHR_027_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Rasim. Hırsız değilim. O dip benim kaçırdığım testinin parçası. Kuyu Evi'nde sıvarım, testiyi onarırım. Yeter ki Şevki'ye teslim etmeyin.", "CHR_027_DUGUM_2_3_SEC_1_METIN": "Rasim olduğunu bildik. Şimdi o dibe bakalım.", "CHR_027_DUGUM_2_3_AGRESIF_REPLIK": "(Paçayı saklar) Evet, Rasim'im ben. Çatlak testiyi bırakıp kaçtım. Baldırımdaki kil ondan. Bu el bir kuyuyu tutar. Geri çevirirseniz dağda aç kalırım.", "CHR_027_DUGUM_3_1_REPLIK": "(Dibi yere kor, paçayı çeker) Görmüşsün bekçi. İnkar etmem.", "CHR_027_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Rasim. Şimdi niyetini söyle.", "CHR_027_DUGUM_3_2_REPLIK": "", "CHR_027_DUGUM_3_3_REPLIK": "(Çatlağı parmağıyla gösterir) Su buradan kaçtı. Kuyu Evi'nde duvarı sıvarım, testiyi içten kapatırım. Bir daha sağlam diye yalan kertik atmam. Beni içeri al. Şevki gelirse sakla beni.", "CHR_027_DUGUM_3_3_SEC_1_METIN": "Elin de çatlağın da belli Rasim. Şimdi hükmün verilecek.", "CHR_027_DUGUM_FINAL_RET_REPLIK": "(Dibi çuvala sokar, paçayı indirir) Siz de o kuyu eri gibisiniz. Testiniz çatlasın.", "CHR_027_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_027_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız çatlak dibe ve baldırdaki kil çizgisine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_027_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Çömlekçi ocağında durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin kil tutmuş ama paçan ıslak. Hangi ocaktan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR027_CatlakDip], [Clue_CHR027_TeslimCubugu] veya [Clue_Görsel_CHR027_CamurCizgi] ipuçlarına dikkatle bakılır: Çuvalındaki çatlak dip [Clue_CHR027_CatlakDip], kuşağındaki yalan teslim çubuğu [Clue_CHR027_TeslimCubugu] ve baldırındaki kil çizgisi [Clue_Görsel_CHR027_CamurCizgi]! Sen testi onaran değil, çatlak kaçıran çömlekçisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR027_CatlakDip", "Clue_CHR027_TeslimCubugu", "Clue_Görsel_CHR027_CamurCizgi", "Clue_CHR027_CatlakDip", "Clue_CHR027_TeslimCubugu", "Clue_Görsel_CHR027_CamurCizgi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kil kurudu elimde bekçi. Testi onarırım, kuyu sıvarım. Bir köşe verseniz çamuru çözerim.\"", "Seçenek 1 (Dal 1 yol): \"Çömlekçi ocağında durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin kil tutmuş ama paçan ıslak. Hangi ocaktan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR027_CatlakDip], [Clue_CHR027_TeslimCubugu] veya [Clue_Görsel_CHR027_CamurCizgi] ipuçlarına dikkatle bakılır: Çuvalındaki çatlak dip [Clue_CHR027_CatlakDip], kuşağındaki yalan teslim çubuğu [Clue_CHR027_TeslimCubugu] ve baldırındaki kil çizgisi [Clue_Görsel_CHR027_CamurCizgi]! Sen testi onaran değil, çatlak kaçıran çömlekçisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_027_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, ocak sönünce çömlekçi yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Ocak söndüyse çuvalındaki dip niye hâlâ ıslak?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Testiköy'de iş bitti bekçi. Ocak söndü. Boş duracağıma burada testi onarırım dedim.\"", "Seçenek inan: \"Doğrudur, ocak sönünce çömlekçi yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Ocak söndüyse çuvalındaki dip niye hâlâ ıslak?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_027_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yoldan aldığın dip senin ocağının kili! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_027_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir dip işte. Yoldan aldım. Köye yük olmayayım diye çuvala koydum.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yoldan aldığın dip senin ocağının kili! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm
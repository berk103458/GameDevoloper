sonraki_spawns = {"on_accept": {"entity_id": &"CHR_096", "offset": 3, "kaynak": "on accept: [CHR_096] - Menteşe çırağı Ekrem, Fehmi'nin alet düzeltmesine yardım etmek için gelen genç, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_097", "offset": 2, "kaynak": "on reject: [CHR_097] - Anbar emini Fikret, geri verilmeyen eğri kılıcı arayan sancak adamı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_098", "offset": 2, "kaynak": "on bribe: [CHR_098] - Bileyici Haşim, muhafızın elindeki eğri kılıcı düzeltmek isteyen, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_099", "offset": 3, "kaynak": "on jail: [CHR_099] - Anbar kâtibi Celal, zindandaki Fehmi'den kılıcı teslim almak için gelen, +3 tur sonra kapıyı çalar."}}

[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_024"
ad = "Fehmi"
sinif = &"asker"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 6
spawn_kosulu = "Tur > 5 ve Refah < 7"
secere_matrisi = {"Doğum_Yeri": "Demirkapı, Anbar Sokağı", "Aile_Bağı": "Bekâr, ustası anbarda kaldı", "Kırılma_Olayı": "Eğri kalan kılıcı anbar emini Fikret'e geri veremeyip gece beze sarması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Tamir Sundurması'nda eğri alet düzeltme ve menteşe çakma", "Gece_Döngüsü": "Kapı önü tahtasına çivi çakıp gediği sıkıştırma."}
persona_maskesi = "Örsü dağılmış, alet düzeltmeye gelmiş yorgun bir demir yamağı."
gizlenen_gercek = "Sancak anbarına geri vermesi gereken eğri kılıcı beze sarıp saklaması."
gorsel_hata = "Sol ön kolda eğri namlunun açtığı taze ince kesik."
sir_baglantisi = "Bu iz örs sıyrığı değildir; sakladığı eğri kılıç kola sürtünce kalan izdir."
sfx = "Bez altından kör metal tıkırtısı, utangaç yutkunma, çarık hışırtısı."
baslangic_tansiyonu = 1
zar = "d12"
sorgu_degeri = 4
obje_1 = {"aciklama": "Kolunun altında beze sarılı eğri kılıç. Tıklandığında namlu ortası bükük çıkar, dipte Demirkapı anbarının kertiği durur.", "uretilen_ipucu": &"Clue_CHR024_EgriKilic"}
obje_2 = {"aciklama": "Cebindeki anbar çubuğu. Tıklandığında bir kılıç geri verilmemiş, kertik açık kalmış görünür.", "uretilen_ipucu": &"Clue_CHR024_AnbarCubugu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR024_KolKesigi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; bezi koluna bastırır, kesik kolu yenine çeker, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; anbar çubuğunu avuçlar, kılıcı göğsüne çeker.", "Panic": "Tansiyon 8-10; kol kesığını saklar, diz çöker, Fikret'in adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR024_EGRIKILIC_BASLIK": "Kolunun altında beze sarılı eğri kılıç", "CLUE_CHR024_EGRIKILIC_TANIM": "Kolunun altında beze sarılı eğri kılıç. Tıklandığında namlu ortası bükük çıkar, dipte Demirkapı anbarının kertiği durur.", "CLUE_CHR024_ANBARCUBUGU_BASLIK": "Cebindeki anbar çubuğu", "CLUE_CHR024_ANBARCUBUGU_TANIM": "Cebindeki anbar çubuğu. Tıklandığında bir kılıç geri verilmemiş, kertik açık kalmış görünür.", "CHR_024_DUGUM_00_REPLIK": "Omuzlarım düştü bekçi. Örste durmuşluğum var. Eğriyi düzeltirim, menteşe çakarım. Bir köşe verseniz aletin ucundan tutarım.", "CHR_024_DUGUM_00_SEC_1_METIN": "Anbar dururken tamir sundurmasına niye tek başına geldin?", "CHR_024_DUGUM_00_SEC_2_METIN": "Elin demir tutmuş ama kolun sarılı. Hangi anbardan koptun?", "CHR_024_DUGUM_00_SEC_3_METIN": "Kolundaki eğri kılıç , cebindeki açık anbar çubuğu ve ön koldaki taze kesik ! Sen alet arayan değil, kılıç saklayan yamağısın!", "CHR_024_DUGUM_1_1_REPLIK": "Demirkapı'da iş bitti bekçi. Örs soğudu. Boş duracağıma burada alet düzeltirim dedim.", "CHR_024_DUGUM_1_1_SEC_1_METIN": "Doğrudur, örs susunca yamak yer arar.", "CHR_024_DUGUM_1_1_SEC_2_METIN": "İş bittiyse kolunun altındaki bez niye metal sesi veriyor?", "CHR_024_DUGUM_1_2_REPLIK": "Eski bir demir parçası işte. Yoldan aldım. Köye yük olmayayım diye sardım.", "CHR_024_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_024_DUGUM_1_2_SEC_2_METIN": "Yoldan aldığın demirin dipinde anbar kertiği var!", "CHR_024_DUGUM_1_2_BASK__REPLIK": "(Kolunu yener) Ne karıştırırsın bekçi? Kolum örsten sıyrıldı. Kılıç saklayan adam güpegündüz kapıya çıkar mı?", "CHR_024_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_024_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Kolundaki kesik duruyor, doğruyu söyle!", "CHR_024_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Sakladım. Bir kılıç eğri kaldı. Fikret Emin'e geri veremedim. Utandım. Beze sardım, geldim. Kimseye kaldırmadım.", "CHR_024_DUGUM_1_3_SEC_1_METIN": "Demek kılıcı geri vermedin... Şimdi geçmişini anlat.", "CHR_024_DUGUM_2_1_REPLIK": "Demirkapı anbarındanım. Eğriyi düzeltirim, menteşe yaparım, çivi dizerim. Kapı tahtasını sıkarım.", "CHR_024_DUGUM_2_1_SEC_1_METIN": "Madem cebe yamağısın, eğri namlu nasıl düzeltilir, menteşe nereye çakılır?", "CHR_024_DUGUM_2_2_REPLIK": "(Eli rahatlar) Eğri namlu soğukken vurulmaz, közde yavaş düzelir. Menteşe kanada iki, pervazına üç çivi. Utanç düşünce el titrer ama ölçü şaşmaz.", "CHR_024_DUGUM_2_2_SEC_1_METIN": "Utanç insanın yakasını bırakmaz. İş bilen adama kapımız açık.", "CHR_024_DUGUM_2_2_SEC_2_METIN": "Kılıcı sakladığını ağzınla söyledin. Emin arkandan gelir, adın ne?", "CHR_024_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Fehmi. Hırsız değilim, bir kılıcı utancımdan sakladım. Tamir Sundurması'nda alet düzeltirim, kapıya çivi çakarım. Yeter ki Fikret Emin'e teslim etmeyin.", "CHR_024_DUGUM_2_3_SEC_1_METIN": "Fehmi olduğunu bildik. Şimdi o beze bakalım.", "CHR_024_DUGUM_2_3_AGRESIF_REPLIK": "(Kolu saklar) Evet, Fehmi'yim ben. Eğri kılıcı geri veremedim. Koldaki kesik ondan. Bu el bir menteşeyi düz tutar. Geri çevirirseniz dağda aç kalırım.", "CHR_024_DUGUM_3_1_REPLIK": "(Bezi açar, eğri namluyu yere kor) Görmüşsün bekçi. İnkar etmem.", "CHR_024_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Fehmi. Şimdi niyetini söyle.", "CHR_024_DUGUM_3_2_REPLIK": "", "CHR_024_DUGUM_3_3_REPLIK": "(Eğri yeri gösterir) Şuna bak. Orta yerinden bükük. Kimseye sallamadım. Tamir Sundurması'nda alet düzeltirim, kapı tahtasına çivi çakarım. Beni içeri al. Fikret Emin gelirse sakla beni.", "CHR_024_DUGUM_3_3_SEC_1_METIN": "Elin de utancın da belli Fehmi. Şimdi hükmün verilecek.", "CHR_024_DUGUM_FINAL_RET_REPLIK": "(Kılıcı beze sarar, kolunu saklar) Siz de o emin gibisiniz. Menteşeniz düşsün.", "CHR_024_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_024_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız eğri kılıca ve koldaki kesiğe bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_024_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Anbar dururken tamir sundurmasına niye tek başına geldin?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin demir tutmuş ama kolun sarılı. Hangi anbardan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR024_EgriKilic], [Clue_CHR024_AnbarCubugu] veya [Clue_Görsel_CHR024_KolKesigi] ipuçlarına dikkatle bakılır: Kolundaki eğri kılıç [Clue_CHR024_EgriKilic], cebindeki açık anbar çubuğu [Clue_CHR024_AnbarCubugu] ve ön koldaki taze kesik [Clue_Görsel_CHR024_KolKesigi]! Sen alet arayan değil, kılıç saklayan yamağısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR024_EgriKilic", "Clue_CHR024_AnbarCubugu", "Clue_Görsel_CHR024_KolKesigi", "Clue_CHR024_EgriKilic", "Clue_CHR024_AnbarCubugu", "Clue_Görsel_CHR024_KolKesigi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Omuzlarım düştü bekçi. Örste durmuşluğum var. Eğriyi düzeltirim, menteşe çakarım. Bir köşe verseniz aletin ucundan tutarım.\"", "Seçenek 1 (Dal 1 yol): \"Anbar dururken tamir sundurmasına niye tek başına geldin?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin demir tutmuş ama kolun sarılı. Hangi anbardan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR024_EgriKilic], [Clue_CHR024_AnbarCubugu] veya [Clue_Görsel_CHR024_KolKesigi] ipuçlarına dikkatle bakılır: Kolundaki eğri kılıç [Clue_CHR024_EgriKilic], cebindeki açık anbar çubuğu [Clue_CHR024_AnbarCubugu] ve ön koldaki taze kesik [Clue_Görsel_CHR024_KolKesigi]! Sen alet arayan değil, kılıç saklayan yamağısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_024_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, örs susunca yamak yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"İş bittiyse kolunun altındaki bez niye metal sesi veriyor?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Demirkapı'da iş bitti bekçi. Örs soğudu. Boş duracağıma burada alet düzeltirim dedim.\"", "Seçenek inan: \"Doğrudur, örs susunca yamak yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"İş bittiyse kolunun altındaki bez niye metal sesi veriyor?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_024_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yoldan aldığın demirin dipinde anbar kertiği var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir demir parçası işte. Yoldan aldım. Köye yük olmayayım diye sardım.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yoldan aldığın demirin dipinde anbar kertiği var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_024_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Kolundaki kesik duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Kolunu yener) Ne karıştırırsın bekçi? Kolum örsten sıyrıldı. Kılıç saklayan adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Kolundaki kesik duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_024_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek kılıcı geri vermedin... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. Sakladım. Bir kılıç eğri kaldı. Fikret Emin'e geri veremedim. Utandım. Beze sardım, geldim. Kimseye kaldırmadım.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek kılıcı geri vermedin... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_024_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem cebe yamağısın, eğri namlu nasıl düzeltilir, menteşe nereye çakılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Demirkapı anbarındanım. Eğriyi düzeltirim, menteşe yaparım, çivi dizerim. Kapı tahtasını sıkarım.\"", "Test sorusu: \"Madem cebe yamağısın, eğri namlu nasıl düzeltilir, menteşe nereye çakılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_024_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Utanç insanın yakasını bırakmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Kılıcı sakladığını ağzınla söyledin. Emin arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_024_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Eğri namlu soğukken vurulmaz, közde yavaş düzelir. Menteşe kanada iki, pervazına üç çivi. Utanç düşünce el titrer ama ölçü şaşmaz.\"", "Seçenek empati: \"Utanç insanın yakasını bırakmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Kılıcı sakladığını ağzınla söyledin. Emin arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_024_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Fehmi olduğunu bildik. Şimdi o beze bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Fehmi. Hırsız değilim, bir kılıcı utancımdan sakladım. Tamir Sundurması'nda alet düzeltirim, kapıya çivi çakarım. Yeter ki Fikret Emin'e teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Fehmi olduğunu bildik. Şimdi o beze bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_024_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Kolu saklar) Evet, Fehmi'yim ben. Eğri kılıcı geri veremedim. Koldaki kesik ondan. Bu el bir menteşeyi düz tutar. Geri çevirirseniz dağda aç kalırım.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_024_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Fehmi. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR024_EgriKilic], [Clue_CHR024_AnbarCubugu] veya [Clue_Görsel_CHR024_KolKesigi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kolundaki eğri kılıç [Clue_CHR024_EgriKilic], cebindeki açık anbar çubuğu [Clue_CHR024_AnbarCubugu] ve ön koldaki taze kesik [Clue_Görsel_CHR024_KolKesigi]! Sen anbara geri vermeyen Fehmi'sin!\"", "NPC Replik: \"(Bezi açar, eğri namluyu yere kor) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Fehmi. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_024_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_024_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Elin de utancın da belli Fehmi. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Eğri yeri gösterir) Şuna bak. Orta yerinden bükük. Kimseye sallamadım. Tamir Sundurması'nda alet düzeltirim, kapı tahtasına çivi çakarım. Beni içeri al. Fikret Emin gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Elin de utancın da belli Fehmi. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_024_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_024_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Kılıcı beze sarar, kolunu saklar) Siz de o emin gibisiniz. Menteşeniz düşsün.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_024_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız eğri kılıca ve koldaki kesiğe bakar; karar menüsü açılır.", ""]}}

[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_005"
ad = "Çolak Kerim"
sinif = &"asker"
fraksiyon = &"Kızıl Karga Dağ Haramilere"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Güvenlik < 4"
secere_matrisi = {"Doğum_Yeri": "Karaboran Boğazı, Çatakkaya Mezrası", "Aile_Bağı": "Kimsesiz dağ yetimi, çete reisi İlyas'ın büyüttüğü tetikçi", "Kırılma_Olayı": "Sancak sipahilerinin köyünü basıp sol kolunu kırması sonrası kan davası gütmesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Ahır ve Köy Meydanı civarında seyislere yardım etme bahanesiyle atları ve nöbetçi devriyelerini kollama işi", "Gece_Döngüsü": "Köy çeşmesi arkasında pusuya yatıp yalnız kalan nöbetçilerin kılıçlarını ve anahtarlarını çalma girişimi."}
persona_maskesi = "Dağda ayı saldırısına uğrayıp sol kolunu sakatlamış, karın tokluğuna davar güdecek garip ve mazlum bir çoban."
gizlenen_gercek = "Sargılı kolunun içinde gizlediği zehirli kama ile köyün gece devriyesini sessizce biçip kapı sürgüsünü dışarıdaki bölüğe açma vazifesi."
gorsel_hata = "Sakat numarası yaptığı sol elinin parmakları diri ve güçlüdür; bileğinde sargının kenarından taşan karga pençesi dövmesi görünür."
sir_baglantisi = "Felçli kolun parmakları diri kalamaz ve karga pençesi damgası Karaboran haramilerinin ölüm andı mühürüdür."
sfx = "Kaba bez hışırtısı, demir çıngırtısı, hırıltılı soluma."
baslangic_tansiyonu = 3
zar = "d12"
sorgu_degeri = 4
obje_1 = {"aciklama": "Boynuna asılmış kirli meşin kol sargısı. Tıklandığında sargının altında tahta atel değil, yağlanmış keskin bir dağ kamasının kabzası ve namlusu hissedilir.", "uretilen_ipucu": &"Clue_CHR005_SargiliKama"}
obje_2 = {"aciklama": "Omzundaki eski kıl heybe. Tıklandığında bayat yufkaların altına gizlenmiş at nalı sökmeye yarayan çelik kıskaç ve tel kesme demiri bulunur.", "uretilen_ipucu": &"Clue_CHR005_DemirKeski"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR005_KargaDamgasi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; kolunu tutup inler, boynunu bükerek aciz köylü tavrı takınır.", "Stressed": "Tansiyon 4-7; inlemeyi keser, sağlam elini heybesine atar, gözlerini muhafızın boğazına diker.", "Panic": "Tansiyon 8-10; sargıyı çözer gibi geri sıçrar, dişlerini gösterir, bıçak çekmeye yeltenir."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR005_SARGILIKAMA_BASLIK": "Boynuna asılmış kirli meşin kol sargısı", "CLUE_CHR005_SARGILIKAMA_TANIM": "Boynuna asılmış kirli meşin kol sargısı. Tıklandığında sargının altında tahta atel değil, yağlanmış keskin bir dağ kamasının kabzası ve namlusu hissedilir.", "CLUE_CHR005_DEMIRKESKI_BASLIK": "Omzundaki eski kıl heybe", "CLUE_CHR005_DEMIRKESKI_TANIM": "Omzundaki eski kıl heybe. Tıklandığında bayat yufkaların altına gizlenmiş at nalı sökmeye yarayan çelik kıskaç ve tel kesme demiri bulunur.", "CHR_005_DUGUM_00_REPLIK": "Merhamet et ağa, kapıyı aç. Dağda ayı bastı, kolumu kırdı, sürüm dağıldı. Bir tas sıcak çorba, bir kuru köşe verin; ne iş olsa yaparım.", "CHR_005_DUGUM_00_SEC_1_METIN": "Ayı bastı dersin ama Karaboran yolunda ayılardan önce Kızıl Karga'nın pusuları vardır. Seni nasıl sağ bıraktılar?", "CHR_005_DUGUM_00_SEC_2_METIN": "Çobanım dersin lakin adım atışın bir kılıç erbabı gibi dengeli. Hangi yaylanın adamısın?", "CHR_005_DUGUM_00_SEC_3_METIN": "Sargının içindeki kama kabzası , heybendeki demir keskisi ve bileğindeki karga dövmesi ! Sen sakat çoban değil, harami fedaisisin!", "CHR_005_DUGUM_1_1_REPLIK": "Kayalıklara tırmandım ağam. Haydutlar atlı gezer, sarp kayaya çıkamaz. Kolum kırılınca kendimi uçurum dibine attım da kurtuldum.", "CHR_005_DUGUM_1_1_SEC_1_METIN": "Kayalıklara sığındıysan atlılar yetişemez elbet.", "CHR_005_DUGUM_1_1_SEC_2_METIN": "Uçurumdan yuvarlanan adamın kolu kırılır da üstü başı kayada paramparça olur! Senin urbanda tek bir yırtık yok!", "CHR_005_DUGUM_1_2_REPLIK": "Öyle ya... Çalılar tuttu beni ağam. Can havli işte, acıdan bayılmışım, sabah ayazında kendime geldim.", "CHR_005_DUGUM_1_2_SEC_1_METIN": "Neyse, içeri girince bakarız yaranın haline.", "CHR_005_DUGUM_1_2_SEC_2_METIN": "Bayılan adamın heybesinde taze yağlanmış demir keskisi ne arar?", "CHR_005_DUGUM_1_2_BASK__REPLIK": "(Gözleri kısılır, sağlam koluyla heybesini sıkar) Şüpheyi bırak ağa! Yaralı adamla alay mı edersin? Aç şu kapıyı!", "CHR_005_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme yolcu, vazifemi yapıyorum.", "CHR_005_DUGUM_1_2_BASK__SEC_2_METIN": "Sesindeki o hırıltı çoban sesi değil! Karaboran'da kimin adamısın sen?", "CHR_005_DUGUM_1_3_REPLIK": "(Dişlerini sıkar, parmaklıklara sokulur) Tamam... Çetenin nöbetçisiyim ben. Reis beni köye yolladı. İçerideki adamlarımıza haber ulaştıracaktım.", "CHR_005_DUGUM_1_3_SEC_1_METIN": "Demek içeride adamlarınız var... Şimdi geçmişini anlat.", "CHR_005_DUGUM_2_1_REPLIK": "Çatakkaya mezrasındanım ağam. Ağanın koyunlarını güderdim. Sancak sipahileri geldi, ocağımızı dağıttı, ben de dağlara düştüm.", "CHR_005_DUGUM_2_1_SEC_1_METIN": "Madem Çatakkayalısın, oranın koyun damgası nasıldır, kırkım zamanı ne vakittir?", "CHR_005_DUGUM_2_2_REPLIK": "(Yutkunur, başını eğer) Kırkım... güz başında yapılır... Biz koyuna damga vurmazdık, kulağını enlerdik ağam.", "CHR_005_DUGUM_2_2_SEC_1_METIN": "Köyü dağılan adamın derdi çok olur, bilirim. Sakin ol, doğrusunu de.", "CHR_005_DUGUM_2_2_SEC_2_METIN": "Çatakkaya eşkıya yatağıdır! Çeteden olduğunu itiraf ettin, asıl adın ne senin?", "CHR_005_DUGUM_2_3_REPLIK": "(Omuzları çöker) Adım Kerim'dir. Çolak Kerim derler dağda. İlyas Reis beni büyüttü, borcumu ödemek için geldim. Ama canımdan bıktım gayrı.", "CHR_005_DUGUM_2_3_SEC_1_METIN": "Kimliğini bilmek iyi oldu Kerim. Şimdi o sargına bakalım.", "CHR_005_DUGUM_2_3_AGRESIF_REPLIK": "(Sağlam eliyle sargıyı kavrar, gözleri parlar) Evet, Çolak Kerim'im ben! İlyas Reis'in fedaisiyim! Kapıyı açmazsanız bu gece kandaşlarım kanınızı içer!", "CHR_005_DUGUM_3_1_REPLIK": "(Gözleri açılır, sağlam eliyle sargıyı tutar) Gözünden bir şey kaçmıyor muhafız...", "CHR_005_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Kerim. Niyetini söyle!", "CHR_005_DUGUM_3_2_REPLIK": "", "CHR_005_DUGUM_3_3_REPLIK": "(Sargıyı çözer, kamayı toprağa saplar) Gece nöbetçileri şişleyip kapı kilidini kesecektim. Reis öyle emretti. Ama kolum gerçekten ağrır, yoruldum bu hayattan. Canımı bağışla, köyün çobanı olayım.", "CHR_005_DUGUM_3_3_SEC_1_METIN": "Bütün tertibin meydana çıktı. Şimdi hükmün verilecek.", "CHR_005_DUGUM_FINAL_RET_REPLIK": "(Kamayı çeker, parmaklıklara savurur) Geberin o zaman! Bu kapı açılmasa da dağ inecek üzerinize!", "CHR_005_DUGUM_FINAL_RET_SEC_1_METIN": "Haddini bildirme vakti geldi.", "CHR_005_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız kamayı süzer, fedainin yüzüne bakar. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_005_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Ayı bastı dersin ama Karaboran yolunda ayılardan önce Kızıl Karga'nın pusuları vardır. Seni nasıl sağ bıraktılar?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Çobanım dersin lakin adım atışın bir kılıç erbabı gibi dengeli. Hangi yaylanın adamısın?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR005_SargiliKama], [Clue_CHR005_DemirKeski] veya [Clue_Görsel_CHR005_KargaDamgasi] ipuçlarına dikkatle bakılır: Sargının içindeki kama kabzası [Clue_CHR005_SargiliKama], heybendeki demir keskisi [Clue_CHR005_DemirKeski] ve bileğindeki karga dövmesi [Clue_Görsel_CHR005_KargaDamgasi]! Sen sakat çoban değil, harami fedaisisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR005_SargiliKama", "Clue_CHR005_DemirKeski", "Clue_Görsel_CHR005_KargaDamgasi", "Clue_CHR005_SargiliKama", "Clue_CHR005_DemirKeski", "Clue_Görsel_CHR005_KargaDamgasi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Merhamet et ağa, kapıyı aç. Dağda ayı bastı, kolumu kırdı, sürüm dağıldı. Bir tas sıcak çorba, bir kuru köşe verin; ne iş olsa yaparım.\"", "Seçenek 1 (Dal 1 yol): \"Ayı bastı dersin ama Karaboran yolunda ayılardan önce Kızıl Karga'nın pusuları vardır. Seni nasıl sağ bıraktılar?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Çobanım dersin lakin adım atışın bir kılıç erbabı gibi dengeli. Hangi yaylanın adamısın?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR005_SargiliKama], [Clue_CHR005_DemirKeski] veya [Clue_Görsel_CHR005_KargaDamgasi] ipuçlarına dikkatle bakılır: Sargının içindeki kama kabzası [Clue_CHR005_SargiliKama], heybendeki demir keskisi [Clue_CHR005_DemirKeski] ve bileğindeki karga dövmesi [Clue_Görsel_CHR005_KargaDamgasi]! Sen sakat çoban değil, harami fedaisisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_005_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Kayalıklara sığındıysan atlılar yetişemez elbet.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Uçurumdan yuvarlanan adamın kolu kırılır da üstü başı kayada paramparça olur! Senin urbanda tek bir yırtık yok!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kayalıklara tırmandım ağam. Haydutlar atlı gezer, sarp kayaya çıkamaz. Kolum kırılınca kendimi uçurum dibine attım da kurtuldum.\"", "Seçenek inan: \"Kayalıklara sığındıysan atlılar yetişemez elbet.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Uçurumdan yuvarlanan adamın kolu kırılır da üstü başı kayada paramparça olur! Senin urbanda tek bir yırtık yok!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_005_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Neyse, içeri girince bakarız yaranın haline.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Bayılan adamın heybesinde taze yağlanmış demir keskisi ne arar? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyle ya... Çalılar tuttu beni ağam. Can havli işte, acıdan bayılmışım, sabah ayazında kendime geldim.\"", "Seçenek kapat: \"Neyse, içeri girince bakarız yaranın haline.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Bayılan adamın heybesinde taze yağlanmış demir keskisi ne arar? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_005_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme yolcu, vazifemi yapıyorum.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Sesindeki o hırıltı çoban sesi değil! Karaboran'da kimin adamısın sen? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri kısılır, sağlam koluyla heybesini sıkar) Şüpheyi bırak ağa! Yaralı adamla alay mı edersin? Aç şu kapıyı!\"", "Seçenek geri çekil: \"Öfkelenme yolcu, vazifemi yapıyorum.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Sesindeki o hırıltı çoban sesi değil! Karaboran'da kimin adamısın sen? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_005_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek içeride adamlarınız var... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Dişlerini sıkar, parmaklıklara sokulur) Tamam... Çetenin nöbetçisiyim ben. Reis beni köye yolladı. İçerideki adamlarımıza haber ulaştıracaktım.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek içeride adamlarınız var... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_005_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem Çatakkayalısın, oranın koyun damgası nasıldır, kırkım zamanı ne vakittir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Çatakkaya mezrasındanım ağam. Ağanın koyunlarını güderdim. Sancak sipahileri geldi, ocağımızı dağıttı, ben de dağlara düştüm.\"", "Test sorusu: \"Madem Çatakkayalısın, oranın koyun damgası nasıldır, kırkım zamanı ne vakittir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_005_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Köyü dağılan adamın derdi çok olur, bilirim. Sakin ol, doğrusunu de.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Çatakkaya eşkıya yatağıdır! Çeteden olduğunu itiraf ettin, asıl adın ne senin? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_005_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Yutkunur, başını eğer) Kırkım... güz başında yapılır... Biz koyuna damga vurmazdık, kulağını enlerdik ağam.\"", "Seçenek empati: \"Köyü dağılan adamın derdi çok olur, bilirim. Sakin ol, doğrusunu de.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Çatakkaya eşkıya yatağıdır! Çeteden olduğunu itiraf ettin, asıl adın ne senin? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_005_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kimliğini bilmek iyi oldu Kerim. Şimdi o sargına bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Omuzları çöker) Adım Kerim'dir. Çolak Kerim derler dağda. İlyas Reis beni büyüttü, borcumu ödemek için geldim. Ama canımdan bıktım gayrı.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Kimliğini bilmek iyi oldu Kerim. Şimdi o sargına bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_005_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Sağlam eliyle sargıyı kavrar, gözleri parlar) Evet, Çolak Kerim'im ben! İlyas Reis'in fedaisiyim! Kapıyı açmazsanız bu gece kandaşlarım kanınızı içer!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_005_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Kerim. Niyetini söyle!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR005_SargiliKama], [Clue_CHR005_DemirKeski] veya [Clue_Görsel_CHR005_KargaDamgasi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Sargındaki kama kabzası [Clue_CHR005_SargiliKama], heybendeki keski [Clue_CHR005_DemirKeski] ve bileğindeki karga dövmesi [Clue_Görsel_CHR005_KargaDamgasi]! Sen çoban değil, harami fedaisi Kerim'sin!\"", "NPC Replik: \"(Gözleri açılır, sağlam eliyle sargıyı tutar) Gözünden bir şey kaçmıyor muhafız...\"", "Seçenek: \"Yalan bitti Kerim. Niyetini söyle!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_005_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_005_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Bütün tertibin meydana çıktı. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Sargıyı çözer, kamayı toprağa saplar) Gece nöbetçileri şişleyip kapı kilidini kesecektim. Reis öyle emretti. Ama kolum gerçekten ağrır, yoruldum bu hayattan. Canımı bağışla, köyün çobanı olayım.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Bütün tertibin meydana çıktı. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_005_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_005_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Kamayı çeker, parmaklıklara savurur) Geberin o zaman! Bu kapı açılmasa da dağ inecek üzerinize!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_005_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız kamayı süzer, fedainin yüzüne bakar. Karar menüsü açılır.", ""]}}

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_020", "offset": 3, "kaynak": "on accept: [CHR_020] - Seyis Duran, Kerim'in ahırda çalışmasına kefil olan yaşlı seyis, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_021", "offset": 3, "kaynak": "on reject: [CHR_021] - Dilsiz Boğa, Kerim'in yerine köyü gözetlemeye yollanan dağ haydutu, +3 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_022", "offset": 2, "kaynak": "on bribe: [CHR_022] - Sarhoş Bican, Kerim'den alınan kamayı satın almak isteyen köy avcısı, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_023", "offset": 4, "kaynak": "on jail: [CHR_023] - Çavuş Hurşit, tutsak fedaiyi zincire vurup sorgulamak isteyen sancak neferi, +4 tur sonra teşrif eder."}}

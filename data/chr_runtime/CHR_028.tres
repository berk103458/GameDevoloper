[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_028"
ad = "Hulusi"
sinif = &"esnaf"
fraksiyon = &"Çocuklarına bağlı"
en_erken_tur = 6
spawn_kosulu = "Tur > 5 ve Moral < 6"
secere_matrisi = {"Doğum_Yeri": "Bezhan, Bez Sokağı", "Aile_Bağı": "İki küçük çocuğu evde, eşi yok", "Kırılma_Olayı": "Kesimci Bahri payı bölerken iki topun eksik çıkması ve Hulusi'nin gece yola düşmesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Bez Evi binasında sökük dikme ve yama tutturma", "Gece_Döngüsü": "Bez Evi'nde çocuk ölçüsü kadar bezi katlayıp sabaha hazırlama."}
persona_maskesi = "Tezgâhı kapanmış, dikişe gelmiş yorgun bir bez satıcısı."
gizlenen_gercek = "Loncanın ortak kesiminden sakladığı iki top bez ve yelek içindeki çivit."
gorsel_hata = "Yeleğin iç yüzünde, dışarıdan görünmeyen taze çivit lekesi."
sir_baglantisi = "Bu leke tezgâh teri değildir; saklanan topların yelek içine sürtünce bıraktığı izdir."
sfx = "Bez hışırtısı, iğne kutusunun tıkırtısı, yorgun nefes."
baslangic_tansiyonu = 1
obje_1 = {"aciklama": "Kuşağındaki kesim çubuğu. Tıklandığında ortak pay iki top eksik, kertik açık durur.", "uretilen_ipucu": &"Clue_CHR028_KesimCubugu"}
obje_2 = {"aciklama": "Yeleğin içine sarılı iki top ucu. Tıklandığında lonca ipi hâlâ uçlarda durur, bez çocuk boyundadır.", "uretilen_ipucu": &"Clue_CHR028_SakliTop"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR028_CivitYeni"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; yeleği ilikler, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; kesim çubuğunu avuçlar, yelek içini gizler.", "Panic": "Tansiyon 8-10; yeleği iki eliyle tutar, diz çöker, Bahri'nin adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR028_KESIMCUBUGU_BASLIK": "Kuşağındaki kesim çubuğu", "CLUE_CHR028_KESIMCUBUGU_TANIM": "Kuşağındaki kesim çubuğu. Tıklandığında ortak pay iki top eksik, kertik açık durur.", "CLUE_CHR028_SAKLITOP_BASLIK": "Yeleğin içine sarılı iki top ucu", "CLUE_CHR028_SAKLITOP_TANIM": "Yeleğin içine sarılı iki top ucu. Tıklandığında lonca ipi hâlâ uçlarda durur, bez çocuk boyundadır.", "CHR_028_DUGUM_00_REPLIK": "Sırtım tutuldu bekçi. Bez dikerim, yama tutarım. Çocukların söküğünü de kapatırım. Bir köşe verseniz iğneye dururum.", "CHR_028_DUGUM_00_SEC_1_METIN": "Bezci tezgâhta durur. Sen niye tek başına bu kapıdasın?", "CHR_028_DUGUM_00_SEC_2_METIN": "Dışın sade, göğsün şişkin. Hangi tezgâhtan koptun?", "CHR_028_DUGUM_00_SEC_3_METIN": "Kuşağındaki kesim çubuğu , yelekteki iki top ucu ve iç yüzde çivit lekesi ! Sen dikiş arayan değil, top saklayan bezcisin!", "CHR_028_DUGUM_1_1_REPLIK": "Bezhan'da iş bitti bekçi. Kesim dağıldı. Boş duracağıma burada dikerim dedim.", "CHR_028_DUGUM_1_1_SEC_1_METIN": "Doğrudur, kesim bitince bezci yer arar.", "CHR_028_DUGUM_1_1_SEC_2_METIN": "Kesim bittiyse yeleğinin içi niye şişkin?", "CHR_028_DUGUM_1_2_REPLIK": "Eski bir astar işte. Yoldan kaldı. Köye yük olmayayım diye sardım.", "CHR_028_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_028_DUGUM_1_2_SEC_2_METIN": "Yol astarında lonca ipi durmaz!", "CHR_028_DUGUM_1_2_BASK__REPLIK": "(Yeleği ilikler) Ne karıştırırsın bekçi? İçim terden boyandı. Top saklayan adam güpegündüz kapıya çıkar mı?", "CHR_028_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_028_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Yeleğinin içindeki çivit duruyor, doğruyu söyle!", "CHR_028_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Sakladım. İki top. Ortak kesimden. Çocuklarım çıplak. Bahri payı sayınca kaçtım.", "CHR_028_DUGUM_1_3_SEC_1_METIN": "Demek iki topu çocukların için sakladın... Şimdi geçmişini anlat.", "CHR_028_DUGUM_2_1_REPLIK": "Bezhan bez sokağındanım. Sökük dikerim, yama tutarım, çocuk ölçüsü keserim.", "CHR_028_DUGUM_2_1_SEC_1_METIN": "Madem bezcisin, top nasıl katlanır, çocuk gömleği nereden kısaltılır?", "CHR_028_DUGUM_2_2_REPLIK": "(Eli rahatlar) Top ters katlanır, çivit dışa vurmasın. Çocuk gömleği omuzdan bir karış, yen dirsekte biter. Çocuk aklıma düşünce makas titrer ama dikiş şaşmaz.", "CHR_028_DUGUM_2_2_SEC_1_METIN": "Çocuk çıplaksa insan dayanmaz. İş bilen adama kapımız açık.", "CHR_028_DUGUM_2_2_SEC_2_METIN": "Top sakladığını ağzınla söyledin. Kesimci arkandan gelir, adın ne?", "CHR_028_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Hulusi. Hırsız değilim. O iki top çocuklarımın üstüydü. Bez Evi'nde dikerim. Yeter ki Bahri'ye teslim etmeyin.", "CHR_028_DUGUM_2_3_SEC_1_METIN": "Hulusi olduğunu bildik. Şimdi o yeleğe bakalım.", "CHR_028_DUGUM_2_3_AGRESIF_REPLIK": "(Yeleği tutar) Evet, Hulusi'yim ben. İki topu çocuklarım için sakladım. İçimdeki çivit ondan. Bu el bir söküğü kapatır. Geri çevirirseniz çocuklar açıkta kalır.", "CHR_028_DUGUM_3_1_REPLIK": "(Yeleği aralar, topları gösterir) Görmüşsün bekçi. İnkar etmem.", "CHR_028_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Hulusi. Şimdi niyetini söyle.", "CHR_028_DUGUM_3_2_REPLIK": "", "CHR_028_DUGUM_3_3_REPLIK": "(Topları çocuk boyu katlar) İkisi bu kadar. Çocuklarıma gömlek olur, fazlası yok. Bez Evi'nde dikerim, payı doğru keserim. Beni içeri al. Bahri gelirse sakla beni.", "CHR_028_DUGUM_3_3_SEC_1_METIN": "İğnen de derdin de belli Hulusi. Şimdi hükmün verilecek.", "CHR_028_DUGUM_FINAL_RET_REPLIK": "(Yeleği kapatır, çiviti saklar) Siz de o kesimci gibisiniz. Beziniz yırtılsın.", "CHR_028_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_028_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız iki top ucuna ve yelek içindeki çivit lekesine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_028_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Bezci tezgâhta durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Dışın sade, göğsün şişkin. Hangi tezgâhtan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR028_KesimCubugu], [Clue_CHR028_SakliTop] veya [Clue_Görsel_CHR028_CivitYeni] ipuçlarına dikkatle bakılır: Kuşağındaki kesim çubuğu [Clue_CHR028_KesimCubugu], yelekteki iki top ucu [Clue_CHR028_SakliTop] ve iç yüzde çivit lekesi [Clue_Görsel_CHR028_CivitYeni]! Sen dikiş arayan değil, top saklayan bezcisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR028_KesimCubugu", "Clue_CHR028_SakliTop", "Clue_Görsel_CHR028_CivitYeni", "Clue_CHR028_KesimCubugu", "Clue_CHR028_SakliTop", "Clue_Görsel_CHR028_CivitYeni"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Sırtım tutuldu bekçi. Bez dikerim, yama tutarım. Çocukların söküğünü de kapatırım. Bir köşe verseniz iğneye dururum.\"", "Seçenek 1 (Dal 1 yol): \"Bezci tezgâhta durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Dışın sade, göğsün şişkin. Hangi tezgâhtan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR028_KesimCubugu], [Clue_CHR028_SakliTop] veya [Clue_Görsel_CHR028_CivitYeni] ipuçlarına dikkatle bakılır: Kuşağındaki kesim çubuğu [Clue_CHR028_KesimCubugu], yelekteki iki top ucu [Clue_CHR028_SakliTop] ve iç yüzde çivit lekesi [Clue_Görsel_CHR028_CivitYeni]! Sen dikiş arayan değil, top saklayan bezcisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_028_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, kesim bitince bezci yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Kesim bittiyse yeleğinin içi niye şişkin?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bezhan'da iş bitti bekçi. Kesim dağıldı. Boş duracağıma burada dikerim dedim.\"", "Seçenek inan: \"Doğrudur, kesim bitince bezci yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Kesim bittiyse yeleğinin içi niye şişkin?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_028_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yol astarında lonca ipi durmaz! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir astar işte. Yoldan kaldı. Köye yük olmayayım diye sardım.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yol astarında lonca ipi durmaz! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_028_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Yeleğinin içindeki çivit duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Yeleği ilikler) Ne karıştırırsın bekçi? İçim terden boyandı. Top saklayan adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Yeleğinin içindeki çivit duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_028_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek iki topu çocukların için sakladın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. Sakladım. İki top. Ortak kesimden. Çocuklarım çıplak. Bahri payı sayınca kaçtım.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek iki topu çocukların için sakladın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_028_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem bezcisin, top nasıl katlanır, çocuk gömleği nereden kısaltılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bezhan bez sokağındanım. Sökük dikerim, yama tutarım, çocuk ölçüsü keserim.\"", "Test sorusu: \"Madem bezcisin, top nasıl katlanır, çocuk gömleği nereden kısaltılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_028_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Çocuk çıplaksa insan dayanmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Top sakladığını ağzınla söyledin. Kesimci arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_028_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Top ters katlanır, çivit dışa vurmasın. Çocuk gömleği omuzdan bir karış, yen dirsekte biter. Çocuk aklıma düşünce makas titrer ama dikiş şaşmaz.\"", "Seçenek empati: \"Çocuk çıplaksa insan dayanmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Top sakladığını ağzınla söyledin. Kesimci arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_028_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Hulusi olduğunu bildik. Şimdi o yeleğe bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Hulusi. Hırsız değilim. O iki top çocuklarımın üstüydü. Bez Evi'nde dikerim. Yeter ki Bahri'ye teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Hulusi olduğunu bildik. Şimdi o yeleğe bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_028_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yeleği tutar) Evet, Hulusi'yim ben. İki topu çocuklarım için sakladım. İçimdeki çivit ondan. Bu el bir söküğü kapatır. Geri çevirirseniz çocuklar açıkta kalır.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_028_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Hulusi. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR028_KesimCubugu], [Clue_CHR028_SakliTop] veya [Clue_Görsel_CHR028_CivitYeni] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kuşağındaki kesim çubuğu [Clue_CHR028_KesimCubugu], yelekteki iki top ucu [Clue_CHR028_SakliTop] ve iç yüzde çivit lekesi [Clue_Görsel_CHR028_CivitYeni]! Sen ortak kesimden top saklayan Hulusi'sin!\"", "NPC Replik: \"(Yeleği aralar, topları gösterir) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Hulusi. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_028_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_028_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İğnen de derdin de belli Hulusi. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Topları çocuk boyu katlar) İkisi bu kadar. Çocuklarıma gömlek olur, fazlası yok. Bez Evi'nde dikerim, payı doğru keserim. Beni içeri al. Bahri gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"İğnen de derdin de belli Hulusi. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_028_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_028_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Yeleği kapatır, çiviti saklar) Siz de o kesimci gibisiniz. Beziniz yırtılsın.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_028_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız iki top ucuna ve yelek içindeki çivit lekesine bakar; karar menüsü açılır.", ""]}}

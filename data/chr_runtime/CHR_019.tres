[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_019"
ad = "İsmail"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 6
spawn_kosulu = "Tur > 5 ve Sağlık < 6"
secere_matrisi = {"Doğum_Yeri": "Akpınar, Kuyu Başı", "Aile_Bağı": "Karısı ve bir oğlu Akpınar'da kalmış", "Kırılma_Olayı": "Muhtarın kuyuda suyu yerinde bulup yalanı köy meydanında söylemesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Kuyu binasında dip temizleme ve Su Arkı boyunca çamur atma", "Gece_Döngüsü": "Kuyu sundurmasında ölçeğini saklayıp sabahın ilk suyunu bekleme."}
persona_maskesi = "Kuyusu kuruyan bir köyden inmiş, ark temizleyecek yorgun bir sucu."
gizlenen_gercek = "Kuraklık lafının yalan olduğu; kuyunun suyu yerindeyken nöbetini savması ve muhtarın bunu yazdığı pusula."
gorsel_hata = "Paçası dizine kadar taze ark çamuru, toz değil; yeninde hâlâ ıslak su çizgisi."
sir_baglantisi = "Kurak köyden gelen adamın paçası toz olur; bu çamur yaşayan bir arkta, su varken basılmış izdir."
sfx = "Islak ölçeğin tahtaya vuruşu, çamur şıpırtısı, kısık öksürük."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Cebindeki katlanmış muhtar pusulası. Tıklandığında 'kuyu dolu, kuraklık yok, İsmail nöbeti savdı' satırı okunur.", "uretilen_ipucu": &"Clue_CHR019_MuhtarNotu"}
obje_2 = {"aciklama": "Belindeki su ölçeği. Tıklandığında çubuğun dip çizgisi kurumuş değil, taze ıslak ve çamurludur.", "uretilen_ipucu": &"Clue_CHR019_IslakOlcek"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR019_CamurPaca"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; kazmayı yere kor, paçasındaki çamuru saklar, yavaş konuşur.", "Stressed": "Tansiyon 4-7; pusulayı cebine iter, ölçeğin ıslak ucunu avuçlar.", "Panic": "Tansiyon 8-10; ölçeği saklar, muhtar lafını duyunca kekeler."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR019_MUHTARNOTU_BASLIK": "Cebindeki katlanmış muhtar pusulası", "CLUE_CHR019_MUHTARNOTU_TANIM": "Cebindeki katlanmış muhtar pusulası. Tıklandığında 'kuyu dolu, kuraklık yok, İsmail nöbeti savdı' satırı okunur.", "CLUE_CHR019_ISLAKOLCEK_BASLIK": "Belindeki su ölçeği", "CLUE_CHR019_ISLAKOLCEK_TANIM": "Belindeki su ölçeği. Tıklandığında çubuğun dip çizgisi kurumuş değil, taze ıslak ve çamurludur.", "CHR_019_DUGUM_00_REPLIK": "Su kokusu aldım bu taraftan. Bizim oralarda kuyu çamur tuttu derler, ben de ark temizlemeye iş arıyorum. Kazmam kör ama elim durmaz.", "CHR_019_DUGUM_00_SEC_1_METIN": "Sucu köyünü bırakıp bu kapıya niye tek başına geldi?", "CHR_019_DUGUM_00_SEC_2_METIN": "Paçan ıslak, kurak köyden gelen böyle yürümez. Hangi kuyudan geldin?", "CHR_019_DUGUM_00_SEC_3_METIN": "Muhtarın pusulası , ıslak su ölçeği ve taze çamur paça ! Sen kuraklık yalanı söyleyen sucusun!", "CHR_019_DUGUM_1_1_REPLIK": "Akpınar'da kuyu kurudu. Ark da çatladı. Su kalmayınca iş de kalmadı. Burada kuyu temizlerim dedim.", "CHR_019_DUGUM_1_1_SEC_1_METIN": "Doğrudur, kuyu kuruyunca sucu yer arar.", "CHR_019_DUGUM_1_1_SEC_2_METIN": "Kuyu kuruduysa ölçeğinin dibi niye daha ıslak?", "CHR_019_DUGUM_1_2_REPLIK": "Yolda bir birikintiye bastım, o kadar. Ölçek eski, çizgisi kalmış.", "CHR_019_DUGUM_1_2_SEC_1_METIN": "Peki, kuyuya gir de bir bak.", "CHR_019_DUGUM_1_2_SEC_2_METIN": "Birikinti paçayı dizine kadar çıkarmaz. Yalanın ne?", "CHR_019_DUGUM_1_2_BASK__REPLIK": "(Ölçeği arkasına alır) Ne ölçersin hemşerim? Su arıyorum, yalan taşımıyorum.", "CHR_019_DUGUM_1_2_BASK__SEC_1_METIN": "Tamam, ölçeğine dokunmam.", "CHR_019_DUGUM_1_2_BASK__SEC_2_METIN": "Pusula da çamur da duruyor. Kuraklık lafını bırak!", "CHR_019_DUGUM_1_3_REPLIK": "(Cebindeki kâğıdı ezer) Tamam. Kuraklık yalan. Kuyu doluydu. Su nöbetimi savdım, komşunun bostanı susuz kaldı. Ben gök vermedi dedim. Muhtar ölçtü, su yerindeydi. Utancımdan çıktım.", "CHR_019_DUGUM_1_3_SEC_1_METIN": "Demek kuraklık yalanmış... Şimdi geçmişini anlat.", "CHR_019_DUGUM_2_1_REPLIK": "Akpınar'danım. Kuyu temizlerim, arkın çamurunu atarım. Su nöbetini de bilirim, savmasam iyiydi.", "CHR_019_DUGUM_2_1_SEC_1_METIN": "Madem sucusun, kuyu damarı nasıl anlaşılır, ark nasıl temizlenir?", "CHR_019_DUGUM_2_2_REPLIK": "(Ölçeğin ıslak ucunu gösterir, sonra saklar) Dipteki kumun kokusu değişirse damar yakındır. Arkı savak savak açarsın, çamuru yukarı atarsın, suyu kendi yatağında bırakırsın. Bunu bilirim. Nöbeti savmak başka.", "CHR_019_DUGUM_2_2_SEC_1_METIN": "Nöbet savmak ayıp ama eli işe yatkın adam lazım. Kapı açık.", "CHR_019_DUGUM_2_2_SEC_2_METIN": "Kuraklık yalanını söyledin. Muhtar peşinde, adın ne?", "CHR_019_DUGUM_2_3_REPLIK": "(Başını eğer) Adım İsmail. Yalancıyım, inkâr etmem. Kuyu binasında dibi temizlerim, Su Arkı'nın çamurunu atarım. Yeter ki muhtarın adamına hemen teslim etmeyin.", "CHR_019_DUGUM_2_3_SEC_1_METIN": "İsmail olduğunu bildik. Şimdi o ölçeğe bakalım.", "CHR_019_DUGUM_2_3_AGRESIF_REPLIK": "(Kazmayı sıkar) Evet, İsmail'im. Yalan söyledim, bostanı susuz bıraktım. Ama bu el kuyuyu temizler, arkın çamurunu atar. Geri çevirirseniz bir köy daha susuz kalır, ben de.", "CHR_019_DUGUM_3_1_REPLIK": "(Pusulayı yere düşürür) Okudun. Yalanım ortaya çıktı.", "CHR_019_DUGUM_3_1_SEC_1_METIN": "Yalan bitti İsmail. Şimdi niyetini söyle.", "CHR_019_DUGUM_3_2_REPLIK": "", "CHR_019_DUGUM_3_3_REPLIK": "(Ölçeği uzatır) Su varmış, ben yok dedim. Burada öyle yapmam. Kuyu'nun dibini temizlerim, Su Arkı'nın çamurunu atarım. İçme suyu durulur, bostan da su görür. Beni içeri alın. Muhtara hemen haber salmayın.", "CHR_019_DUGUM_3_3_SEC_1_METIN": "Yalanın da elin de belli İsmail. Şimdi hükmün verilecek.", "CHR_019_DUGUM_FINAL_RET_REPLIK": "(Kazmayı omzuna alır) Size de yalan söyledim, yeter. Başka kuyu ararım.", "CHR_019_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_019_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız ıslak ölçeğe ve paçadaki taze çamura bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_019_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Sucu köyünü bırakıp bu kapıya niye tek başına geldi?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Paçan ıslak, kurak köyden gelen böyle yürümez. Hangi kuyudan geldin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR019_MuhtarNotu], [Clue_CHR019_IslakOlcek] veya [Clue_Görsel_CHR019_CamurPaca] ipuçlarına dikkatle bakılır: Muhtarın pusulası [Clue_CHR019_MuhtarNotu], ıslak su ölçeği [Clue_CHR019_IslakOlcek] ve taze çamur paça [Clue_Görsel_CHR019_CamurPaca]! Sen kuraklık yalanı söyleyen sucusun!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR019_MuhtarNotu", "Clue_CHR019_IslakOlcek", "Clue_Görsel_CHR019_CamurPaca", "Clue_CHR019_MuhtarNotu", "Clue_CHR019_IslakOlcek", "Clue_Görsel_CHR019_CamurPaca"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Su kokusu aldım bu taraftan. Bizim oralarda kuyu çamur tuttu derler, ben de ark temizlemeye iş arıyorum. Kazmam kör ama elim durmaz.\"", "Seçenek 1 (Dal 1 yol): \"Sucu köyünü bırakıp bu kapıya niye tek başına geldi?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Paçan ıslak, kurak köyden gelen böyle yürümez. Hangi kuyudan geldin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR019_MuhtarNotu], [Clue_CHR019_IslakOlcek] veya [Clue_Görsel_CHR019_CamurPaca] ipuçlarına dikkatle bakılır: Muhtarın pusulası [Clue_CHR019_MuhtarNotu], ıslak su ölçeği [Clue_CHR019_IslakOlcek] ve taze çamur paça [Clue_Görsel_CHR019_CamurPaca]! Sen kuraklık yalanı söyleyen sucusun!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_019_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, kuyu kuruyunca sucu yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Kuyu kuruduysa ölçeğinin dibi niye daha ıslak?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Akpınar'da kuyu kurudu. Ark da çatladı. Su kalmayınca iş de kalmadı. Burada kuyu temizlerim dedim.\"", "Seçenek inan: \"Doğrudur, kuyu kuruyunca sucu yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Kuyu kuruduysa ölçeğinin dibi niye daha ıslak?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_019_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, kuyuya gir de bir bak.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Birikinti paçayı dizine kadar çıkarmaz. Yalanın ne? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Yolda bir birikintiye bastım, o kadar. Ölçek eski, çizgisi kalmış.\"", "Seçenek kapat: \"Peki, kuyuya gir de bir bak.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Birikinti paçayı dizine kadar çıkarmaz. Yalanın ne? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_019_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Tamam, ölçeğine dokunmam.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Pusula da çamur da duruyor. Kuraklık lafını bırak! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Ölçeği arkasına alır) Ne ölçersin hemşerim? Su arıyorum, yalan taşımıyorum.\"", "Seçenek geri çekil: \"Tamam, ölçeğine dokunmam.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Pusula da çamur da duruyor. Kuraklık lafını bırak! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_019_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek kuraklık yalanmış... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Cebindeki kâğıdı ezer) Tamam. Kuraklık yalan. Kuyu doluydu. Su nöbetimi savdım, komşunun bostanı susuz kaldı. Ben gök vermedi dedim. Muhtar ölçtü, su yerindeydi. Utancımdan çıktım.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek kuraklık yalanmış... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_019_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem sucusun, kuyu damarı nasıl anlaşılır, ark nasıl temizlenir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Akpınar'danım. Kuyu temizlerim, arkın çamurunu atarım. Su nöbetini de bilirim, savmasam iyiydi.\"", "Test sorusu: \"Madem sucusun, kuyu damarı nasıl anlaşılır, ark nasıl temizlenir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_019_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Nöbet savmak ayıp ama eli işe yatkın adam lazım. Kapı açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Kuraklık yalanını söyledin. Muhtar peşinde, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_019_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Ölçeğin ıslak ucunu gösterir, sonra saklar) Dipteki kumun kokusu değişirse damar yakındır. Arkı savak savak açarsın, çamuru yukarı atarsın, suyu kendi yatağında bırakırsın. Bunu bilirim. Nöbeti savmak başka.\"", "Seçenek empati: \"Nöbet savmak ayıp ama eli işe yatkın adam lazım. Kapı açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Kuraklık yalanını söyledin. Muhtar peşinde, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_019_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İsmail olduğunu bildik. Şimdi o ölçeğe bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Başını eğer) Adım İsmail. Yalancıyım, inkâr etmem. Kuyu binasında dibi temizlerim, Su Arkı'nın çamurunu atarım. Yeter ki muhtarın adamına hemen teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"İsmail olduğunu bildik. Şimdi o ölçeğe bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_019_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Kazmayı sıkar) Evet, İsmail'im. Yalan söyledim, bostanı susuz bıraktım. Ama bu el kuyuyu temizler, arkın çamurunu atar. Geri çevirirseniz bir köy daha susuz kalır, ben de.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_019_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti İsmail. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR019_MuhtarNotu], [Clue_CHR019_IslakOlcek] veya [Clue_Görsel_CHR019_CamurPaca] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Cebindeki muhtar pusulası [Clue_CHR019_MuhtarNotu], ölçeğin ıslak dip çizgisi [Clue_CHR019_IslakOlcek] ve dizine kadar taze çamur [Clue_Görsel_CHR019_CamurPaca]! Sen kuraklık yalanı söyleyen sucu İsmail'sin!\"", "NPC Replik: \"(Pusulayı yere düşürür) Okudun. Yalanım ortaya çıktı.\"", "Seçenek: \"Yalan bitti İsmail. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_019_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_019_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalanın da elin de belli İsmail. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Ölçeği uzatır) Su varmış, ben yok dedim. Burada öyle yapmam. Kuyu'nun dibini temizlerim, Su Arkı'nın çamurunu atarım. İçme suyu durulur, bostan da su görür. Beni içeri alın. Muhtara hemen haber salmayın.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Yalanın da elin de belli İsmail. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_019_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_019_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Kazmayı omzuna alır) Size de yalan söyledim, yeter. Başka kuyu ararım.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_019_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız ıslak ölçeğe ve paçadaki taze çamura bakar; karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Saglik": 3, "Erzak": 2}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise İsmail Kuyu binasında dip temizler ve Su Arkı'nın çamurunu atar; derhal Sağlık +3 ve Erzak +2 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te yalan ortaya çıkar, köylü Kuyu suyunu içmez; Sağlık -2 ve Güvenlik -1 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Yalancı sucu kovulur, muhtar kavgası kapıya gelmez. Debuff: 3 tur boyunca Kuyu binasında dip temizliği aksar; Güvenlik +1 artarken Sağlık -2 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "İş bilen sucu sebepsiz yere kovulur. Debuff: 4 tur boyunca Su Arkı'nda çamur atacak kimse bulunamaz; Erzak -2 ve Sağlık -2 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": ["1 bakır tas", "1 avuç çakıl"], "varyantlar": [], "kosullar": {}, "kaynak": "İsmail bakır su tasını ve bir avuç temiz çakılı muhafıza verir (Kişisel Kazanç: 1 bakır tas, 1 avuç çakıl). Tur 4'te Kuyu'da tas eksik, su bulanık kalır; Sağlık -1 ve Erzak -1 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 1, "Moral": -2}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "İsmail kışla zindanına atılır ve muhtara haber salınır. Güvenlik +1 kazanılırken sucunun hapsedilmesi Moral -2 kaybettirir."}}

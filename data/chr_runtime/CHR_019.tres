sonraki_spawns = {"on_accept": {"entity_id": &"CHR_076", "offset": 3, "kaynak": "on accept: [CHR_076] - Ark temizleyici Musa, İsmail'in çamur işine yardım etmek için gelen ırgat, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_077", "offset": 2, "kaynak": "on reject: [CHR_077] - Muhtar vekili Kasım, kuraklık yalanının hesabını sormaya gelen köy adamı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_078", "offset": 2, "kaynak": "on bribe: [CHR_078] - Sucu İbrahim, muhafızın elindeki bakır tası kuyuda kullanmak isteyen delikanlı, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_079", "offset": 3, "kaynak": "on jail: [CHR_079] - Köy bekçisi Yaşar, zindandaki İsmail'in çıkarılması için gelen Akpınar bekçisi, +3 tur sonra kapıyı çalar."}}

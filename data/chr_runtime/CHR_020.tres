[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_020"
ad = "Satılmış"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 7
spawn_kosulu = "Tur > 6 ve Erzak < 7"
secere_matrisi = {"Doğum_Yeri": "Sarıharman, Orta Harman", "Aile_Bağı": "Karısı ölü, kayınbabası köyde kalmış", "Kırılma_Olayı": "Bakır kalburun kumarbaz Nazım'a rehin kaldığının harman yerinde duyulması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Harman Yeri binasında döven sürme, sap savurma ve kalbur çekme", "Gece_Döngüsü": "Harman Yeri sundurmasında boş kalbur kasnağını altına alıp yüzünü saklayarak yatma."}
persona_maskesi = "Harmanı bitmiş bir köyden inmiş, savurmaya gelecek yorgun bir ırgat."
gizlenen_gercek = "Karısının bakır kalburunu kumarda rehin bırakması ve kurt kaptı diye söylediği utanç yalanı."
gorsel_hata = "Sağ elinin mafsalı yarık ve gömlek yakasında şarap lekesi, harman tozu değil."
sir_baglantisi = "Bu yara döven izi değildir; kalbur yüzüne vurulunca çıkan kavganın ve içki sofrasının izidir."
sfx = "Boş kasnağın tıkırtısı, saman hışırtısı, utangaç öksürük."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Kuşağındaki buruşuk rehin kâğıdı. Tıklandığında Nazım'ın kömür imzası, bakır kalbur yazısı ve ödenmemiş borç çizgisi görünür.", "uretilen_ipucu": &"Clue_CHR020_RehinKagidi"}
obje_2 = {"aciklama": "Koltuğunun altındaki kalbur kasnağı. Tıklandığında bakır telinin sökülmüş olduğu, yerine saman tıkandığı görünür.", "uretilen_ipucu": &"Clue_CHR020_BosKalbur"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR020_YaraliParmak"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; kasnağı yere kor, elindeki yarayı saklar, kısa konuşur.", "Stressed": "Tansiyon 4-7; rehin kâğıdını avuçlar, gözünü kaçırır.", "Panic": "Tansiyon 8-10; boş kalburu göğsüne çeker, Nazım'ın adını duyunca susar."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR020_REHINKAGIDI_BASLIK": "Kuşağındaki buruşuk rehin kâğıdı", "CLUE_CHR020_REHINKAGIDI_TANIM": "Kuşağındaki buruşuk rehin kâğıdı. Tıklandığında Nazım'ın kömür imzası, bakır kalbur yazısı ve ödenmemiş borç çizgisi görünür.", "CLUE_CHR020_BOSKALBUR_BASLIK": "Koltuğunun altındaki kalbur kasnağı", "CLUE_CHR020_BOSKALBUR_TANIM": "Koltuğunun altındaki kalbur kasnağı. Tıklandığında bakır telinin sökülmüş olduğu, yerine saman tıkandığı görünür.", "CHR_020_DUGUM_00_REPLIK": "Harman tozu burnumda kaldı. Savurmaya, döven sürmeye gelirim. Gece yürümekten belim tutuldu, bir tas su olsa iyi olur.", "CHR_020_DUGUM_00_SEC_1_METIN": "Harman bitmeden bu kapıya niye tek başına düştün?", "CHR_020_DUGUM_00_SEC_2_METIN": "Elin harman eli ama yüzün utançlı. Hangi harmandan geldin?", "CHR_020_DUGUM_00_SEC_3_METIN": "Kuşağındaki rehin kâğıdı , teli sökük kalbur ve mafsalındaki yara ! Sen ırgat değil, kalburunu kumara kaptıran adamsın!", "CHR_020_DUGUM_1_1_REPLIK": "Sarıharman'da iş bitti. Sap savruldu, paylar bölündü. Boş duracağıma burada döven sürerim dedim.", "CHR_020_DUGUM_1_1_SEC_1_METIN": "Doğrudur, harman bitince ırgat yer arar.", "CHR_020_DUGUM_1_1_SEC_2_METIN": "İş bittiyse koltuğundaki kalburun teli niye sökük?", "CHR_020_DUGUM_1_2_REPLIK": "Kalbur eski. Tel yolda koptu. Samanı elemek için yanıma aldım, o kadar.", "CHR_020_DUGUM_1_2_SEC_1_METIN": "Peki, harmana gir de bir sap savur.", "CHR_020_DUGUM_1_2_SEC_2_METIN": "Kopan tel samanla doldurulmaz. O kâğıt ne?", "CHR_020_DUGUM_1_2_BASK__REPLIK": "(Kasnağı sıkar) Ne bakarsın öyle. Harman adamıyım. Utanç taşıdığım yok.", "CHR_020_DUGUM_1_2_BASK__SEC_1_METIN": "Tamam, kâğıdına dokunmam.", "CHR_020_DUGUM_1_2_BASK__SEC_2_METIN": "Rehin kâğıdı da yara da duruyor. Kalburu ne yaptın?", "CHR_020_DUGUM_1_3_REPLIK": "(Kâğıdı açar, sesi düşer) Tamam. Harman günü kumarda kaybettim. Karımın bakır kalburunu Nazım'a rehin verdim. Köylüye kurt kaptı dedim. Duydular. Yüzüme bakmadılar, kalktım geldim.", "CHR_020_DUGUM_1_3_SEC_1_METIN": "Demek kalburu rehin verdin... Şimdi geçmişini anlat.", "CHR_020_DUGUM_2_1_REPLIK": "Sarıharman'danım. Döven sürerim, sap savururum, kalbur çekerim. Başka hünerim yok.", "CHR_020_DUGUM_2_1_SEC_1_METIN": "Madem harman ırgatısın, sap ne zaman savrulur, döven nasıl sürülür?", "CHR_020_DUGUM_2_2_REPLIK": "(Eli kasnakta gezer) İkindi yelinde savrulur, rüzgar arkandan esecek, saman uçar dane kalır. Döveni düz sür, sapı ez, taşı yarmadan. Bunu bilirim. Kalburu koruyamadım, o ayrı.", "CHR_020_DUGUM_2_2_SEC_1_METIN": "Utanç ağırdır. İş bilen adama bir kapı açılır.", "CHR_020_DUGUM_2_2_SEC_2_METIN": "Kalburu kumara verdiğini söyledin. Nazım peşinde, adın ne?", "CHR_020_DUGUM_2_3_REPLIK": "(Gözünü kaldırır) Adım Satılmış. Utandım, inkâr etmem. Harman Yeri'nde döven sürerim, sap savururum. Yeter ki Nazım'a hemen teslim etmeyin.", "CHR_020_DUGUM_2_3_SEC_1_METIN": "Satılmış olduğunu bildik. Şimdi o kasnağa bakalım.", "CHR_020_DUGUM_2_3_AGRESIF_REPLIK": "(Yaralı elini gösterir) Evet, Satılmış'ım. Kalburu kumara verdim, kurt yalanı söyledim. Bu el yine harman savurur. Geri çevirirseniz utancım da açlığım da dağda kalır.", "CHR_020_DUGUM_3_1_REPLIK": "(Kasnağı yere kor) Gördün. Utancımı da gördün.", "CHR_020_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Satılmış. Şimdi niyetini söyle.", "CHR_020_DUGUM_3_2_REPLIK": "", "CHR_020_DUGUM_3_3_REPLIK": "(Boş kasnağı çevirir) Tel gitti, el duruyor. Harman Yeri'nde döven sürerim, sapı savururum, kalburu da yeni tel gelince çekerim. Dane temiz çıkar. Beni içeri alın. Nazım'a hemen haber salmayın.", "CHR_020_DUGUM_3_3_SEC_1_METIN": "Utancın da elin de belli Satılmış. Şimdi hükmün verilecek.", "CHR_020_DUGUM_FINAL_RET_REPLIK": "(Kasnağı koltuğuna alır) Yüzüme bakan da siz oldunuz. Başka harman ararım.", "CHR_020_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_020_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız boş kalbur kasnağına ve mafsaldeki yaraya bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_020_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Harman bitmeden bu kapıya niye tek başına düştün?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin harman eli ama yüzün utançlı. Hangi harmandan geldin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR020_RehinKagidi], [Clue_CHR020_BosKalbur] veya [Clue_Görsel_CHR020_YaraliParmak] ipuçlarına dikkatle bakılır: Kuşağındaki rehin kâğıdı [Clue_CHR020_RehinKagidi], teli sökük kalbur [Clue_CHR020_BosKalbur] ve mafsalındaki yara [Clue_Görsel_CHR020_YaraliParmak]! Sen ırgat değil, kalburunu kumara kaptıran adamsın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR020_RehinKagidi", "Clue_CHR020_BosKalbur", "Clue_Görsel_CHR020_YaraliParmak", "Clue_CHR020_RehinKagidi", "Clue_CHR020_BosKalbur", "Clue_Görsel_CHR020_YaraliParmak"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Harman tozu burnumda kaldı. Savurmaya, döven sürmeye gelirim. Gece yürümekten belim tutuldu, bir tas su olsa iyi olur.\"", "Seçenek 1 (Dal 1 yol): \"Harman bitmeden bu kapıya niye tek başına düştün?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin harman eli ama yüzün utançlı. Hangi harmandan geldin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR020_RehinKagidi], [Clue_CHR020_BosKalbur] veya [Clue_Görsel_CHR020_YaraliParmak] ipuçlarına dikkatle bakılır: Kuşağındaki rehin kâğıdı [Clue_CHR020_RehinKagidi], teli sökük kalbur [Clue_CHR020_BosKalbur] ve mafsalındaki yara [Clue_Görsel_CHR020_YaraliParmak]! Sen ırgat değil, kalburunu kumara kaptıran adamsın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_020_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, harman bitince ırgat yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"İş bittiyse koltuğundaki kalburun teli niye sökük?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Sarıharman'da iş bitti. Sap savruldu, paylar bölündü. Boş duracağıma burada döven sürerim dedim.\"", "Seçenek inan: \"Doğrudur, harman bitince ırgat yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"İş bittiyse koltuğundaki kalburun teli niye sökük?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_020_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, harmana gir de bir sap savur.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Kopan tel samanla doldurulmaz. O kâğıt ne? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_020_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kalbur eski. Tel yolda koptu. Samanı elemek için yanıma aldım, o kadar.\"", "Seçenek kapat: \"Peki, harmana gir de bir sap savur.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Kopan tel samanla doldurulmaz. O kâğıt ne? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Dü
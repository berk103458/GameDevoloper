sonraki_spawns = {"on_accept": {"entity_id": &"CHR_080", "offset": 3, "kaynak": "on accept: [CHR_080] - Döven yamağı Hakkı, Satılmış'ın savurma işine yardım etmek için gelen ırgat, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_081", "offset": 2, "kaynak": "on reject: [CHR_081] - Kumarbaz Nazım, rehin kalburun hesabını sormaya gelen adam, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_082", "offset": 2, "kaynak": "on bribe: [CHR_082] - Elekçi Rıfat, muhafızın elindeki buğdayı elekten geçirmek isteyen esnaf, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_083", "offset": 3, "kaynak": "on jail: [CHR_083] - Kayınbaba Şükrü, zindandaki Satılmış'ın çıkarılması için gelen yaşlı, +3 tur sonra kapıyı çalar."}}

.1": {"replik_anahtari": &"CHR_017_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem çobansın, koyun kuzuya yakın mı nasıl anlaşılır, yün ne zaman kırkılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Karayayla'danım. Sağmal bilirim, kuzu bilirim. Ağılınızda yer varsa hakkıyla güderim.\"", "Test sorusu: \"Madem çobansın, koyun kuzuya yakın mı nasıl anlaşılır, yün ne zaman kırkılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_017_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Çoluk çocuğu kapıdan çevirmeyiz. İş bilen çobana yer var.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Kızını heybede sakladığını söyledin. Kaynın peşinde, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_017_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Koyunun memesine bakar) Meme şişer, kuyruk altı kızarırsa kuzu yakındır. Kırkım güzün olur, yünü dibinden yolmazsın, makas boyu alırsın. Bunu bilmeyen çoban sürüyü kırar.\"", "Seçenek empati: \"Çoluk çocuğu kapıdan çevirmeyiz. İş bilen çobana yer var.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Kızını heybede sakladığını söyledin. Kaynın peşinde, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_017_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Fadime olduğunu bildik. Şimdi o heybeye bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Heybeyi göğsüne bastırır) Adım Fadime. Hırsız değilim. Kızım Esma benim. Ağıl'da sağarım, yün ayıklarım. Yeter ki Recep'e teslim etmeyin bizi.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Fadime olduğunu bildik. Şimdi o heybeye bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_017_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Kızını sıkı sarar) Evet, Fadime'yim. Çocuğumu kaynıma mal diye vermedim. Bu iki sağmal bir ağılı doyurur. Geri çevirirseniz dağda ikimiz de kalırız.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_017_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Fadime. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR017_Kurdele], [Clue_CHR017_HeybeCocuk] veya [Clue_Görsel_CHR017_SutLekesi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Çıngıraktaki saç kurdelesi [Clue_CHR017_Kurdele], heybedeki küçük kız [Clue_CHR017_HeybeCocuk] ve göğsündeki süt lekesi [Clue_Görsel_CHR017_SutLekesi]! Sen çocuğunu saklayan çoban Fadime'sin!\"", "NPC Replik: \"(Heybenin kapağını aralar) Bildin. Saklayacak halim kalmadı.\"", "Seçenek: \"Yalan bitti Fadime. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_017_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_017_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kızın da koyunun da belli Fadime. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Uyuyan Esma'yı gösterir, yine örter) Kızım bu. İki sağmalım da var. Ağıl'da sağarım, yün kırkarım, sütü peynire koyarım. Bizi içeri alın. Recep gelirse kızı vermeyin.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Kızın da koyunun da belli Fadime. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_017_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Heybeyi sırtlar, geriler) Merhametiniz yok. Dağda kalırım da kızı kaynıma vermem.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_017_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız heybedeki çocuğa ve kadının süt lekeli eteğine bakar; karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Erzak": 2, "Moral": 2}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise Fadime Ağıl binasında koyun sağma ve yün ayıklama işine geçirilir; derhal Erzak +2 ve Moral +2 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te Recep Ağıl kapısına dayanıp kızı ister; Moral -2 ve Güvenlik -1 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Kadın ve çocuğu kovulur, miras kavgası kapıya gelmez. Debuff: 3 tur boyunca Ağıl binasında sağma işi aksar; Güvenlik +1 artarken Erzak -2 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "İş bilen çoban sebepsiz yere kovulur. Debuff: 4 tur boyunca Ağıl'da yün ayıklayacak kimse bulunamaz; Erzak -2 ve Moral -2 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": ["1 tulum peynir", "1 bakır çıngırak"], "varyantlar": [], "kosullar": {}, "kaynak": "Fadime küçük bir tulum peynir ve bakır çıngırağı muhafıza verir (Kişisel Kazanç: 1 tulum peynir, 1 bakır çıngırak). Tur 4'te Ağıl'da süt eksiği baş gösterir; Erzak -2 ve Moral -1 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 1, "Moral": -3}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Fadime kışla zindanına atılır, çocuk da yanında kapatılır. Güvenlik +1 kazanılırken çocuğun hapsedilmesi Moral -3 kaybettirir."}}

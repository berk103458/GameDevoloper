[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_017"
ad = "Fadime"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Moral < 6"
secere_matrisi = {"Doğum_Yeri": "Karayayla, Koyunlu Mezra", "Aile_Bağı": "Kocası ölü, küçük kızı Esma heybede", "Kırılma_Olayı": "Recep'in çocuğu ve sürüyü miras diye kapıya dayanması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Ağıl binasında koyun sağma, yemleme ve yün ayıklama", "Gece_Döngüsü": "Ağıl kapısında kızının üstüne keçe örtüp koyunların yanında nöbetleşme."}
persona_maskesi = "Yaylası dağılmış, iki sağmalla iş arayan dul bir çoban."
gizlenen_gercek = "Keçe heybede sakladığı kızı Esma ve kayınbiraderinin miras diye peşine düşmesi."
gorsel_hata = "Göğsündeki süt lekesi ve etek ucunda küçük bir çamur izi, koyun ayağından büyük."
sir_baglantisi = "Bu leke sağmalın sütü değil; heybedeki çocuğu doyururken bulaşan süt ve küçük ayak izidir."
sfx = "Boğuk çıngırak, koyun meliği, keçenin hışırtısı."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Koyunun boynundaki tıkanmış çıngırak. Tıklandığında dilinin arasına sıkıştırılmış küçük bir saç kurdelesi ve çocuk düğümü görünür.", "uretilen_ipucu": &"Clue_CHR017_Kurdele"}
obje_2 = {"aciklama": "Omzundaki keçe heybe. Tıklandığında yün kılıfın altında uyuyan küçük kız Esma çıkar.", "uretilen_ipucu": &"Clue_CHR017_HeybeCocuk"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR017_SutLekesi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; koyunun başını okşar, alçak sesle konuşur, heybeden gözünü ayırmaz.", "Stressed": "Tansiyon 4-7; heybenin ağzını kapatır, yola bakar, sesi kısıktır.", "Panic": "Tansiyon 8-10; heybesine kapanır, Recep'in adını duyunca titrer."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR017_KURDELE_BASLIK": "Koyunun boynundaki tıkanmış çıngırak", "CLUE_CHR017_KURDELE_TANIM": "Koyunun boynundaki tıkanmış çıngırak. Tıklandığında dilinin arasına sıkıştırılmış küçük bir saç kurdelesi ve çocuk düğümü görünür.", "CLUE_CHR017_HEYBECOCUK_BASLIK": "Omzundaki keçe heybe", "CLUE_CHR017_HEYBECOCUK_TANIM": "Omzundaki keçe heybe. Tıklandığında yün kılıfın altında uyuyan küçük kız Esma çıkar.", "CHR_017_DUGUM_00_REPLIK": "Koyunlar susadı. İki sağmalım var, ben de bitkinim. Ağılınız varsa sağarım, yün de kırkarım. Hayvan kapıda üşür.", "CHR_017_DUGUM_00_SEC_1_METIN": "Çoban köyünü bırakıp bu sınıra niye tek başına indi?", "CHR_017_DUGUM_00_SEC_2_METIN": "Koyunun hali iyi ama senin gözün yolda. Hangi ağıldan geldin?", "CHR_017_DUGUM_00_SEC_3_METIN": "Çıngıraktaki saç kurdelesi , heybedeki çocuk ve göğüsteki süt lekesi ! Sen yalnız çoban değilsin, çocuğunu saklıyorsun!", "CHR_017_DUGUM_1_1_REPLIK": "Yayla kurudu sandık, sürü dağıldı. Elimde bu iki baş kaldı. Sağmal varsa ekmek de vardır dedim, indim.", "CHR_017_DUGUM_1_1_SEC_1_METIN": "Doğrudur, çoban sürüsünü arar.", "CHR_017_DUGUM_1_1_SEC_2_METIN": "Sürü dağıldıysa heyben niye kuzu değil de insan gibi kımıldıyor?", "CHR_017_DUGUM_1_2_REPLIK": "Heybede yün var, biraz peynir. Kendi azığım. Kimseye yük olmam.", "CHR_017_DUGUM_1_2_SEC_1_METIN": "Peki, ağıla gir de koyununa bak.", "CHR_017_DUGUM_1_2_SEC_2_METIN": "Yün peynir gibi kımıldamaz. Heybede ne var?", "CHR_017_DUGUM_1_2_BASK__REPLIK": "(Heybeyi iki elle tutar) Dokunma heybe me. İçinde yün var. Çobanı yol ortasında soyacak mısın?", "CHR_017_DUGUM_1_2_BASK__SEC_1_METIN": "Tamam, ellemiyorum. Kapıda herkese bakarız.", "CHR_017_DUGUM_1_2_BASK__SEC_2_METIN": "Kurdele de süt lekesi de duruyor. Çocuğu söyle!", "CHR_017_DUGUM_1_3_REPLIK": "(Sesini kısar) Tamam. Heybede kızım var. Adı Esma. Kocam öldü. Kaynım Recep çocuğu da koyunu da miras dedi. Kızı vermedim, kaçtım.", "CHR_017_DUGUM_1_3_SEC_1_METIN": "Demek çocuğunu saklıyorsun... Şimdi geçmişini anlat.", "CHR_017_DUGUM_2_1_REPLIK": "Karayayla'danım. Sağmal bilirim, kuzu bilirim. Ağılınızda yer varsa hakkıyla güderim.", "CHR_017_DUGUM_2_1_SEC_1_METIN": "Madem çobansın, koyun kuzuya yakın mı nasıl anlaşılır, yün ne zaman kırkılır?", "CHR_017_DUGUM_2_2_REPLIK": "(Koyunun memesine bakar) Meme şişer, kuyruk altı kızarırsa kuzu yakındır. Kırkım güzün olur, yünü dibinden yolmazsın, makas boyu alırsın. Bunu bilmeyen çoban sürüyü kırar.", "CHR_017_DUGUM_2_2_SEC_1_METIN": "Çoluk çocuğu kapıdan çevirmeyiz. İş bilen çobana yer var.", "CHR_017_DUGUM_2_2_SEC_2_METIN": "Kızını heybede sakladığını söyledin. Kaynın peşinde, adın ne?", "CHR_017_DUGUM_2_3_REPLIK": "(Heybeyi göğsüne bastırır) Adım Fadime. Hırsız değilim. Kızım Esma benim. Ağıl'da sağarım, yün ayıklarım. Yeter ki Recep'e teslim etmeyin bizi.", "CHR_017_DUGUM_2_3_SEC_1_METIN": "Fadime olduğunu bildik. Şimdi o heybeye bakalım.", "CHR_017_DUGUM_2_3_AGRESIF_REPLIK": "(Kızını sıkı sarar) Evet, Fadime'yim. Çocuğumu kaynıma mal diye vermedim. Bu iki sağmal bir ağılı doyurur. Geri çevirirseniz dağda ikimiz de kalırız.", "CHR_017_DUGUM_3_1_REPLIK": "(Heybenin kapağını aralar) Bildin. Saklayacak halim kalmadı.", "CHR_017_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Fadime. Şimdi niyetini söyle.", "CHR_017_DUGUM_3_2_REPLIK": "", "CHR_017_DUGUM_3_3_REPLIK": "(Uyuyan Esma'yı gösterir, yine örter) Kızım bu. İki sağmalım da var. Ağıl'da sağarım, yün kırkarım, sütü peynire koyarım. Bizi içeri alın. Recep gelirse kızı vermeyin.", "CHR_017_DUGUM_3_3_SEC_1_METIN": "Kızın da koyunun da belli Fadime. Şimdi hükmün verilecek.", "CHR_017_DUGUM_FINAL_RET_REPLIK": "(Heybeyi sırtlar, geriler) Merhametiniz yok. Dağda kalırım da kızı kaynıma vermem.", "CHR_017_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_017_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız heybedeki çocuğa ve kadının süt lekeli eteğine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_017_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Çoban köyünü bırakıp bu sınıra niye tek başına indi?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Koyunun hali iyi ama senin gözün yolda. Hangi ağıldan geldin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR017_Kurdele], [Clue_CHR017_HeybeCocuk] veya [Clue_Görsel_CHR017_SutLekesi] ipuçlarına dikkatle bakılır: Çıngıraktaki saç kurdelesi [Clue_CHR017_Kurdele], heybedeki çocuk [Clue_CHR017_HeybeCocuk] ve göğüsteki süt lekesi [Clue_Görsel_CHR017_SutLekesi]! Sen yalnız çoban değilsin, çocuğunu saklıyorsun!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR017_Kurdele", "Clue_CHR017_HeybeCocuk", "Clue_Görsel_CHR017_SutLekesi", "Clue_CHR017_Kurdele", "Clue_CHR017_HeybeCocuk", "Clue_Görsel_CHR017_SutLekesi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_017_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Koyunlar susadı. İki sağmalım var, ben de bitkinim. Ağılınız varsa sağarım, yün de kırkarım. Hayvan kapıda üşür.\"", "Seçenek 1 (Dal 1 yol): \"Çoban köyünü bırakıp bu sınıra niye tek başına indi?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Koyunun hali iyi ama senin gözün yolda. Hangi ağıldan geldin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR017_Kurdele], [Clue_CHR017_HeybeCocuk] veya [Clue_Görsel_CHR017_SutLekesi] ipuçlarına dikkatle bakılır: Çıngıraktaki saç kurdelesi [Clue_CHR017_Kurdele], heybedeki çocuk [Clue_CHR017_HeybeCocuk] ve göğüsteki süt lekesi [Clue_Görsel_CHR017_SutLekesi]! Sen yalnız çoban 
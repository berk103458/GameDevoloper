sonraki_spawns = {"on_accept": {"entity_id": &"CHR_068", "offset": 3, "kaynak": "on accept: [CHR_068] - Sağmalcı Hatice, Fadime'nin sağımına yardım etmek için gelen köy kadını, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_069", "offset": 2, "kaynak": "on reject: [CHR_069] - Kayınbirader Recep, kızı ve koyunları miras diye arayan adam, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_070", "offset": 2, "kaynak": "on bribe: [CHR_070] - Peynirci Gülizar, muhafızın elindeki tulumu almak isteyen gezgin, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_071", "offset": 3, "kaynak": "on jail: [CHR_071] - Nine Pakize, zindandaki çocuğun çıkarılması için gelen yaşlı, +3 tur sonra kapıyı çalar."}}

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_100", "offset": 3, "kaynak": "on accept: [CHR_100] - Su yamağı Samet, Nevzat'ın çeşme taşımasına yardım etmek için gelen delikanlı, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_101", "offset": 2, "kaynak": "on reject: [CHR_101] - Ekmekçi Remzi, eksik somunu arayan kışla fırıncısı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_102", "offset": 2, "kaynak": "on bribe: [CHR_102] - Fırın yamağı Adem, muhafızın elindeki somun parçasını almak isteyen, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_103", "offset": 3, "kaynak": "on jail: [CHR_103] - Komşu kadın Hacer, zindandaki Nevzat'ın küçük kardeşi Zahide'ye ekmek götüren, +3 tur sonra kapıyı çalar."}}

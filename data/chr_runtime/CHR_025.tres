[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_025"
ad = "Nevzat"
sinif = &"asker"
fraksiyon = &"Kız kardeşine bağlı"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Erzak < 6"
secere_matrisi = {"Doğum_Yeri": "Akçavuş, Su Yokuşu", "Aile_Bağı": "Küçük kız kardeşi Zahide evde, anası yok", "Kırılma_Olayı": "Fırıncının payından bir somunu Zahide için ayırınca ekmekçi Remzi'nin sayımında eksiğin çıkması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Köy Çeşmesi binasında su taşıma ve fıçı doldurma", "Gece_Döngüsü": "Ortak Sofra binasında ekmek paylaştırma ve artanı sayma."}
persona_maskesi = "Su omuzu çökmüş, çeşmeye gelmiş yorgun bir kışla sucusu."
gizlenen_gercek = "Kız kardeşi Zahide için sakladığı fazla somun ve koltuk dikişindeki un."
gorsel_hata = "Sol koltuk dikişinde kurumuş un ve ekmek kırıntısı."
sir_baglantisi = "Bu un su sıçrantısı değildir; kız kardeşe saklanan somunun dikişte bıraktığı izdir."
sfx = "Su omuzunun gıcırtısı, ekmek hışırtısı, yorgun yutkunma."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Omzundaki su omuzu. Tıklandığında ağaçta Akçavuş kışlasının kertikleri durur, fıçı boşalmış.", "uretilen_ipucu": &"Clue_CHR025_SuOmuzu"}
obje_2 = {"aciklama": "Koltuk altında Zahide'nin dikişli yazması. Tıklandığında yazmanın içinde yarım somun ve un çıkar.", "uretilen_ipucu": &"Clue_CHR025_KardesSomunu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR025_UnDikisi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; su omuzunu yere kor, koltuğunu örter, boğuk konuşur.", "Stressed": "Tansiyon 4-7; yazmayı göğsüne bastırır, unlu dikişi gizler.", "Panic": "Tansiyon 8-10; koltuğunu kapatır, diz çöker, Remzi'nin adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR025_SUOMUZU_BASLIK": "Omzundaki su omuzu", "CLUE_CHR025_SUOMUZU_TANIM": "Omzundaki su omuzu. Tıklandığında ağaçta Akçavuş kışlasının kertikleri durur, fıçı boşalmış.", "CLUE_CHR025_KARDESSOMUNU_BASLIK": "Koltuk altında Zahide'nin dikişli yazması", "CLUE_CHR025_KARDESSOMUNU_TANIM": "Koltuk altında Zahide'nin dikişli yazması. Tıklandığında yazmanın içinde yarım somun ve un çıkar.", "CHR_025_DUGUM_00_REPLIK": "Boğazım kurudu bekçi. Su taşırım, ekmek paylarım. Çeşmede dururum, sofrada da. Bir köşe verseniz yükü indiririm.", "CHR_025_DUGUM_00_SEC_1_METIN": "Sucu kışlada durur. Sen niye tek başına bu kapıdasın?", "CHR_025_DUGUM_00_SEC_2_METIN": "Omzun ıslak ama koltuğun unlu. Hangi kışladan koptun?", "CHR_025_DUGUM_00_SEC_3_METIN": "Omzundaki su omuzu , yazmadaki yarım somun ve koltuk dikişindeki un ! Sen sucu değil, ekmek saklayan ersin!", "CHR_025_DUGUM_1_1_REPLIK": "Akçavuş'ta su bitti bekçi. Fıçı kurudu. Boş duracağıma burada taşırım dedim.", "CHR_025_DUGUM_1_1_SEC_1_METIN": "Doğrudur, fıçı kuruyunca sucu yer arar.", "CHR_025_DUGUM_1_1_SEC_2_METIN": "Su bittiyse koltuk dikişindeki un neyin nesi?", "CHR_025_DUGUM_1_2_REPLIK": "Eski bir kırıntı işte. Yoldan kaldı. Köye yük olmayayım diye silkelemedim.", "CHR_025_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_025_DUGUM_1_2_SEC_2_METIN": "Yol kırıntısı yazma dikişine somun diye girmez!", "CHR_025_DUGUM_1_2_BASK__REPLIK": "(Koltuk dikişini yener) Ne karıştırırsın bekçi? Un yoldan sıçradı. Ekmek saklayan adam güpegündüz kapıya çıkar mı?", "CHR_025_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_025_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Koltuk dikişindeki un duruyor, doğruyu söyle!", "CHR_025_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Sakladım. Küçük kardeşim Zahide aç. Fırından bir somun fazla aldım. Remzi sayınca kaçtım. Yazmaya sardım, geldim.", "CHR_025_DUGUM_1_3_SEC_1_METIN": "Demek ekmeği kız kardeşin için sakladın... Şimdi geçmişini anlat.", "CHR_025_DUGUM_2_1_REPLIK": "Akçavuş su yokuşundanım. Fıçı taşırım, pay bölerim. Su eksilmesin, ekmek de artmasın diye sayarım.", "CHR_025_DUGUM_2_1_SEC_1_METIN": "Madem sucusun, fıçı nasıl dengelenir, ekmek payı kaça bölünür?", "CHR_025_DUGUM_2_2_REPLIK": "(Eli rahatlar) Fıçı iki omza birden biner, tek omuz döker. Ekmek payı kişi başı bir dilim, çocuk yarım. Kardeşim aklıma düşünce sayım şaşar ama omuz şaşmaz.", "CHR_025_DUGUM_2_2_SEC_1_METIN": "Kardeşin açsa insan dayanmaz. İş bilen adama kapımız açık.", "CHR_025_DUGUM_2_2_SEC_2_METIN": "Ekmeği sakladığını ağzınla söyledin. Ekmekçi arkandan gelir, adın ne?", "CHR_025_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Nevzat. Hırsız değilim. O somun Zahide'nin payıydı, fazla kaçtı. Çeşmede su taşırım, Ortak Sofra'da ekmeği doğru bölerim. Yeter ki Remzi'ye teslim etmeyin.", "CHR_025_DUGUM_2_3_SEC_1_METIN": "Nevzat olduğunu bildik. Şimdi o yazmaya bakalım.", "CHR_025_DUGUM_2_3_AGRESIF_REPLIK": "(Yazmayı göğsüne bastırır) Evet, Nevzat'ım ben. Zahide için somun sakladım. Koltuk dikişindeki un ondan. Bu omuz bir çeşmeyi doldurur. Geri çevirirseniz kardeşim aç kalır.", "CHR_025_DUGUM_3_1_REPLIK": "(Yazmayı açar, somunu gösterir) Görmüşsün bekçi. İnkar etmem.", "CHR_025_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Nevzat. Şimdi niyetini söyle.", "CHR_025_DUGUM_3_2_REPLIK": "", "CHR_025_DUGUM_3_3_REPLIK": "(Somunu ikiye böler gibi gösterir, yine sarar) Zahide küçük. Buna muhtaç. Ben çeşmede su taşırım, sofrada payı doğru keserim. Bir daha fazla almam. Beni içeri al. Remzi gelirse sakla beni.", "CHR_025_DUGUM_3_3_SEC_1_METIN": "Omzun da derdin de belli Nevzat. Şimdi hükmün verilecek.", "CHR_025_DUGUM_FINAL_RET_REPLIK": "(Yazmayı koltuğuna sokar) Siz de o ekmekçi gibisiniz. Çeşmeniz kurusun.", "CHR_025_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_025_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız yarım somuna ve koltuk dikişindeki una bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_025_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Sucu kışlada durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Omzun ıslak ama koltuğun unlu. Hangi kışladan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR025_SuOmuzu], [Clue_CHR025_KardesSomunu] veya [Clue_Görsel_CHR025_UnDikisi] ipuçlarına dikkatle bakılır: Omzundaki su omuzu [Clue_CHR025_SuOmuzu], yazmadaki yarım somun [Clue_CHR025_KardesSomunu] ve koltuk dikişindeki un [Clue_Görsel_CHR025_UnDikisi]! Sen sucu değil, ekmek saklayan ersin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR025_SuOmuzu", "Clue_CHR025_KardesSomunu", "Clue_Görsel_CHR025_UnDikisi", "Clue_CHR025_SuOmuzu", "Clue_CHR025_KardesSomunu", "Clue_Görsel_CHR025_UnDikisi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Boğazım kurudu bekçi. Su taşırım, ekmek paylarım. Çeşmede dururum, sofrada da. Bir köşe verseniz yükü indiririm.\"", "Seçenek 1 (Dal 1 yol): \"Sucu kışlada durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Omzun ıslak ama koltuğun unlu. Hangi kışladan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR025_SuOmuzu], [Clue_CHR025_KardesSomunu] veya [Clue_Görsel_CHR025_UnDikisi] ipuçlarına dikkatle bakılır: Omzundaki su omuzu [Clue_CHR025_SuOmuzu], yazmadaki yarım somun [Clue_CHR025_KardesSomunu] ve koltuk dikişindeki un [Clue_Görsel_CHR025_UnDikisi]! Sen sucu değil, ekmek saklayan ersin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_025_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, fıçı kuruyunca sucu yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Su bittiyse koltuk dikişindeki un neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Akçavuş'ta su bitti bekçi. Fıçı kurudu. Boş duracağıma burada taşırım dedim.\"", "Seçenek inan: \"Doğrudur, fıçı kuruyunca sucu yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Su bittiyse koltuk dikişindeki un neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_025_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yol kırıntısı yazma dikişine somun diye girmez! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir kırıntı işte. Yoldan kaldı. Köye yük olmayayım diye silkelemedim.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yol kırıntısı yazma dikişine somun diye girmez! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_025_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Koltuk dikişindeki un duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Koltuk dikişini yener) Ne karıştırırsın bekçi? Un yoldan sıçradı. Ekmek saklayan adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Koltuk dikişindeki un duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_025_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek ekmeği kız kardeşin için sakladın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. Sakladım. Küçük kardeşim Zahide aç. Fırından bir somun fazla aldım. Remzi sayınca kaçtım. Yazmaya sardım, geldim.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek ekmeği kız kardeşin için sakladın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_025_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem sucusun, fıçı nasıl dengelenir, ekmek payı kaça bölünür?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Akçavuş su yokuşundanım. Fıçı taşırım, pay bölerim. Su eksilmesin, ekmek de artmasın diye sayarım.\"", "Test sorusu: \"Madem sucusun, fıçı nasıl dengelenir, ekmek payı kaça bölünür?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_025_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Kardeşin açsa insan dayanmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Ekmeği sakladığını ağzınla söyledin. Ekmekçi arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_025_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Fıçı iki omza birden biner, tek omuz döker. Ekmek payı kişi başı bir dilim, çocuk yarım. Kardeşim aklıma düşünce sayım şaşar ama omuz şaşmaz.\"", "Seçenek empati: \"Kardeşin açsa insan dayanmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Ekmeği sakladığını ağzınla söyledin. Ekmekçi arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_025_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Nevzat olduğunu bildik. Şimdi o yazmaya bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Nevzat. Hırsız değilim. O somun Zahide'nin payıydı, fazla kaçtı. Çeşmede su taşırım, Ortak Sofra'da ekmeği doğru bölerim. Yeter ki Remzi'ye teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Nevzat olduğunu bildik. Şimdi o yazmaya bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_025_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yazmayı göğsüne bastırır) Evet, Nevzat'ım ben. Zahide için somun sakladım. Koltuk dikişindeki un ondan. Bu omuz bir çeşmeyi doldurur. Geri çevirirseniz kardeşim aç kalır.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_025_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Nevzat. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR025_SuOmuzu], [Clue_CHR025_KardesSomunu] veya [Clue_Görsel_CHR025_UnDikisi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Omzundaki su omuzu [Clue_CHR025_SuOmuzu], yazmadaki yarım somun [Clue_CHR025_KardesSomunu] ve koltuk dikişindeki un [Clue_Görsel_CHR025_UnDikisi]! Sen kız kardeşine ekmek saklayan Nevzat'sın!\"", "NPC Replik: \"(Yazmayı açar, somunu gösterir) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Nevzat. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_025_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_025_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Omzun da derdin de belli Nevzat. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Somunu ikiye böler gibi gösterir, yine sarar) Zahide küçük. Buna muhtaç. Ben çeşmede su taşırım, sofrada payı doğru keserim. Bir daha fazla almam. Beni içeri al. Remzi gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Omzun da derdin de belli Nevzat. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_025_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_025_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Yazmayı koltuğuna sokar) Siz de o ekmekçi gibisiniz. Çeşmeniz kurusun.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_025_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız yarım somuna ve koltuk dikişindeki una bakar; karar menüsü açılır.", ""]}}

[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_008"
ad = "Otacı Dudu Hatun"
sinif = &"esnaf"
fraksiyon = &"Bağımsız Şifacılar"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Sağlık < 5"
secere_matrisi = {"Doğum_Yeri": "Dağardı Yaylası", "Aile_Bağı": "Üç oğlu sancak cenginde ölmüş, kimsesiz ihtiyar kadın", "Kırılma_Olayı": "Kulübesine sığınan yaralı haramileri tedavi ettiği için ocağının sipahilerce ateşe verilmesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Şifahane ve Bostan çevresinde dağ otlarını kaynatma, merhem ezme ve hasta köylülerin nabzını sayma işi", "Gece_Döngüsü": "Şifahane ocağında sabaha kadar afyonlu tentür kaynatma ve kurutulmuş akrep otlarını ayıklama."}
persona_maskesi = "Yaylasından sürülmüş, köy köy dolaşıp dua okuyan, sıtmalı çocuklara kurşun döken garip bir ihtiyar ebe."
gizlenen_gercek = "Çantasında sancak muhafızlarının aradığı kaçak haramilerin kurşun yaralarını dağlamak için kullandığı cerrah maşaları ve ağır afyon şurupları saklaması."
gorsel_hata = "Sağ avucunun içinde şifalı ot özünden değil, kızgın demirle yara dağlamaktan sıçrayan cerahat yanığı izi ve parmak uçlarında ocak isi."
sir_baglantisi = "Basit bir köy ebesi derin kılıç ve ok yarası dağlamaz; bu yanıklar haydutların cerrahlığını yaptığının fiziki kanıtıdır."
sfx = "Baston tıkırtısı, bakır havan sesi, kuru ve derinden öksürük."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Belinde asılı bakır havan ve tokmağı. Tıklandığında içinde sıradan nane değil, ağır afyon sakızı ve kurtboğan kökü ezildiği kokusundan anlaşılır.", "uretilen_ipucu": &"Clue_CHR008_AfyonluHavan"}
obje_2 = {"aciklama": "Sırtındaki bezle örtülü koca ot küfesi. Tıklandığında kurutulmuş adaçayı demetlerinin altında kan lekeleri yıkanmış sargı bezleri ve cerrah iğneleri bulunur.", "uretilen_ipucu": &"Clue_CHR008_KanliSargilar"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR008_CerahatYarigi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; bastonuna dayanır, 'oğlum' diyerek şefkatle konuşur, boyun büker.", "Stressed": "Tansiyon 4-7; bastonunu sıkar, gözlerini kaçırır, göğsü hızlı hızlı iner kalkar.", "Panic": "Tansiyon 8-10; bastonunu yere vurur, titreyerek ağlar, kaderine ve zalimlere beddua eder."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR008_AFYONLUHAVAN_BASLIK": "Belinde asılı bakır havan ve tokmağı", "CLUE_CHR008_AFYONLUHAVAN_TANIM": "Belinde asılı bakır havan ve tokmağı. Tıklandığında içinde sıradan nane değil, ağır afyon sakızı ve kurtboğan kökü ezildiği kokusundan anlaşılır.", "CLUE_CHR008_KANLISARGILAR_BASLIK": "Sırtındaki bezle örtülü koca ot küfesi", "CLUE_CHR008_KANLISARGILAR_TANIM": "Sırtındaki bezle örtülü koca ot küfesi. Tıklandığında kurutulmuş adaçayı demetlerinin altında kan lekeleri yıkanmış sargı bezleri ve cerrah iğneleri bulunur.", "CHR_008_DUGUM_00_REPLIK": "Selamunaleyküm yiğit nöbetçi. Dağardı yaylasından gelirim, adım Dudu Ebe derler. Ocağım yandı, yolda kaldım. Köyünüzün hastası, kırığı çıkığı varsa sararım; bir lokma ekmek, bir sıcak köşe yeter bana.", "CHR_008_DUGUM_00_SEC_1_METIN": "Dağardı yaylası askerle tutulmuşken bu yaşta o koca küfeyle nasıl aştın dağları nine?", "CHR_008_DUGUM_00_SEC_2_METIN": "Ebeyim dersin lakin avuçlarında ateş ve demir kokusu var. Hangi ocağın şifacısısın sen?", "CHR_008_DUGUM_00_SEC_3_METIN": "Havanındaki afyon kokusu , küfendeki kanlı bezler ve elindeki yara yanığı ! Sen ebe değil, dağdaki haramilerin hekimisin!", "CHR_008_DUGUM_1_1_REPLIK": "Kervan yolundan gelmedim oğul. Keçi izlerini takip ettim. Yaşlı kadına dağ kurdu bile dokunmaz, ot toplaya toplaya vardım buraya.", "CHR_008_DUGUM_1_1_SEC_1_METIN": "Doğrudur nine, şifacı kadına kurdun bile hürmeti vardır.", "CHR_008_DUGUM_1_1_SEC_2_METIN": "Keçi izinden bu koca küfeyle geçilmez! Dağdaki haramiler seni at sırtında mı geçirdi yoksa?", "CHR_008_DUGUM_1_2_REPLIK": "Öyle ya oğlum... Yolda bazen soluklandım, pınarlardan su içtim. Ayaklarım şişti ama çok şükür kapınıza erdim.", "CHR_008_DUGUM_1_2_SEC_1_METIN": "Neyse, içeri girince dinlenirsin.", "CHR_008_DUGUM_1_2_SEC_2_METIN": "Küfende otların altına gizlediğin bezler neden kızıla boyanmış?", "CHR_008_DUGUM_1_2_BASK__REPLIK": "(Bastonunu sıkar, gözleri buğulanır) Bana harami yamağı mı dersin oğul? Kocamış kadının günahına girme!", "CHR_008_DUGUM_1_2_BASK__SEC_1_METIN": "Kusuruma bakma nine, vazifemizi yapıyoruz.", "CHR_008_DUGUM_1_2_BASK__SEC_2_METIN": "Gizleme nine! Dağda kimin kanını yıkadın o bezlerden?", "CHR_008_DUGUM_1_3_REPLIK": "(İçini çeker, başını sallar) Tamam oğul... Dağdaki o yaralı uşakları getirdiler önüme. 'Yaralarını sarmazsan kulübeni yakarız' dediler. Hekim adam yaralı seçer mi? Can kurtardım diye beylik beni kaçak saydı.", "CHR_008_DUGUM_1_3_SEC_1_METIN": "Demek haramilerin yarasını sardın... Şimdi geçmişini anlat.", "CHR_008_DUGUM_2_1_REPLIK": "Dağardı yaylasında doğdum, orada kocalttım saçımı. Yüzlerce bebenin göbeğini kestim. Üç oğlumu askere verdim, üçü de şehit düştü.", "CHR_008_DUGUM_2_1_SEC_1_METIN": "Madem dağ ebesisin, humma basan çocuğa ne kaynatılır, kurşun yarası neyle yıkanır?", "CHR_008_DUGUM_2_2_REPLIK": "(Gözleri parlar) Hummanın ilacı söğüt kabuğu ve ak nilüferdir. Kurşun yarasını kaynar sirkeyle yıkar, dağlama demiriyle basarsın oğul...", "CHR_008_DUGUM_2_2_SEC_1_METIN": "Usta bir şifacısın nine, hünerin bellidir. Çekinme, derdini aç.", "CHR_008_DUGUM_2_2_SEC_2_METIN": "Kurşun yarası dağlamayı köy ebesi bilmez! Haramilerin ordusuna hekimlik ettin sen!", "CHR_008_DUGUM_2_3_REPLIK": "(Gözyaşını siler) Adım Dudu'dur. Ben cana düşman değilim oğul. Dağda inleyen kim varsa merhem sürdüm. Ama çete peşimi bırakmadı, sipahi ocağımı yıktı. Sığınacak bir dam ararım.", "CHR_008_DUGUM_2_3_SEC_1_METIN": "Hakikati bilmek iyi oldu Dudu Nine. Şimdi küfene bakalım.", "CHR_008_DUGUM_2_3_AGRESIF_REPLIK": "(Bastonunu yere vurur, sesi titrer) Evet! Dağda kanı akan canı kurtardım! Günah mı bu? Beyin kılıcı keser de hekimin merhemi suç mu olur? Beni de vurun o vakit, canımdan bıktım!", "CHR_008_DUGUM_3_1_REPLIK": "(İrkip küfesini yere indirir) Nereden anladın oğul...", "CHR_008_DUGUM_3_1_SEC_1_METIN": "Gözümüzden kaçmaz nine. Şimdi aslını söyle!", "CHR_008_DUGUM_3_2_REPLIK": "", "CHR_008_DUGUM_3_3_REPLIK": "(Kollarını açar, hırkasının içindeki aletleri gösterir) Evet, dağda vurulan haramileri dağladım. Ama onlar için değil, can için yaptım. Yanımda kurşun çıkaran kıskaçlarım, acıyı dindiren şuruplarım var. Köyünüzün Şifahane'sinde ölenleri diriltirim, hastalara derman olurum. Beni o zalim sipahilere teslim etmeyin.", "CHR_008_DUGUM_3_3_SEC_1_METIN": "Hünerin köyümüze gereklidir nine. Şimdi senin hükmün verilecek.", "CHR_008_DUGUM_FINAL_RET_REPLIK": "(Bastonunu savurur, gözleri kararır) Sizde de merhamet kalmamış! Alın o zaman başınıza çalın köyünüzü!", "CHR_008_DUGUM_FINAL_RET_SEC_1_METIN": "İhtiyarın kalbi kırıldı.", "CHR_008_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız yaşlı kadının hüneri ile sancak fermanı arasında kararını verir; kapı kolu elde bekler. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_008_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Dağardı yaylası askerle tutulmuşken bu yaşta o koca küfeyle nasıl aştın dağları nine?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Ebeyim dersin lakin avuçlarında ateş ve demir kokusu var. Hangi ocağın şifacısısın sen?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR008_AfyonluHavan], [Clue_CHR008_KanliSargilar] veya [Clue_Görsel_CHR008_CerahatYarigi] ipuçlarına dikkatle bakılır: Havanındaki afyon kokusu [Clue_CHR008_AfyonluHavan], küfendeki kanlı bezler [Clue_CHR008_KanliSargilar] ve elindeki yara yanığı [Clue_Görsel_CHR008_CerahatYarigi]! Sen ebe değil, dağdaki haramilerin hekimisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR008_AfyonluHavan", "Clue_CHR008_KanliSargilar", "Clue_Görsel_CHR008_CerahatYarigi", "Clue_CHR008_AfyonluHavan", "Clue_CHR008_KanliSargilar", "Clue_Görsel_CHR008_CerahatYarigi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Selamunaleyküm yiğit nöbetçi. Dağardı yaylasından gelirim, adım Dudu Ebe derler. Ocağım yandı, yolda kaldım. Köyünüzün hastası, kırığı çıkığı varsa sararım; bir lokma ekmek, bir sıcak köşe yeter bana.\"", "Seçenek 1 (Dal 1 yol): \"Dağardı yaylası askerle tutulmuşken bu yaşta o koca küfeyle nasıl aştın dağları nine?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Ebeyim dersin lakin avuçlarında ateş ve demir kokusu var. Hangi ocağın şifacısısın sen?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR008_AfyonluHavan], [Clue_CHR008_KanliSargilar] veya [Clue_Görsel_CHR008_CerahatYarigi] ipuçlarına dikkatle bakılır: Havanındaki afyon kokusu [Clue_CHR008_AfyonluHavan], küfendeki kanlı bezler [Clue_CHR008_KanliSargilar] ve elindeki yara yanığı [Clue_Görsel_CHR008_CerahatYarigi]! Sen ebe değil, dağdaki haramilerin hekimisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_008_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur nine, şifacı kadına kurdun bile hürmeti vardır.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Keçi izinden bu koca küfeyle geçilmez! Dağdaki haramiler seni at sırtında mı geçirdi yoksa?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kervan yolundan gelmedim oğul. Keçi izlerini takip ettim. Yaşlı kadına dağ kurdu bile dokunmaz, ot toplaya toplaya vardım buraya.\"", "Seçenek inan: \"Doğrudur nine, şifacı kadına kurdun bile hürmeti vardır.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Keçi izinden bu koca küfeyle geçilmez! Dağdaki haramiler seni at sırtında mı geçirdi yoksa?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_008_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Neyse, içeri girince dinlenirsin.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Küfende otların altına gizlediğin bezler neden kızıla boyanmış? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyle ya oğlum... Yolda bazen soluklandım, pınarlardan su içtim. Ayaklarım şişti ama çok şükür kapınıza erdim.\"", "Seçenek kapat: \"Neyse, içeri girince dinlenirsin.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Küfende otların altına gizlediğin bezler neden kızıla boyanmış? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_008_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Kusuruma bakma nine, vazifemizi yapıyoruz.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Gizleme nine! Dağda kimin kanını yıkadın o bezlerden? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Bastonunu sıkar, gözleri buğulanır) Bana harami yamağı mı dersin oğul? Kocamış kadının günahına girme!\"", "Seçenek geri çekil: \"Kusuruma bakma nine, vazifemizi yapıyoruz.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Gizleme nine! Dağda kimin kanını yıkadın o bezlerden? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_008_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek haramilerin yarasını sardın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(İçini çeker, başını sallar) Tamam oğul... Dağdaki o yaralı uşakları getirdiler önüme. 'Yaralarını sarmazsan kulübeni yakarız' dediler. Hekim adam yaralı seçer mi? Can kurtardım diye beylik beni kaçak saydı.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek haramilerin yarasını sardın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_008_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem dağ ebesisin, humma basan çocuğa ne kaynatılır, kurşun yarası neyle yıkanır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Dağardı yaylasında doğdum, orada kocalttım saçımı. Yüzlerce bebenin göbeğini kestim. Üç oğlumu askere verdim, üçü de şehit düştü.\"", "Test sorusu: \"Madem dağ ebesisin, humma basan çocuğa ne kaynatılır, kurşun yarası neyle yıkanır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_008_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Usta bir şifacısın nine, hünerin bellidir. Çekinme, derdini aç.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Kurşun yarası dağlamayı köy ebesi bilmez! Haramilerin ordusuna hekimlik ettin sen! (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_008_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri parlar) Hummanın ilacı söğüt kabuğu ve ak nilüferdir. Kurşun yarasını kaynar sirkeyle yıkar, dağlama demiriyle basarsın oğul...\"", "Seçenek empati: \"Usta bir şifacısın nine, hünerin bellidir. Çekinme, derdini aç.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Kurşun yarası dağlamayı köy ebesi bilmez! Haramilerin ordusuna hekimlik ettin sen! (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_008_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Hakikati bilmek iyi oldu Dudu Nine. Şimdi küfene bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Gözyaşını siler) Adım Dudu'dur. Ben cana düşman değilim oğul. Dağda inleyen kim varsa merhem sürdüm. Ama çete peşimi bırakmadı, sipahi ocağımı yıktı. Sığınacak bir dam ararım.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Hakikati bilmek iyi oldu Dudu Nine. Şimdi küfene bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_008_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Bastonunu yere vurur, sesi titrer) Evet! Dağda kanı akan canı kurtardım! Günah mı bu? Beyin kılıcı keser de hekimin merhemi suç mu olur? Beni de vurun o vakit, canımdan bıktım!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_008_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Gözümüzden kaçmaz nine. Şimdi aslını söyle!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR008_AfyonluHavan], [Clue_CHR008_KanliSargilar] veya [Clue_Görsel_CHR008_CerahatYarigi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Havanındaki afyon sakızı [Clue_CHR008_AfyonluHavan], küfendeki kanlı cerrah bezleri [Clue_CHR008_KanliSargilar] ve elindeki dağlama yanığı [Clue_Görsel_CHR008_CerahatYarigi]! Sen dağ haydutlarının yarasını saran kaçak hekimsin!\"", "NPC Replik: \"(İrkip küfesini yere indirir) Nereden anladın oğul...\"", "Seçenek: \"Gözümüzden kaçmaz nine. Şimdi aslını söyle!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_008_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_008_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Hünerin köyümüze gereklidir nine. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Kollarını açar, hırkasının içindeki aletleri gösterir) Evet, dağda vurulan haramileri dağladım. Ama onlar için değil, can için yaptım. Yanımda kurşun çıkaran kıskaçlarım, acıyı dindiren şuruplarım var. Köyünüzün Şifahane'sinde ölenleri diriltirim, hastalara derman olurum. Beni o zalim sipahilere teslim etmeyin.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Hünerin köyümüze gereklidir nine. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_008_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İhtiyarın kalbi kırıldı.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_008_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Bastonunu savurur, gözleri kararır) Sizde de merhamet kalmamış! Alın o zaman başınıza çalın köyünüzü!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İhtiyarın kalbi kırıldı.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_008_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız yaşlı kadının hüneri ile sancak fermanı arasında kararını verir; kapı kolu elde bekler. Karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Saglik": 4, "Moral": 2}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise Dudu Hatun Şifahane ve Bostan'da başotacı yapılır; salgınlar diner, hastalar ayağa kalkar; derhal Sağlık +4 ve Moral +2 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 5 gecesi dağdan yaralı haramiler şifahaneye sızar; Güvenlik -3 ve Moral -2 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Kaçak şifacı kovulur, sancakla kriz önlenir. Debuff: 3 tur boyunca Şifahane binasında yaralı nöbetçilerin pansumanı aksar; Güvenlik +1 artarken Sağlık -2 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Usta bir şifacı haksız yere kovulur. Debuff: 4 tur boyunca Şifahane'de salgın başlar; Sağlık -4 ve Moral -2 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": ["Afyon kalıbı", "gümüş yüksük"], "varyantlar": [], "kosullar": {}, "kaynak": "Muhafız kadının torbasındaki saf afyon kalıbını ve gümüş dikiş yüksüğünü alır (Kişisel Kazanç: Afyon kalıbı, gümüş yüksük). Tur 4'te Şifahane'de ilaç zehirlenmesi olur; Sağlık -3 ve Moral -1 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 1, "Moral": -4}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Dudu Hatun kışla zindanına atılır. Köy ahalisi yaşlı bir ebenin hapsedilmesine isyan eder; Güvenlik +1 kazanılırken, Moral -4 kaybedilir."}}
gecikmeli_etkiler = Array[Dictionary]([{"tur_offset": 4, "hedef_bina": "Şifahane", "olay_id": "Gece Şüphesi", "stat_etkisi": {"Guvenlik": -2}, "karar": "", "kosullar": {"Flag_Yol_Sirri_Acik": false}, "sure": 1, "kaynak": "Tur 4'te Şifahane binasında 'Gece Şüphesi' olayı çıkar; Dudu Hatun gizlice kaçak yaralıları tedavi ettiği duyulunca köyde Güvenlik -2 azalır."}, {"tur_offset": 6, "hedef_bina": "Köy Meydanı", "olay_id": "CHR_008_If [Flag_Kimlik_Cozuldu] is false", "stat_etkisi": {"Moral": -2}, "karar": "", "kosullar": {"Flag_Kimlik_Cozuldu": false}, "sure": 1, "kaynak": "Tur 6'da Köy Meydanı binasında 'Büyücü Cadı İftirası' yaşanır; kadının geçmişi bilinmediğinden köylüler şüpheye düşer, Moral -2 kaybedilir."}, {"tur_offset": 5, "hedef_bina": "Şifahane", "olay_id": "CHR_008_Kabul and secret hidden", "stat_etkisi": {"Guvenlik": -3, "Moral": -2}, "karar": "kabul", "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "sure": 1, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 5 gecesi dağdan yaralı haramiler şifahaneye sızar; Güvenlik -3 ve Moral -2 kaybedilir."}, {"tur_offset": 1, "hedef_bina": "Şifahane", "olay_id": "CHR_008_Zorunlu ret", "stat_etkisi": {"Guvenlik": 1, "Saglik": -2}, "karar": "zorunlu_ret", "kosullar": {}, "sure": 3, "kaynak": "Kaçak şifacı kovulur, sancakla kriz önlenir. Debuff: 3 tur boyunca Şifahane binasında yaralı nöbetçilerin pansumanı aksar; Güvenlik +1 artarken Sağlık -2 düşer."}, {"tur_offset": 1, "hedef_bina": "Şifahane", "olay_id": "CHR_008_Gönüllü ret", "stat_etkisi": {"Saglik": -4, "Moral": -2}, "karar": "gonullu_ret", "kosullar": {}, "sure": 4, "kaynak": "Usta bir şifacı haksız yere kovulur. Debuff: 4 tur boyunca Şifahane'de salgın başlar; Sağlık -4 ve Moral -2 kaybedilir."}, {"tur_offset": 4, "hedef_bina": "Şifahane", "olay_id": "CHR_008_Rüşvet", "stat_etkisi": {"Saglik": -3, "Moral": -1}, "karar": "rusvet", "kosullar": {}, "sure": 1, "kaynak": "Muhafız kadının torbasındaki saf afyon kalıbını ve gümüş dikiş yüksüğünü alır (Kişisel Kazanç: Afyon kalıbı, gümüş yüksük). Tur 4'te Şifahane'de ilaç zehirlenmesi olur; Sağlık -3 ve Moral -1 kaybedilir."}])

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_032", "offset": 3, "kaynak": "on accept: [CHR_032] - Çoban Halil, Dudu Hatun'un yayladan getirdiği şifalı otları toplamaya yardım eden dağ çobanı, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_033", "offset": 2, "kaynak": "on reject: [CHR_033] - Yaralı Harami Bekir, Dudu Hatun'u aramak için kapıya sürünen ağır yaralı eşkıya, +2 tur sonra belirir."}, "on_bribe": {"entity_id": &"CHR_034", "offset": 2, "kaynak": "on bribe: [CHR_034] - Meyhancı Civan, muhafızın elindeki afyonu satın almak isteyen hancı yamağı, +2 tur sonra kapıda biter."}, "on_jail": {"entity_id": &"CHR_035", "offset": 3, "kaynak": "on jail: [CHR_035] - Köy Ebesi Fatma, Dudu Hatun'un zindandan çıkarılması için yalvaran köy kadını, +3 tur sonra kapıyı çalar."}}

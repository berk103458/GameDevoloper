[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_021"
ad = "Cemil"
sinif = &"asker"
fraksiyon = &"Anasına bağlı"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Güvenlik < 7"
secere_matrisi = {"Doğum_Yeri": "Kumlukale, Aşağı Ocak", "Aile_Bağı": "Anası Hanife evde, kardeşi Müslim yolda öldü, eşi yok", "Kırılma_Olayı": "Müslim'in ölüm haberi üstüne celp çavuşunun bileğini yoklama ipiyle bağlı bırakması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Sur binasında taş dizme, harç sürme ve gedik kapatma", "Gece_Döngüsü": "Sur yürüyüşünde gençlere gece bekçiliği adımı ve sıra talimi."}
persona_maskesi = "Ocağı dağılmış, duvar örmeye gelmiş yorgun bir taş işçisi."
gizlenen_gercek = "Kuşağındaki ikiye kırık yoklama nişanı, bileğindeki ip izi ve anası için celpten kaçtığı."
gorsel_hata = "Sol bileğinde taze ip sıyrığı ve deriye gömülü kenevir lifi."
sir_baglantisi = "Bu iz taş çizığı değildir; yoklama ipini kesip celpten kaçtığının izidir."
sfx = "Kırık tahtanın kuşağa sürtmesi, yorgun nefes, çarık hışırtısı."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Kuşağındaki ikiye kırık tahta yoklama nişanı. Tıklandığında kırıkta Kumlukale ocağının kertik sayısı ve Cemil'in adı kömürle yazılmış görünür.", "uretilen_ipucu": &"Clue_CHR021_KirikNisan"}
obje_2 = {"aciklama": "Gömlek altında sarılı yol çıkını. Tıklandığında kardeşi Müslim'in tozlu yırtık yeni ve \"Müslim geçitte düştü, anan yalnız\" diye kömür not çıkar.", "uretilen_ipucu": &"Clue_CHR021_KardesYeni"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR021_BilekLifi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; nişanı kuşağa sokar, bileğini ovar, yorgun ve alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; kırık nişanı avuçlar, bileğini yeninin içine çeker.", "Panic": "Tansiyon 8-10; bileğindeki lifi saklar, diz çöker, çavuşun adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR021_KIRIKNISAN_BASLIK": "Kuşağındaki ikiye kırık tahta yoklama nişanı", "CLUE_CHR021_KIRIKNISAN_TANIM": "Kuşağındaki ikiye kırık tahta yoklama nişanı. Tıklandığında kırıkta Kumlukale ocağının kertik sayısı ve Cemil'in adı kömürle yazılmış görünür.", "CLUE_CHR021_KARDESYENI_BASLIK": "Gömlek altında sarılı yol çıkını", "CLUE_CHR021_KARDESYENI_TANIM": "Gömlek altında sarılı yol çıkını. Tıklandığında kardeşi Müslim'in tozlu yırtık yeni ve \"Müslim geçitte düştü, anan yalnız\" diye kömür not çıkar.", "CHR_021_DUGUM_00_REPLIK": "Yol uzun geldi bekçi. Dizlerim tutmuyor. Taş dizerim, gedik örerim. Bir köşe verseniz surun dibine dururum.", "CHR_021_DUGUM_00_SEC_1_METIN": "Ocak dururken sur dibine niye tek başına geldin?", "CHR_021_DUGUM_00_SEC_2_METIN": "Elin taş tutmuş ama halin kaçak gibi. Hangi ocaktan koptun?", "CHR_021_DUGUM_00_SEC_3_METIN": "Kuşağındaki kırık yoklama nişanı , çıkındaki kardeş yeni ve bileğindeki kenevir lifi ! Sen iş arayan değil, celp kaçkınısın!", "CHR_021_DUGUM_1_1_REPLIK": "Kumlukale'de iş bitti bekçi. Duvar çöktü, adam az kaldı. Boş duracağıma burada taş dizerim dedim.", "CHR_021_DUGUM_1_1_SEC_1_METIN": "Doğrudur, ocak dağılınca taşçı yer arar.", "CHR_021_DUGUM_1_1_SEC_2_METIN": "İş bittiyse kuşağındaki kırık tahta nişan neyin nesi?", "CHR_021_DUGUM_1_2_REPLIK": "Eski bir tahta işte. Yoldan aldım. Köye yük olmayayım diye yanıma koydum.", "CHR_021_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_021_DUGUM_1_2_SEC_2_METIN": "Yoldan aldığın tahtada senin adın yazılı!", "CHR_021_DUGUM_1_2_BASK__REPLIK": "(Bileğini yeninin içine çeker) Ne karıştırırsın bekçi? Bileğim taştan sıyrıldı. Kaçak adam güpegündüz kapıya çıkar mı?", "CHR_021_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_021_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Bileğindeki kenevir lifi duruyor, doğruyu söyle!", "CHR_021_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Kaçtım. Kardeşim Müslim yolda öldü. Anam Hanife evde tek. Çavuş Şahin bileğimi yoklama ipiyle bağladı. Gece ipi kestim, nişanı kırdım, geldim.", "CHR_021_DUGUM_1_3_SEC_1_METIN": "Demek celpten kaçtın... Şimdi geçmişini anlat.", "CHR_021_DUGUM_2_1_REPLIK": "Kumlukale ocağındanım. Duvar, sıra, gece adımı bilirim. Taş dizerim, gediği kapatırım.", "CHR_021_DUGUM_2_1_SEC_1_METIN": "Madem ocaktansın, gece sırası nasıl kurulur, gedik nasıl örülür?", "CHR_021_DUGUM_2_2_REPLIK": "(Eli rahatlar) Gece sırası iki adamdır, biri durur biri yürür. Gedik altta geniş, üstte dar örülür. Harç kurumadan üstüne basılmaz. Anam aklıma düşünce adım şaşar ama el şaşmaz.", "CHR_021_DUGUM_2_2_SEC_1_METIN": "Ananın yükü ağırdır. İş bilen adama kapımız açık.", "CHR_021_DUGUM_2_2_SEC_2_METIN": "Anan için kaçtığını ağzınla söyledin. Çavuş arkandan gelir, adın ne?", "CHR_021_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Cemil. Hırsız değilim. O kırık nişan benim kaçtığımın parçası. Sur'da taş dizerim, gece sırasını gençlere sayarım. Yeter ki Şahin Çavuş'a teslim etmeyin.", "CHR_021_DUGUM_2_3_SEC_1_METIN": "Cemil olduğunu bildik. Şimdi o nişana bakalım.", "CHR_021_DUGUM_2_3_AGRESIF_REPLIK": "(Bileğini saklar) Evet, Cemil'im ben. Kardeşim yolda öldü, anam yalnız. Bileğimdeki lif ondan. Bu el bir gediği kapatır. Geri çevirirseniz anam da ben de açıkta kalırız.", "CHR_021_DUGUM_3_1_REPLIK": "(Nişanı yere bırakır, bileğini açar) Görmüşsün bekçi. İnkar etmem.", "CHR_021_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Cemil. Şimdi niyetini söyle.", "CHR_021_DUGUM_3_2_REPLIK": "", "CHR_021_DUGUM_3_3_REPLIK": "(Çıkını açar, yırtık yeni gösterir) Kardeşim Müslim bu yende düştü yolda. Anam Hanife evde tek. Sur'da taş dizerim, gece bekçiliğini gençlere sayarım. Beni içeri al. Şahin Çavuş gelirse sakla beni.", "CHR_021_DUGUM_3_3_SEC_1_METIN": "Elin de derdin de belli Cemil. Şimdi hükmün verilecek.", "CHR_021_DUGUM_FINAL_RET_REPLIK": "(Nişanı kuşağa sokar, bileğini saklar) Siz de o çavuş gibisiniz. Surunuz çöksün.", "CHR_021_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_021_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız kırık nişana ve bilekteki kenevir lifine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_021_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Ocak dururken sur dibine niye tek başına geldin?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin taş tutmuş ama halin kaçak gibi. Hangi ocaktan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR021_KirikNisan], [Clue_CHR021_KardesYeni] veya [Clue_Görsel_CHR021_BilekLifi] ipuçlarına dikkatle bakılır: Kuşağındaki kırık yoklama nişanı [Clue_CHR021_KirikNisan], çıkındaki kardeş yeni [Clue_CHR021_KardesYeni] ve bileğindeki kenevir lifi [Clue_Görsel_CHR021_BilekLifi]! Sen iş arayan değil, celp kaçkınısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR021_KirikNisan", "Clue_CHR021_KardesYeni", "Clue_Görsel_CHR021_BilekLifi", "Clue_CHR021_KirikNisan", "Clue_CHR021_KardesYeni", "Clue_Görsel_CHR021_BilekLifi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Yol uzun geldi bekçi. Dizlerim tutmuyor. Taş dizerim, gedik örerim. Bir köşe verseniz surun dibine dururum.\"", "Seçenek 1 (Dal 1 yol): \"Ocak dururken sur dibine niye tek başına geldin?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin taş tutmuş ama halin kaçak gibi. Hangi ocaktan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR021_KirikNisan], [Clue_CHR021_KardesYeni] veya [Clue_Görsel_CHR021_BilekLifi] ipuçlarına dikkatle bakılır: Kuşağındaki kırık yoklama nişanı [Clue_CHR021_KirikNisan], çıkındaki kardeş yeni [Clue_CHR021_KardesYeni] ve bileğindeki kenevir lifi [Clue_Görsel_CHR021_BilekLifi]! Sen iş arayan değil, celp kaçkınısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_021_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, ocak dağılınca taşçı yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"İş bittiyse kuşağındaki kırık tahta nişan neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kumlukale'de iş bitti bekçi. Duvar çöktü, adam az kaldı. Boş duracağıma burada taş dizerim dedim.\"", "Seçenek inan: \"Doğrudur, ocak dağılınca taşçı yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"İş bittiyse kuşağındaki kırık tahta nişan neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_021_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yoldan aldığın tahtada senin adın yazılı! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir tahta işte. Yoldan aldım. Köye yük olmayayım diye yanıma koydum.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yoldan aldığın tahtada senin adın yazılı! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_021_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Bileğindeki kenevir lifi duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Bileğini yeninin içine çeker) Ne karıştırırsın bekçi? Bileğim taştan sıyrıldı. Kaçak adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Bileğindeki kenevir lifi duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_021_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek celpten kaçtın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. Kaçtım. Kardeşim Müslim yolda öldü. Anam Hanife evde tek. Çavuş Şahin bileğimi yoklama ipiyle bağladı. Gece ipi kestim, nişanı kırdım, geldim.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek celpten kaçtın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_021_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem ocaktansın, gece sırası nasıl kurulur, gedik nasıl örülür?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kumlukale ocağındanım. Duvar, sıra, gece adımı bilirim. Taş dizerim, gediği kapatırım.\"", "Test sorusu: \"Madem ocaktansın, gece sırası nasıl kurulur, gedik nasıl örülür?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_021_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Ananın yükü ağırdır. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Anan için kaçtığını ağzınla söyledin. Çavuş arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_021_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Gece sırası iki adamdır, biri durur biri yürür. Gedik altta geniş, üstte dar örülür. Harç kurumadan üstüne basılmaz. Anam aklıma düşünce adım şaşar ama el şaşmaz.\"", "Seçenek empati: \"Ananın yükü ağırdır. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Anan için kaçtığını ağzınla söyledin. Çavuş arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_021_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Cemil olduğunu bildik. Şimdi o nişana bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Cemil. Hırsız değilim. O kırık nişan benim kaçtığımın parçası. Sur'da taş dizerim, gece sırasını gençlere sayarım. Yeter ki Şahin Çavuş'a teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Cemil olduğunu bildik. Şimdi o nişana bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_021_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Bileğini saklar) Evet, Cemil'im ben. Kardeşim yolda öldü, anam yalnız. Bileğimdeki lif ondan. Bu el bir gediği kapatır. Geri çevirirseniz anam da ben de açıkta kalırız.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_021_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Cemil. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR021_KirikNisan], [Clue_CHR021_KardesYeni] veya [Clue_Görsel_CHR021_BilekLifi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kuşağındaki kırık yoklama nişanı [Clue_CHR021_KirikNisan], çıkındaki kardeş yeni [Clue_CHR021_KardesYeni] ve bileğindeki kenevir lifi [Clue_Görsel_CHR021_BilekLifi]! Sen celpten kaçan Cemil'sin!\"", "NPC Replik: \"(Nişanı yere bırakır, bileğini açar) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Cemil. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_021_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_021_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Elin de derdin de belli Cemil. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Çıkını açar, yırtık yeni gösterir) Kardeşim Müslim bu yende düştü yolda. Anam Hanife evde tek. Sur'da taş dizerim, gece bekçiliğini gençlere sayarım. Beni içeri al. Şahin Çavuş gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Elin de derdin de belli Cemil. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_021_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_021_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Nişanı kuşağa sokar, bileğini saklar) Siz de o çavuş gibisiniz. Surunuz çöksün.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_021_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız kırık nişana ve bilekteki kenevir lifine bakar; karar menüsü açılır.", ""]}}

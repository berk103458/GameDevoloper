sonraki_spawns = {"on_accept": {"entity_id": &"CHR_084", "offset": 3, "kaynak": "on accept: [CHR_084] - Duvar çırağı Tarık, Cemil'in sur onarımına ve gece sırasına yardım etmek için gelen genç, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_085", "offset": 2, "kaynak": "on reject: [CHR_085] - Celp çavuşu Şahin, kırık yoklama nişanını arayan levent toplayıcısı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_086", "offset": 2, "kaynak": "on bribe: [CHR_086] - Nişan bozucusu Vedat, muhafızın elindeki kırık tahta nişanı parçalamak isteyen işgüzar, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_087", "offset": 3, "kaynak": "on jail: [CHR_087] - Ana Hanife, zindandaki oğlu Cemil'in çıkarılması için gelen Kumlukale kadını, +3 tur sonra kapıyı çalar."}}

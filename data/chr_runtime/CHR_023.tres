[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_023"
ad = "Necip"
sinif = &"asker"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Güvenlik < 8"
secere_matrisi = {"Doğum_Yeri": "Bozgeçit, Keşif Yokuşu", "Aile_Bağı": "Bekâr, anası uzakta", "Kırılma_Olayı": "Geçen gece şarap yüzünden geçidi kaçırıp yolu boş diye yalan söylemesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Hendek binasında hendek dibi yürüme ve geleni sayma", "Gece_Döngüsü": "Hendek kıyısında kimsenin geçide yaklaştığını not etme."}
persona_maskesi = "Yolu yürüyüp bitmiş, hendek bakmaya gelmiş yorgun bir yol eri."
gizlenen_gercek = "Şarap içip Bozgeçit'i kaçırması ve yolu boş diye yalan söylemesi."
gorsel_hata = "Sakalında ve çenesinde taze üzüm sırası lekesi."
sir_baglantisi = "Bu leke yol tozu değildir; geçidi kaçırdığı gece içtiği şarabın sakalda kalan izidir."
sfx = "Boş şişenin tıkırtısı, boğuk öksürük, çarık hışırtısı."
baslangic_tansiyonu = 2
zar = "d12"
sorgu_degeri = 4
obje_1 = {"aciklama": "Kuşağındaki boş şarap şişesi. Tıklandığında dibinde üzüm sırası ve meyhane kertikleri durur, su kokmaz.", "uretilen_ipucu": &"Clue_CHR023_SarapSisesi"}
obje_2 = {"aciklama": "Cebindeki geçit çubuğu. Tıklandığında o geceye ait kertik yoktur; çubuk düz, geçide uğramamış.", "uretilen_ipucu": &"Clue_CHR023_GecitCubugu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR023_SiraLeke"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; şişeyi kuşağa sokar, sakalını ovar, boğuk konuşur.", "Stressed": "Tansiyon 4-7; geçit çubuğunu avuçlar, sakaldaki lekeyi gizler.", "Panic": "Tansiyon 8-10; sakalı yener, diz çöker, Bedri'nin adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR023_SARAPSISESI_BASLIK": "Kuşağındaki boş şarap şişesi", "CLUE_CHR023_SARAPSISESI_TANIM": "Kuşağındaki boş şarap şişesi. Tıklandığında dibinde üzüm sırası ve meyhane kertikleri durur, su kokmaz.", "CLUE_CHR023_GECITCUBUGU_BASLIK": "Cebindeki geçit çubuğu", "CLUE_CHR023_GECITCUBUGU_TANIM": "Cebindeki geçit çubuğu. Tıklandığında o geceye ait kertik yoktur; çubuk düz, geçide uğramamış.", "CHR_023_DUGUM_00_REPLIK": "Başım çatlıyor bekçi. Yol yürüdüm, hendek bilirim. Kimin geldiğini sayarım. Bir köşe verseniz hendekte dururum.", "CHR_023_DUGUM_00_SEC_1_METIN": "Keşif eri geçitte durur. Sen niye tek başına bu kapıdasın?", "CHR_023_DUGUM_00_SEC_2_METIN": "Ayağın temiz, halin bozuk. Hangi geçitten koptun?", "CHR_023_DUGUM_00_SEC_3_METIN": "Kuşağındaki boş şişe , cebindeki kertiksiz geçit çubuğu ve sakalındaki şarap lekesi ! Sen yol yürüyen değil, geçidi kaçırmış yalancısın!", "CHR_023_DUGUM_1_1_REPLIK": "Bozgeçit sakindi bekçi. Yol boştu. İş kalmadı, burada hendek yürüyeyim dedim.", "CHR_023_DUGUM_1_1_SEC_1_METIN": "Doğrudur, yol boşsa keşif eri yer arar.", "CHR_023_DUGUM_1_1_SEC_2_METIN": "Yol boşsa cebindeki çubuk niye kertiksiz?", "CHR_023_DUGUM_1_2_REPLIK": "Eski bir çubuk işte. Sayım bitti. Köye yük olmayayım diye cebime koydum.", "CHR_023_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_023_DUGUM_1_2_SEC_2_METIN": "Sayımı biten çubukta o gecenin kertiği olur!", "CHR_023_DUGUM_1_2_BASK__REPLIK": "(Sakalını yener) Ne karıştırırsın bekçi? Sakalım toz tuttu. Yalan söyleyen adam güpegündüz kapıya çıkar mı?", "CHR_023_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_023_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Sakalındaki şarap sırası duruyor, doğruyu söyle!", "CHR_023_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. İçtim. Geçidi kaçırdım. Çavuş Bedri'ye yol boş dedim. Çubuğa kertik atmadım. Utancımdan geldim.", "CHR_023_DUGUM_1_3_SEC_1_METIN": "Demek yolu boş diye yalan söyledin... Şimdi geçmişini anlat.", "CHR_023_DUGUM_2_1_REPLIK": "Bozgeçit keşif yokuşundanım. Hendek, iz, gelen giden bilirim. Kim geçti sayarım.", "CHR_023_DUGUM_2_1_SEC_1_METIN": "Madem keşif erisin, geçit izi nasıl okunur, hendek dibi ne zaman yürünür?", "CHR_023_DUGUM_2_2_REPLIK": "(Eli rahatlar) Geçit izi çakılda taze olur, eski iz toz tutar. Hendek dibi sabah çiyinde yürünür, gece ayak sesi uzar. Şarap düşünce göz şaşar ama kulak şaşmaz.", "CHR_023_DUGUM_2_2_SEC_1_METIN": "Bir gece şaşmak insanı bitirmez. İş bilen adama kapımız açık.", "CHR_023_DUGUM_2_2_SEC_2_METIN": "Yolu boş dediğini ağzınla söyledin. Bekçi arkandan gelir, adın ne?", "CHR_023_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Necip. Hırsız değilim. O çubuk geçide uğramadığımın parçası. Hendek'te yürürüm, geleni doğru sayarım. Yeter ki Timur'a teslim etmeyin.", "CHR_023_DUGUM_2_3_SEC_1_METIN": "Necip olduğunu bildik. Şimdi o çubuğa bakalım.", "CHR_023_DUGUM_2_3_AGRESIF_REPLIK": "(Sakalını saklar) Evet, Necip'im ben. İçtim, geçidi kaçırdım, yolu boş dedim. Sakalımdaki sıra ondan. Bu kulak bir hendeği sayar. Geri çevirirseniz dağda aç kalırım.", "CHR_023_DUGUM_3_1_REPLIK": "(Şişeyi yere bırakır, sakalını açar) Görmüşsün bekçi. İnkar etmem.", "CHR_023_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Necip. Şimdi niyetini söyle.", "CHR_023_DUGUM_3_2_REPLIK": "", "CHR_023_DUGUM_3_3_REPLIK": "(Çubuğu gösterir, kertiksizdir) Bu gece geçide çıkmadım. Bedri'ye yol boş dedim. Bir daha yalan saymam. Hendek'te yürürüm, geleni olduğu gibi söylerim. Beni içeri al. Timur gelirse sakla beni.", "CHR_023_DUGUM_3_3_SEC_1_METIN": "Kulağın da utancın da belli Necip. Şimdi hükmün verilecek.", "CHR_023_DUGUM_FINAL_RET_REPLIK": "(Şişeyi kuşağa sokar, sakalını saklar) Siz de o çavuş gibisiniz. Yolunuz karışsın.", "CHR_023_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_023_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız boş şişeye ve sakaldaki şarap lekesine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_023_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Keşif eri geçitte durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Ayağın temiz, halin bozuk. Hangi geçitten koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR023_SarapSisesi], [Clue_CHR023_GecitCubugu] veya [Clue_Görsel_CHR023_SiraLeke] ipuçlarına dikkatle bakılır: Kuşağındaki boş şişe [Clue_CHR023_SarapSisesi], cebindeki kertiksiz geçit çubuğu [Clue_CHR023_GecitCubugu] ve sakalındaki şarap lekesi [Clue_Görsel_CHR023_SiraLeke]! Sen yol yürüyen değil, geçidi kaçırmış yalancısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR023_SarapSisesi", "Clue_CHR023_GecitCubugu", "Clue_Görsel_CHR023_SiraLeke", "Clue_CHR023_SarapSisesi", "Clue_CHR023_GecitCubugu", "Clue_Görsel_CHR023_SiraLeke"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Başım çatlıyor bekçi. Yol yürüdüm, hendek bilirim. Kimin geldiğini sayarım. Bir köşe verseniz hendekte dururum.\"", "Seçenek 1 (Dal 1 yol): \"Keşif eri geçitte durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Ayağın temiz, halin bozuk. Hangi geçitten koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR023_SarapSisesi], [Clue_CHR023_GecitCubugu] veya [Clue_Görsel_CHR023_SiraLeke] ipuçlarına dikkatle bakılır: Kuşağındaki boş şişe [Clue_CHR023_SarapSisesi], cebindeki kertiksiz geçit çubuğu [Clue_CHR023_GecitCubugu] ve sakalındaki şarap lekesi [Clue_Görsel_CHR023_SiraLeke]! Sen yol yürüyen değil, geçidi kaçırmış yalancısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_023_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, yol boşsa keşif eri yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Yol boşsa cebindeki çubuk niye kertiksiz?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bozgeçit sakindi bekçi. Yol boştu. İş kalmadı, burada hendek yürüyeyim dedim.\"", "Seçenek inan: \"Doğrudur, yol boşsa keşif eri yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Yol boşsa cebindeki çubuk niye kertiksiz?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_023_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Sayımı biten çubukta o gecenin kertiği olur! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir çubuk işte. Sayım bitti. Köye yük olmayayım diye cebime koydum.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Sayımı biten çubukta o gecenin kertiği olur! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_023_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Sakalındaki şarap sırası duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Sakalını yener) Ne karıştırırsın bekçi? Sakalım toz tuttu. Yalan söyleyen adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Sakalındaki şarap sırası duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_023_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek yolu boş diye yalan söyledin... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. İçtim. Geçidi kaçırdım. Çavuş Bedri'ye yol boş dedim. Çubuğa kertik atmadım. Utancımdan geldim.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek yolu boş diye yalan söyledin... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_023_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem keşif erisin, geçit izi nasıl okunur, hendek dibi ne zaman yürünür?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bozgeçit keşif yokuşundanım. Hendek, iz, gelen giden bilirim. Kim geçti sayarım.\"", "Test sorusu: \"Madem keşif erisin, geçit izi nasıl okunur, hendek dibi ne zaman yürünür?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_023_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Bir gece şaşmak insanı bitirmez. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Yolu boş dediğini ağzınla söyledin. Bekçi arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_023_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Geçit izi çakılda taze olur, eski iz toz tutar. Hendek dibi sabah çiyinde yürünür, gece ayak sesi uzar. Şarap düşünce göz şaşar ama kulak şaşmaz.\"", "Seçenek empati: \"Bir gece şaşmak insanı bitirmez. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Yolu boş dediğini ağzınla söyledin. Bekçi arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_023_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Necip olduğunu bildik. Şimdi o çubuğa bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Necip. Hırsız değilim. O çubuk geçide uğramadığımın parçası. Hendek'te yürürüm, geleni doğru sayarım. Yeter ki Timur'a teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Necip olduğunu bildik. Şimdi o çubuğa bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_023_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Sakalını saklar) Evet, Necip'im ben. İçtim, geçidi kaçırdım, yolu boş dedim. Sakalımdaki sıra ondan. Bu kulak bir hendeği sayar. Geri çevirirseniz dağda aç kalırım.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_023_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Necip. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR023_SarapSisesi], [Clue_CHR023_GecitCubugu] veya [Clue_Görsel_CHR023_SiraLeke] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kuşağındaki boş şişe [Clue_CHR023_SarapSisesi], cebindeki kertiksiz geçit çubuğu [Clue_CHR023_GecitCubugu] ve sakalındaki şarap lekesi [Clue_Görsel_CHR023_SiraLeke]! Sen geçidi kaçırıp yolu boş diyen Necip'sin!\"", "NPC Replik: \"(Şişeyi yere bırakır, sakalını açar) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Necip. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_023_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_023_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kulağın da utancın da belli Necip. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Çubuğu gösterir, kertiksizdir) Bu gece geçide çıkmadım. Bedri'ye yol boş dedim. Bir daha yalan saymam. Hendek'te yürürüm, geleni olduğu gibi söylerim. Beni içeri al. Timur gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Kulağın da utancın da belli Necip. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_023_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_023_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Şişeyi kuşağa sokar, sakalını saklar) Siz de o çavuş gibisiniz. Yolunuz karışsın.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_023_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız boş şişeye ve sakaldaki şarap lekesine bakar; karar menüsü açılır.", ""]}}

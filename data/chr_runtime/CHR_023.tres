sonraki_spawns = {"on_accept": {"entity_id": &"CHR_092", "offset": 3, "kaynak": "on accept: [CHR_092] - Hendek yürüyücüsü Cahit, Necip'in hendek haberine ortak olmak için gelen köylü, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_093", "offset": 2, "kaynak": "on reject: [CHR_093] - Geçit bekçisi Timur, Bozgeçit'e uğramayan keşif erini arayan, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_094", "offset": 2, "kaynak": "on bribe: [CHR_094] - Meyhane yamağı Kamil, muhafızın elindeki boş şişeyi doldurmak isteyen, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_095", "offset": 3, "kaynak": "on jail: [CHR_095] - Eski yol arkadaşı Ziya, yalanı düzeltmek için gelen keşif ortağı, +3 tur sonra kapıyı çalar."}}

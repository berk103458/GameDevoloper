sonraki_spawns = {"on_accept": {"entity_id": &"CHR_044", "offset": 3, "kaynak": "on accept: [CHR_044] - Kalburcu Hasan, İdris'in harman savurma işine yardım etmek için gelen akrabası, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_045", "offset": 2, "kaynak": "on reject: [CHR_045] - Kırbaçlı Hamit, tefecinin kaçan buğdayı arayan acımasız tahsildarı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_046", "offset": 2, "kaynak": "on bribe: [CHR_046] - Değirmenci Yamağı Seyfo, muhafızın elindeki kunduru buğdayını öğütmek isteyen işgüzar, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_047", "offset": 3, "kaynak": "on jail: [CHR_047] - Tefeci Vekili Mahmut, İdris'in borcunu ve buğdayını teslim almaya gelen katip, +3 tur sonra kapıyı çalar."}}

[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_011"
ad = "Veli oğlu İdris"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Erzak < 6"
secere_matrisi = {"Doğum_Yeri": "Sazlıkova, Aşağı Harman Mezrası", "Aile_Bağı": "Yaşlı anası ve iki kardeşi mezrada rehin bırakılmış", "Kırılma_Olayı": "Tefecinin geçen kış borç faizini üç katına çıkarıp ekinine el koyması üzerine gece harmanı kaçırması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Değirmen ve Bostan çevresinde harman savurma, sap dövme ve kalbur çekme işi", "Gece_Döngüsü": "Değirmen sundurmasında yatıp çuvalındaki buğdayı farelerden korumak için nöbetleşe uyuma."}
persona_maskesi = "Kuraklık yüzünden mezrası dağılmış, boğaz tokluğuna tırpan sallayıp harman sürecek garip bir rençber."
gizlenen_gercek = "Sırtındaki çuvalda tefecinin ambarından aşırdığı tescilli tohumluk kunduru buğdayını saklaması ve arkasından tefecinin borç tahsildarlarının gelmesi."
gorsel_hata = "Göğsündeki yırtık yakadan görünen sopa darbesi morluğu ve kollarında gece kaçarken dikenli çit tellerinden kalma taze yırtıklar."
sir_baglantisi = "Bu morluklar orak veya harman yorgunluğundan olmaz; harman yerinden kaçarken tefecinin korumalarından yenen dayağın fiziki kanıtıdır."
sfx = "Ağır çuvalın toprağa düşüşü, tane buğday hışırtısı, yorgun iç çekiş."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Kuşağındaki çatlak tahta borç çetelesi. Tıklandığında çentiklerin üzerinde tefecinin kızgın demirle bastığı üç nal damgası ve ödenmemiş kile hesabı görünür.", "uretilen_ipucu": &"Clue_CHR011_TefeciCetelesi"}
obje_2 = {"aciklama": "Sırtındaki çift dikişli ağır çuval. Tıklandığında kaba arpa kılıfının altına gizlenmiş, ağanın ambarından aşırma mühürlü saf kunduru buğdayı tohumu çıkar.", "uretilen_ipucu": &"Clue_CHR011_AraklandikBugday"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR011_SopaMorlugu"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; çuvalını yere koyar, alnındaki teri koluyla siler, yorgun ve mütevazı konuşur.", "Stressed": "Tansiyon 4-7; çuvalın ağzını sıkar, gözlerini kırpıştırır, yola doğru tedirgin bakar.", "Panic": "Tansiyon 8-10; çuvala yapışıp diz çöker, tefecilerin adını duyunca titreyip yalvarmaya başlar."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR011_TEFECICETELESI_BASLIK": "Kuşağındaki çatlak tahta borç çetelesi", "CLUE_CHR011_TEFECICETELESI_TANIM": "Kuşağındaki çatlak tahta borç çetelesi. Tıklandığında çentiklerin üzerinde tefecinin kızgın demirle bastığı üç nal damgası ve ödenmemiş kile hesabı görünür.", "CLUE_CHR011_ARAKLANDIKBUGDAY_BASLIK": "Sırtındaki çift dikişli ağır çuval", "CLUE_CHR011_ARAKLANDIKBUGDAY_TANIM": "Sırtındaki çift dikişli ağır çuval. Tıklandığında kaba arpa kılıfının altına gizlenmiş, ağanın ambarından aşırma mühürlü saf kunduru buğdayı tohumu çıkar.", "CHR_011_DUGUM_00_REPLIK": "Selam sabah nöbetçi gardaş. Gün kararmadan kapıyı tutuver hele. Çeltikten, tozdan ciğerim kurudu; harman savurmaya, tırpan sallamaya amele ararsanız buradayım.", "CHR_011_DUGUM_00_SEC_1_METIN": "Harman zamanı köyünü bırakıp bu sınır kapısına niye tek başına vurdun rençber?", "CHR_011_DUGUM_00_SEC_2_METIN": "Alnın terli ama gözlerinde bir kaçak korkusu var. Hangi mezranın harmanından gelirsin?", "CHR_011_DUGUM_00_SEC_3_METIN": "Kuşağındaki tefeci çetelesi , çuvalındaki mühürlü kunduru buğdayı ve göğsündeki sopa izi ! Sen amele değil, tefeciden mal kaçıran borçlusun!", "CHR_011_DUGUM_1_1_REPLIK": "Bizim mezrada harman bitti gardaşım. Ekin az çıktı, aç kaldık. Boş oturmaktansa gurbete çıkayım, çalışan el darda kalmaz dedim.", "CHR_011_DUGUM_1_1_SEC_1_METIN": "Doğrudur, ekin bitince ırgat gurbete çıkar.", "CHR_011_DUGUM_1_1_SEC_2_METIN": "Ekin bittiyse sırtındaki o koca çuval niye has buğdayla dopdolu?", "CHR_011_DUGUM_1_2_REPLIK": "Öyle ya... Birkaç kile azığım var işte. Köye yük olmayayım, kendi ekmeğimi taştan çıkarayım niyetindeyim.", "CHR_011_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri gir de bir işin ucundan tut.", "CHR_011_DUGUM_1_2_SEC_2_METIN": "Azık dediğin bir çıkın olur, senin sırtındaki yük bey ambarı yükü!", "CHR_011_DUGUM_1_2_BASK__REPLIK": "(Yutkunur, çuvalın ipini sıkar) Ne sorgularsın gardaşım? Sırtımdaki helal terimdir, hırsızlık malı taşıyan adam böyle güpegündüz kapıya gelir mi?", "CHR_011_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_011_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın bacakları kısadır! Yolda kimden kaçtın, doğruyu söyle!", "CHR_011_DUGUM_1_3_REPLIK": "(Sesini kısar, başını öne eğer) Tamam gardaşım... Yalan yok, kaçtım. Aşağı Harman'ın tefecisi Faik Ağa ekini elimden alacaktı. Gece kendi ektiğim buğdayı yüklendim, korumaların sopasından zor kurtuldum.", "CHR_011_DUGUM_1_3_SEC_1_METIN": "Demek harman kaçırdın... Şimdi geçmişini anlat.", "CHR_011_DUGUM_2_1_REPLIK": "Aşağı Harman'da Veli oğullarındanım. Topraktan başka şey bilmeyiz. Tırpan salla dersen sabaha kadar biçerim, kalbur tut dersen tozunu alırım.", "CHR_011_DUGUM_2_1_SEC_1_METIN": "Madem harman ırgatısın, kunduru buğdayı ne zaman savrulur, kile hesabı kaça bölünür?", "CHR_011_DUGUM_2_2_REPLIK": "(Hafif ferahlar) İkindi rüzgarında savrulur gardaşım, saman uçar dâne kalır. Bir kile sekiz şiniktir, beye beşte bir hak düşer... Lakin tefeci gelince hak falan kalmaz.", "CHR_011_DUGUM_2_2_SEC_1_METIN": "Tefecinin insafı olmaz, bilirim. Alın teri döken adama kapımız açık.", "CHR_011_DUGUM_2_2_SEC_2_METIN": "Tefeciden tohum kaçırdığını ağzınla söyledin! Ağa arkandan adam salacak, adın ne senin?", "CHR_011_DUGUM_2_3_REPLIK": "(Gözleri parlar) Adım İdris'tir. Hırsız değilim ben. Alın terim o buğday. Köyünüze ekeyim, harmanında çalışayım. Yeter ki o zalim tefeciye beni teslim etmeyin.", "CHR_011_DUGUM_2_3_SEC_1_METIN": "İdris olduğunu bildik. Şimdi o çuvala bakalım.", "CHR_011_DUGUM_2_3_AGRESIF_REPLIK": "(Çuvalı sıkar, hırsla konuşur) Evet, İdris'im ben! Çoluk çocuğumun kışlık rızkını o harami ağaya bırakmadım diye suçlu mu oldum? Bu eller iki köyü doyuracak ekin biçer, geri çevirirseniz dağda kurda kuşa yem olurum!", "CHR_011_DUGUM_3_1_REPLIK": "(Dizleri titrer, çuvalı bırakır) Her şeyi görmüşsün gardaş... İnkar etmem.", "CHR_011_DUGUM_3_1_SEC_1_METIN": "Yalan bitti İdris. Şimdi niyetini dökül!", "CHR_011_DUGUM_3_2_REPLIK": "", "CHR_011_DUGUM_3_3_REPLIK": "(Çuvalın ağzını açar, altın sarısı iri buğday tanelerini gösterir) Bak şu tânelere gardaşım... Saf kunduru tohumu. Köyün tarlasına ekersek bire on beş verir. Değirmende öğütürsek unu bembeyaz çıkar. Beni içeri al, harmanın başına geçir. Tefecinin adamları gelirse de sakla beni.", "CHR_011_DUGUM_3_3_SEC_1_METIN": "Tohumun da hünerin de kıymetlidir İdris. Şimdi senin hükmün verilecek.", "CHR_011_DUGUM_FINAL_RET_REPLIK": "(Çuvalı sırtlar, yüzü kararır) Siz de o tefeci ağa gibisiniz! Alın toprağınız da buğdayınız da başınıza çalınsın!", "CHR_011_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_011_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız çuvaldaki has buğdaya ve adamın nasırlı ellerine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_011_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Harman zamanı köyünü bırakıp bu sınır kapısına niye tek başına vurdun rençber?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_011_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Alnın terli ama gözlerinde bir kaçak korkusu var. Hangi mezranın harmanından gelirsin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_011_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR011_TefeciCetelesi], [Clue_CHR011_AraklandikBugday] veya [Clue_Görsel_CHR011_SopaMorlugu] ipuçlarına dikkatle bakılır: Kuşağındaki tefeci çetelesi [Clue_CHR011_TefeciCetelesi], çuvalındaki mühürlü kunduru buğdayı [Clue_CHR011_AraklandikBugday] ve göğsündeki sopa izi [Clue_Görsel_CHR011_SopaMorlugu]! Sen amele değil, tefeciden mal kaçıran borçlusun!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR011_TefeciCetelesi", "Clue_CHR011_AraklandikBugday", "Clue_Görsel_CHR011_SopaMorlugu", "Clue_CHR011_TefeciCetelesi", "Clue_CHR011_AraklandikBugday", "Clue_Görsel_CHR011_SopaMorlugu"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_011_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Selam sabah nöbetçi gardaş. Gün kararmadan kapıyı tutuver hele. Çeltikten, tozdan ciğerim kurudu; harman savurmaya, tırpan sallamaya amele ararsanız buradayım.\"", "Seçenek 1 (Dal 1 yol): \"Harman zamanı köyünü bırakıp bu sınır kapısına niye tek başına vurdun rençber?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Alnın terli ama gözlerinde bir kaçak korkusu var. Hangi mezranın harmanından gelirsin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR011_TefeciCetelesi], [Clue_CHR011_Arak
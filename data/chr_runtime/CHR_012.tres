[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_012"
ad = "Hatice kızı Zeynep"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Moral < 7"
secere_matrisi = {"Doğum_Yeri": "Taşlıbel, Asmalıdere Köyü", "Aile_Bağı": "Üç yaşında öksüz oğlu Yusuf", "Kırılma_Olayı": "Sancak beyinin borç karşılığı kocasının cenazesini kaldırmayıp yetim oğlunu haraç niyetine istemesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Bağ ve Bostan'da asma budama, bağ bozumu, çapa yapma ve pekmez kaynatma işi", "Gece_Döngüsü": "Şifahane arkasındaki bağ evinde gizlice oğlunu besleme ve ona ninniler söyleme."}
persona_maskesi = "Boğaz tokluğuna bağ kazacak, asma budayacak, kuru bir saçak altında barınmaya razı kimsesiz bir dul bağcı kadın."
gizlenen_gercek = "Sırtındaki asma yaprağı dolu koca küfenin dibinde samanların arasına gizlediği üç yaşındaki yetim oğlu Yusuf'u kaçırması."
gorsel_hata = "Elbisesinin göğüs kısmındaki taze süt sızıntısı lekesi ve küfeyi taşırken omzunu korumak için sardığı kundak bezi parçası."
sir_baglantisi = "Yalnız bir bağ ırgatı kadın süt emzirmez; bu sızıntı küfenin içinde saklanan canlı bir bebeğin açık fiziki kanıtıdır."
sfx = "Asma yaprağı hışırtısı, küfe gıcırtısı, derinden gelen kısık bebek nefesi."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Göğsündeki yün iple asılı oyma tahta emzik. Tıklandığında tek başına gezen bir kadının üzerinde kundak bezi parçası ve süt ısıtma maşrapası bulunduğu fark edilir.", "uretilen_ipucu": &"Clue_CHR012_TahtaEmzik"}
obje_2 = {"aciklama": "Sırtındaki koca asma küfesi. Tıklandığında yaprakların ve kuru samanların altında nefes alan, uyutulmuş üç yaşında bir erkek çocuğu bulunur.", "uretilen_ipucu": &"Clue_CHR012_KufedekiCocuk"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR012_SutLekesi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; küfesini dikkatle sırtında tutar, başını hafifçe eğer, yumuşak ve saygılı konuşur.", "Stressed": "Tansiyon 4-7; küfenin kapağını eliyle örter, nefesi hızlanır, kapı muhafızına yalvaran gözlerle bakar.", "Panic": "Tansiyon 8-10; küfeyi arkasına alıp yere çöker, göğsünü siper eder, çocuğunu korumak için gözyaşlarıyla feryat eder."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR012_TAHTAEMZIK_BASLIK": "Göğsündeki yün iple asılı oyma tahta emzik", "CLUE_CHR012_TAHTAEMZIK_TANIM": "Göğsündeki yün iple asılı oyma tahta emzik. Tıklandığında tek başına gezen bir kadının üzerinde kundak bezi parçası ve süt ısıtma maşrapası bulunduğu fark edilir.", "CLUE_CHR012_KUFEDEKICOCUK_BASLIK": "Sırtındaki koca asma küfesi", "CLUE_CHR012_KUFEDEKICOCUK_TANIM": "Sırtındaki koca asma küfesi. Tıklandığında yaprakların ve kuru samanların altında nefes alan, uyutulmuş üç yaşında bir erkek çocuğu bulunur.", "CHR_012_DUGUM_00_REPLIK": "Hayırlı nöbetler ağam. Boğazı aştım da geldim. Asma budamayı, pekmez kaynatmayı iyi bilirim. Bağınızda bahçenizde boğaz tokluğuna ter dökeyim, bir sundurma altı verin yeter.", "CHR_012_DUGUM_00_SEC_1_METIN": "Dağ boğazını tek bir kadın başına o koca küfeyle nasıl aştın Hatice kızı?", "CHR_012_DUGUM_00_SEC_2_METIN": "Bağcıyım dersin ama gözlerinde kaçak telaşı var. Kimin ocağındandın sen?", "CHR_012_DUGUM_00_SEC_3_METIN": "Göğsündeki tahta emzik , küfendeki çocuk soluğu ve göğsündeki süt lekesi ! Sen yalnız değilsin kadın, indir o küfeyi!", "CHR_012_DUGUM_1_1_REPLIK": "Patikalardan yürüdüm ağam. Dağ köyleri tanıdıktır, kimse dul kadına ilişmez. Asma çubukları topladım yolda, köye bereket getiririm.", "CHR_012_DUGUM_1_1_SEC_1_METIN": "Doğrudur, bağcı kadına dağda kem gözle bakmazlar.", "CHR_012_DUGUM_1_1_SEC_2_METIN": "Asma çubuğu böyle canlı nefes almaz! Küfenin içinden ses geliyor!", "CHR_012_DUGUM_1_2_REPLIK": "Öyledir ağam... Elim işe yatkındır. Köyünüzün bağları kurumuşsa diriltirim.", "CHR_012_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri gir de bağlara bak.", "CHR_012_DUGUM_1_2_SEC_2_METIN": "Küfeni yere koymadan adım atamazsın, ne saklıyorsun orada?", "CHR_012_DUGUM_1_2_BASK__REPLIK": "(Küfeyi iki eliyle sarar, geri çekilir) Dokunmayın küfeme kurban olayım! İçinde yaprak var sadece, kuru yaprak!", "CHR_012_DUGUM_1_2_BASK__SEC_1_METIN": "Korkma bacım, hırpalamak istemem.", "CHR_012_DUGUM_1_2_BASK__SEC_2_METIN": "Kuru yaprak kıpırdamaz! Ne saklıyorsun orada, açık söyle!", "CHR_012_DUGUM_1_3_REPLIK": "(Gözyaşları boşanır, diz çöker) Tamam ağam... Küfede yavrum var. Üç yaşında öksüz Yusuf'um. Sancak ağası kocamın borcuna karşılık köle alacaktı. Kaçırdım yavrumu, kıymayın bize!", "CHR_012_DUGUM_1_3_SEC_1_METIN": "Demek evladını kurtarmak için kaçtın... Şimdi geçmişini anlat.", "CHR_012_DUGUM_2_1_REPLIK": "Asmalıdere köyündenim. Rahmetli kocamla on yıl bağ sürdük, nar yetiştirdik. Kuraklık vurdu, ocağımız dağıldı.", "CHR_012_DUGUM_2_1_SEC_1_METIN": "Madem bağcısın, asma ne zaman aşılanır, kış budaması hangi ayda yapılır?", "CHR_012_DUGUM_2_2_REPLIK": "(Sesi titrer ama kendinden emin) Gözler uyanmadan şubatta budanır ağam... Mart başında kalem aşısı vurulur. Çubuğun özsuyu ağlamadan işi bitirirsin.", "CHR_012_DUGUM_2_2_SEC_1_METIN": "Usta bir bağcısın kadın, hünerin belli. Korkma, sana kötülük gelmez.", "CHR_012_DUGUM_2_2_SEC_2_METIN": "Ağanın adamları kaçak reayayı aratır! Sancak peşine düşecek, adın ne senin?", "CHR_012_DUGUM_2_3_REPLIK": "(Yemenisini düzeltir) Adım Zeynep'tir. Ben hırsız değilim ağam. Elimle ektiğim üzümden başka şey tatmadım. Beni içeri alın, bağınızı cennet edeyim, yavrumu da bir köşede büyüteyim.", "CHR_012_DUGUM_2_3_SEC_1_METIN": "Zeynep bacı, hünerin de niyetin de temizdir. Şimdi o küfeye bakalım.", "CHR_012_DUGUM_2_3_AGRESIF_REPLIK": "(Çocuğuna sarılır, feryat eder) Evet, Zeynep'im ben! Çocuğumu ağaya köle vermedim diye canımı mı alacaksınız? Bu köyde hiç mi ana baba yok? Kapıyı açın, bağınızda gece gündüz çalışayım!", "CHR_012_DUGUM_3_1_REPLIK": "(Küfenin kapağını aralar, gözyaşları içinde başını eğer) Bildin ağam... Saklayacak halim kalmadı.", "CHR_012_DUGUM_3_1_SEC_1_METIN": "Korkma bacım, niyetini söyle.", "CHR_012_DUGUM_3_2_REPLIK": "", "CHR_012_DUGUM_3_3_REPLIK": "(Küfeden uyuyan Yusuf'u çıkarıp göğsüne basar) Yanımda üç bağ çubuğu çeliği var ağam. Razakı ve misket üzümü. Köyünüzün bağlarına aşılayayım, pekmez kaynatayım. Yeter ki yavrumla başımızı sokacak bir dam verin, bizi o zalim ağaya vermeyin.", "CHR_012_DUGUM_3_3_SEC_1_METIN": "Ana yüreğine kapımız kapanmaz Zeynep bacı. Şimdi senin hükmün verilecek.", "CHR_012_DUGUM_FINAL_RET_REPLIK": "(Çocuğunu kucağına alıp geriye kaçar) Merhametsizler! Dağda kurda kuşa yem olurum da size minnet etmem!", "CHR_012_DUGUM_FINAL_RET_SEC_1_METIN": "Kadın korkudan kaçtı, dinlemez.", "CHR_012_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız küfedeki masum yavruya ve ananın nasırlı ellerine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_012_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Dağ boğazını tek bir kadın başına o koca küfeyle nasıl aştın Hatice kızı?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Bağcıyım dersin ama gözlerinde kaçak telaşı var. Kimin ocağındandın sen?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR012_TahtaEmzik], [Clue_CHR012_KufedekiCocuk] veya [Clue_Görsel_CHR012_SutLekesi] ipuçlarına dikkatle bakılır: Göğsündeki tahta emzik [Clue_CHR012_TahtaEmzik], küfendeki çocuk soluğu [Clue_CHR012_KufedekiCocuk] ve göğsündeki süt lekesi [Clue_Görsel_CHR012_SutLekesi]! Sen yalnız değilsin kadın, indir o küfeyi!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR012_TahtaEmzik", "Clue_CHR012_KufedekiCocuk", "Clue_Görsel_CHR012_SutLekesi", "Clue_CHR012_TahtaEmzik", "Clue_CHR012_KufedekiCocuk", "Clue_Görsel_CHR012_SutLekesi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Hayırlı nöbetler ağam. Boğazı aştım da geldim. Asma budamayı, pekmez kaynatmayı iyi bilirim. Bağınızda bahçenizde boğaz tokluğuna ter dökeyim, bir sundurma altı verin yeter.\"", "Seçenek 1 (Dal 1 yol): \"Dağ boğazını tek bir kadın başına o koca küfeyle nasıl aştın Hatice kızı?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Bağcıyım dersin ama gözlerinde kaçak telaşı var. Kimin ocağındandın sen?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR012_TahtaEmzik], [Clue_CHR012_KufedekiCocuk] veya [Clue_Görsel_CHR012_SutLekesi] ipuçlarına dikkatle bakılır: Göğsündeki tahta emzik [Clue_CHR012_TahtaEmzik], küfendeki çocuk soluğu [Clue_CHR012_KufedekiCocuk] ve göğsündeki süt lekesi [Clue_Görsel_CHR012_SutLekesi]! Sen yalnız değilsin kadın, indir o küfeyi!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_012_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, bağcı kadına dağda kem gözle bakmazlar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Asma çubuğu böyle canlı nefes almaz! Küfenin içinden ses geliyor!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Patikalardan yürüdüm ağam. Dağ köyleri tanıdıktır, kimse dul kadına ilişmez. Asma çubukları topladım yolda, köye bereket getiririm.\"", "Seçenek inan: \"Doğrudur, bağcı kadına dağda kem gözle bakmazlar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Asma çubuğu böyle canlı nefes almaz! Küfenin içinden ses geliyor!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_012_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Pekala, içeri gir de bağlara bak.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Küfeni yere koymadan adım atamazsın, ne saklıyorsun orada? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyledir ağam... Elim işe yatkındır. Köyünüzün bağları kurumuşsa diriltirim.\"", "Seçenek kapat: \"Pekala, içeri gir de bağlara bak.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Küfeni yere koymadan adım atamazsın, ne saklıyorsun orada? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_012_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Korkma bacım, hırpalamak istemem.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Kuru yaprak kıpırdamaz! Ne saklıyorsun orada, açık söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Küfeyi iki eliyle sarar, geri çekilir) Dokunmayın küfeme kurban olayım! İçinde yaprak var sadece, kuru yaprak!\"", "Seçenek geri çekil: \"Korkma bacım, hırpalamak istemem.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Kuru yaprak kıpırdamaz! Ne saklıyorsun orada, açık söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_012_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek evladını kurtarmak için kaçtın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Gözyaşları boşanır, diz çöker) Tamam ağam... Küfede yavrum var. Üç yaşında öksüz Yusuf'um. Sancak ağası kocamın borcuna karşılık köle alacaktı. Kaçırdım yavrumu, kıymayın bize!\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek evladını kurtarmak için kaçtın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_012_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem bağcısın, asma ne zaman aşılanır, kış budaması hangi ayda yapılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Asmalıdere köyündenim. Rahmetli kocamla on yıl bağ sürdük, nar yetiştirdik. Kuraklık vurdu, ocağımız dağıldı.\"", "Test sorusu: \"Madem bağcısın, asma ne zaman aşılanır, kış budaması hangi ayda yapılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_012_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Usta bir bağcısın kadın, hünerin belli. Korkma, sana kötülük gelmez.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Ağanın adamları kaçak reayayı aratır! Sancak peşine düşecek, adın ne senin? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_012_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Sesi titrer ama kendinden emin) Gözler uyanmadan şubatta budanır ağam... Mart başında kalem aşısı vurulur. Çubuğun özsuyu ağlamadan işi bitirirsin.\"", "Seçenek empati: \"Usta bir bağcısın kadın, hünerin belli. Korkma, sana kötülük gelmez.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Ağanın adamları kaçak reayayı aratır! Sancak peşine düşecek, adın ne senin? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_012_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Zeynep bacı, hünerin de niyetin de temizdir. Şimdi o küfeye bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yemenisini düzeltir) Adım Zeynep'tir. Ben hırsız değilim ağam. Elimle ektiğim üzümden başka şey tatmadım. Beni içeri alın, bağınızı cennet edeyim, yavrumu da bir köşede büyüteyim.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Zeynep bacı, hünerin de niyetin de temizdir. Şimdi o küfeye bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_012_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Çocuğuna sarılır, feryat eder) Evet, Zeynep'im ben! Çocuğumu ağaya köle vermedim diye canımı mı alacaksınız? Bu köyde hiç mi ana baba yok? Kapıyı açın, bağınızda gece gündüz çalışayım!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_012_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Korkma bacım, niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR012_TahtaEmzik], [Clue_CHR012_KufedekiCocuk] veya [Clue_Görsel_CHR012_SutLekesi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Göğsündeki tahta emzik [Clue_CHR012_TahtaEmzik], küfendeki çocuk [Clue_CHR012_KufedekiCocuk] ve göğsündeki süt lekesi [Clue_Görsel_CHR012_SutLekesi]! Sen yetimini ağadan kaçıran bağcı Zeynep'sin!\"", "NPC Replik: \"(Küfenin kapağını aralar, gözyaşları içinde başını eğer) Bildin ağam... Saklayacak halim kalmadı.\"", "Seçenek: \"Korkma bacım, niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_012_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_012_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Ana yüreğine kapımız kapanmaz Zeynep bacı. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Küfeden uyuyan Yusuf'u çıkarıp göğsüne basar) Yanımda üç bağ çubuğu çeliği var ağam. Razakı ve misket üzümü. Köyünüzün bağlarına aşılayayım, pekmez kaynatayım. Yeter ki yavrumla başımızı sokacak bir dam verin, bizi o zalim ağaya vermeyin.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Ana yüreğine kapımız kapanmaz Zeynep bacı. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_012_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kadın korkudan kaçtı, dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_012_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Çocuğunu kucağına alıp geriye kaçar) Merhametsizler! Dağda kurda kuşa yem olurum da size minnet etmem!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Kadın korkudan kaçtı, dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_012_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız küfedeki masum yavruya ve ananın nasırlı ellerine bakar; karar menüsü açılır.", ""]}}

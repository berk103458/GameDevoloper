sonraki_spawns = {"on_accept": {"entity_id": &"CHR_048", "offset": 3, "kaynak": "on accept: [CHR_048] - Pekmezci Nuri, Zeynep'in getirdiği asma çubuklarını aşılamak isteyen köy bağcısı, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_049", "offset": 2, "kaynak": "on reject: [CHR_049] - Kethüda Rıza, kaçak kadının ve çocuğun izini süren sancak ağasının adamı, +2 tur sonra kapıya dayanır."}, "on_bribe": {"entity_id": &"CHR_050", "offset": 2, "kaynak": "on bribe: [CHR_050] - Bohçacı Elif, muhafızın elindeki gümüş kuşağı satın almak isteyen gezgin kadın, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_051", "offset": 3, "kaynak": "on jail: [CHR_051] - Köy İhtiyarı Bilal, zindandaki bebeğin çıkarılması için muhafıza yalvaran ak sakallı, +3 tur sonra kapıyı çalar."}}

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_072", "offset": 3, "kaynak": "on accept: [CHR_072] - Fide diken Kadir, Rahime'nin bostan işine ortak olmak için gelen ırgat, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_073", "offset": 2, "kaynak": "on reject: [CHR_073] - Enişte Hayri, ana tohumunu pazarda satmak için arayan adam, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_074", "offset": 2, "kaynak": "on bribe: [CHR_074] - Tohumcu yamağı Selim, muhafızın elindeki kabak tohumunu ekmek isteyen genç, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_075", "offset": 3, "kaynak": "on jail: [CHR_075] - Komşu kadın Fatma, zindandaki Rahime'nin çıkarılması için gelen bostan komşusu, +3 tur sonra kapıyı çalar."}}

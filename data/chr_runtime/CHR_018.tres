[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_018"
ad = "Rahime"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Erzak < 5"
secere_matrisi = {"Doğum_Yeri": "Derebostan, Aşağı Tarla", "Aile_Bağı": "Anası ölü, kız kardeşinin kocası Hayri tohumun peşinde", "Kırılma_Olayı": "Hayri'nin ana tohumunu çuvallayıp pazara götüreceğini söylemesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Bostan binasında çapa, fide dikme ve ot alma", "Gece_Döngüsü": "Bostan sundurmasında su kabağını dizinin arasında saklayıp tohumu nemden koruma."}
persona_maskesi = "Tarlası bölününce iş aramaya çıkmış, çapa vuracak yorgun bir bostancı."
gizlenen_gercek = "Su kabağının içinde anasından kalan bamya ve kabak tohumu; eniştesinin bu tohumu pazarda satmak istemesi."
gorsel_hata = "Yen dikişinde sıkışmış iki tane bamya tohumu ve tırnak altında taze toprak değil, kuru tohum kabuğu."
sir_baglantisi = "Bu tohum tarladan bulaşma değildir; kabağa doldururken dikişe kaçmış ana tohumdur."
sfx = "Çapanın toprağa değmesi, kuru kabak tıkırtısı, yorgun nefes."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Kuşağındaki düğümlü ip. Tıklandığında her düğümün bir tohum sayımına denk geldiği ve son düğümün taze atıldığı görünür.", "uretilen_ipucu": &"Clue_CHR018_TohumDugumu"}
obje_2 = {"aciklama": "Belindeki kuru su kabağı. Tıklandığında balmumu kapağın altında ana bamya ve kabak tohumu çıkar.", "uretilen_ipucu": &"Clue_CHR018_Sukabak"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR018_MansetTohum"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; çapasını yere dayar, elindeki toprağı silkeler, düz konuşur.", "Stressed": "Tansiyon 4-7; su kabağını eteğinin altına çeker, düğümlü ipi sayar.", "Panic": "Tansiyon 8-10; kabağı göğsüne bastırır, Hayri'nin adını duyunca geriler."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR018_TOHUMDUGUMU_BASLIK": "Kuşağındaki düğümlü ip", "CLUE_CHR018_TOHUMDUGUMU_TANIM": "Kuşağındaki düğümlü ip. Tıklandığında her düğümün bir tohum sayımına denk geldiği ve son düğümün taze atıldığı görünür.", "CLUE_CHR018_SUKABAK_BASLIK": "Belindeki kuru su kabağı", "CLUE_CHR018_SUKABAK_TANIM": "Belindeki kuru su kabağı. Tıklandığında balmumu kapağın altında ana bamya ve kabak tohumu çıkar.", "CHR_018_DUGUM_00_REPLIK": "Bostandan geliyorum, elim toprak. Soğan, bamya, kabak bilirim. Tarlanız varsa çapa vururum, boğaz tokluğuna.", "CHR_018_DUGUM_00_SEC_1_METIN": "Bostan dururken bu kapıya niye tek başına yürüdün?", "CHR_018_DUGUM_00_SEC_2_METIN": "Elin toprak ama belindeki kap kuru. Hangi tarladan geldin?", "CHR_018_DUGUM_00_SEC_3_METIN": "Kuşaktaki tohum düğümü , su kabağındaki çekirdek ve yen dikişindeki bamya tanesi ! Sen bostancı değil, tohum saklayan kadınsın!", "CHR_018_DUGUM_1_1_REPLIK": "Derebostan'da tarla bölündü. Benim payıma otluk düştü. İş aramaya çıktım, çapa bende.", "CHR_018_DUGUM_1_1_SEC_1_METIN": "Doğrudur, tarla bölününce insan iş arar.", "CHR_018_DUGUM_1_1_SEC_2_METIN": "Otluğa düştüysen belindeki kabın niye tohumla dolu?", "CHR_018_DUGUM_1_2_REPLIK": "Kapta biraz su vardı, bitti. Yanımda azık niyetine bir avuç çekirdek var, o kadar.", "CHR_018_DUGUM_1_2_SEC_1_METIN": "Peki, bostana gir de çapanı vur.", "CHR_018_DUGUM_1_2_SEC_2_METIN": "Azık bir avuç olmaz, o kap mühürlü. İçinde ne var?", "CHR_018_DUGUM_1_2_BASK__REPLIK": "(Kabağı eteğinin altına iter) Ne kurcalarsın? Bostancıyım ben. Haram mal taşıdığım yok.", "CHR_018_DUGUM_1_2_BASK__SEC_1_METIN": "Tamam, kapına dokunmam.", "CHR_018_DUGUM_1_2_BASK__SEC_2_METIN": "Düğüm de dikişteki tane de duruyor. Tohumu söyle!", "CHR_018_DUGUM_1_3_REPLIK": "(Kapağı sıyırır, sesi düşer) Tamam. İçinde anamın tohumu var. Bamya, kabak. Eniştem Hayri pazarda satacaktı. Sakladım, kaçtım.", "CHR_018_DUGUM_1_3_SEC_1_METIN": "Demek tohumu sakladın... Şimdi geçmişini anlat.", "CHR_018_DUGUM_2_1_REPLIK": "Derebostan'danım. Çapadan, fideden başka işim yok. Soğanı da bamyayı da yerinde ekerim.", "CHR_018_DUGUM_2_1_SEC_1_METIN": "Madem bostancısın, bamya ne zaman ekilir, kabak fidesi donu nasıl atlatır?", "CHR_018_DUGUM_2_2_REPLIK": "(Toprağı parmağında ezer) Bamya toprak ısınınca ekilir, tohum iki parmak derine. Kabak fidesi don yemeden dışarı çıkmaz, gece üstüne çul atarsın. Bunu bilmeyen bostanı boşa sürer.", "CHR_018_DUGUM_2_2_SEC_1_METIN": "Ana tohumu pazara gidecek mal değildir. İş bilene yer var.", "CHR_018_DUGUM_2_2_SEC_2_METIN": "Tohumu sakladığını söyledin. Enişten peşinde, adın ne?", "CHR_018_DUGUM_2_3_REPLIK": "(Başını kaldırır) Adım Rahime. Hırsız değilim. O tohum anamın. Bostan'da çapa vururum, fide dikerim. Yeter ki Hayri'ye vermeyin.", "CHR_018_DUGUM_2_3_SEC_1_METIN": "Rahime olduğunu bildik. Şimdi o kabağa bakalım.", "CHR_018_DUGUM_2_3_AGRESIF_REPLIK": "(Kabağı sıkı tutar) Evet, Rahime'yim. Anamın tohumunu pazarda ucuza gitmesin diye aldım. Bu el bir bostanı yeşertir. Geri çevirirseniz tohum da ben de kururuz.", "CHR_018_DUGUM_3_1_REPLIK": "(Kabağı bırakır) Gördün. İnkar etmem.", "CHR_018_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Rahime. Şimdi niyetini söyle.", "CHR_018_DUGUM_3_2_REPLIK": "", "CHR_018_DUGUM_3_3_REPLIK": "(Bir avuç tohum gösterir) Bak. Anamın bamyası, kabağı. Bostan binasında çapa vururum, fide dikerim. Soğan da tutar. Beni içeri alın. Hayri gelirse tohumu vermeyin.", "CHR_018_DUGUM_3_3_SEC_1_METIN": "Tohumun da çapan da belli Rahime. Şimdi hükmün verilecek.", "CHR_018_DUGUM_FINAL_RET_REPLIK": "(Kabağı bağrına basar) Sizde de toprak kalmamış. Tohumu çamura atarım da Hayri'ye vermem.", "CHR_018_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_018_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız su kabağındaki tohuma ve kadının topraklı ellerine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_018_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Bostan dururken bu kapıya niye tek başına yürüdün?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_018_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin toprak ama belindeki kap kuru. Hangi tarladan geldin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_018_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR018_TohumDugumu], [Clue_CHR018_Sukabak] veya [Clue_Görsel_CHR018_MansetTohum] ipuçlarına dikkatle bakılır: Kuşaktaki tohum düğümü [Clue_CHR018_TohumDugumu], su kabağındaki çekirdek [Clue_CHR018_Sukabak] ve yen dikişindeki bamya tanesi [Clue_Görsel_CHR018_MansetTohum]! Sen bostancı değil, tohum saklayan kadınsın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR018_TohumDugumu", "Clue_CHR018_Sukabak", "Clue_Görsel_CHR018_MansetTohum", "Clue_CHR018_TohumDugumu", "Clue_CHR018_Sukabak", "Clue_Görsel_CHR018_MansetTohum"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_018_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bostandan geliyorum, elim toprak. Soğan, bamya, kabak bilirim. Tarlanız varsa çapa vururum, boğaz tokluğuna.\"", "Seçenek 1 (Dal 1 yol): \"Bostan dururken bu kapıya niye tek başına yürüdün?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin toprak ama belindeki kap kuru. Hangi tarladan geldin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR018_TohumDugumu], [Clue_CHR018_Sukabak] veya [Clue_Görsel_CHR018_MansetTohum] ipuçlarına dikkatle bakılır: Kuşaktaki tohum düğümü [Clue_CHR018_TohumDugumu], su kabağındaki çekirdek [Clue_CHR018_Sukabak] ve yen dikişindeki bamya tanesi [Clue_Görsel_CHR018_MansetT
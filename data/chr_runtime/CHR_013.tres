[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_013"
ad = "Koca Osman Dayı"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Erzak < 5"
secere_matrisi = {"Doğum_Yeri": "Alçakvadi, Kocapınar Köyü", "Aile_Bağı": "Bütün ataları tohum ıslahçısı, çocukları kuraklıkta veba kurbanı", "Kırılma_Olayı": "Sancak beyinin adamlarının ata yadigarı tohumu beylik mülkü sayıp zorla müsadere etmeye kalkışması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Değirmen ve Bostan çevresinde tohum ayıklama, toprağı nadasa hazırlama ve ekim denetimi işi", "Gece_Döngüsü": "Değirmen ocağında testideki ata tohumlarını bez torbalara tek tek sayarak tasnif etme."}
persona_maskesi = "Köyü kuraklıktan kavrulmuş, bir parça kuru ekmek karşılığında gençlere tarla sürmeyi öğretecek ihtiyar bir rençber."
gizlenen_gercek = "Belindeki killi toprak testide sakladığı kuraklıkta bile başak veren paha biçilmez ata tohumu ve arkasından gelen beylik müsadere zaptiyeleri."
gorsel_hata = "Sağ paçasında taze kan sızmış bez sargı ve ağanın av köpeklerinin dişlediği taze diş yarası izi."
sir_baglantisi = "Kendi halinde gezen ihtiyar rençberi av köpeği kovalamaz; bu diş izi ağanın konağından tohum kaçırırken yaşanan kovalamacanın fiziki kanıtıdır."
sfx = "Meşe değnek sesi, toprak testi tıngırtısı, eşeğin tok nalları."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Belindeki delikli pişmiş toprak tohum testisi. Tıklandığında kapağının balmumuyla mühürlendiği, içinde dev taneli kızıl ata buğdayı saklandığı görülür.", "uretilen_ipucu": &"Clue_CHR013_MuhurluTesti"}
obje_2 = {"aciklama": "Eşeğindeki çifte meşin heybe. Tıklandığında kuru samanların altında beylik kâtibinin müsadere tutanağı ve ağanın adamlarının mühür kırma pusulası ele geçer.", "uretilen_ipucu": &"Clue_CHR013_MusaderePusulasi"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR013_KopekIsirigi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; değneğine yaslanır, sakalını sıvazlar, bilge ve sakin bir köylü edasıyla konuşur.", "Stressed": "Tansiyon 4-7; elini belindeki testiye götürür, kaşlarını çatar, sesi titrer.", "Panic": "Tansiyon 8-10; testiyi göğsüne bastırır, değneğini savurur gibi yapar, tohumu vermemek için diklenir."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR013_MUHURLUTESTI_BASLIK": "Belindeki delikli pişmiş toprak tohum testisi", "CLUE_CHR013_MUHURLUTESTI_TANIM": "Belindeki delikli pişmiş toprak tohum testisi. Tıklandığında kapağının balmumuyla mühürlendiği, içinde dev taneli kızıl ata buğdayı saklandığı görülür.", "CLUE_CHR013_MUSADEREPUSULASI_BASLIK": "Eşeğindeki çifte meşin heybe", "CLUE_CHR013_MUSADEREPUSULASI_TANIM": "Eşeğindeki çifte meşin heybe. Tıklandığında kuru samanların altında beylik kâtibinin müsadere tutanağı ve ağanın adamlarının mühür kırma pusulası ele geçer.", "CHR_013_DUGUM_00_REPLIK": "Kolay gele evlat. İhtiyar halimle şu yokuşu tırmandım. Toprağın dilinden anlarım; kurak toprakta hangi tohumun başak vereceğini benden iyi bilen azdır. Köyünüzde toprağa can vereyim.", "CHR_013_DUGUM_00_SEC_1_METIN": "Alçakvadi kuruduysa bu yaşta o yüklü eşekle tek başına nasıl aştın dağları Osman Dayı?", "CHR_013_DUGUM_00_SEC_2_METIN": "Tohumcuyum dersin ama gözlerinde ağa korkusu sezinlenir. Kimin ocağındandın sen?", "CHR_013_DUGUM_00_SEC_3_METIN": "Belindeki mühürlü testi , heybendeki müsadere tutanağı ve bacağındaki tazı ısırığı ! Sen ağadan ata tohumu kaçıran Koca Osman'sın!", "CHR_013_DUGUM_1_1_REPLIK": "Eşek kocamış ama yolu bilir evlat. Su başlarını takip ettim, pınarlardan doldurdum testimi. Kimseden aş istemedim.", "CHR_013_DUGUM_1_1_SEC_1_METIN": "Doğru dersin dayı, tecrübeli çiftçi yolunu bulur.", "CHR_013_DUGUM_1_1_SEC_2_METIN": "Su başlarından gelen adamın bacağında av köpeği yarası ne gezer!", "CHR_013_DUGUM_1_2_REPLIK": "Öyledir evlat... Toprağı bilen aç kalmaz. Köyünüzün tarlalarına bereket getiririm.", "CHR_013_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri gir de bir soluklan.", "CHR_013_DUGUM_1_2_SEC_2_METIN": "Belindeki o mühürlü testide su taşınmaz dayı, ne var onun içinde?", "CHR_013_DUGUM_1_2_BASK__REPLIK": "(Değneğini sıkar, gözleri kısılır) Neden her şeyin altında fenalık ararsın evlat? İhtiyar bir tohumcunun testisi seni niye bu kadar işkillendirir?", "CHR_013_DUGUM_1_2_BASK__SEC_1_METIN": "Kusuruma bakma dayı, vazifemizi yaparız.", "CHR_013_DUGUM_1_2_BASK__SEC_2_METIN": "Ağanın köpekleri kimi kovaladıysa testi de ondadır! Doğruyu söyle!", "CHR_013_DUGUM_1_3_REPLIK": "(İçini çeker, parmaklıklara sokulur) Tamam evlat... Ağa köyün bütün tohumuna el koydu. Dedemin dedesinden kalan kızıl kılçık tohumunu vermedim. Gece ambarı ateşe verip testiyi kaptım, tazıları saldılar ardımdan.", "CHR_013_DUGUM_1_3_SEC_1_METIN": "Demek ata tohumunu kurtardın... Şimdi geçmişini anlat.", "CHR_013_DUGUM_2_1_REPLIK": "Kocapınar köyünün tohumcusuyum. Yedi kuşaktır bizim ocak buğday ayıklar. Bey gelir geçer, padişah değişir ama tohum kalır.", "CHR_013_DUGUM_2_1_SEC_1_METIN": "Madem tohumcusun, kuraklık buğdayı hangi tavda ekilir, başak ne vakit sararır?", "CHR_013_DUGUM_2_2_REPLIK": "(Gözleri parıldar) Toprak kırağıyı yemeden ekilir evlat. Kökü derine insin ki yaz kurutmasın. Başak tanesi kızarınca orak vurulur.", "CHR_013_DUGUM_2_2_SEC_1_METIN": "Kıymetli bir bilgin var dayı, toprağın kadrini bilen adamsın.", "CHR_013_DUGUM_2_2_SEC_2_METIN": "Ağanın zaptiyeleri buralara kadar iz sürecek! Kimsin sen Osman Dayı?", "CHR_013_DUGUM_2_3_REPLIK": "(Başını sallar) Adım Osman'dır. Koca Osman derler. Ben bu tohumu beye yedirmem evlat. Köyünüzün tarlasına saçayım, kuraklıkta bile aç kalmayın.", "CHR_013_DUGUM_2_3_SEC_1_METIN": "Osman Dayı, hürmetimiz sonsuzdur. Şimdi o testiye bakalım.", "CHR_013_DUGUM_2_3_AGRESIF_REPLIK": "(Değneğini yere vurur, sesi gürleşir) Evet, Koca Osman'ım ben! Yedi kuşaklık tohumu o haramzade beye vermedim! İster vurun ister kovun, bu tohumu benden alamazsınız! Toprağına bereket isteyen kapısını açar!", "CHR_013_DUGUM_3_1_REPLIK": "(Testiyi iki eliyle tutar, derin bir nefes alır) Gözün pek keskinmiş evlat...", "CHR_013_DUGUM_3_1_SEC_1_METIN": "Tohumun aslını anlat Osman Dayı!", "CHR_013_DUGUM_3_2_REPLIK": "", "CHR_013_DUGUM_3_3_REPLIK": "(Testinin balmumunu sıyırır, avucuna döktüğü iri kızıl buğday tanelerini gösterir) Bak evlat... Bu tohum susuzlukta çatlayan toprakta bile boy verir. Köyünüzün tarlalarına ekersek kıtlık yüzü görmezsiniz. Değirmeniniz durmaz. Beni içeri al, tohumu köye emanet edeyim.", "CHR_013_DUGUM_3_3_SEC_1_METIN": "Bu tohum köyün geleceğidir dayı. Şimdi senin hükmün verilecek.", "CHR_013_DUGUM_FINAL_RET_REPLIK": "(Testiyi bağrına basar, eşeğin yularını çeker) Sizde de toprak sevgisi kalmamış! Tohumu çamura atarım da size vermem!", "CHR_013_DUGUM_FINAL_RET_SEC_1_METIN": "İhtiyarın inadı tuttu.", "CHR_013_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız avuçtaki kızıl buğday tânelerine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_013_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Alçakvadi kuruduysa bu yaşta o yüklü eşekle tek başına nasıl aştın dağları Osman Dayı?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Tohumcuyum dersin ama gözlerinde ağa korkusu sezinlenir. Kimin ocağındandın sen?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR013_MuhurluTesti], [Clue_CHR013_MusaderePusulasi] veya [Clue_Görsel_CHR013_KopekIsirigi] ipuçlarına dikkatle bakılır: Belindeki mühürlü testi [Clue_CHR013_MuhurluTesti], heybendeki müsadere tutanağı [Clue_CHR013_MusaderePusulasi] ve bacağındaki tazı ısırığı [Clue_Görsel_CHR013_KopekIsirigi]! Sen ağadan ata tohumu kaçıran Koca Osman'sın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR013_MuhurluTesti", "Clue_CHR013_MusaderePusulasi", "Clue_Görsel_CHR013_KopekIsirigi", "Clue_CHR013_MuhurluTesti", "Clue_CHR013_MusaderePusulasi", "Clue_Görsel_CHR013_KopekIsirigi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kolay gele evlat. İhtiyar halimle şu yokuşu tırmandım. Toprağın dilinden anlarım; kurak toprakta hangi tohumun başak vereceğini benden iyi bilen azdır. Köyünüzde toprağa can vereyim.\"", "Seçenek 1 (Dal 1 yol): \"Alçakvadi kuruduysa bu yaşta o yüklü eşekle tek başına nasıl aştın dağları Osman Dayı?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Tohumcuyum dersin ama gözlerinde ağa korkusu sezinlenir. Kimin ocağındandın sen?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR013_MuhurluTesti], [Clue_
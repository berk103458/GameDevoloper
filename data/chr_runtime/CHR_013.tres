1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyledir evlat... Toprağı bilen aç kalmaz. Köyünüzün tarlalarına bereket getiririm.\"", "Seçenek kapat: \"Pekala, içeri gir de bir soluklan.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Belindeki o mühürlü testide su taşınmaz dayı, ne var onun içinde? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_013_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Kusuruma bakma dayı, vazifemizi yaparız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Ağanın köpekleri kimi kovaladıysa testi de ondadır! Doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Değneğini sıkar, gözleri kısılır) Neden her şeyin altında fenalık ararsın evlat? İhtiyar bir tohumcunun testisi seni niye bu kadar işkillendirir?\"", "Seçenek geri çekil: \"Kusuruma bakma dayı, vazifemizi yaparız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Ağanın köpekleri kimi kovaladıysa testi de ondadır! Doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_013_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek ata tohumunu kurtardın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(İçini çeker, parmaklıklara sokulur) Tamam evlat... Ağa köyün bütün tohumuna el koydu. Dedemin dedesinden kalan kızıl kılçık tohumunu vermedim. Gece ambarı ateşe verip testiyi kaptım, tazıları saldılar ardımdan.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek ata tohumunu kurtardın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_013_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem tohumcusun, kuraklık buğdayı hangi tavda ekilir, başak ne vakit sararır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kocapınar köyünün tohumcusuyum. Yedi kuşaktır bizim ocak buğday ayıklar. Bey gelir geçer, padişah değişir ama tohum kalır.\"", "Test sorusu: \"Madem tohumcusun, kuraklık buğdayı hangi tavda ekilir, başak ne vakit sararır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_013_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Kıymetli bir bilgin var dayı, toprağın kadrini bilen adamsın.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Ağanın zaptiyeleri buralara kadar iz sürecek! Kimsin sen Osman Dayı? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_013_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri parıldar) Toprak kırağıyı yemeden ekilir evlat. Kökü derine insin ki yaz kurutmasın. Başak tanesi kızarınca orak vurulur.\"", "Seçenek empati: \"Kıymetli bir bilgin var dayı, toprağın kadrini bilen adamsın.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Ağanın zaptiyeleri buralara kadar iz sürecek! Kimsin sen Osman Dayı? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_013_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Osman Dayı, hürmetimiz sonsuzdur. Şimdi o testiye bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Başını sallar) Adım Osman'dır. Koca Osman derler. Ben bu tohumu beye yedirmem evlat. Köyünüzün tarlasına saçayım, kuraklıkta bile aç kalmayın.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Osman Dayı, hürmetimiz sonsuzdur. Şimdi o testiye bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_013_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Değneğini yere vurur, sesi gürleşir) Evet, Koca Osman'ım ben! Yedi kuşaklık tohumu o haramzade beye vermedim! İster vurun ister kovun, bu tohumu benden alamazsınız! Toprağına bereket isteyen kapısını açar!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_013_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Tohumun aslını anlat Osman Dayı!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR013_MuhurluTesti], [Clue_CHR013_MusaderePusulasi] veya [Clue_Görsel_CHR013_KopekIsirigi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Belindeki balmumu mühürlü testi [Clue_CHR013_MuhurluTesti], heybendeki müsadere tutanağı [Clue_CHR013_MusaderePusulasi] ve bacağındaki tazı ısırığı [Clue_Görsel_CHR013_KopekIsirigi]! Sen ağadan ata tohumu kaçıran Koca Osman'sın!\"", "NPC Replik: \"(Testiyi iki eliyle tutar, derin bir nefes alır) Gözün pek keskinmiş evlat...\"", "Seçenek: \"Tohumun aslını anlat Osman Dayı!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_013_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_013_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Bu tohum köyün geleceğidir dayı. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Testinin balmumunu sıyırır, avucuna döktüğü iri kızıl buğday tanelerini gösterir) Bak evlat... Bu tohum susuzlukta çatlayan toprakta bile boy verir. Köyünüzün tarlalarına ekersek kıtlık yüzü görmezsiniz. Değirmeniniz durmaz. Beni içeri al, tohumu köye emanet edeyim.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Bu tohum köyün geleceğidir dayı. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_013_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İhtiyarın inadı tuttu.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_013_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Testiyi bağrına basar, eşeğin yularını çeker) Sizde de toprak sevgisi kalmamış! Tohumu çamura atarım da size vermem!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İhtiyarın inadı tuttu.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_013_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız avuçtaki kızıl buğday tânelerine bakar; karar menüsü açılır.", ""]}}

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_024", "offset": 3, "kaynak": "on accept: [CHR_024] - Değirmenci İdris, Seyit'e sahip çıkıp çırak alan ihtiyar değirmenci, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_025", "offset": 3, "kaynak": "on reject: [CHR_025] - Karakulak Ali, Seyit kovulunca zifti bizzat getiren harami kundakçısı, +3 tur sonra sızar."}, "on_bribe": {"entity_id": &"CHR_026", "offset": 2, "kaynak": "on bribe: [CHR_026] - Çerçi Yakup, çocuktan alınan nazarlığı ucuza kapatmak isteyen seyyar tüccar, +2 tur sonra kapıya varır."}, "on_jail": {"entity_id": &"CHR_027", "offset": 4, "kaynak": "on jail: [CHR_027] - İhtiyar Zeliha, kışladaki çocuğa çorba getiren köy anası, +4 tur sonra kapıyı çalar."}}

[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_006"
ad = "Seyit \"Dilsiz\""
sinif = &"ciftci"
fraksiyon = &"Kızıl Karga Dağ Haramilere"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Erzak < 6"
secere_matrisi = {"Doğum_Yeri": "Karaboran Boğazı, Çorakdere Mezrası", "Aile_Bağı": "Çete tarafından kaçırılmış dağ köylüsü çocuğu", "Kırılma_Olayı": "Açlıktan ölmemek için çetenin kundak ve hamallık işlerine boyun eğmesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Değirmen civarında un çuvalı taşıma ve odun kırma işi", "Gece_Döngüsü": "Değirmen savaklarının altına gizlice katranlı bez tıkıştırma ve samanlıklara zift sürme."}
persona_maskesi = "Dilsiz ve sağır numarası yapan, el kol işaretleriyle karnının aç olduğunu anlatan zavallı bir yetim amele."
gizlenen_gercek = "Konuşabildiği halde susması ve sırtındaki sepetin tabanında değirmeni yakmak için getirdiği yağlı katran fitilleri saklaması."
gorsel_hata = "Dilsiz numarası yapmasına rağmen arkadan gelen ani nida sesine irkilerek dönmesi ve gömlek yakasındaki taze kara zift lekesi."
sir_baglantisi = "Sağır biri arkadan gelen sese irkilmez; yakasındaki zift ise değirmen kundaklama hazırlığının fiziki kanıtıdır."
sfx = "Saman hışırtısı, matara tıkırtısı, derinden nefes çekişi."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Belindeki delik kösele matara. Tıklandığında mataradan su yerine geniz yakan kara zift ve katran sızdığı fark edilir.", "uretilen_ipucu": &"Clue_CHR006_KatranMatarasi"}
obje_2 = {"aciklama": "Sırtındaki saman dolu saz sepet. Tıklandığında samanın dibine gizlenmiş kükürtlü kav parçaları ve katranlı fitil yumakları ele gelir.", "uretilen_ipucu": &"Clue_CHR006_FitilYumagi"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR006_ZiftLekesi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; elleriyle ağzını ve karnını gösterir, sessizce boyun büker.", "Stressed": "Tansiyon 4-7; ellerini çeker, dişlerini sıkar, yutkunurken boğazı düğümlenir, gözleri sağa sola kaçışır.", "Panic": "Tansiyon 8-10; aniden dile gelir, bağırır, sırtındaki sepeti fırlatıp kaçmaya çalışır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR006_KATRANMATARASI_BASLIK": "Belindeki delik kösele matara", "CLUE_CHR006_KATRANMATARASI_TANIM": "Belindeki delik kösele matara. Tıklandığında mataradan su yerine geniz yakan kara zift ve katran sızdığı fark edilir.", "CLUE_CHR006_FITILYUMAGI_BASLIK": "Sırtındaki saman dolu saz sepet", "CLUE_CHR006_FITILYUMAGI_TANIM": "Sırtındaki saman dolu saz sepet. Tıklandığında samanın dibine gizlenmiş kükürtlü kav parçaları ve katranlı fitil yumakları ele gelir.", "CHR_006_DUGUM_00_REPLIK": "(Elleriyle karnını gösterir, ağzını açıp 'Aaa, eee' diye sesler çıkararak boynunu büker, saman sepetini yere bırakır.)", "CHR_006_DUGUM_00_SEC_1_METIN": "Dağ yolundan gelirsin lakin dilsiz halinle eşkıya pususundan nasıl kurtuldun?", "CHR_006_DUGUM_00_SEC_2_METIN": "Yetimim dersin ama ellerinde yük taşımaktan ziyade köz tutma izleri var. Kimin çırağısın?", "CHR_006_DUGUM_00_SEC_3_METIN": "Matarandaki zift kokusu , samanın altındaki fitiller ve yakandaki zift lekesi ! Numarayı kes, konuş bakalım!", "CHR_006_DUGUM_1_1_REPLIK": "(Eliyle dağları işaret eder, boynuna bıçak çalınır gibi hareket yapar, sonra toprağa kapanıp merhamet diler.)", "CHR_006_DUGUM_1_1_SEC_1_METIN": "Zavallı çocuk, haramiler hırpalamış belli ki.", "CHR_006_DUGUM_1_1_SEC_2_METIN": "Bırak bu el kol oyununu! Boğazdaki haramiler dilsiz çocuğu sağ bırakmaz, arkandan seslenince irkildin!", "CHR_006_DUGUM_1_2_REPLIK": "(Gözleri dolar, başını sallar, sepetine sarılır.)", "CHR_006_DUGUM_1_2_SEC_1_METIN": "Neyse, içeri girince bir tas çorba verirler.", "CHR_006_DUGUM_1_2_SEC_2_METIN": "Sepetinde ne taşıdığını göstermeden içeri adım atamazsın!", "CHR_006_DUGUM_1_2_BASK__REPLIK": "(Gözleri büyür, titremeye başlar, sırtını duvara verir.)", "CHR_006_DUGUM_1_2_BASK__SEC_1_METIN": "Korkma çocuk, kötülük etmem.", "CHR_006_DUGUM_1_2_BASK__SEC_2_METIN": "Korkunun ecele faydası yok! Kim yolladı seni köye?", "CHR_006_DUGUM_1_3_REPLIK": "(Aniden kısık ve çatlak bir sesle konuşur) Vurma ağabey... Dağdaki İlyas Reis yolladı beni. 'Saman taşıyorum de, değirmenin dibine bu zifti dök' dedi. Açtım, mecbur kaldım!", "CHR_006_DUGUM_1_3_SEC_1_METIN": "Demek dilin çözüldü... Şimdi doğruyu dökül.", "CHR_006_DUGUM_2_1_REPLIK": "(Parmaklarıyla göğsünü gösterir, 'Köy yandı' gibisinden iki elini havaya kaldırıp alev taklidi yapar.)", "CHR_006_DUGUM_2_1_SEC_1_METIN": "Hangi köy yandı, muhtar kimdi, babanın adı neydi söyle bakalım?", "CHR_006_DUGUM_2_2_REPLIK": "(Yere çömelir, çubukla toprağa kaba bir ev resmi çizer, gözlerini muhafıza diker.)", "CHR_006_DUGUM_2_2_SEC_1_METIN": "Köyün yandıysa acın büyüktür. Doğruyu söylersen sana sahip çıkarız.", "CHR_006_DUGUM_2_2_SEC_2_METIN": "Zift taşıdığını kendi ağzınla söyledin! Dilsiz değilsin sen, adın ne senin?", "CHR_006_DUGUM_2_3_REPLIK": "(Ağlayarak başını kaldırır) Adım Seyit'tir. Çorakdere'den kaçırdılar beni. Kundakçı Hamza'nın çırağı yaptılar. Ben adam öldürmedim ağabey!", "CHR_006_DUGUM_2_3_SEC_1_METIN": "Seyit olduğunu öğrendik. Şimdi o sepete bakalım.", "CHR_006_DUGUM_2_3_AGRESIF_REPLIK": "(Ayağa fırlar, bağırır) Evet, konuşuyorum! Adım Seyit! Çete köyümü bastı, anamı vurdu! Beni de köle ettiler! Alın beni içeri, dağa dönersem beni asarlar!", "CHR_006_DUGUM_3_1_REPLIK": "(Dehşetle geri sıçrar, sepetini düşürür) Sen nereden bildin zifti?", "CHR_006_DUGUM_3_1_SEC_1_METIN": "Her şeyi gördüm Seyit. Niyetini anlat!", "CHR_006_DUGUM_3_2_REPLIK": "", "CHR_006_DUGUM_3_3_REPLIK": "(Yere diz çöker, ellerini açar) Bu gece değirmenin savaklarına zift döküp ateşe verecektim. Unlar yanınca köylü panikleyecekti. Ama istemedim ağabey, zorla yaptırdılar. Beni kurtarın o çeteden!", "CHR_006_DUGUM_3_3_SEC_1_METIN": "Hakikat ortaya çıktı. Şimdi senin hükmün verilecek.", "CHR_006_DUGUM_FINAL_RET_REPLIK": "(Sepeti kapıya fırlatır, çığlık atar) Hepiniz taş kalplisiniz! Yanarsa yansın köyünüz, banane!", "CHR_006_DUGUM_FINAL_RET_SEC_1_METIN": "Öfkesi aklını aştı.", "CHR_006_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız yerdeki ziftli fitillere bakar, çocuğun haline acıma ile köy emniyeti arasında kararını verir. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_006_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Dağ yolundan gelirsin lakin dilsiz halinle eşkıya pususundan nasıl kurtuldun?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_006_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Yetimim dersin ama ellerinde yük taşımaktan ziyade köz tutma izleri var. Kimin çırağısın?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_006_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR006_KatranMatarasi], [Clue_CHR006_FitilYumagi] veya [Clue_Görsel_CHR006_ZiftLekesi] ipuçlarına dikkatle bakılır: Matarandaki zift kokusu [Clue_CHR006_KatranMatarasi], samanın altındaki fitiller [Clue_CHR006_FitilYumagi] ve yakandaki zift lekesi [Clue_Görsel_CHR006_ZiftLekesi]! Numarayı kes, konuş bakalım!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR006_KatranMatarasi", "Clue_CHR006_FitilYumagi", "Clue_Görsel_CHR006_ZiftLekesi", "Clue_CHR006_KatranMatarasi", "Clue_CHR006_FitilYumagi", "Clue_Görsel_CHR006_ZiftLekesi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_006_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Elleriyle karnını gösterir, ağzını açıp 'Aaa, eee' diye sesler çıkararak boynunu büker, saman sepetini yere bırakır.)\"", "Seçenek 1 (Dal 1 yol): \"Dağ yolundan gelirsin lakin dilsiz halinle eşkıya pususundan nasıl kurtuldun?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Yetimim dersin ama ellerinde yük taşımaktan ziyade köz tutma izleri var. Kimin çırağısın?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR006_KatranMatarasi], [Clue_CHR006_FitilYumagi] veya [Clue_Görsel_CHR006_ZiftLekesi] ipuçlarına dikkatle bakılır: Matarandaki zift k
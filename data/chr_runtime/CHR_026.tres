[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_026"
ad = "Salih"
sinif = &"esnaf"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Refah < 5"
secere_matrisi = {"Doğum_Yeri": "Koşuluçarşı, Eyer Sokağı", "Aile_Bağı": "Bekâr, dükkân kirası boynunda", "Kırılma_Olayı": "Geçen ay kira günü Seyfettin'in eyerini rehine koyup gece dükkânı boşaltması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Ahır binasında koşum dikme, eyer yama ve kayış değiştirme", "Gece_Döngüsü": "Ahır sundurmasında deriyi yağlayıp sabah çatlamasın diye örtme."}
persona_maskesi = "Dükkânı kapanmış, koşum dikmeye gelmiş yorgun bir saraç."
gizlenen_gercek = "Müşterinin eyerini kira için rehinciye bırakması ve bileğindeki rehin ipi izi."
gorsel_hata = "Sağ bileğinde rehinci ipinin bıraktığı taze yanık halka."
sir_baglantisi = "Bu iz biz izi değildir; eyeri rehine koyarken ipin bilekte sıktığı izdir."
sfx = "Deri gıcırtısı, ip hışırtısı, yorgun iç çekiş."
baslangic_tansiyonu = 1
zar = "d6"
sorgu_degeri = 3
obje_1 = {"aciklama": "Kuşağındaki eyer çubuğu. Tıklandığında Seyfettin'in adı ve ödenmemiş kira kertiği kömürle durur.", "uretilen_ipucu": &"Clue_CHR026_EyerCubugu"}
obje_2 = {"aciklama": "Çantadaki üzengi kayışı. Tıklandığında ucunda rehincinin kördüğümü ve eyerden kopmuş dikiş çıkar.", "uretilen_ipucu": &"Clue_CHR026_UzengeKayisi"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR026_RehinIzi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; kayışı çantaya sokar, bileğini ovar, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; eyer çubuğunu avuçlar, bilekteki halkayı gizler.", "Panic": "Tansiyon 8-10; bileğini yener, diz çöker, Seyfettin'in adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR026_EYERCUBUGU_BASLIK": "Kuşağındaki eyer çubuğu", "CLUE_CHR026_EYERCUBUGU_TANIM": "Kuşağındaki eyer çubuğu. Tıklandığında Seyfettin'in adı ve ödenmemiş kira kertiği kömürle durur.", "CLUE_CHR026_UZENGEKAYISI_BASLIK": "Çantadaki üzengi kayışı", "CLUE_CHR026_UZENGEKAYISI_TANIM": "Çantadaki üzengi kayışı. Tıklandığında ucunda rehincinin kördüğümü ve eyerden kopmuş dikiş çıkar.", "CHR_026_DUGUM_00_REPLIK": "Ellerim deri kokar bekçi. Koşum dikerim, eyer yamarım. Ahırın bir köşesinde dururum.", "CHR_026_DUGUM_00_SEC_1_METIN": "Saraç dükkânda durur. Sen niye tek başına bu kapıdasın?", "CHR_026_DUGUM_00_SEC_2_METIN": "Elin deri tutmuş ama bileğin yanık. Hangi çarşıdan koptun?", "CHR_026_DUGUM_00_SEC_3_METIN": "Kuşağındaki eyer çubuğu , çantadaki üzengi kayışı ve bileğindeki rehin izi ! Sen koşum arayan değil, eyer rehine koymuş saraçsın!", "CHR_026_DUGUM_1_1_REPLIK": "Koşuluçarşı'da iş bitti bekçi. Eyer kalmadı. Boş duracağıma burada koşum dikerim dedim.", "CHR_026_DUGUM_1_1_SEC_1_METIN": "Doğrudur, iş bitince saraç yer arar.", "CHR_026_DUGUM_1_1_SEC_2_METIN": "İş bittiyse çantadaki üzengi kayışı neyin nesi?", "CHR_026_DUGUM_1_2_REPLIK": "Eski bir kayış işte. Yoldan kaldı. Köye yük olmayayım diye yanıma aldım.", "CHR_026_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_026_DUGUM_1_2_SEC_2_METIN": "Yoldan kalan kayışta müşteri dikişi var!", "CHR_026_DUGUM_1_2_BASK__REPLIK": "(Bileğini yener) Ne karıştırırsın bekçi? Bileğim bizden yandı. Eyer rehine koyan adam güpegündüz kapıya çıkar mı?", "CHR_026_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_026_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Bileğindeki rehin halkası duruyor, doğruyu söyle!", "CHR_026_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Rehine koydum. Kiramı ödeyemedim. Seyfettin'in eyerini verdim. Kayışı utancımdan aldım, geldim.", "CHR_026_DUGUM_1_3_SEC_1_METIN": "Demek müşterinin eyerini rehine bıraktın... Şimdi geçmişini anlat.", "CHR_026_DUGUM_2_1_REPLIK": "Koşuluçarşı eyer sokağındanım. Koşum dikerim, kayış değiştiririm, eyer yamarım.", "CHR_026_DUGUM_2_1_SEC_1_METIN": "Madem saraçsın, koşum nereden çürür, üzengi kayışı nasıl dikilir?", "CHR_026_DUGUM_2_2_REPLIK": "(Eli rahatlar) Koşum ter yerinden çürür, önce orası yoklanır. Üzengi kayışı çift dikiş, tek kat yetmez. Kira düşünce el titrer ama iğne şaşmaz.", "CHR_026_DUGUM_2_2_SEC_1_METIN": "Kira insanın yakasını bırakmaz. İş bilen adama kapımız açık.", "CHR_026_DUGUM_2_2_SEC_2_METIN": "Eyer rehine koyduğunu ağzınla söyledin. Müşteri arkandan gelir, adın ne?", "CHR_026_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Salih. Hırsız değilim. O kayış Seyfettin'in eyerinden kaldı. Ahır'da koşum onarırım. Yeter ki Seyfettin'e teslim etmeyin.", "CHR_026_DUGUM_2_3_SEC_1_METIN": "Salih olduğunu bildik. Şimdi o kayışa bakalım.", "CHR_026_DUGUM_2_3_AGRESIF_REPLIK": "(Bileğini saklar) Evet, Salih'im ben. Kiram için eyeri rehine koydum. Bileğimdeki halka ondan. Bu el bir koşumu tutar. Geri çevirirseniz dağda aç kalırım.", "CHR_026_DUGUM_3_1_REPLIK": "(Kayışı yere bırakır, bileğini açar) Görmüşsün bekçi. İnkar etmem.", "CHR_026_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Salih. Şimdi niyetini söyle.", "CHR_026_DUGUM_3_2_REPLIK": "", "CHR_026_DUGUM_3_3_REPLIK": "(Kayışın kördüğümünü gösterir) Eyer gitti, bu kaldı. Ahır'da koşum dikerim, eyer yamarım. Bir daha başkasının malını rehine koymam. Beni içeri al. Seyfettin gelirse sakla beni.", "CHR_026_DUGUM_3_3_SEC_1_METIN": "Elin de utancın da belli Salih. Şimdi hükmün verilecek.", "CHR_026_DUGUM_FINAL_RET_REPLIK": "(Kayışı çantaya sokar, bileğini saklar) Siz de o rehinci gibisiniz. Koşumunuz kopsun.", "CHR_026_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_026_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız üzengi kayışına ve bilekteki rehin izine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_026_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Saraç dükkânda durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin deri tutmuş ama bileğin yanık. Hangi çarşıdan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR026_EyerCubugu], [Clue_CHR026_UzengeKayisi] veya [Clue_Görsel_CHR026_RehinIzi] ipuçlarına dikkatle bakılır: Kuşağındaki eyer çubuğu [Clue_CHR026_EyerCubugu], çantadaki üzengi kayışı [Clue_CHR026_UzengeKayisi] ve bileğindeki rehin izi [Clue_Görsel_CHR026_RehinIzi]! Sen koşum arayan değil, eyer rehine koymuş saraçsın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR026_EyerCubugu", "Clue_CHR026_UzengeKayisi", "Clue_Görsel_CHR026_RehinIzi", "Clue_CHR026_EyerCubugu", "Clue_CHR026_UzengeKayisi", "Clue_Görsel_CHR026_RehinIzi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Ellerim deri kokar bekçi. Koşum dikerim, eyer yamarım. Ahırın bir köşesinde dururum.\"", "Seçenek 1 (Dal 1 yol): \"Saraç dükkânda durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin deri tutmuş ama bileğin yanık. Hangi çarşıdan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR026_EyerCubugu], [Clue_CHR026_UzengeKayisi] veya [Clue_Görsel_CHR026_RehinIzi] ipuçlarına dikkatle bakılır: Kuşağındaki eyer çubuğu [Clue_CHR026_EyerCubugu], çantadaki üzengi kayışı [Clue_CHR026_UzengeKayisi] ve bileğindeki rehin izi [Clue_Görsel_CHR026_RehinIzi]! Sen koşum arayan değil, eyer rehine koymuş saraçsın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_026_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, iş bitince saraç yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"İş bittiyse çantadaki üzengi kayışı neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Koşuluçarşı'da iş bitti bekçi. Eyer kalmadı. Boş duracağıma burada koşum dikerim dedim.\"", "Seçenek inan: \"Doğrudur, iş bitince saraç yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"İş bittiyse çantadaki üzengi kayışı neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_026_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yoldan kalan kayışta müşteri dikişi var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir kayış işte. Yoldan kaldı. Köye yük olmayayım diye yanıma aldım.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yoldan kalan kayışta müşteri dikişi var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_026_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Bileğindeki rehin halkası duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Bileğini yener) Ne karıştırırsın bekçi? Bileğim bizden yandı. Eyer rehine koyan adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Bileğindeki rehin halkası duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_026_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek müşterinin eyerini rehine bıraktın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. Rehine koydum. Kiramı ödeyemedim. Seyfettin'in eyerini verdim. Kayışı utancımdan aldım, geldim.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek müşterinin eyerini rehine bıraktın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_026_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem saraçsın, koşum nereden çürür, üzengi kayışı nasıl dikilir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Koşuluçarşı eyer sokağındanım. Koşum dikerim, kayış değiştiririm, eyer yamarım.\"", "Test sorusu: \"Madem saraçsın, koşum nereden çürür, üzengi kayışı nasıl dikilir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_026_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Kira insanın yakasını bırakmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Eyer rehine koyduğunu ağzınla söyledin. Müşteri arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_026_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Eli rahatlar) Koşum ter yerinden çürür, önce orası yoklanır. Üzengi kayışı çift dikiş, tek kat yetmez. Kira düşünce el titrer ama iğne şaşmaz.\"", "Seçenek empati: \"Kira insanın yakasını bırakmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Eyer rehine koyduğunu ağzınla söyledin. Müşteri arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_026_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Salih olduğunu bildik. Şimdi o kayışa bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Salih. Hırsız değilim. O kayış Seyfettin'in eyerinden kaldı. Ahır'da koşum onarırım. Yeter ki Seyfettin'e teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Salih olduğunu bildik. Şimdi o kayışa bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_026_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Bileğini saklar) Evet, Salih'im ben. Kiram için eyeri rehine koydum. Bileğimdeki halka ondan. Bu el bir koşumu tutar. Geri çevirirseniz dağda aç kalırım.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_026_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Salih. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR026_EyerCubugu], [Clue_CHR026_UzengeKayisi] veya [Clue_Görsel_CHR026_RehinIzi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kuşağındaki eyer çubuğu [Clue_CHR026_EyerCubugu], çantadaki üzengi kayışı [Clue_CHR026_UzengeKayisi] ve bileğindeki rehin izi [Clue_Görsel_CHR026_RehinIzi]! Sen müşterinin eyerini rehine koyan Salih'sin!\"", "NPC Replik: \"(Kayışı yere bırakır, bileğini açar) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Salih. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_026_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_026_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Elin de utancın da belli Salih. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Kayışın kördüğümünü gösterir) Eyer gitti, bu kaldı. Ahır'da koşum dikerim, eyer yamarım. Bir daha başkasının malını rehine koymam. Beni içeri al. Seyfettin gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Elin de utancın da belli Salih. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_026_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_026_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Kayışı çantaya sokar, bileğini saklar) Siz de o rehinci gibisiniz. Koşumunuz kopsun.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_026_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız üzengi kayışına ve bilekteki rehin izine bakar; karar menüsü açılır.", ""]}}

[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_001"
ad = "Rüstem oğlu Hamza"
sinif = &"asker"
fraksiyon = &"Kızıl Karga Dağ Haramilere"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Güvenlik < 6"
secere_matrisi = {"Doğum_Yeri": "Karaboran Boğazı, Taşlıbel Dağ Köyü", "Aile_Bağı": "Kardeşi İlyas çetenin reisi, babası sancaktan sürgün edilmiş eski bir levent", "Kırılma_Olayı": "İki kış evvel kuraklıkta beylik zahiresini yağmalayan ağabeyinin asılması ve köyünün yakılmasıyla dağa çıkışı."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Değirmen ve Odunluk civarında kereste taşıma, kütük yarma ve ambar saçaklarını gizlice gözetleme işi", "Gece_Döngüsü": "Erzak Ambarı arkasındaki samanlıkta kükürt fitili hazırlama ve batı çit kapısını yoklama."}
persona_maskesi = "Ocağı sönmüş, atı nalsızlıktan çatlamış, sırtında dağ kütüğü taşıyıp günü kurtarmaya çalışan garip bir odun nakliyecisi."
gizlenen_gercek = "Gece üçüncü nöbette köyün erzak ambarını kundaklayıp kargaşa çıkararak dışarıdaki harami bölüğüne köy kapısını açma vazifesi."
gorsel_hata = "Sağ el başparmak tırnağı dibinde katranlaşmış kükürt sarılığı ve avuç içinde taze kav isi; parmak boğumlarında ip bağlama sürtünmesi izi."
sir_baglantisi = "Bu sarı yanık ve koku odun külleriyle oluşmaz; ambar ateşe vermek için hazırlanan kükürtlü fitilin ve neft reçinesinin doğrudan fiziksel kanıtıdır."
sfx = "Gıcırtılı kuru deri sesi, kösele sürtünmesi, dipten gelen hırıltılı nefes."
baslangic_tansiyonu = 3
zar = "d12"
sorgu_degeri = 4
obje_1 = {"aciklama": "Kararmış demir çakmak muhafazası ve kösele kav kesesi. Tıklandığında kesenin dibinde sıradan kav değil, kükürt tozuyla harmanlanmış yağlı fitil uçları fark edilir.", "uretilen_ipucu": &"Clue_CHR001_KavliCakmak"}
obje_2 = {"aciklama": "Sırtındaki ıslak sazlarla sarılmış meşe kütüğü bağı. Tıklandığında kütüklerin içinin oyulduğu, sazların arasına neft yağına batırılmış keten paçavralar tıkıştırıldığı görülür.", "uretilen_ipucu": &"Clue_CHR001_KatranliBez"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR001_KukurtYanigi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; başı öne eğik, omuzundaki yükü hafifçe sallayarak sakin ve sefil köylü tavrı takınır.", "Stressed": "Tansiyon 4-7; çenesi kilitlenir, gözleri sağa sola kaçışır, elini gayriihtiyari kuşağına götürüp parmaklarını sıkar.", "Panic": "Tansiyon 8-10; soluk alışverişi hızlanır, dişlerini gıcırdatır, sırtındaki bağı fırlatacak gibi kamburlaşır, saldırganlaşır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR001_KAVLICAKMAK_BASLIK": "Kararmış demir çakmak muhafazası ve kösele kav kesesi", "CLUE_CHR001_KAVLICAKMAK_TANIM": "Kararmış demir çakmak muhafazası ve kösele kav kesesi. Tıklandığında kesenin dibinde sıradan kav değil, kükürt tozuyla harmanlanmış yağlı fitil uçları fark edilir.", "CLUE_CHR001_KATRANLIBEZ_BASLIK": "Sırtındaki ıslak sazlarla sarılmış meşe kütüğü bağı", "CLUE_CHR001_KATRANLIBEZ_TANIM": "Sırtındaki ıslak sazlarla sarılmış meşe kütüğü bağı. Tıklandığında kütüklerin içinin oyulduğu, sazların arasına neft yağına batırılmış keten paçavralar tıkıştırıldığı görülür.", "CHR_001_DUGUM_00_REPLIK": "Aç kapıyı nöbetçi, gün devrildi devrilecek. Dağda ayaz bastırdı, kurt uluması vadiyi sardı. Sırtımdaki iki parça dağ odununu köye teslim edip bir tas sıcak çorbaya sığınmaya geldim.", "CHR_001_DUGUM_00_SEC_1_METIN": "Karaboran boğazında Kızıl Karga çetesi kol gezerken sırtında yükle bu dağları nasıl tek başına aştın?", "CHR_001_DUGUM_00_SEC_2_METIN": "Oduncu kılığına bürünmüşsün lakin yürüyüşün bir levent gibi sert ve adımlı. Kimin ocağındansın?", "CHR_001_DUGUM_00_SEC_3_METIN": "Sırtındaki yükten odun değil, neft ve kükürt kokusu yayılıyor! İndir o bağı yere!", "CHR_001_DUGUM_1_1_REPLIK": "Dağ yolu tenhaydı ağam. Eşkıya dediğin altın yüklü kervana pusu kurar, benim gibi iki çürük meşe kütüğü taşıyan baldırı çıplağa kim ok atar? Köpeğe kemik atsan dönüp bakmaz halime.", "CHR_001_DUGUM_1_1_SEC_1_METIN": "Haklısın, dağın haydutu senin gibi sefilin peşine düşmez.", "CHR_001_DUGUM_1_1_SEC_2_METIN": "Yalan söylersin! Karaboran'da Kızıl Karga uçan kuştan haraç keser. Sırtında yükle o boğazdan sağ geçen adam ya canını satmıştır ya da onların uşağıdır!", "CHR_001_DUGUM_1_2_REPLIK": "Öyle dersin de muhafız ağa... Çete beni görmedi değil hani. Vadide at kişnemesi duyunca kendimi çalılığa attım, nefesimi tuttum. Ucuz kurtuldum velhasıl.", "CHR_001_DUGUM_1_2_SEC_1_METIN": "Neyse, derdin yol olsun, içeri girince bakarız.", "CHR_001_DUGUM_1_2_SEC_2_METIN": "Çalılığa sinen adamın çizmesinde dağ dikeni olur, senin çizmende harami ocağının külü var!", "CHR_001_DUGUM_1_2_BASK__REPLIK": "(Gözleri seğirir, eli kuşağındaki meşin kemere kayar) Dilini kolla nöbetçi! Kimsenin uşağı değilim ben! Kendi ekmeğimin peşindeyim, başıma dert sarmadan aç şu kanadı!", "CHR_001_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme yolcu, vazifemi yaparım. Sakin ol.", "CHR_001_DUGUM_1_2_BASK__SEC_2_METIN": "Kuşağına giden o elini indir! Yalanın sesinde titriyor; Karaboran'da kimin adına yol gözlüyorsun?", "CHR_001_DUGUM_1_3_REPLIK": "(Dişlerini sıkar, sesini kısarak parmaklıkların arasına sokulur) Tamam... Bağırma ahaliye. Boğazda Kızıl Karga'nın gözcüleri kesti önümü. 'Köyün içine girip haber uçurmazsan kelleni gövdenden ayırırız' dediler. Beni zorla önden saldılar!", "CHR_001_DUGUM_1_3_SEC_1_METIN": "Demek haramiler seni önden keşfe sürdü... Şimdi baştan konuşalım bakalım.", "CHR_001_DUGUM_2_1_REPLIK": "Ben Taşlıbel köyünün rençberiyim ağam. Belimiz bükük olsa da dik duruşumuz atadan kalma dağlı inadıdır. Ocak söndü, beylik vergiye bağladı, biz de dağıldık.", "CHR_001_DUGUM_2_1_SEC_1_METIN": "Madem Taşlıbel'densin, oranın sipahisi kimdi, tahrir defterine hangi sancak adına yazıldınız söyle bakalım?", "CHR_001_DUGUM_2_2_REPLIK": "(Bir an yutkunur, alnında ter taneleri belirir) Şey... Sipahi İshak Bey derlerdi... Yok, sancak beyi teftişe gelmezdi, biz vergiyi köyün ihtiyarına sayardık.", "CHR_001_DUGUM_2_2_SEC_1_METIN": "Korkma, Taşlıbel'in yakılıp kül edildiğini bilirim. Dağdan kaçan mazluma kapımız kapanmaz, doğruyu söyle yeter.", "CHR_001_DUGUM_2_2_SEC_2_METIN": "Taşlıbel iki kış evvel Kızıl Karga'ya yataklık etti diye sancak sipahilerince yerle bir edildi! Yolda çeteyle anlaştığını zaten biliyorum, asıl adın ne senin?", "CHR_001_DUGUM_2_3_REPLIK": "(Başını öne eğer, omuzları çöker) Doğrudur... Köyümüz dağıldı. Adım Hamza'dır. Kızıl Karga'nın reisi İlyas benim ağabeyim olur. Beni bu batağa o sürükledi, ama ben kan dökülsün istemem gayrı.", "CHR_001_DUGUM_2_3_SEC_1_METIN": "Kim olduğunu bilmek iyi oldu Hamza. Şimdi diğer meseleye gelelim.", "CHR_001_DUGUM_2_3_AGRESIF_REPLIK": "(Gözleri vahşice parlar, hırsla tıslar) Evet be! İlyas'ın kardeşi Hamza'yım ben! Dağda açlıktan kırılacak mıydık? Ağabeyim asılan babamızın öcünü alacak! Ama beni buraya yem diye gönderdi, biliyorum! İzin ver sığınayım, çetenin yerini dökeyim önüne!", "CHR_001_DUGUM_3_1_REPLIK": "(Gözleri dehşetle açılır, sırtındaki yükü gürültüyle yere düşürür) Sen... Sen nereden anladın? Kütüğün içini kimse göremezdi!", "CHR_001_DUGUM_3_1_SEC_1_METIN": "Yalanın buraya kadardı, şimdi her şeyi dökül!", "CHR_001_DUGUM_3_2_REPLIK": "", "CHR_001_DUGUM_3_3_REPLIK": "(Dizlerinin bağı çözülür, çöker) Lanet olsun... Ağabeyim İlyas bu gece üçüncü nöbette ambarı ateşe vermemi emretti. Yangın çıkınca ahali oraya koşacak, çete de batı kapısından girip tahılı yağmalayacaktı. Her şeyi anlattım, canımı bağışla!", "CHR_001_DUGUM_3_3_SEC_1_METIN": "Bütün tezgâhın ortaya çıktı kundakçı. Şimdi senin hükmünü vereceğim.", "CHR_001_DUGUM_FINAL_RET_REPLIK": "(Dişlerini kenetler, gözleri nefretle kararır, hançer kabzasına sarılır gibi yapar) Boş lafı kes muhafız! Ne ben bir şey derim ne de sen benden laf alırsın! Bu kapıyı açmazsanız bu gece o dağ üzerinize yıkılacak, hiçbiriniz gün ışığını göremeyeceksiniz!", "CHR_001_DUGUM_FINAL_RET_SEC_1_METIN": "Haddini aştın harami dölü! Karar vakti geldi.", "CHR_001_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız son hükmü vermek üzere derin bir nefes alır; kapı mandalı elde bekler. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_001_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Karaboran boğazında Kızıl Karga çetesi kol gezerken sırtında yükle bu dağları nasıl tek başına aştın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Oduncu kılığına bürünmüşsün lakin yürüyüşün bir levent gibi sert ve adımlı. Kimin ocağındansın?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR001_KavliCakmak], [Clue_CHR001_KatranliBez] veya [Clue_Görsel_CHR001_KukurtYanigi] ipuçlarına dikkatle bakılır: Sırtındaki yükten odun değil, neft ve kükürt kokusu yayılıyor! İndir o bağı yere!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR001_KavliCakmak", "Clue_CHR001_KatranliBez", "Clue_Görsel_CHR001_KukurtYanigi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Aç kapıyı nöbetçi, gün devrildi devrilecek. Dağda ayaz bastırdı, kurt uluması vadiyi sardı. Sırtımdaki iki parça dağ odununu köye teslim edip bir tas sıcak çorbaya sığınmaya geldim.\"", "Seçenek 1 (Dal 1 yol): \"Karaboran boğazında Kızıl Karga çetesi kol gezerken sırtında yükle bu dağları nasıl tek başına aştın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Oduncu kılığına bürünmüşsün lakin yürüyüşün bir levent gibi sert ve adımlı. Kimin ocağındansın?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR001_KavliCakmak], [Clue_CHR001_KatranliBez] veya [Clue_Görsel_CHR001_KukurtYanigi] ipuçlarına dikkatle bakılır: Sırtındaki yükten odun değil, neft ve kükürt kokusu yayılıyor! İndir o bağı yere!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_001_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Haklısın, dağın haydutu senin gibi sefilin peşine düşmez.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Yalan söylersin! Karaboran'da Kızıl Karga uçan kuştan haraç keser. Sırtında yükle o boğazdan sağ geçen adam ya canını satmıştır ya da onların uşağıdır!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Dağ yolu tenhaydı ağam. Eşkıya dediğin altın yüklü kervana pusu kurar, benim gibi iki çürük meşe kütüğü taşıyan baldırı çıplağa kim ok atar? Köpeğe kemik atsan dönüp bakmaz halime.\"", "Seçenek inan: \"Haklısın, dağın haydutu senin gibi sefilin peşine düşmez.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Yalan söylersin! Karaboran'da Kızıl Karga uçan kuştan haraç keser. Sırtında yükle o boğazdan sağ geçen adam ya canını satmıştır ya da onların uşağıdır!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_001_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Neyse, derdin yol olsun, içeri girince bakarız.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Çalılığa sinen adamın çizmesinde dağ dikeni olur, senin çizmende harami ocağının külü var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyle dersin de muhafız ağa... Çete beni görmedi değil hani. Vadide at kişnemesi duyunca kendimi çalılığa attım, nefesimi tuttum. Ucuz kurtuldum velhasıl.\"", "Seçenek kapat: \"Neyse, derdin yol olsun, içeri girince bakarız.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Çalılığa sinen adamın çizmesinde dağ dikeni olur, senin çizmende harami ocağının külü var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_001_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme yolcu, vazifemi yaparım. Sakin ol.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Kuşağına giden o elini indir! Yalanın sesinde titriyor; Karaboran'da kimin adına yol gözlüyorsun? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri seğirir, eli kuşağındaki meşin kemere kayar) Dilini kolla nöbetçi! Kimsenin uşağı değilim ben! Kendi ekmeğimin peşindeyim, başıma dert sarmadan aç şu kanadı!\"", "Seçenek geri çekil: \"Öfkelenme yolcu, vazifemi yaparım. Sakin ol.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Kuşağına giden o elini indir! Yalanın sesinde titriyor; Karaboran'da kimin adına yol gözlüyorsun? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_001_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek haramiler seni önden keşfe sürdü... Şimdi baştan konuşalım bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Dişlerini sıkar, sesini kısarak parmaklıkların arasına sokulur) Tamam... Bağırma ahaliye. Boğazda Kızıl Karga'nın gözcüleri kesti önümü. 'Köyün içine girip haber uçurmazsan kelleni gövdenden ayırırız' dediler. Beni zorla önden saldılar!\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek haramiler seni önden keşfe sürdü... Şimdi baştan konuşalım bakalım.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_001_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem Taşlıbel'densin, oranın sipahisi kimdi, tahrir defterine hangi sancak adına yazıldınız söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Ben Taşlıbel köyünün rençberiyim ağam. Belimiz bükük olsa da dik duruşumuz atadan kalma dağlı inadıdır. Ocak söndü, beylik vergiye bağladı, biz de dağıldık.\"", "Test sorusu: \"Madem Taşlıbel'densin, oranın sipahisi kimdi, tahrir defterine hangi sancak adına yazıldınız söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_001_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Korkma, Taşlıbel'in yakılıp kül edildiğini bilirim. Dağdan kaçan mazluma kapımız kapanmaz, doğruyu söyle yeter.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Taşlıbel iki kış evvel Kızıl Karga'ya yataklık etti diye sancak sipahilerince yerle bir edildi! Yolda çeteyle anlaştığını zaten biliyorum, asıl adın ne senin? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_001_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Bir an yutkunur, alnında ter taneleri belirir) Şey... Sipahi İshak Bey derlerdi... Yok, sancak beyi teftişe gelmezdi, biz vergiyi köyün ihtiyarına sayardık.\"", "Seçenek empati: \"Korkma, Taşlıbel'in yakılıp kül edildiğini bilirim. Dağdan kaçan mazluma kapımız kapanmaz, doğruyu söyle yeter.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Taşlıbel iki kış evvel Kızıl Karga'ya yataklık etti diye sancak sipahilerince yerle bir edildi! Yolda çeteyle anlaştığını zaten biliyorum, asıl adın ne senin? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_001_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kim olduğunu bilmek iyi oldu Hamza. Şimdi diğer meseleye gelelim.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Başını öne eğer, omuzları çöker) Doğrudur... Köyümüz dağıldı. Adım Hamza'dır. Kızıl Karga'nın reisi İlyas benim ağabeyim olur. Beni bu batağa o sürükledi, ama ben kan dökülsün istemem gayrı.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Kim olduğunu bilmek iyi oldu Hamza. Şimdi diğer meseleye gelelim.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_001_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Gözleri vahşice parlar, hırsla tıslar) Evet be! İlyas'ın kardeşi Hamza'yım ben! Dağda açlıktan kırılacak mıydık? Ağabeyim asılan babamızın öcünü alacak! Ama beni buraya yem diye gönderdi, biliyorum! İzin ver sığınayım, çetenin yerini dökeyim önüne!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_001_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalanın buraya kadardı, şimdi her şeyi dökül!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR001_KavliCakmak], [Clue_CHR001_KatranliBez] veya [Clue_Görsel_CHR001_KukurtYanigi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kav kutundaki kükürt tozu [Clue_CHR001_KavliCakmak], oyulmuş meşe kütüğüne gizlediğin neftli bezler [Clue_CHR001_KatranliBez] ve parmaklarındaki kundakçı kükürt lekesi [Clue_Görsel_CHR001_KukurtYanigi]! Sen oduncu değil, köyü ateşe vermeye gelmiş harami kundakçısısın!\"", "NPC Replik: \"(Gözleri dehşetle açılır, sırtındaki yükü gürültüyle yere düşürür) Sen... Sen nereden anladın? Kütüğün içini kimse göremezdi!\"", "Seçenek: \"Yalanın buraya kadardı, şimdi her şeyi dökül!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_001_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_001_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Bütün tezgâhın ortaya çıktı kundakçı. Şimdi senin hükmünü vereceğim.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Dizlerinin bağı çözülür, çöker) Lanet olsun... Ağabeyim İlyas bu gece üçüncü nöbette ambarı ateşe vermemi emretti. Yangın çıkınca ahali oraya koşacak, çete de batı kapısından girip tahılı yağmalayacaktı. Her şeyi anlattım, canımı bağışla!\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Bütün tezgâhın ortaya çıktı kundakçı. Şimdi senin hükmünü vereceğim.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_001_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Haddini aştın harami dölü! Karar vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_001_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Dişlerini kenetler, gözleri nefretle kararır, hançer kabzasına sarılır gibi yapar) Boş lafı kes muhafız! Ne ben bir şey derim ne de sen benden laf alırsın! Bu kapıyı açmazsanız bu gece o dağ üzerinize yıkılacak, hiçbiriniz gün ışığını göremeyeceksiniz!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Haddini aştın harami dölü! Karar vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_001_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız son hükmü vermek üzere derin bir nefes alır; kapı mandalı elde bekler. Karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Guvenlik": 3, "Refah": 1}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise Hamza Muhafız Kışlası emrinde ağır kütük yarma işine verilir. Verdiği bilgilerle çetenin gece baskını pusuya düşürülür: derhal Güvenlik +3 ve Refah +1 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te Erzak Ambarı binasında kundaklama yaşanır; Erzak -4, Güvenlik -3 ve Moral -2 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Haraminin kundaklama tertibi bozulur ve kapıdan kovulur. Debuff: 3 tur boyunca Muhafız Kışlası muhafızları teyakkuzda kütük nöbeti tutar, Güvenlik +2 artarken yorgunluktan Moral -1 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Yolcu sebepsizce geri çevrilmiş sayılır. Debuff: 4 tur boyunca Odunluk binasında kereste kesme işi aksar, yakacak kıtlığından Refah -1 ve Moral -2 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 4, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Hamza kuşağından çıkardığı 4 adet gümüş beylik sikkesini ve çakmak takımını muhafıza verir (Kişisel Kazanç: 4 gümüş sikke). Tur 4'te Odunluk binasında gizli sabotaj başlar, çürüme sonucunda Erzak -3 ve Güvenlik -2 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 3, "Moral": -2}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Hamza kışla zindanına atılır. Çete elebaşısının kardeşi esir edilmiştir. Muhafız Kışlası binasında Güvenlik +3 kazanılırken, çetenin intikam tehdidi yüzünden köyde Moral -2 kaybedilir."}}
gecikmeli_etkiler = Array[Dictionary]([{"tur_offset": 3, "hedef_sistem": "bar", "alan": "Guvenlik", "deger": -3, "hedef_bina": "Erzak Ambarı", "olay_id": "Gece Gözcüsü", "stat_etkisi": {"Guvenlik": -3}, "karar": "", "kosullar": {"Flag_Yol_Sirri_Acik": false}, "sure": 1, "kaynak": "Tur 3'te Erzak Ambarı binasında 'Gece Gözcüsü' olayı patlak verir; harami öncüsü fark edilmediği için ambar çevresinde Güvenlik -3 kaybı yaşanır."}, {"tur_offset": 5, "hedef_sistem": "dedikodu", "alan": "Moral", "deger": -2, "hedef_bina": "Köy Meydanı", "olay_id": "Dağ Fısıltısı", "stat_etkisi": {"Moral": -2}, "karar": "", "kosullar": {"Flag_Kimlik_Cozuldu": false}, "sure": 1, "kaynak": "Tur 5'te Köy Meydanı binasında 'Dağ Fısıltısı' olayı meydana gelir; Hamza'nın Kızıl Karga bağı gizli kaldığından köy ahalisi arasına casus korkusu düşer, Moral -2 azalır."}, {"tur_offset": 4, "hedef_sistem": "ambar_kundak", "alan": "Erzak", "deger": -4, "hedef_bina": "Erzak Ambarı", "olay_id": "CHR_001_Kabul and secret hidden", "stat_etkisi": {"Erzak": -4, "Guvenlik": -3, "Moral": -2}, "karar": "kabul", "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "sure": 1, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te Erzak Ambarı binasında kundaklama yaşanır; Erzak -4, Güvenlik -3 ve Moral -2 kaybedilir."}, {"tur_offset": 1, "hedef_sistem": "bar", "alan": "Guvenlik", "deger": 2, "hedef_bina": "Muhafız Kışlası", "olay_id": "CHR_001_Zorunlu ret", "stat_etkisi": {"Guvenlik": 2, "Moral": -1}, "karar": "zorunlu_ret", "kosullar": {}, "sure": 3, "kaynak": "Haraminin kundaklama tertibi bozulur ve kapıdan kovulur. Debuff: 3 tur boyunca Muhafız Kışlası muhafızları teyakkuzda kütük nöbeti tutar, Güvenlik +2 artarken yorgunluktan Moral -1 düşer."}, {"tur_offset": 1, "hedef_sistem": "bar", "alan": "Refah", "deger": -1, "hedef_bina": "Odunluk", "olay_id": "CHR_001_Gönüllü ret", "stat_etkisi": {"Refah": -1, "Moral": -2}, "karar": "gonullu_ret", "kosullar": {}, "sure": 4, "kaynak": "Yolcu sebepsizce geri çevrilmiş sayılır. Debuff: 4 tur boyunca Odunluk binasında kereste kesme işi aksar, yakacak kıtlığından Refah -1 ve Moral -2 kaybedilir."}, {"tur_offset": 4, "hedef_sistem": "ambar_kundak", "alan": "Erzak", "deger": -3, "hedef_bina": "Odunluk", "olay_id": "CHR_001_Rüşvet", "stat_etkisi": {"Erzak": -3, "Guvenlik": -2}, "karar": "rusvet", "kosullar": {}, "sure": 1, "kaynak": "Hamza kuşağından çıkardığı 4 adet gümüş beylik sikkesini ve çakmak takımını muhafıza verir (Kişisel Kazanç: 4 gümüş sikke). Tur 4'te Odunluk binasında gizli sabotaj başlar, çürüme sonucunda Erzak -3 ve Güvenlik -2 kaybedilir."}])
kosullu_etkiler = Array[Dictionary]([{"stat_etkisi": {}, "kosullar": {"Flag_Yol_Sirri_Acik": false}, "kaynak": "Tur 3'te Erzak Ambarı binasında 'Gece Gözcüsü' olayı patlak verir; harami öncüsü fark edilmediği için ambar çevresinde Güvenlik -3 kaybı yaşanır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Kimlik_Cozuldu": false}, "kaynak": "Tur 5'te Köy Meydanı binasında 'Dağ Fısıltısı' olayı meydana gelir; Hamza'nın Kızıl Karga bağı gizli kaldığından köy ahalisi arasına casus korkusu düşer, Moral -2 azalır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {"Guvenlik": -1}, "kosullar": {"Flag_Kilitlendi": true}, "kaynak": "Barışçıl uzlaşma ve güvene dayalı işe koşma seçenekleri iptal edilir; yalnızca Zorunlu Ret, Kışla veya Rüşvet seçenekleri sunulur. Kapıdaki sert direnç muhafızların tetikte beklemesine sebep olarak Güvenlik -1 ekler.", "muhafiz_akce": 0, "esyalar": []}])
sonraki_spawns = {"on_accept": {"entity_id": &"CHR_004", "offset": 4, "kaynak": "on accept: [CHR_004] - İlyas \"Kızıl Karga\", kardeşini kurtarmak için tüccar kılığına girmiş harami reisi, +4 tur sonra kapıya dayanır."}, "on_reject": {"entity_id": &"CHR_005", "offset": 3, "kaynak": "on reject: [CHR_005] - Çolak Kerim, Hamza'nın yerine keşfe gönderilen gözü kara ikinci harami, +3 tur sonra belirir."}, "on_bribe": {"entity_id": &"CHR_006", "offset": 2, "kaynak": "on bribe: [CHR_006] - Dilsiz Seyit, Hamza'nın bıraktığı işareti takip edip kundak yağını getiren çete yamağı, +2 tur sonra kapıda biter."}, "on_jail": {"entity_id": &"CHR_007", "offset": 5, "kaynak": "on jail: [CHR_007] - Kadı Naibi Şemsettin, tutsak haraminin sorgusu ve idam hükmü için sancaktan gelen sert mizaçlı divan memuru, +5 tur sonra teşrif eder."}}

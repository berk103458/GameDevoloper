[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_010"
ad = "Tellal Gaffar"
sinif = &"ciftci"
fraksiyon = &"Menfaatçi Sınır Ayaktakımı"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Moral < 6"
secere_matrisi = {"Doğum_Yeri": "Sınır Hanı Mezrası", "Aile_Bağı": "Babası eski bir han odacısı", "Kırılma_Olayı": "Kumar borcu yüzünden handan kovulup sınır boyundaki kaçakçıların ayakçısı ve komisyoncusu olması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Han ve Köy Meydanı'nda fısıltı yayma, köylülerin borç senetlerini öğrenme ve rüşvet pazarlığı yapma işi", "Gece_Döngüsü": "Muhafız Kışlası penceresi altına sokulup zayıf nöbetçilere altın teklif ederek gizli ittifak arama."}
persona_maskesi = "Köyün pazarına iki cılız keçi getiren, herkesin halini hatırını soran, neşeli ve zararsız bir davar tellalı."
gizlenen_gercek = "Kuşağının içinde muhafızları satın almak için getirdiği kesilmiş gümüş külçeler ve köylüleri haramilere haraca bağlamak için tuttuğu gizli borç çetelesi."
gorsel_hata = "Sol avucunun içinde tefeci mührü basmaktan kalma mor çivit mürekkebi lekesi ve kuşağında gizli altın bölmesi."
sir_baglantisi = "Sıradan keçi tellalı tefeci mürekkebi taşımaz; bu leke sınır boyundaki kirli borç ve rüşvet ağının fiziki kanıtıdır."
sfx = "Çıngırak şıkırtısı, gümüş sikke sesi, yılışık ve kısık kıkırdama."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Belinde asılı deri tellal çıngırağı ve meşin kese. Tıklandığında keseden sıradan bakır mangır yerine sancak damgalı ağır gümüş dirhemler çıktığı görülür.", "uretilen_ipucu": &"Clue_CHR010_GumusDirhem"}
obje_2 = {"aciklama": "Yedeğindeki iki zayıf keçi ve sırtındaki kıl hurç. Tıklandığında hurcun dibinde köylülerin tefeciye kaptırdığı senet çeteleleri ve şantaj pusulaları bulunur.", "uretilen_ipucu": &"Clue_CHR010_CeteleHurcu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR010_CivitLekesi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; çıngırağını sallar, pişkin pişkin sırıtır, ahbapça koluna dokunur gibi yapar.", "Stressed": "Tansiyon 4-7; bıyığını büker, sesini alçaltıp fısıldar, rüşvet teklifini artırır.", "Panic": "Tansiyon 8-10; yüzü asılır, tehditkâr bir dille köydeki rüşvetleri kadıya duyuracağını haykırır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR010_GUMUSDIRHEM_BASLIK": "Belinde asılı deri tellal çıngırağı ve meşin kese", "CLUE_CHR010_GUMUSDIRHEM_TANIM": "Belinde asılı deri tellal çıngırağı ve meşin kese. Tıklandığında keseden sıradan bakır mangır yerine sancak damgalı ağır gümüş dirhemler çıktığı görülür.", "CLUE_CHR010_CETELEHURCU_BASLIK": "Yedeğindeki iki zayıf keçi ve sırtındaki kıl hurç", "CLUE_CHR010_CETELEHURCU_TANIM": "Yedeğindeki iki zayıf keçi ve sırtındaki kıl hurç. Tıklandığında hurcun dibinde köylülerin tefeciye kaptırdığı senet çeteleleri ve şantaj pusulaları bulunur.", "CHR_010_DUGUM_00_REPLIK": "Eyvallah nöbetçi gardaşım! Tellal Gaffar derler bana. İki keçi getirdim pazara, köylünün işi görülsün. Aç şu kapıyı da akşam hanın ocağında iki lafın belini kıralım.", "CHR_010_DUGUM_00_SEC_1_METIN": "Sınır boyu tekinsizken bu iki cılız keçiyle hangi yoldan geldin Gaffar?", "CHR_010_DUGUM_00_SEC_2_METIN": "Tellalım dersin ama kuşağındaki gümüş köstek tellal harcı değil. Kimin hesabını görürsün?", "CHR_010_DUGUM_00_SEC_3_METIN": "Kesendeki ağır gümüş dirhemler , hurcundaki şantaj çetelesi ve elindeki tefeci lekesi ! Sen tellal değil, rüşvetçi bir madrabazsan!", "CHR_010_DUGUM_1_1_REPLIK": "Ben yolun kurduyum gardaşım. Kimseye görünmeden dere yatağından kıvrıldım geldim. Keçi dediğin dağda yol açar.", "CHR_010_DUGUM_1_1_SEC_1_METIN": "Haklısın, keçi patikayı iyi bilir.", "CHR_010_DUGUM_1_1_SEC_2_METIN": "Dere yatağı balçık içindedir! Senin çizmelerinde tek bir damla çamur yok!", "CHR_010_DUGUM_1_2_REPLIK": "Öyle ya muhafız ağam... Kuru taşlara bastım hep. Yılların tellalıyız, ayağımızı nereye basacağımızı biliriz.", "CHR_010_DUGUM_1_2_SEC_1_METIN": "Neyse, içeri gir de işine bak.", "CHR_010_DUGUM_1_2_SEC_2_METIN": "Ayağını bildiğin gibi heybende ne sakladığını da söylesene!", "CHR_010_DUGUM_1_2_BASK__REPLIK": "(Bıyığını büker, sırıtır) Yahu ne kurcalarsın gardaşım? İki dirhem ekmeğimizin peşindeyiz şurada.", "CHR_010_DUGUM_1_2_BASK__SEC_1_METIN": "Vazifemi yapıyorum Gaffar, sakin ol.", "CHR_010_DUGUM_1_2_BASK__SEC_2_METIN": "Pişkinliği bırak! Sınır boyunda kimin parasını taşıyorsun sen?", "CHR_010_DUGUM_1_3_REPLIK": "(Sırıtışı kaybolur, kulağına eğilir) Bak muhafız ağa... Dağdaki çete reisi İlyas beni yolladı. 'Köyün nöbetçilerine şu gümüşleri say, gece kapıyı aralık bıraksınlar' dedi. Payını al, keyfine bak.", "CHR_010_DUGUM_1_3_SEC_1_METIN": "Demek rüşvetle kapıyı açtırmaya geldin... Şimdi geçmişini anlat.", "CHR_010_DUGUM_2_1_REPLIK": "Sınır Hanı mezrasında doğdum büyüdüm. Pazarda mal alıp satarım. Herkes beni sever, kimseye bir zararım dokunmaz.", "CHR_010_DUGUM_2_1_SEC_1_METIN": "Madem pazarcısın, sınır boyunda keçinin rayici nedir, tellaliye harcı kime verilir?", "CHR_010_DUGUM_2_2_REPLIK": "(Gözlerini kırpıştırır) Keçisine göre değişir ağam... Tellaliye de han ağasına sayılır... Ama bizim hesabımız gayrıresmidir.", "CHR_010_DUGUM_2_2_SEC_1_METIN": "Zor iştir tellallık, iki tarafı da idare etmek gerek. Doğrusunu de bana.", "CHR_010_DUGUM_2_2_SEC_2_METIN": "Haraminin parasını dağıtmaya geldiğini söyledin! Sen tefecilerin ayakçısısın!", "CHR_010_DUGUM_2_3_REPLIK": "(Yutkunur) Adım Gaffar işte. Kumar borcum vardı, dağdakiler borcumu kapattı, beni de bu işe koştular. Ben kan dökmem ağam, sadece laf taşır, para iletirim.", "CHR_010_DUGUM_2_3_SEC_1_METIN": "Kimliğini bildik Gaffar. Şimdi o hurcuna bakalım.", "CHR_010_DUGUM_2_3_AGRESIF_REPLIK": "(Gözleri parlar, sesini yükseltir) Evet, Gaffar'ım ben! Bu sınırda benim elimden geçmeyen iş mi var? Açın şu kapıyı, aklınızı başınıza alın, açmazsanız köylünün borç defterini meydana dökerim!", "CHR_010_DUGUM_3_1_REPLIK": "(Çıngırağını saklar, yüzü sararır) Yavaş konuş nöbetçi ağa... Ahali duyacak!", "CHR_010_DUGUM_3_1_SEC_1_METIN": "Her şeyin ortada Gaffar. Dökül niyetini!", "CHR_010_DUGUM_3_2_REPLIK": "", "CHR_010_DUGUM_3_3_REPLIK": "(Kuşağındaki gümüşleri avucuna döker) Bak ağam, altı adet has gümüş dirhem. Köyün muhafızlarına dağıtacaktım bunu. İki tanesi senin olsun, bu gece batı kapısını görmezden gel. Kimsenin canı yanmayacak, sadece ambarı boşaltacaklar.", "CHR_010_DUGUM_3_3_SEC_1_METIN": "Köyün ekmeğini haramiye satmaya gelmişsin. Şimdi senin hükmün verilecek.", "CHR_010_DUGUM_FINAL_RET_REPLIK": "(Çıngırağını savurur, tükürür) Siz de açlıktan geberin o zaman! Bu köy zaten batmış, yakında haramiler hepinizi kılıçtan geçirecek!", "CHR_010_DUGUM_FINAL_RET_SEC_1_METIN": "Haddini bildirme vakti geldi.", "CHR_010_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız gümüş dirhemlere bakar, rüşvet ile köyün namusu arasında kararını verir; kapı mandalı elde bekler. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_010_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Sınır boyu tekinsizken bu iki cılız keçiyle hangi yoldan geldin Gaffar?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_010_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Tellalım dersin ama kuşağındaki gümüş köstek tellal harcı değil. Kimin hesabını görürsün?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_010_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR010_GumusDirhem], [Clue_CHR010_CeteleHurcu] veya [Clue_Görsel_CHR010_CivitLekesi] ipuçlarına dikkatle bakılır: Kesendeki ağır gümüş dirhemler [Clue_CHR010_GumusDirhem], hurcundaki şantaj çetelesi [Clue_CHR010_CeteleHurcu] ve elindeki tefeci lekesi [Clue_Görsel_CHR010_CivitLekesi]! Sen tellal değil, rüşvetçi bir madrabazsan!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR010_GumusDirhem", "Clue_CHR010_CeteleHurcu", "Clue_Görsel_CHR010_CivitLekesi", "Clue_CHR010_GumusDirhem", "Clue_CHR010_CeteleHurcu", "Clue_Görsel_CHR010_CivitLekesi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_010_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eyvallah nöbetçi gardaşım! Tellal Gaffar derler bana. İki keçi getirdim pazara, köylünün işi görülsün. Aç şu kapıyı da akşam hanın ocağında iki lafın belini kıralım.\"", "Seçenek 1 (Dal 1 yol): \"Sınır boyu tekinsizken bu iki cılız keçiyle hangi yoldan geldin Gaffar?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Tellalım dersin ama kuşağındaki gümüş köstek tellal harcı değil. Kimin hesabını görürsün?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR010_GumusDirhem], [Clue_CHR010_CeteleHurcu] veya [Clue_Görsel_CHR010_CivitLekesi]
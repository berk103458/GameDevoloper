sonraki_spawns = {"on_accept": {"entity_id": &"CHR_040", "offset": 3, "kaynak": "on accept: [CHR_040] - Kasap Hayrullah, Gaffar'ın getirdiği keçileri kesmek isteyen köy kasabı, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_041", "offset": 3, "kaynak": "on reject: [CHR_041] - Kanlı Murtaza, rüşvet planı bozulunca zorla girmeye çalışan çete fedaisi, +3 tur sonra kapıya dayanır."}, "on_bribe": {"entity_id": &"CHR_042", "offset": 2, "kaynak": "on bribe: [CHR_042] - Sarhoş Cafer, muhafızın gümüşlerini görüp borç istemeye gelen kumarbaz, +2 tur sonra kapıda biter."}, "on_jail": {"entity_id": &"CHR_043", "offset": 3, "kaynak": "on jail: [CHR_043] - Çerçi Selim, Gaffar'ın hapsedildiğini duyup mallarına çökmek isteyen fırsatçı, +3 tur sonra kapıyı çalar."}}

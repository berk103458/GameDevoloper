[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_009"
ad = "Çopur Abbas"
sinif = &"esnaf"
fraksiyon = &"Dağ Haramilere"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Güvenlik < 6"
secere_matrisi = {"Doğum_Yeri": "Sazlıkova bataklık boyu", "Aile_Bağı": "Çetede at hırsızı bir dayısı vardır", "Kırılma_Olayı": "Kaçak tuz satarken sancak zaptiyelerine yakalanıp sağ kulağının kesilmesi sonrası intikam için çeteye kurye yazılması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Köy Meydanı ve Han önünde ayna, tarak, iğne satıp kadınların ve çocukların lafını dinleme işi", "Gece_Döngüsü": "Su Kuyusu arkasına sokulup kuyu kapağını zorlama ve kuyuya kurutulmuş engerek zehri dökme fırsatı arama."}
persona_maskesi = "İğne, iplik, kına ve ayna satan, güler yüzlü, çenebaz ve zararsız bir garip gezgin çerçi."
gizlenen_gercek = "Çerçi tezgâhının çift tabanında hayvan kıran zehri, kurutulmuş engerek tozu ve gece çetenin baskını için hazırlanmış köy sokak krokisi saklaması."
gorsel_hata = "Sarı poşusunun altından taşan sağ kulağındaki ceza kesiği izi ve tırnak diplerindeki kına değil, gri engerek zehri tortusu."
sir_baglantisi = "Kesik kulak hırsızlık ve kaçakçılık suçunun resmi devlet damgasıdır; tırnaklardaki gri tortu ise su kuyusunu zehirlemek için taşınan zehrin kanıtıdır."
sfx = "Çerçi çıngırağı sesi, ayna şıngırtısı, cırtlak ve hızlı nefes alıp verme."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 3
obje_1 = {"aciklama": "Boynunda asılı meşin kayışlı tahta çerçi çekmecesi. Tıklandığında çekmecenin çift dip yaptığı, renkli boncukların altındaki gizli gözde kurutulmuş gri engerek zehri kesesi bulunduğu fark edilir.", "uretilen_ipucu": &"Clue_CHR009_EngerekZehri"}
obje_2 = {"aciklama": "Yularından tuttuğu cılız yük katırı ve çift kına heybesi. Tıklandığında kına torbalarının içine su geçirmez ziftli bezle sarılmış zehirli tohumlar ve harami pusulası gizlendiği görülür.", "uretilen_ipucu": &"Clue_CHR009_ZehirliKina"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR009_KesikKulak"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; elindeki aynayı mendiliyle siler, yılışıkça sırıtır, tezgâhındaki boncukları över.", "Stressed": "Tansiyon 4-7; sırıtması donar, poşusunu kulağının üstüne çeker, gözleri kapı arkasına kaçar.", "Panic": "Tansiyon 8-10; çekmecesini göğsüne siper eder, katırın arkasına saklanır, tiz bir sesle tehdit savurur."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR009_ENGEREKZEHRI_BASLIK": "Boynunda asılı meşin kayışlı tahta çerçi çekmecesi", "CLUE_CHR009_ENGEREKZEHRI_TANIM": "Boynunda asılı meşin kayışlı tahta çerçi çekmecesi. Tıklandığında çekmecenin çift dip yaptığı, renkli boncukların altındaki gizli gözde kurutulmuş gri engerek zehri kesesi bulunduğu fark edilir.", "CLUE_CHR009_ZEHIRLIKINA_BASLIK": "Yularından tuttuğu cılız yük katırı ve çift kına heybesi", "CLUE_CHR009_ZEHIRLIKINA_TANIM": "Yularından tuttuğu cılız yük katırı ve çift kına heybesi. Tıklandığında kına torbalarının içine su geçirmez ziftli bezle sarılmış zehirli tohumlar ve harami pusulası gizlendiği görülür.", "CHR_009_DUGUM_00_REPLIK": "Selamlar ağaların ağası nöbetçi! Çerçi Abbas derler bana. Halep kınası, Hasankeyf aynası, iğnesi, ipliği getirdim. Köyün hanımlarına üç beş süs satıp bu gece hanın köşesinde kıvrılayım.", "CHR_009_DUGUM_00_SEC_1_METIN": "Sazlıkova bataklığından bu dağ köyüne kadar bunca boncukla hangi kervanla geldin çerçi?", "CHR_009_DUGUM_00_SEC_2_METIN": "Çerçiyim dersin ama kulağındaki o poşuyu niye öyle yamuk doladın başına?", "CHR_009_DUGUM_00_SEC_3_METIN": "Çekmecendeki engerek tozu , kınanın içine gizlediğin zehir torbaları ve poşunun altındaki kesik kulak ! Sen esnaf değil, kuyu zehirlemeye gelen çete uşağısın!", "CHR_009_DUGUM_1_1_REPLIK": "Kervan ne gezer ağam! Fakir adam kendi bacağının kervanıdır. Katırımla patikalardan tıkır tıkır geldim işte. Kim bakar benim iki paslı iğneme?", "CHR_009_DUGUM_1_1_SEC_1_METIN": "Doğru, çerçinin malına haydut tenezzül etmez.", "CHR_009_DUGUM_1_1_SEC_2_METIN": "Yalan söylersin! Sazlıkova yolunu tutan çete uçan sinekten haraç alır, senin katırını çoktan kesip yerlerdi!", "CHR_009_DUGUM_1_2_REPLIK": "Öyle ya kurban olduğum... Dağda birkaç haramiye rast geldim de iki ayna bir parça kına hediye ettim, güle oynaya saldılar.", "CHR_009_DUGUM_1_2_SEC_1_METIN": "Neyse, içeri gir de han köşesinde otur.", "CHR_009_DUGUM_1_2_SEC_2_METIN": "Haramiler aynayla kınayla adam salmaz! Heybendeki o ağır torbalarda ne var?", "CHR_009_DUGUM_1_2_BASK__REPLIK": "(Gözleri döner, poşusunu çeker) Aman ağam! Yoksul bir çerçinin ekmeğiyle oynama, kurbanın olayım!", "CHR_009_DUGUM_1_2_BASK__SEC_1_METIN": "Tamam, sakin ol, bağırma.", "CHR_009_DUGUM_1_2_BASK__SEC_2_METIN": "Kıvırma çerçi! Dağdaki haramiler seni bu köye niye saldı?", "CHR_009_DUGUM_1_3_REPLIK": "(Yere çöker, sesini kısar) Tamam ağam, aramızda kalsın... Çete beni yolladı. 'Kız içeri giremedi, var git köyün çeşmesini sen hallet' dediler. Beni zorladılar!", "CHR_009_DUGUM_1_3_SEC_1_METIN": "Demek Meryem'in arkasından sen geldin... Şimdi geçmişini dökül.", "CHR_009_DUGUM_2_1_REPLIK": "Sazlıkova pazarlarında yirmi yıldır çerçilik yaparım ağam. Kulağım küçüklükten çıbandan delindi de ayaz vurmasın diye poşu örterim.", "CHR_009_DUGUM_2_1_SEC_1_METIN": "Çıban değil o! Sancak beyinin celladı hangi suçtan kulak keser söyle bakalım?", "CHR_009_DUGUM_2_2_REPLIK": "(Kulağını tutar, dili damağına yapışır) Ağam... Gençlik hatası işte... Pazar yerinde iki dirhem tuz aşırmıştım, cellat acımadı kesti.", "CHR_009_DUGUM_2_2_SEC_1_METIN": "Cezanı çekmişsin, geçmişte kalmış. Doğruyu dersen sana acırım.", "CHR_009_DUGUM_2_2_SEC_2_METIN": "Kulağı kesik hırsız köyün suyuna zehir katmaya gelmiş! Kimsin sen Abbas?", "CHR_009_DUGUM_2_3_REPLIK": "(Başını eğer) Adım Çopur Abbas'tır. Çetenin kuryesiyim. Beni borçla bağladılar kendilerine. 'Bu işi bitirmezsen öbür kulağını da keseriz' dediler. Can havliyle geldim.", "CHR_009_DUGUM_2_3_SEC_1_METIN": "Kim olduğunu öğrendik Abbas. Şimdi şu çekmeceyi aç bakalım.", "CHR_009_DUGUM_2_3_AGRESIF_REPLIK": "(Gözleri parlar, katırın arkasına geçer) Evet, Çopur Abbas'ım ben! Bu köye su içirmeyeceğim! Çete bu gece kapıya dayanacak, hiçbirinizi sağ koymayacaklar!", "CHR_009_DUGUM_3_1_REPLIK": "(Aynaları yere düşürür, dizlerinin bağı çözülür) Sen... sen cin misin nesin ağam!", "CHR_009_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Abbas. Niyetini açıkla!", "CHR_009_DUGUM_3_2_REPLIK": "", "CHR_009_DUGUM_3_3_REPLIK": "(Zehir kesesini çıkarıp yere atar) Bu gece köyün ana su kuyusuna dökecektim bu engerek tozunu. Sabah herkes kıvranırken çete batı kapısından girecekti. Her şeyi anlattım, canımı bağışla!", "CHR_009_DUGUM_3_3_SEC_1_METIN": "Zehirci tertibin çöktü. Şimdi hükmün verilecek.", "CHR_009_DUGUM_FINAL_RET_REPLIK": "(Zehir şişesini eline alır, parmaklıklara savuracak gibi yapar) Alın o zaman! Bu zehir hepinizi kurutacak!", "CHR_009_DUGUM_FINAL_RET_SEC_1_METIN": "Haddini bildirme vakti geldi.", "CHR_009_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız yerdeki zehir kesesine bakar; kapı mandalı elde bekler. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_009_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Sazlıkova bataklığından bu dağ köyüne kadar bunca boncukla hangi kervanla geldin çerçi?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Çerçiyim dersin ama kulağındaki o poşuyu niye öyle yamuk doladın başına?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR009_EngerekZehri], [Clue_CHR009_ZehirliKina] veya [Clue_Görsel_CHR009_KesikKulak] ipuçlarına dikkatle bakılır: Çekmecendeki engerek tozu [Clue_CHR009_EngerekZehri], kınanın içine gizlediğin zehir torbaları [Clue_CHR009_ZehirliKina] ve poşunun altındaki kesik kulak [Clue_Görsel_CHR009_KesikKulak]! Sen esnaf değil, kuyu zehirlemeye gelen çete uşağısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR009_EngerekZehri", "Clue_CHR009_ZehirliKina", "Clue_Görsel_CHR009_KesikKulak", "Clue_CHR009_EngerekZehri", "Clue_CHR009_ZehirliKina", "Clue_Görsel_CHR009_KesikKulak"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Selamlar ağaların ağası nöbetçi! Çerçi Abbas derler bana. Halep kınası, Hasankeyf aynası, iğnesi, ipliği getirdim. Köyün hanımlarına üç beş süs satıp bu gece hanın köşesinde kıvrılayım.\"", "Seçenek 1 (Dal 1 yol): \"Sazlıkova bataklığından bu dağ köyüne kadar bunca boncukla hangi kervanla geldin çerçi?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Çerçiyim dersin ama kulağındaki o poşuyu niye öyle yamuk doladın başına?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR009_EngerekZehri], [Clue_CHR009_ZehirliKina] veya [Clue_Görsel_CHR009_KesikKulak] ipuçlarına dikkatle bakılır: Çekmecendeki engerek tozu [Clue_CHR009_EngerekZehri], kınanın içine gizlediğin zehir torbaları [Clue_CHR009_ZehirliKina] ve poşunun altındaki kesik kulak [Clue_Görsel_CHR009_KesikKulak]! Sen esnaf değil, kuyu zehirlemeye gelen çete uşağısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_009_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğru, çerçinin malına haydut tenezzül etmez.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Yalan söylersin! Sazlıkova yolunu tutan çete uçan sinekten haraç alır, senin katırını çoktan kesip yerlerdi!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kervan ne gezer ağam! Fakir adam kendi bacağının kervanıdır. Katırımla patikalardan tıkır tıkır geldim işte. Kim bakar benim iki paslı iğneme?\"", "Seçenek inan: \"Doğru, çerçinin malına haydut tenezzül etmez.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Yalan söylersin! Sazlıkova yolunu tutan çete uçan sinekten haraç alır, senin katırını çoktan kesip yerlerdi!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_009_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Neyse, içeri gir de han köşesinde otur.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Haramiler aynayla kınayla adam salmaz! Heybendeki o ağır torbalarda ne var? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Öyle ya kurban olduğum... Dağda birkaç haramiye rast geldim de iki ayna bir parça kına hediye ettim, güle oynaya saldılar.\"", "Seçenek kapat: \"Neyse, içeri gir de han köşesinde otur.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Haramiler aynayla kınayla adam salmaz! Heybendeki o ağır torbalarda ne var? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_009_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Tamam, sakin ol, bağırma.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Kıvırma çerçi! Dağdaki haramiler seni bu köye niye saldı? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri döner, poşusunu çeker) Aman ağam! Yoksul bir çerçinin ekmeğiyle oynama, kurbanın olayım!\"", "Seçenek geri çekil: \"Tamam, sakin ol, bağırma.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Kıvırma çerçi! Dağdaki haramiler seni bu köye niye saldı? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_009_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek Meryem'in arkasından sen geldin... Şimdi geçmişini dökül.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Yere çöker, sesini kısar) Tamam ağam, aramızda kalsın... Çete beni yolladı. 'Kız içeri giremedi, var git köyün çeşmesini sen hallet' dediler. Beni zorladılar!\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek Meryem'in arkasından sen geldin... Şimdi geçmişini dökül.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_009_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Çıban değil o! Sancak beyinin celladı hangi suçtan kulak keser söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Sazlıkova pazarlarında yirmi yıldır çerçilik yaparım ağam. Kulağım küçüklükten çıbandan delindi de ayaz vurmasın diye poşu örterim.\"", "Test sorusu: \"Çıban değil o! Sancak beyinin celladı hangi suçtan kulak keser söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_009_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Cezanı çekmişsin, geçmişte kalmış. Doğruyu dersen sana acırım.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Kulağı kesik hırsız köyün suyuna zehir katmaya gelmiş! Kimsin sen Abbas? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_009_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Kulağını tutar, dili damağına yapışır) Ağam... Gençlik hatası işte... Pazar yerinde iki dirhem tuz aşırmıştım, cellat acımadı kesti.\"", "Seçenek empati: \"Cezanı çekmişsin, geçmişte kalmış. Doğruyu dersen sana acırım.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Kulağı kesik hırsız köyün suyuna zehir katmaya gelmiş! Kimsin sen Abbas? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_009_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kim olduğunu öğrendik Abbas. Şimdi şu çekmeceyi aç bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Başını eğer) Adım Çopur Abbas'tır. Çetenin kuryesiyim. Beni borçla bağladılar kendilerine. 'Bu işi bitirmezsen öbür kulağını da keseriz' dediler. Can havliyle geldim.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Kim olduğunu öğrendik Abbas. Şimdi şu çekmeceyi aç bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_009_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Gözleri parlar, katırın arkasına geçer) Evet, Çopur Abbas'ım ben! Bu köye su içirmeyeceğim! Çete bu gece kapıya dayanacak, hiçbirinizi sağ koymayacaklar!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_009_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Abbas. Niyetini açıkla!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR009_EngerekZehri], [Clue_CHR009_ZehirliKina] veya [Clue_Görsel_CHR009_KesikKulak] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Çekmecendeki engerek zehri [Clue_CHR009_EngerekZehri], kınanın içine gizlediğin zehir torbaları [Clue_CHR009_ZehirliKina] ve poşunun altındaki kesik kulak [Clue_Görsel_CHR009_KesikKulak]! Sen kuyuya zehir saçmaya gelen harami kuryesisin!\"", "NPC Replik: \"(Aynaları yere düşürür, dizlerinin bağı çözülür) Sen... sen cin misin nesin ağam!\"", "Seçenek: \"Yalan bitti Abbas. Niyetini açıkla!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_009_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_009_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Zehirci tertibin çöktü. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Zehir kesesini çıkarıp yere atar) Bu gece köyün ana su kuyusuna dökecektim bu engerek tozunu. Sabah herkes kıvranırken çete batı kapısından girecekti. Her şeyi anlattım, canımı bağışla!\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Zehirci tertibin çöktü. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_009_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_009_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Zehir şişesini eline alır, parmaklıklara savuracak gibi yapar) Alın o zaman! Bu zehir hepinizi kurutacak!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_009_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız yerdeki zehir kesesine bakar; kapı mandalı elde bekler. Karar menüsü açılır.", ""]}}

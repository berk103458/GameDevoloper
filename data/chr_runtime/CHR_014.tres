[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_014"
ad = "Çoban Bekir"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Güvenlik < 7"
secere_matrisi = {"Doğum_Yeri": "Çorakdere Yaylası", "Aile_Bağı": "Çoban babası yaylada ölmüş, iki küçük kardeşi dağda saklı", "Kırılma_Olayı": "Sancak zaptiyelerinin asker toplamak için kapısına dayanıp damızlık koçlarına el koymak istemesi."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Ağıl ve Ahır çevresinde koyun kırkma, sağım yapma, peynir basma ve çit onarma işi", "Gece_Döngüsü": "Ağıl köşesinde kaval çalıp koçların yemini ve tuzunu denetleme."}
persona_maskesi = "Dağda sürüsü kurttan ve kuraklıktan kırılmış, iki cılız tokluyla kalmış, karın tokluğuna çobanlık yapacak biçare bir dağlı."
gizlenen_gercek = "Sürüsünün en kıymetli damızlık merinos koçlarını vergi zaptiyelerinden kaçırması ve heybesinde yırtılmış levent celp fermanını saklaması."
gorsel_hata = "Çizmesinde dağ tozu süsü varken tırnak diplerinde sulak yayla kili kokusu ve omzunda koç zaptetmekten kalma taze boynuz çürüğü."
sir_baglantisi = "Kırılmış sürünün çobanı semiz damızlık koç zaptetmez; bu çürük ve sulak kil kaçırılan damızlık sürünün fiziki kanıtıdır."
sfx = "Kısık çıngırak tıkırtısı, koyun soluması, kaba keçe hışırtısı."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Boynundaki deriden kavukluk ve koç çıngırağı. Tıklandığında çıngırağın diline kurşun akıtılarak sesinin kısıldığı, gece sürüyü gizlice kaçırmak için susturulduğu fark edilir.", "uretilen_ipucu": &"Clue_CHR014_SusturulmusCingirak"}
obje_2 = {"aciklama": "Yedeğinde çektiği iki cins merinos koçu ve sırtındaki tepeleme yün bağı. Tıklandığında yünlerin içine gizlenmiş sancak memurunun yırtılmış levent yazım fermanı bulunur.", "uretilen_ipucu": &"Clue_CHR014_YirtikFerman"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR014_BoynuzCurugu"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; değneğine dayanır, koçların sırtını sıvazlar, toy bir köylü şivesiyle konuşur.", "Stressed": "Tansiyon 4-7; koçların yularını çeker, gözleri kaçışır, kavalını kuşağına sıkıştırır.", "Panic": "Tansiyon 8-10; değneğini önüne tutar, koçları arkasına çeker, asker lafı duyunca kaçmaya davranır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR014_SUSTURULMUSCINGIRAK_BASLIK": "Boynundaki deriden kavukluk ve koç çıngırağı", "CLUE_CHR014_SUSTURULMUSCINGIRAK_TANIM": "Boynundaki deriden kavukluk ve koç çıngırağı. Tıklandığında çıngırağın diline kurşun akıtılarak sesinin kısıldığı, gece sürüyü gizlice kaçırmak için susturulduğu fark edilir.", "CLUE_CHR014_YIRTIKFERMAN_BASLIK": "Yedeğinde çektiği iki cins merinos koçu ve sırtındaki tepeleme yün bağı", "CLUE_CHR014_YIRTIKFERMAN_TANIM": "Yedeğinde çektiği iki cins merinos koçu ve sırtındaki tepeleme yün bağı. Tıklandığında yünlerin içine gizlenmiş sancak memurunun yırtılmış levent yazım fermanı bulunur.", "CHR_014_DUGUM_00_REPLIK": "Selamın aleyküm bekçi gardaş. Dağda yayla kurudu, sürüden kalan iki baş damızlıkla yola düştüm. Ağılınızda yer, koyunlarınıza çoban gerekse hakkıyla güderim.", "CHR_014_DUGUM_00_SEC_1_METIN": "Yayla kuruduysa bu koçların yünü niye pırıl pırıl, semiz hayvanlarla hangi yoldan indin?", "CHR_014_DUGUM_00_SEC_2_METIN": "Çobanım dersin ama yaşın tam levent yazılacak çağda. Sancak kütüğünden kaçar gibi geldin?", "CHR_014_DUGUM_00_SEC_3_METIN": "Kurşunla susturulmuş çıngırak , yünlerin içindeki yırtık ferman ve omzundaki taze boynuz çürüğü ! Sen sürü kırımından değil, levent celbinden kaçan Bekir'sin!", "CHR_014_DUGUM_1_1_REPLIK": "Gözüm gibi baktım bu iki başa gardaşım. Koca sürüden bunlar kaldı elimde. Kayalıklardan aşırdım, çalı çırpı yedire yedire indirdim ovaya.", "CHR_014_DUGUM_1_1_SEC_1_METIN": "Helal olsun, iyi çoban malına iyi bakar.", "CHR_014_DUGUM_1_1_SEC_2_METIN": "Çalı yiyen koyun böyle yağ bağlamaz! Sen yaylanın göbeğinden kaçırmışsın bu sürüyü!", "CHR_014_DUGUM_1_2_REPLIK": "Öyledir gardaşım... Cins hayvandır bunlar, yayla havası iyi gelir. Köyünüzün ağılına bereket katar.", "CHR_014_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri gir de ağıla bak.", "CHR_014_DUGUM_1_2_SEC_2_METIN": "Çıngırağın dilini niye kurşunla tıkadın öyleyse, kimden saklandın?", "CHR_014_DUGUM_1_2_BASK__REPLIK": "(Yutkunur, koçun yularını sıkar) Gece kurttan sakındım gardaşım... Çıngırak sesine kurt uyanmasın diye tıkadım dilini.", "CHR_014_DUGUM_1_2_BASK__SEC_1_METIN": "Mantıklı, kurt tehlikelidir.", "CHR_014_DUGUM_1_2_BASK__SEC_2_METIN": "Kurt çıngırağa gelmez, zaptiye gelir! Sancak zaptiyelerinden mi kaçtın?", "CHR_014_DUGUM_1_3_REPLIK": "(Sesini kısar, başını eğer) Tamam gardaşım... Doğru bildin. Sancak sipahileri geldi yaylaya. 'Hem sürünü alırız hem seni levent yazarız' dediler. Babam öldü, geride kardeşlerim var. Koçları kaptığım gibi gece dağa vurdum.", "CHR_014_DUGUM_1_3_SEC_1_METIN": "Demek askerden ve vergiden kaçtın... Şimdi geçmişini anlat.", "CHR_014_DUGUM_2_1_REPLIK": "Çorakdere yaylasında doğdum. Koyunların arasında büyüdüm. Kırkım bilirim, sağım bilirim, peynir mayalarım. Cenk etmek benim harcım değil gardaşım.", "CHR_014_DUGUM_2_1_SEC_1_METIN": "Madem merinos güdersin, bu koçlar yılda kaç okka yapağı verir, tohumlama ne vakittir?", "CHR_014_DUGUM_2_2_REPLIK": "(Gözleri parlar) Her biri altı okka saf yapağı verir gardaşım! Güz ayında koç katımı yapılır, bahara ikiz kuzular dökülür ağıla.", "CHR_014_DUGUM_2_2_SEC_1_METIN": "Çobanlığı iyi bilirsin Bekir, toprağın insanısın. Korkma, doğrunun yanındayız.", "CHR_014_DUGUM_2_2_SEC_2_METIN": "Zaptiyeler ardına düşecek! Asker kaçağı mısın sen?", "CHR_014_DUGUM_2_3_REPLIK": "(Yüzü güler) Adım Bekir'dir. Ben kılıç tutamam gardaşım, kaval tutarım. Köyünüzün ağılına bakayım, sütünü peynirini artırayım. Beni o sipahilere vermeyin.", "CHR_014_DUGUM_2_3_SEC_1_METIN": "Bekir, hünerin köyümüze gerektir. Şimdi heybene bakalım.", "CHR_014_DUGUM_2_3_AGRESIF_REPLIK": "(Değneğini kaldırır, sesi yükselir) Evet, Bekir'im ben! Kardeşlerimi aç bırakıp beyin cengine gitmedim diye hain mi oldum? Bu iki damızlık köyünüzün sürüsünü iki katına çıkarır! Alacaksanız alın, yoksa dağda koyun güderim!", "CHR_014_DUGUM_3_1_REPLIK": "(Koçun boynuna sarılır, gözleri açılır) Nereden anladın gardaş...", "CHR_014_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Bekir. Niyetini söyle!", "CHR_014_DUGUM_3_2_REPLIK": "", "CHR_014_DUGUM_3_3_REPLIK": "(Koçların başını okşar) Bu iki koç sancaktaki en iyi damızlıktır gardaşım. Köyün koyunlarına katarsak seneye ağıllar kuzu dolar, yünüyle aba dokursunuz. Beni kışlaya sürmeyin, ağılınızda ömrümce hizmet edeyim.", "CHR_014_DUGUM_3_3_SEC_1_METIN": "Damızlıkların kıymetlidir Bekir. Şimdi senin hükmün verilecek.", "CHR_014_DUGUM_FINAL_RET_REPLIK": "(Koçları çevirir, ters ters bakar) Siz de asker kafalısınız! Alın başınıza çalın köyünüzü!", "CHR_014_DUGUM_FINAL_RET_SEC_1_METIN": "Çoban huysuzlandı.", "CHR_014_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız cins koçlara ve çobanın sağlam adımlarına bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_014_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Yayla kuruduysa bu koçların yünü niye pırıl pırıl, semiz hayvanlarla hangi yoldan indin?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_014_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Çobanım dersin ama yaşın tam levent yazılacak çağda. Sancak kütüğünden kaçar gibi geldin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_014_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR014_SusturulmusCingirak], [Clue_CHR014_YirtikFerman] veya [Clue_Görsel_CHR014_BoynuzCurugu] ipuçlarına dikkatle bakılır: Kurşunla susturulmuş çıngırak [Clue_CHR014_SusturulmusCingirak], yünlerin içindeki yırtık ferman [Clue_CHR014_YirtikFerman] ve omzundaki taze boynuz çürüğü [Clue_Görsel_CHR014_BoynuzCurugu]! Sen sürü kırımından değil, levent celbinden kaçan Bekir'sin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR014_SusturulmusCingirak", "Clue_CHR014_YirtikFerman", "Clue_Görsel_CHR014_BoynuzCurugu", "Clue_CHR014_SusturulmusCingirak", "Clue_CHR014_YirtikFerman", "Clue_Görsel_CHR014_BoynuzCurugu"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_014_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Selamın aleyküm bekçi gardaş. Dağda yayla kurudu, sürüden kalan iki baş damızlıkla yola düştüm. Ağılınızda yer, koyunlarınıza çoban gerekse hakkıyla güderim.\"", "Seçenek 1 (Dal 1 yol): \"Yayla kuruduysa bu koçların yünü niye pırıl pırıl, semiz hayvanlarla hangi yoldan indin?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Çobanım dersin ama yaşın tam levent yazılacak çağda. Sancak kütüğünden kaçar gibi geldin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt):
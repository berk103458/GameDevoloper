[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_022"
ad = "Bayram"
sinif = &"asker"
fraksiyon = &"Babasına bağlı"
en_erken_tur = 5
spawn_kosulu = "Tur > 4 ve Sağlık < 6"
secere_matrisi = {"Doğum_Yeri": "Hisaraltı, Davul Ocağı", "Aile_Bağı": "Babası Reşat hasta, eşi yok", "Kırılma_Olayı": "Nazile'nin ilaç parasını davuldan başka karşılayamaması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Tarla Damı'nda tarla işine vuruş temposu tutma", "Gece_Döngüsü": "Köy Meydanı'nda çocuklara alarm vuruşunu ezberletme."}
persona_maskesi = "Davulu yolda kırılmış, tempo tutmaya gelmiş yorgun bir ocak eri."
gizlenen_gercek = "Bölük davulunu babasının ilacı için satması, boş omuz kayışı ve kuşağındaki tokmak."
gorsel_hata = "Sol omzunda davul kayışının bıraktığı soluk çizgi ve kopuk toka deliği."
sir_baglantisi = "Bu çizgi ter lekesinden değildir; satılan davulun kayışı omuzdan düşünce kalan izdir."
sfx = "Tokmağın dize vuruşu, boş kayış şakırtısı, yorgun öksürük."
baslangic_tansiyonu = 1
obje_1 = {"aciklama": "Kuşağındaki davul tokmağı. Tıklandığında sapında Hisaraltı ocağının kertikleri durur, davulun kendisi yoktur.", "uretilen_ipucu": &"Clue_CHR022_Tokmak"}
obje_2 = {"aciklama": "Cebindeki kopuk pirinç halka ve üstüne sarılı ot bohçası. Tıklandığında halkada davul kasnağının izi, bohçada Nazile'nin ilaç artığı ve \"davul, baba ilacı\" diye kömür hesap çıkar.", "uretilen_ipucu": &"Clue_CHR022_DavulHalkasi"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR022_OmuzCizgi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; tokmağı dizine vurur, omzunu örter, alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; boş kayışı avuçlar, gözünü yoldan ayırmaz.", "Panic": "Tansiyon 8-10; omuz çizgisini saklar, diz çöker, davul emininin adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR022_TOKMAK_BASLIK": "Kuşağındaki davul tokmağı", "CLUE_CHR022_TOKMAK_TANIM": "Kuşağındaki davul tokmağı. Tıklandığında sapında Hisaraltı ocağının kertikleri durur, davulun kendisi yoktur.", "CLUE_CHR022_DAVULHALKASI_BASLIK": "Cebindeki kopuk pirinç halka ve üstüne sarılı ot bohçası", "CLUE_CHR022_DAVULHALKASI_TANIM": "Cebindeki kopuk pirinç halka ve üstüne sarılı ot bohçası. Tıklandığında halkada davul kasnağının izi, bohçada Nazile'nin ilaç artığı ve \"davul, baba ilacı\" diye kömür hesap çıkar.", "CHR_022_DUGUM_00_REPLIK": "Ayaklarım şişti bekçi. Elim boş ama vuruşum durur. Tarlada tempo tutarım, çocuklara alarm vuruşunu sayarım. Bir köşe verseniz işe dururum.", "CHR_022_DUGUM_00_SEC_1_METIN": "Davulcu ocakta durur. Sen niye tek başına bu kapıdasın?", "CHR_022_DUGUM_00_SEC_2_METIN": "Tokmak var, davul yok. Hangi kışladan koptun?", "CHR_022_DUGUM_00_SEC_3_METIN": "Kuşağındaki tokmak , cebindeki davul halkası ve omzundaki boş kayış çizgisi ! Sen tempo arayan değil, davul satmış kaçaksın!", "CHR_022_DUGUM_1_1_REPLIK": "Hisaraltı'da davul sustu bekçi. İş kalmadı. Boş duracağıma burada vuruş tutayım dedim.", "CHR_022_DUGUM_1_1_SEC_1_METIN": "Doğrudur, davul susunca adam yer arar.", "CHR_022_DUGUM_1_1_SEC_2_METIN": "Davul sustuysa cebindeki pirinç halka neyin nesi?", "CHR_022_DUGUM_1_2_REPLIK": "Eski bir halka işte. Yoldan kaldı. Köye yük olmayayım diye cebime attım.", "CHR_022_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_022_DUGUM_1_2_SEC_2_METIN": "Yoldan kalan halkada davul kasnağının izi var!", "CHR_022_DUGUM_1_2_BASK__REPLIK": "(Omzunu örter) Ne karıştırırsın bekçi? Omzum kayıştan aşındı. Davul satan adam güpegündüz kapıya çıkar mı?", "CHR_022_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_022_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Omzundaki boş çizgi duruyor, doğruyu söyle!", "CHR_022_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Sattım. Babam Reşat yatakta. Otacı Nazile ilaç dedi, param yoktu. Bölük davulunu verdim, halkayı cebime sakladım, geldim.", "CHR_022_DUGUM_1_3_SEC_1_METIN": "Demek davulu sattın... Şimdi geçmişini anlat.", "CHR_022_DUGUM_2_1_REPLIK": "Hisaraltı davul ocağındanım. Tempo, alarm, yürüyüş vuruşu bilirim. Tarlada da sayarım, meydana da.", "CHR_022_DUGUM_2_1_SEC_1_METIN": "Madem davulcusun, alarm vuruşu kaçtır, tarla temposu nasıl sayılır?", "CHR_022_DUGUM_2_2_REPLIK": "(Tokmağı ikiye böler gibi vurur) Alarm üç kısa bir uzun. Tarla temposu yavaş başlar, orak düşünce sıklaşır. Babam aklıma düşünce el şaşar ama sayım şaşmaz.", "CHR_022_DUGUM_2_2_SEC_1_METIN": "Babanın derdi insanın yakasını bırakmaz. İş bilen adama kapımız açık.", "CHR_022_DUGUM_2_2_SEC_2_METIN": "Davulu sattığını ağzınla söyledin. Emin arkandan gelir, adın ne?", "CHR_022_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Bayram. Hırsız değilim. O halka sattığım davulun parçası. Tarla Damı'nda tempo tutarım, çocuklara alarmı sayarım. Yeter ki Pertev Emin'e teslim etmeyin.", "CHR_022_DUGUM_2_3_SEC_1_METIN": "Bayram olduğunu bildik. Şimdi o halkaya bakalım.", "CHR_022_DUGUM_2_3_AGRESIF_REPLIK": "(Omzunu kapatır) Evet, Bayram'ım ben. Babam hasta diye davulu sattım. Omzumdaki çizgi ondan. Bu el bir tarlayı sayar. Geri çevirirseniz babam da ben de açıkta kalırız.", "CHR_022_DUGUM_3_1_REPLIK": "(Halkayı yere bırakır, omzunu açar) Görmüşsün bekçi. İnkar etmem.", "CHR_022_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Bayram. Şimdi niyetini söyle.", "CHR_022_DUGUM_3_2_REPLIK": "", "CHR_022_DUGUM_3_3_REPLIK": "(Ot bohçasını açar) Babam Reşat için sattım. Nazile'ye davul gitti, ilaç geldi. Tarla Damı'nda tempo tutarım, Meydan'da alarmı çocuklara sayarım. Beni içeri al. Pertev Emin gelirse sakla beni.", "CHR_022_DUGUM_3_3_SEC_1_METIN": "Vuruşun da derdin de belli Bayram. Şimdi hükmün verilecek.", "CHR_022_DUGUM_FINAL_RET_REPLIK": "(Tokmağı kuşağa sokar, omzunu saklar) Siz de o emin gibisiniz. Tarlanız şaşsın.", "CHR_022_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_022_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız boş omuz çizgisine ve davul halkasına bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_022_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Davulcu ocakta durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Tokmak var, davul yok. Hangi kışladan koptun?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR022_Tokmak], [Clue_CHR022_DavulHalkasi] veya [Clue_Görsel_CHR022_OmuzCizgi] ipuçlarına dikkatle bakılır: Kuşağındaki tokmak [Clue_CHR022_Tokmak], cebindeki davul halkası [Clue_CHR022_DavulHalkasi] ve omzundaki boş kayış çizgisi [Clue_Görsel_CHR022_OmuzCizgi]! Sen tempo arayan değil, davul satmış kaçaksın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR022_Tokmak", "Clue_CHR022_DavulHalkasi", "Clue_Görsel_CHR022_OmuzCizgi", "Clue_CHR022_Tokmak", "Clue_CHR022_DavulHalkasi", "Clue_Görsel_CHR022_OmuzCizgi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Ayaklarım şişti bekçi. Elim boş ama vuruşum durur. Tarlada tempo tutarım, çocuklara alarm vuruşunu sayarım. Bir köşe verseniz işe dururum.\"", "Seçenek 1 (Dal 1 yol): \"Davulcu ocakta durur. Sen niye tek başına bu kapıdasın?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Tokmak var, davul yok. Hangi kışladan koptun?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR022_Tokmak], [Clue_CHR022_DavulHalkasi] veya [Clue_Görsel_CHR022_OmuzCizgi] ipuçlarına dikkatle bakılır: Kuşağındaki tokmak [Clue_CHR022_Tokmak], cebindeki davul halkası [Clue_CHR022_DavulHalkasi] ve omzundaki boş kayış çizgisi [Clue_Görsel_CHR022_OmuzCizgi]! Sen tempo arayan değil, davul satmış kaçaksın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_022_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Doğrudur, davul susunca adam yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Davul sustuysa cebindeki pirinç halka neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Hisaraltı'da davul sustu bekçi. İş kalmadı. Boş duracağıma burada vuruş tutayım dedim.\"", "Seçenek inan: \"Doğrudur, davul susunca adam yer arar.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Davul sustuysa cebindeki pirinç halka neyin nesi?\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_022_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Yoldan kalan halkada davul kasnağının izi var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Eski bir halka işte. Yoldan kaldı. Köye yük olmayayım diye cebime attım.\"", "Seçenek kapat: \"Peki, içeri gir de bir işin ucundan tut.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Yoldan kalan halkada davul kasnağının izi var! (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_022_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Yalanın kısa. Omzundaki boş çizgi duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Omzunu örter) Ne karıştırırsın bekçi? Omzum kayıştan aşındı. Davul satan adam güpegündüz kapıya çıkar mı?\"", "Seçenek geri çekil: \"Öfkelenme, kapıda her yüke bakarız.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Yalanın kısa. Omzundaki boş çizgi duruyor, doğruyu söyle! (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_022_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek davulu sattın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Başını eğer) Tamam. Sattım. Babam Reşat yatakta. Otacı Nazile ilaç dedi, param yoktu. Bölük davulunu verdim, halkayı cebime sakladım, geldim.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek davulu sattın... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_022_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem davulcusun, alarm vuruşu kaçtır, tarla temposu nasıl sayılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Hisaraltı davul ocağındanım. Tempo, alarm, yürüyüş vuruşu bilirim. Tarlada da sayarım, meydana da.\"", "Test sorusu: \"Madem davulcusun, alarm vuruşu kaçtır, tarla temposu nasıl sayılır?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_022_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Babanın derdi insanın yakasını bırakmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Davulu sattığını ağzınla söyledin. Emin arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_022_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Tokmağı ikiye böler gibi vurur) Alarm üç kısa bir uzun. Tarla temposu yavaş başlar, orak düşünce sıklaşır. Babam aklıma düşünce el şaşar ama sayım şaşmaz.\"", "Seçenek empati: \"Babanın derdi insanın yakasını bırakmaz. İş bilen adama kapımız açık.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Davulu sattığını ağzınla söyledin. Emin arkandan gelir, adın ne? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_022_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Bayram olduğunu bildik. Şimdi o halkaya bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Yüzünü siler) Adım Bayram. Hırsız değilim. O halka sattığım davulun parçası. Tarla Damı'nda tempo tutarım, çocuklara alarmı sayarım. Yeter ki Pertev Emin'e teslim etmeyin.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Bayram olduğunu bildik. Şimdi o halkaya bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_022_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Omzunu kapatır) Evet, Bayram'ım ben. Babam hasta diye davulu sattım. Omzumdaki çizgi ondan. Bu el bir tarlayı sayar. Geri çevirirseniz babam da ben de açıkta kalırız.\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_022_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Yalan bitti Bayram. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR022_Tokmak], [Clue_CHR022_DavulHalkasi] veya [Clue_Görsel_CHR022_OmuzCizgi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Kuşağındaki tokmak [Clue_CHR022_Tokmak], cebindeki davul halkası [Clue_CHR022_DavulHalkasi] ve omzundaki boş kayış çizgisi [Clue_Görsel_CHR022_OmuzCizgi]! Sen bölük davulunu satan Bayram'sın!\"", "NPC Replik: \"(Halkayı yere bırakır, omzunu açar) Görmüşsün bekçi. İnkar etmem.\"", "Seçenek: \"Yalan bitti Bayram. Şimdi niyetini söyle.\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_022_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_022_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Vuruşun da derdin de belli Bayram. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Ot bohçasını açar) Babam Reşat için sattım. Nazile'ye davul gitti, ilaç geldi. Tarla Damı'nda tempo tutarım, Meydan'da alarmı çocuklara sayarım. Beni içeri al. Pertev Emin gelirse sakla beni.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Vuruşun da derdin de belli Bayram. Şimdi hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_022_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_022_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Tokmağı kuşağa sokar, omzunu saklar) Siz de o emin gibisiniz. Tarlanız şaşsın.\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"İnat etti, laf dinlemez.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_022_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız boş omuz çizgisine ve davul halkasına bakar; karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Erzak": 2, "Guvenlik": 1}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise Bayram Tarla Damı'nda tempo tutmaya ve Meydan'da alarm öğretmeye geçirilir; derhal Erzak +2 ve Güvenlik +1 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te davul emini Tarla Damı'na gelip temposu yarıda kesilir; Erzak -2 ve Moral -1 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Davulunu satan er kovulur, eminle kapı kavgası önlenir. Debuff: 3 tur boyunca Tarla Damı binasında tarla temposu tutma işi aksar; Erzak -2 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "İş bilen davulcu sebepsiz yere kovulur. Debuff: 4 tur boyunca Köy Meydanı binasında alarm vuruşu öğretme işi aksar; Güvenlik -2 ve Moral -1 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 1, "esyalar": ["1 tokmak"], "varyantlar": [], "kosullar": {}, "kaynak": "Bayram tokmağı ve kuşağındaki tek bakır akçeyi muhafıza verir (Kişisel Kazanç: 1 tokmak, 1 bakır akçe). İz: Tur 4'te Tarla Damı binasında tempo şaşar; Erzak -1 ve Moral -1 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 1, "Saglik": -1, "Moral": -2}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Bayram kışla zindanına atılır ve davul eminine haber salınır. İz: Tarla Damı'nda tempo boş kalır, babasının ilaç haberi kesilir. Güvenlik +1 kazanılırken Sağlık -1 ve Moral -2 kaybedilir."}}

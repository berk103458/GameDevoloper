sonraki_spawns = {"on_accept": {"entity_id": &"CHR_088", "offset": 3, "kaynak": "on accept: [CHR_088] - Tempo tutan Orhan, Bayram'ın tarla vuruşuna katılmak için gelen delikanlı, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_089", "offset": 2, "kaynak": "on reject: [CHR_089] - Davul emini Pertev, satılan bölük davulunu arayan kışla adamı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_090", "offset": 2, "kaynak": "on bribe: [CHR_090] - Otacı yamağı Nedim, muhafızın elindeki tokmağı ilaç hesabına saymak isteyen, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_091", "offset": 3, "kaynak": "on jail: [CHR_091] - Komşu kadın Gülsüm, zindandaki Bayram'ın hasta babası Reşat'a haber götüren, +3 tur sonra kapıyı çalar."}}

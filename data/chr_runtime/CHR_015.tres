[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_015"
ad = "Emine Hatun"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Sağlık < 6"
secere_matrisi = {"Doğum_Yeri": "Çakıllıvadi, Kayalıbent Köyü", "Aile_Bağı": "Kocasını dere taşkınında yitirmiş, iki kızı köyde akrabalarında saklı", "Kırılma_Olayı": "Ağanın su bendini kapatıp köylünün bostanlarını kurutması üzerine gece bent kapağını parçalaması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Su Kuyusu ve Bostan civarında taş ark örme, bent onarma, kuyu derinleştirme ve sebze fidesi dikme işi", "Gece_Döngüsü": "Su Kuyusu başında su debisini ölçme ve kuyu tabanındaki kireç birikintisini kazıma."}
persona_maskesi = "Boğaz tokluğuna kuyu başında kova çekecek, bostan belleyecek, kuru ekmeğe razı kimsesiz bir bostancı kadın."
gizlenen_gercek = "Ağanın bent kapağını kırdığı için aranan bir kanun kaçağı olması ve torbasında ağanın kırık bent mandalını saklaması."
gorsel_hata = "Kollarında dere kireci ve harç yanıkları ile sağ bileğinde bent kapağını kanırtırken demir manivelanın bıraktığı derin sıyrık izi."
sir_baglantisi = "Bu kireç tortusu ve manivela yarası basit bahçe çapasından olmaz; gece vakti su bendini parçalayan bir asinin fiziki kanıtıdır."
sfx = "Demir çapa şakırtısı, sepet gıcırtısı, tok ve kararlı nefes."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Belindeki kösele kemerde asılı demir ark çapası ve kurşun çekül. Tıklandığında çapada taze bent kireci ve parçalanmış su kapağı demirinin çapakları görülür.", "uretilen_ipucu": &"Clue_CHR015_BentCapasi"}
obje_2 = {"aciklama": "Sırtındaki sepet dolusu bostan fidesi ve çifte kuyu vanası. Tıklandığında fidelerin altından ağanın bent kapağından sökülmüş kırık tunç su mandalı çıkar.", "uretilen_ipucu": &"Clue_CHR015_KirikSuMandali"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR015_BentYarasi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; çapasını yere dayar, sakin ve kendinden emin konuşur.", "Stressed": "Tansiyon 4-7; çapanın sapını sıkar, gözleri kapı muhafızının elindeki kılıca kayar, çenesi kilitlenir.", "Panic": "Tansiyon 8-10; çapasını iki eliyle tutar, geri çekilir, su hırsızlarına pabuç bırakmayacağını haykırır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR015_BENTCAPASI_BASLIK": "Belindeki kösele kemerde asılı demir ark çapası ve kurşun çekül", "CLUE_CHR015_BENTCAPASI_TANIM": "Belindeki kösele kemerde asılı demir ark çapası ve kurşun çekül. Tıklandığında çapada taze bent kireci ve parçalanmış su kapağı demirinin çapakları görülür.", "CLUE_CHR015_KIRIKSUMANDALI_BASLIK": "Sırtındaki sepet dolusu bostan fidesi ve çifte kuyu vanası", "CLUE_CHR015_KIRIKSUMANDALI_TANIM": "Sırtındaki sepet dolusu bostan fidesi ve çifte kuyu vanası. Tıklandığında fidelerin altından ağanın bent kapağından sökülmüş kırık tunç su mandalı çıkar.", "CHR_015_DUGUM_00_REPLIK": "Günün hayrolsun nöbetçi. Çakıllıvadi'den yürüdüm geldim. Kuruyan toprağa su getirmeyi, arktan bostana bereket akıtmayı bilirim. Kazmam elimde, kuyu başınızda ter dökmeye hazırım.", "CHR_015_DUGUM_00_SEC_1_METIN": "Çakıllıvadi'den bu sınıra kadar sırtında bu koca su aletleriyle hangi yoldan vardın bacım?", "CHR_015_DUGUM_00_SEC_2_METIN": "Bostancıyım dersin lakin bileğindeki demir yarası bir cenk gazisi gibi taze. Kimin bendinden gelirsin?", "CHR_015_DUGUM_00_SEC_3_METIN": "Çapandaki bent kireci , sepetindeki kırık su mandalı ve kolundaki demir sıyrığı ! Sen ağanın bent kapağını parçalayan asi Emine Hatun'sun!", "CHR_015_DUGUM_1_1_REPLIK": "Dere yataklarından geldim nöbetçi. Suyun kuruduğu yerleri aradım. Nerede su biterse orada insan çaresiz kalır. Kendi bacaklarıma güvendim.", "CHR_015_DUGUM_1_1_SEC_1_METIN": "Doğrudur, su ustası dere yatağını iyi bilir.", "CHR_015_DUGUM_1_1_SEC_2_METIN": "Dere yatakları ağanın korumalarıyla doludur! Sırtında bu demirlerle yakalanmadan nasıl geçtin?", "CHR_015_DUGUM_1_2_REPLIK": "Öyledir... Kimseye görünmeden gece yürüdüm. Benim kavgam insanla değil, kuraklıkladır.", "CHR_015_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri gir de kuyuya bak.", "CHR_015_DUGUM_1_2_SEC_2_METIN": "Sepetinde sakladığın tunç mandal neyin nesidir peki?", "CHR_015_DUGUM_1_2_BASK__REPLIK": "(Kaşları çatılır, çapasını sıkar) Neyi kurcalarsın nöbetçi? Ekmeğimin peşindeyim, haram mal taşımam ben!", "CHR_015_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme bacım, kapının kanunudur.", "CHR_015_DUGUM_1_2_BASK__SEC_2_METIN": "Kime kafa tuttun da kaçtın Çakıllıvadi'den? Açık konuş!", "CHR_015_DUGUM_1_3_REPLIK": "(Gözleri parlar, sesini yükseltir) Ağa köyün ortak suyunu kesti! Çocuklar susuzluktan kırılırken suyunu kendi bahçesine akıttı. Gece gittim, bent kapağını parçaladım, suyu vadiye saldım. Kaçtım işte, pişman da değilim!", "CHR_015_DUGUM_1_3_SEC_1_METIN": "Demek haksızlığa karşı bent yıktın... Şimdi geçmişini anlat.", "CHR_015_DUGUM_2_1_REPLIK": "Çakıllıvadi'de yirmi yıldır su arkı kazarım, kuyu açarım. Suyun damarını toprağın altından duyarım. Kocamı taşkında kaybettim ama suya küsmedim.", "CHR_015_DUGUM_2_1_SEC_1_METIN": "Madem su ustasısın, kuruyan kuyu nasıl canlandırılır, taş bent hangi harçla tutar?", "CHR_015_DUGUM_2_2_REPLIK": "(Yüzü aydınlanır) Kuyu tabanına killi kum basarsın, damar temizlenir. Bende de kireçle yumurta akı katılmış taş harcı vurursun ki su basınca yarıp geçmesin.", "CHR_015_DUGUM_2_2_SEC_1_METIN": "Büyük bir zanaatin var Emine Hatun, su getiren el baş üstünde tutulur.", "CHR_015_DUGUM_2_2_SEC_2_METIN": "Ağanın zaptiyeleri bendi yıkanı arar! Asi misin sen?", "CHR_015_DUGUM_2_3_REPLIK": "(Vakur bir duruşla bakar) Adım Emine'dir. Ben asi değilim, köylünün suyunu kurtaran bir anayım. Köyünüzün kuyularını derinleştireyim, bostanlarına su çekeyim. Beni o zalim ağaya teslim etmeyin.", "CHR_015_DUGUM_2_3_SEC_1_METIN": "Emine Hatun, hünerin köyümüzün canıdır. Şimdi sepetine bakalım.", "CHR_015_DUGUM_2_3_AGRESIF_REPLIK": "(Çapasını yere vurur, sesi çınlar) Evet, Bostancı Emine'yim ben! Çocukların suyunu çalan ağaya boyun eğmedim! Kapıyı açarsanız bu köyün çeşmelerinden gürül gürül su akar, açmazsanız dağdaki kuraklıkta kuyu kazarım gene boyun eğmem!", "CHR_015_DUGUM_3_1_REPLIK": "(Gözlerini diker, çapasını indirir) Doğru dersin nöbetçi. Gözünden kaçmamış.", "CHR_015_DUGUM_3_1_SEC_1_METIN": "Niyetini açıkça söyle Emine Hatun!", "CHR_015_DUGUM_3_2_REPLIK": "", "CHR_015_DUGUM_3_3_REPLIK": "(Sepetindeki fideleri ve su vanalarını gösterir) Köyünüzün kuyuları sığ, suyu acıymış, bilirim. Yanımda kuyu derinleştirme araçlarım ve sulak bostan fidelerim var. Kuyu başınıza taş bent öreyim, bostanları yeşerteyim. Yeter ki beni o zalim ağanın zaptiyelerine vermeyin.", "CHR_015_DUGUM_3_3_SEC_1_METIN": "Hünerin köyümüzün kuraklığına derman olur. Şimdi senin hükmün verilecek.", "CHR_015_DUGUM_FINAL_RET_REPLIK": "(Çapasını omzuna atar, gururla diklenir) Siz de o su hırsızı ağa gibisiniz! Gider dağda kuyu kazarım gene size yalvarmam!", "CHR_015_DUGUM_FINAL_RET_SEC_1_METIN": "Kadın gururundan dönmez.", "CHR_015_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız kadının su vanalarına ve kararlı gözlerine bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_015_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Çakıllıvadi'den bu sınıra kadar sırtında bu koca su aletleriyle hangi yoldan vardın bacım?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_015_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Bostancıyım dersin lakin bileğindeki demir yarası bir cenk gazisi gibi taze. Kimin bendinden gelirsin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_015_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR015_BentCapasi], [Clue_CHR015_KirikSuMandali] veya [Clue_Görsel_CHR015_BentYarasi] ipuçlarına dikkatle bakılır: Çapandaki bent kireci [Clue_CHR015_BentCapasi], sepetindeki kırık su mandalı [Clue_CHR015_KirikSuMandali] ve kolundaki demir sıyrığı [Clue_Görsel_CHR015_BentYarasi]! Sen ağanın bent kapağını parçalayan asi Emine Hatun'sun!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR015_BentCapasi", "Clue_CHR015_KirikSuMandali", "Clue_Görsel_CHR015_BentYarasi", "Clue_CHR015_BentCapasi", "Clue_CHR015_KirikSuMandali", "Clue_Görsel_CHR015_BentYarasi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_015_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Günün hayrolsun nöbetçi. Çakıllıvadi'den yürüdüm geldim. Kuruyan toprağa su getirmeyi, arktan bostana bereket akıtmayı bilirim. Kazmam elimde, kuyu başınızda ter dökmeye hazırım.\"", "Seçenek 1 (Dal 1 yol): \"Çakıllıvadi'den bu sınıra kadar sırtında bu koca su aletleriyle hangi yoldan vardın bacım?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Bostancıyım dersin lakin bileğindeki demir yarası bir cenk gazisi gibi taze. Kimin bendinden gelirsin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[C
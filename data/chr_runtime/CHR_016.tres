[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_016"
ad = "Halil"
sinif = &"ciftci"
fraksiyon = &"Bağımsız Köylüler"
en_erken_tur = 3
spawn_kosulu = "Tur > 2 ve Refah < 6"
secere_matrisi = {"Doğum_Yeri": "Koruklu, Aşağı Bağ", "Aile_Bağı": "Dul anası Koruklu'da kalmış, eşi yok", "Kırılma_Olayı": "Geçen güz eşek borcunun faizinin binmesi ve Eşref Ağa'nın çubuk hakkını da borca sayması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Bağ Evi'nde kuru çubuk ayıklama, göz budama ve aşı bağlama", "Gece_Döngüsü": "Bağ Evi sundurmasında çubuk demetinin üstüne yatıp sabah kırağısına karşı örtme."}
persona_maskesi = "Bağı kurumuş bir köyden inmiş, boğaz tokluğuna asma budayacak yorgun bir rençber."
gizlenen_gercek = "Eşref Ağa'ya ödenmemiş eşek borcu, kuşağındaki borç değneği ve sırtında ağanın mühür ipiyle bağlı aşı çubukları."
gorsel_hata = "Sol bileğinde taze ip yanığı ve gömlek yeninde kopmuş kenevir lifleri."
sir_baglantisi = "Bu iz budama çizığı değildir; borç için bileği bağlanıp gece ipi çözerek kaçtığının izidir."
sfx = "Çubuk demetinin hışırtısı, kör bıçağın kına sürtmesi, yorgun öksürük."
baslangic_tansiyonu = 2
obje_1 = {"aciklama": "Kuşağındaki kertikli borç değneği. Tıklandığında kertiklerin yanında Eşref Ağa'nın kömürle çizdiği eşek damgası ve ödenmemiş akçe hesabı görünür.", "uretilen_ipucu": &"Clue_CHR016_BorcDegnegi"}
obje_2 = {"aciklama": "Sırtındaki hasır çubuk demeti. Tıklandığında kuru bağ çırpısının altında, ağanın mühür ipiyle bağlı taze aşı kalemleri çıkar.", "uretilen_ipucu": &"Clue_CHR016_BagCubugu"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR016_IpYanigi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; demeti yere koyar, bileğini ovar, yorgun ve alçak sesle konuşur.", "Stressed": "Tansiyon 4-7; borç değneğini avuçlar, gözünü yoldan ayırmaz.", "Panic": "Tansiyon 8-10; bileğindeki izi saklar, diz çöker, Eşref Ağa'nın adını duyunca yalvarır."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR016_BORCDEGNEGI_BASLIK": "Kuşağındaki kertikli borç değneği", "CLUE_CHR016_BORCDEGNEGI_TANIM": "Kuşağındaki kertikli borç değneği. Tıklandığında kertiklerin yanında Eşref Ağa'nın kömürle çizdiği eşek damgası ve ödenmemiş akçe hesabı görünür.", "CLUE_CHR016_BAGCUBUGU_BASLIK": "Sırtındaki hasır çubuk demeti", "CLUE_CHR016_BAGCUBUGU_TANIM": "Sırtındaki hasır çubuk demeti. Tıklandığında kuru bağ çırpısının altında, ağanın mühür ipiyle bağlı taze aşı kalemleri çıkar.", "CHR_016_DUGUM_00_REPLIK": "Yol uzun geldi bekçi. Dizlerim tutmuyor. Bağ budağım ben, kuru asmayı diriltirim. Bir köşe verseniz budamaya dururum.", "CHR_016_DUGUM_00_SEC_1_METIN": "Bağ zamanı köyünü bırakıp bu kapıya niye tek başına geldin?", "CHR_016_DUGUM_00_SEC_2_METIN": "Elin bıçak tutmuş ama halin kaçak gibi. Hangi bağdan kopup geldin?", "CHR_016_DUGUM_00_SEC_3_METIN": "Kuşağındaki borç değneği , demetteki mühürlü aşı çubuğu ve bileğindeki ip yanığı ! Sen iş arayan değil, borç kaçkınısın!", "CHR_016_DUGUM_1_1_REPLIK": "Koruklu'da bağ bitti bekçi. Üzüm az oldu, iş kalmadı. Boş duracağıma burada budama yapayım dedim.", "CHR_016_DUGUM_1_1_SEC_1_METIN": "Doğrudur, iş bitince budamacı yer arar.", "CHR_016_DUGUM_1_1_SEC_2_METIN": "İş bittiyse sırtındaki taze çubuk demeti neyin nesi?", "CHR_016_DUGUM_1_2_REPLIK": "Birkaç kalem çubuk işte. Kendi aşım. Köye yük olmayayım diye yanıma aldım.", "CHR_016_DUGUM_1_2_SEC_1_METIN": "Peki, içeri gir de bir işin ucundan tut.", "CHR_016_DUGUM_1_2_SEC_2_METIN": "Kendi aşın dediğin demet ağanın ipiyle bağlı!", "CHR_016_DUGUM_1_2_BASK__REPLIK": "(Demetin ipini sıkar) Ne karıştırırsın bekçi? Sırtımdaki kendi emeğim. Borçlu adam güpegündüz kapıya çıkar mı?", "CHR_016_DUGUM_1_2_BASK__SEC_1_METIN": "Öfkelenme, kapıda her yüke bakarız.", "CHR_016_DUGUM_1_2_BASK__SEC_2_METIN": "Yalanın kısa. Bileğindeki ip izi duruyor, doğruyu söyle!", "CHR_016_DUGUM_1_3_REPLIK": "(Başını eğer) Tamam. Borcum var. Eşref Ağa'ya eşek parası kaldı. Ödeyemeyince bileğimi bağladılar. Gece ipi çözdüm, kendi aşıladığım çubukları aldım, geldim.", "CHR_016_DUGUM_1_3_SEC_1_METIN": "Demek borçlusun... Şimdi geçmişini anlat.", "CHR_016_DUGUM_2_1_REPLIK": "Koruklu'danım. Bağdan başka iş bilmem. Budamayı, aşıyı, herek bağlamayı yaparım.", "CHR_016_DUGUM_2_1_SEC_1_METIN": "Madem budamacısın, asma hangi ay budanır, hangi göz bırakılır?", "CHR_016_DUGUM_2_2_REPLIK": "(Eli rahatlar) Şubat sonu, göz uyanmadan. Üst göze dokunma, kuru çubuğu dipten kes. Aşı kalemini özsu yürümeden bağlarsın. Borç düşünce takvim şaşar ama el şaşmaz.", "CHR_016_DUGUM_2_2_SEC_1_METIN": "Borç insanın yakasını bırakmaz. İş bilen adama kapımız açık.", "CHR_016_DUGUM_2_2_SEC_2_METIN": "Borcunu ağzınla söyledin. Eşref'in adamı arkandan gelir, adın ne?", "CHR_016_DUGUM_2_3_REPLIK": "(Yüzünü siler) Adım Halil. Hırsız değilim. O çubuklar benim aşım. Bağ Evi'nde budarım, kuru asmayı düzeltirim. Yeter ki Eşref Ağa'nın adamına teslim etmeyin.", "CHR_016_DUGUM_2_3_SEC_1_METIN": "Halil olduğunu bildik. Şimdi o demete bakalım.", "CHR_016_DUGUM_2_3_AGRESIF_REPLIK": "(Demeti göğsüne çeker) Evet, Halil'im ben. Eşek borcu için bileğimi bağladılar. Kendi emeğim olan çubuğu bırakıp gideyim mi? Bu el bir bağı diriltir. Geri çevirirseniz dağda aç kalırım.", "CHR_016_DUGUM_3_1_REPLIK": "(Demeti yere bırakır) Görmüşsün bekçi. İnkar etmem.", "CHR_016_DUGUM_3_1_SEC_1_METIN": "Yalan bitti Halil. Şimdi niyetini söyle.", "CHR_016_DUGUM_3_2_REPLIK": "", "CHR_016_DUGUM_3_3_REPLIK": "(Demetin ağzını açar, taze kalemleri gösterir) Şu çubuklara bak. Sağlam aşı. Bağ Evi'nde budamamı yaparsam asma tutar, üzüm olur. Beni içeri al. Eşref'in adamı gelirse sakla beni.", "CHR_016_DUGUM_3_3_SEC_1_METIN": "Çubuğun da elin de işe yarar Halil. Şimdi hükmün verilecek.", "CHR_016_DUGUM_FINAL_RET_REPLIK": "(Demeti sırtlar, yüzü kararır) Siz de Eşref Ağa gibisiniz. Bağınız kurusun.", "CHR_016_DUGUM_FINAL_RET_SEC_1_METIN": "İnat etti, laf dinlemez.", "CHR_016_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız çubuk demetine ve bilekteki ip yanığına bakar; karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_016_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Bağ zamanı köyünü bırakıp bu kapıya niye tek başına geldin?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_016_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Elin bıçak tutmuş ama halin kaçak gibi. Hangi bağdan kopup geldin?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_016_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR016_BorcDegnegi], [Clue_CHR016_BagCubugu] veya [Clue_Görsel_CHR016_IpYanigi] ipuçlarına dikkatle bakılır: Kuşağındaki borç değneği [Clue_CHR016_BorcDegnegi], demetteki mühürlü aşı çubuğu [Clue_CHR016_BagCubugu] ve bileğindeki ip yanığı [Clue_Görsel_CHR016_IpYanigi]! Sen iş arayan değil, borç kaçkınısın!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR016_BorcDegnegi", "Clue_CHR016_BagCubugu", "Clue_Görsel_CHR016_IpYanigi", "Clue_CHR016_BorcDegnegi", "Clue_CHR016_BagCubugu", "Clue_Görsel_CHR016_IpYanigi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_016_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Yol uzun geldi bekçi. Dizlerim tutmuyor. Bağ budağım ben, kuru asmayı diriltirim. Bir köşe verseniz budamaya dururum.\"", "Seçenek 1 (Dal 1 yol): \"Bağ zamanı köyünü bırakıp bu kapıya niye tek başına geldin?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Elin bıçak tutmuş ama halin kaçak gibi. Hangi bağdan kopup geldin?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR016_BorcDegnegi], [Clue_CHR016_BagCubugu] veya [Clue_Görsel_CHR016_IpYanigi] ipuçlarına dikkatle bakılır: Kuşağındaki borç değneği [Clue_CHR016_BorcDegnegi], demetteki mühürlü aşı çubuğu [Clue_CHR016_BagCubugu] ve bileğindeki ip y
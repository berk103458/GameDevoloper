sonraki_spawns = {"on_accept": {"entity_id": &"CHR_064", "offset": 3, "kaynak": "on accept: [CHR_064] - Bağcı çırağı Kemal, Halil'in budama işine yardım etmek için gelen genç, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_065", "offset": 2, "kaynak": "on reject: [CHR_065] - Alacaklı kâhya Sabri, Eşref Ağa'nın eşek borcunu arayan adamı, +2 tur sonra kapıda biter."}, "on_bribe": {"entity_id": &"CHR_066", "offset": 2, "kaynak": "on bribe: [CHR_066] - Çubukçu Arif, muhafızın elindeki aşı kalemlerini bağa vurmak isteyen işgüzar, +2 tur sonra belirir."}, "on_jail": {"entity_id": &"CHR_067", "offset": 3, "kaynak": "on jail: [CHR_067] - Borç yazıcısı Niyazi, Halil'in çetelesini ve çubuğunu teslim almaya gelen kâtip, +3 tur sonra kapıyı çalar."}}

sonraki_spawns = {"on_accept": {"entity_id": &"CHR_028", "offset": 3, "kaynak": "on accept: [CHR_028] - Kâtip Behçet, Şemsettin'in yolsuzluğunu teyit eden sancak müfettişi, +3 tur sonra gelir."}, "on_reject": {"entity_id": &"CHR_029", "offset": 3, "kaynak": "on reject: [CHR_029] - Sipahi Müfreze Başı Rüstem, Şemsettin'in şikayeti üzerine köyü sorgulamaya gelen zırhlı sipahi, +3 tur sonra kapıya dayanır."}, "on_bribe": {"entity_id": &"CHR_030", "offset": 2, "kaynak": "on bribe: [CHR_030] - Sarraf Mıgırdiç, Şemsettin'in rüşvet altınlarını bozdurmak isteyen tefeci, +2 tur sonra kapıda biter."}}

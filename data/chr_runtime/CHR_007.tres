[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_007"
ad = "Kadı Naibi Şemsettin"
sinif = &"asker"
fraksiyon = &"Sancak Beyliği Divanı"
en_erken_tur = 6
spawn_kosulu = "Tur > 5 ve Güvenlik > 4"
secere_matrisi = {"Doğum_Yeri": "Taşlık Hisar Şehir Merkezi", "Aile_Bağı": "Beyin divan katibinin kayınbiraderi", "Kırılma_Olayı": "Sancak hazinesindeki açığı kapatmak için taşra köylerine teftişe çıkarılması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Köy Meydanı ve Muhafız Kışlası'nda teftiş kurma, ambar defterlerini inceleme ve tutsakları sorgulama işi", "Gece_Döngüsü": "Muhafız Kışlası divanhanesinde oturup köyün gelir kayıtlarını kurcalama ve haraç hesabı çıkarma."}
persona_maskesi = "Adalet dağıtan, kanun ve nizamı koruyan, sancak beyinin fermanını taşıyan dürüst ve vakar sahibi bir divan memuru."
gizlenen_gercek = "Köydeki zenginlerden rüşvet toplamak, tutsak haramileri altın karşılığı serbest bırakmak ve köyün erzak ambarına beylik vergisi adı altında el koymak."
gorsel_hata = "Kaftanının geniş yen astarında gizli para kesesi cepleri ve parmaklarındaki yüzük diplerinde taze kırmızı mühür mumu lekesi."
sir_baglantisi = "Resmi tahrir katibi teftiş yolunda gizli para cepleri taşımaz; bu cepler ve sahte mühür mumu rüşvet çarkının açık kanıtıdır."
sfx = "Katır nalı tıkırtısı, meşin sandık gıcırtısı, tok öksürük."
baslangic_tansiyonu = 2
zar = "d12"
sorgu_degeri = 4
obje_1 = {"aciklama": "Boynunda asılı meşin mühür mahfazası. Tıklandığında kutunun içinde resmi sancak mührünün yanı sıra sahte mühür yüzükleri ve kazınmış tahrir damgaları bulunur.", "uretilen_ipucu": &"Clue_CHR007_SahteDamga"}
obje_2 = {"aciklama": "Katırının sırtındaki çift kilitli divan sandığı. Tıklandığında kanun tomarının altında rehin tutulmuş altın küpeler ve rüşvet çetele defteri ele geçer.", "uretilen_ipucu": &"Clue_CHR007_RusvetDefteri"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR007_BalmumuLekesi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; sarığını düzeltir, katırının başını tutar, buyurgan bir dille konuşur.", "Stressed": "Tansiyon 4-7; kaşlarını çatar, parmağındaki fermanı sallar, muhafızı azarlar.", "Panic": "Tansiyon 8-10; yüzü kızarır, bağırmaya başlar, cellat ve sürgün fermanlarıyla tehdit savurur."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR007_SAHTEDAMGA_BASLIK": "Boynunda asılı meşin mühür mahfazası", "CLUE_CHR007_SAHTEDAMGA_TANIM": "Boynunda asılı meşin mühür mahfazası. Tıklandığında kutunun içinde resmi sancak mührünün yanı sıra sahte mühür yüzükleri ve kazınmış tahrir damgaları bulunur.", "CLUE_CHR007_RUSVETDEFTERI_BASLIK": "Katırının sırtındaki çift kilitli divan sandığı", "CLUE_CHR007_RUSVETDEFTERI_TANIM": "Katırının sırtındaki çift kilitli divan sandığı. Tıklandığında kanun tomarının altında rehin tutulmuş altın küpeler ve rüşvet çetele defteri ele geçer.", "CHR_007_DUGUM_00_REPLIK": "Açın kapıyı! Sancak Divanı'ndan Kadı Naibi Şemsettin Efendi derler bana. Beyimizin fermanıyla köyünüzün tahririni ve zindanını teftişe geldim. Yolumu kesmeye cüret etmeyin!", "CHR_007_DUGUM_00_SEC_1_METIN": "Sancak yolu haydut kaynarken maiyetsiz, tek bir katırla bu sınıra nasıl vardınız efendi?", "CHR_007_DUGUM_00_SEC_2_METIN": "Kadı naibiyim dersiniz lakin divanınızın mührünü hangi sancak beyi onayladı?", "CHR_007_DUGUM_00_SEC_3_METIN": "Mahfazandaki sahte damgalar , sandığındaki rüşvet defteri ve yenindeki gizli para cepleri ! Sen kadı naibi değil, harami ortağı bir rüşvetçisin!", "CHR_007_DUGUM_1_1_REPLIK": "Ben devletin adamıyım muhafız! Dağdaki harami bile sancak fermanını görünce önümde diz çöker. Beni sıradan köylüyle bir mi tutarsın?", "CHR_007_DUGUM_1_1_SEC_1_METIN": "Devletin heybeti büyüktür efendi, haklısınız.", "CHR_007_DUGUM_1_1_SEC_2_METIN": "Fermana dağdaki harami diz çökmez! Haramiyle anlaşmayan memur o boğazdan sağ çıkamaz!", "CHR_007_DUGUM_1_2_REPLIK": "Elbette öyledir. Şimdi lafı uzatma da kışlanın kapısını aç. Zindandaki tutsakları sayacağım.", "CHR_007_DUGUM_1_2_SEC_1_METIN": "Pekala, içeri buyrun.", "CHR_007_DUGUM_1_2_SEC_2_METIN": "Zindandaki tutsakları neden muhafızsız, yalnız saymak istersiniz?", "CHR_007_DUGUM_1_2_BASK__REPLIK": "(Sarığını düzeltir, gözlerini diker) Sen kim oluyorsun da beylik katibini sorguya çekersin bre zındık!", "CHR_007_DUGUM_1_2_BASK__SEC_1_METIN": "Bağışlayın efendi, haddimi aştım.", "CHR_007_DUGUM_1_2_BASK__SEC_2_METIN": "Bağırma! Boğazda hangi çeteyle anlaştın, kimin canını satmaya geldin?", "CHR_007_DUGUM_1_3_REPLIK": "(Sesini alçaltır, parmaklıklara yaklaşır) Bak muhafız... Akıllı adamsın. Dağdakiler tutsak Hamza için bana iki kese altın vaat etti. Onu bana teslim edin, payınızı alın, bu iş kapansın.", "CHR_007_DUGUM_1_3_SEC_1_METIN": "Demek rüşvet pazarlığına geldin... Şimdi geçmişini anlat.", "CHR_007_DUGUM_2_1_REPLIK": "Ben Taşlık Hisar Divanı'nda on beş yıl kadı vekilliği yaptım. Kanunnameyi ezbere bilirim. Benim geçmişimi sorgulamak senin haddin değildir.", "CHR_007_DUGUM_2_1_SEC_1_METIN": "Madem kanun bilirsiniz, kaçak leventlerin diyeti hangi fasılda yazar, köyün zahire hakkı nedir?", "CHR_007_DUGUM_2_2_REPLIK": "(Duraksar, kaşlarını oynatır) Zahire hakkı... beye aittir! Kanunname benim cebimdedir muhafız, ahkam kesme!", "CHR_007_DUGUM_2_2_SEC_1_METIN": "Zor zamanlar efendi, sancak da dardadır bilirim. Doğruyu derseniz anlaşırız.", "CHR_007_DUGUM_2_2_SEC_2_METIN": "Altın için tutsak kaçırmaya geldiğini itiraf ettin! Sancaktan kovulmuş bir sahtekarsın sen!", "CHR_007_DUGUM_2_3_REPLIK": "(Omuzlarını düşürür, içini çeker) Doğrudur... Sancak hazinesinde açık çıktı, suçu üzerime yıktılar. Borcumu kapatmazsam kellem gidecek. Bana o tutsağı verin, borcumu ödeyeyim.", "CHR_007_DUGUM_2_3_SEC_1_METIN": "Derdi anlaşıldı naip efendi. Şimdi sandığına bakalım.", "CHR_007_DUGUM_2_3_AGRESIF_REPLIK": "(Kızarır, cübbesini silkeler) Ben divan memuruyum! Sancak beyinin fermanı bendedir! Beni içeri almazsanız yarın bir alay süvariyle gelip bu köyü haritadan silerim!", "CHR_007_DUGUM_3_1_REPLIK": "(Yüzü kireç gibi bembeyaz olur, sandığın kilidine sarılır) Nereden açtın o sandığı sen!", "CHR_007_DUGUM_3_1_SEC_1_METIN": "Mesele sandık değil efendi, asıl niyetini anlat!", "CHR_007_DUGUM_3_2_REPLIK": "", "CHR_007_DUGUM_3_3_REPLIK": "(Ses tonu yumuşar, fısıldar) Tamam muhafız ağa... Görüyorsun işte, dünya hali. Köyünüzün ambarından pay istemem. Tutsakları da size bırakırım. Yeter ki beni içeri alın, bir gece dinleneyim, yoluma gideyim. Sandıktaki altınlardan da payın ayrılır.", "CHR_007_DUGUM_3_3_SEC_1_METIN": "Rüşvet çarkın sökmedi efendi. Şimdi senin hükmün verilecek.", "CHR_007_DUGUM_FINAL_RET_REPLIK": "(Katırın yularını çeker, tükürür) Cahil köylüler! Sizi kadı divanında astırmazsam bana da Şemsettin demesinler!", "CHR_007_DUGUM_FINAL_RET_SEC_1_METIN": "Haddini bildirme vakti geldi.", "CHR_007_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız ferman ile adalet arasındaki çizgiyi çeker; kapı kolu elde bekler. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_007_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Sancak yolu haydut kaynarken maiyetsiz, tek bir katırla bu sınıra nasıl vardınız efendi?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Kadı naibiyim dersiniz lakin divanınızın mührünü hangi sancak beyi onayladı?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR007_SahteDamga], [Clue_CHR007_RusvetDefteri] veya [Clue_Görsel_CHR007_BalmumuLekesi] ipuçlarına dikkatle bakılır: Mahfazandaki sahte damgalar [Clue_CHR007_SahteDamga], sandığındaki rüşvet defteri [Clue_CHR007_RusvetDefteri] ve yenindeki gizli para cepleri [Clue_Görsel_CHR007_BalmumuLekesi]! Sen kadı naibi değil, harami ortağı bir rüşvetçisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR007_SahteDamga", "Clue_CHR007_RusvetDefteri", "Clue_Görsel_CHR007_BalmumuLekesi", "Clue_CHR007_SahteDamga", "Clue_CHR007_RusvetDefteri", "Clue_Görsel_CHR007_BalmumuLekesi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Açın kapıyı! Sancak Divanı'ndan Kadı Naibi Şemsettin Efendi derler bana. Beyimizin fermanıyla köyünüzün tahririni ve zindanını teftişe geldim. Yolumu kesmeye cüret etmeyin!\"", "Seçenek 1 (Dal 1 yol): \"Sancak yolu haydut kaynarken maiyetsiz, tek bir katırla bu sınıra nasıl vardınız efendi?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Kadı naibiyim dersiniz lakin divanınızın mührünü hangi sancak beyi onayladı?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR007_SahteDamga], [Clue_CHR007_RusvetDefteri] veya [Clue_Görsel_CHR007_BalmumuLekesi] ipuçlarına dikkatle bakılır: Mahfazandaki sahte damgalar [Clue_CHR007_SahteDamga], sandığındaki rüşvet defteri [Clue_CHR007_RusvetDefteri] ve yenindeki gizli para cepleri [Clue_Görsel_CHR007_BalmumuLekesi]! Sen kadı naibi değil, harami ortağı bir rüşvetçisin!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_007_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Devletin heybeti büyüktür efendi, haklısınız.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Fermana dağdaki harami diz çökmez! Haramiyle anlaşmayan memur o boğazdan sağ çıkamaz!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Ben devletin adamıyım muhafız! Dağdaki harami bile sancak fermanını görünce önümde diz çöker. Beni sıradan köylüyle bir mi tutarsın?\"", "Seçenek inan: \"Devletin heybeti büyüktür efendi, haklısınız.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Fermana dağdaki harami diz çökmez! Haramiyle anlaşmayan memur o boğazdan sağ çıkamaz!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_007_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Pekala, içeri buyrun.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Zindandaki tutsakları neden muhafızsız, yalnız saymak istersiniz? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Elbette öyledir. Şimdi lafı uzatma da kışlanın kapısını aç. Zindandaki tutsakları sayacağım.\"", "Seçenek kapat: \"Pekala, içeri buyrun.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Zindandaki tutsakları neden muhafızsız, yalnız saymak istersiniz? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_007_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Bağışlayın efendi, haddimi aştım.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Bağırma! Boğazda hangi çeteyle anlaştın, kimin canını satmaya geldin? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Sarığını düzeltir, gözlerini diker) Sen kim oluyorsun da beylik katibini sorguya çekersin bre zındık!\"", "Seçenek geri çekil: \"Bağışlayın efendi, haddimi aştım.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Bağırma! Boğazda hangi çeteyle anlaştın, kimin canını satmaya geldin? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_007_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Demek rüşvet pazarlığına geldin... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Sesini alçaltır, parmaklıklara yaklaşır) Bak muhafız... Akıllı adamsın. Dağdakiler tutsak Hamza için bana iki kese altın vaat etti. Onu bana teslim edin, payınızı alın, bu iş kapansın.\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Demek rüşvet pazarlığına geldin... Şimdi geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_007_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem kanun bilirsiniz, kaçak leventlerin diyeti hangi fasılda yazar, köyün zahire hakkı nedir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Ben Taşlık Hisar Divanı'nda on beş yıl kadı vekilliği yaptım. Kanunnameyi ezbere bilirim. Benim geçmişimi sorgulamak senin haddin değildir.\"", "Test sorusu: \"Madem kanun bilirsiniz, kaçak leventlerin diyeti hangi fasılda yazar, köyün zahire hakkı nedir?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_007_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Zor zamanlar efendi, sancak da dardadır bilirim. Doğruyu derseniz anlaşırız.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Altın için tutsak kaçırmaya geldiğini itiraf ettin! Sancaktan kovulmuş bir sahtekarsın sen! (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_007_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Duraksar, kaşlarını oynatır) Zahire hakkı... beye aittir! Kanunname benim cebimdedir muhafız, ahkam kesme!\"", "Seçenek empati: \"Zor zamanlar efendi, sancak da dardadır bilirim. Doğruyu derseniz anlaşırız.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Altın için tutsak kaçırmaya geldiğini itiraf ettin! Sancaktan kovulmuş bir sahtekarsın sen! (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_007_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Derdi anlaşıldı naip efendi. Şimdi sandığına bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Omuzlarını düşürür, içini çeker) Doğrudur... Sancak hazinesinde açık çıktı, suçu üzerime yıktılar. Borcumu kapatmazsam kellem gidecek. Bana o tutsağı verin, borcumu ödeyeyim.\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Derdi anlaşıldı naip efendi. Şimdi sandığına bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_007_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Kızarır, cübbesini silkeler) Ben divan memuruyum! Sancak beyinin fermanı bendedir! Beni içeri almazsanız yarın bir alay süvariyle gelip bu köyü haritadan silerim!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_007_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Mesele sandık değil efendi, asıl niyetini anlat!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR007_SahteDamga], [Clue_CHR007_RusvetDefteri] veya [Clue_Görsel_CHR007_BalmumuLekesi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Sandığındaki rüşvet defteri [Clue_CHR007_RusvetDefteri], kutundaki sahte damgalar [Clue_CHR007_SahteDamga] ve kaftanındaki gizli cepler [Clue_Görsel_CHR007_BalmumuLekesi]! Sen adalet memuru değil, rüşvetçi bir madrabazsan!\"", "NPC Replik: \"(Yüzü kireç gibi bembeyaz olur, sandığın kilidine sarılır) Nereden açtın o sandığı sen!\"", "Seçenek: \"Mesele sandık değil efendi, asıl niyetini anlat!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_007_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_007_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Rüşvet çarkın sökmedi efendi. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Ses tonu yumuşar, fısıldar) Tamam muhafız ağa... Görüyorsun işte, dünya hali. Köyünüzün ambarından pay istemem. Tutsakları da size bırakırım. Yeter ki beni içeri alın, bir gece dinleneyim, yoluma gideyim. Sandıktaki altınlardan da payın ayrılır.\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Rüşvet çarkın sökmedi efendi. Şimdi senin hükmün verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_007_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_007_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Katırın yularını çeker, tükürür) Cahil köylüler! Sizi kadı divanında astırmazsam bana da Şemsettin demesinler!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Haddini bildirme vakti geldi.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_007_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız ferman ile adalet arasındaki çizgiyi çeker; kapı kolu elde bekler. Karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Guvenlik": 2, "Refah": 2}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise sahte mühürlerine el konur, Şemsettin Köy Meydanı'nda kayıt tutma ve kâtiplik işine koşulur; Güvenlik +2 ve Refah +2 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 4'te Erzak Ambarı binasında ambar soyulur ve tutsaklar kaçar; Erzak -4 ve Güvenlik -3 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Rüşvetçi memur kovulur. Debuff: 3 tur boyunca Muhafız Kışlası nöbetçileri sancak tehdidine karşı teyakkuz tutar; Güvenlik +2 artarken yorgunluktan Moral -1 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Sancak memuru haksız yere kovulmuş sayılır. Debuff: 4 tur boyunca Köy Meydanı binasında divanda beylik korkusu hakim olur; Moral -3 ve Refah -1 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 8, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Şemsettin sandığından çıkardığı 8 altın sikkeyi muhafıza verir (Kişisel Kazanç: 8 altın sikke). Tur 4'te Muhafız Kışlası binasında zindandaki tutsak kaçar; Güvenlik -3 ve Moral -2 kaybedilir."}, "kisla": {"stat_etkisi": {"Guvenlik": 2, "Moral": -2}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Şemsettin kışla zindanına atılır. Memur tutsak edilmiştir; Güvenlik +2 kazanılır, sancak beyliği ile gerginlik sebebiyle Moral -2 kaybedilir."}}

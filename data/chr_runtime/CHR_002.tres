[gd_resource type="Resource" script_class="KarakterVerisi" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/veri/karakter_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
entity_id = &"CHR_002"
ad = "Elif kızı Meryem"
sinif = &"ciftci"
fraksiyon = &"Yok (kandırılmış masum köylü)"
en_erken_tur = 4
spawn_kosulu = "Tur > 3 ve Erzak < 5"
secere_matrisi = {"Doğum_Yeri": "Sazlıkova, Balçıkbükü Mezrası", "Aile_Bağı": "Üç küçük kardeşi mezrada açlıkla pençeleşir, babası değirmen bendi çökünce can vermiş, anasını humma almıştır", "Kırılma_Olayı": "Mezralarını vuran büyük çamur taşkınından sonra yolda rastladığı sahte dervişlerin kardeşlerine un ve yağ vadetmesiyle bu vazifeye inanması."}
koy_ici_davranis = {"Gündüz_Döngüsü": "Su Kuyusu ve Bostan civarında kuyu başındaki kadınlara yardım etme, kova çekme ve bostan çapalama işi", "Gece_Döngüsü": "Şifahane bahçesindeki su arkına gizlice sokulup torbasındaki tohumları suya daldırarak \"tohumları uyandırma\" duası okuma."}
persona_maskesi = "Sel felaketinden canını zor kurtarmış, bir lokma ekmek ve kuru samanlık karşılığında her türlü ağır ırgatlığa razı öksüz bir köy kızı."
gizlenen_gercek = "Kutsal bereket tohumu sandığı şeyin aslında içme suyuna karıştığında koyunları döken, içeni sayıklatıp kör eden ölümcül yabani kara banotu (deliceotu) tohumu olması."
gorsel_hata = "İki elinin ayasında ve bileklerinde su toplamış morumsu kabarcıklar, çatlaklar ve deliceotu özsuyunun bıraktığı asitli yanık lekeleri."
sir_baglantisi = "Bu deri döküntüleri tarladaki buğday veya çeltik samanından olmaz; yalnızca canlı deriyi yakıp zehirleyen yabani kara banotunun özsuyundan kaynaklanan fiziksel zehir kanıtıdır."
sfx = "Kenevir kumaşın hışırtısı, tohum tanelerinin birbirine sürtünme sesi, titrek iç çekişler."
baslangic_tansiyonu = 2
zar = "d6"
sorgu_degeri = 2
obje_1 = {"aciklama": "Boynundaki yıpranmış ham deri muska bağı. Tıklandığında kaba dikişlerin içinden dua yerine eşkıyanın kömür parçasıyla karaladığı \"suyu kurutana dek üç şafak daldır\" talimatı ve kaba bir kuyu krokisi çıkar.", "uretilen_ipucu": &"Clue_CHR002_SahteMuska"}
obje_2 = {"aciklama": "Kucağında iki eliyle sımsıkı sardığı kaba kenevir torba. Tıklandığında torbadan bayıltıcı, acı badem ve çürük lahana benzeri zehirli bir rayiha yayılır; içinde parıldayan siyah küçük tohumlar görülür.", "uretilen_ipucu": &"Clue_CHR002_KaraTohum"}
gorsel_hata_ipucu = &"Clue_Görsel_CHR002_BanotuYarasi"
poz_aciklamalari = {"Idle": "Tansiyon 0-3; iki büklüm durur, torbasını okşar, kapıdaki muhafıza yalvaran nemli gözlerle masumca bakar.", "Stressed": "Tansiyon 4-7; nefesi daralır, torbayı arkasına saklamaya çalışır, boynundaki muskaya sarılıp sessizce dua mırıldanır.", "Panic": "Tansiyon 8-10; feryat eder gibi sesini yükseltir, dizlerinin üzerine çöküp ağlar, yaklaşana torbayı vermemek için tırnaklarını geçirir."}
animasyon_anahtarlari = {"Idle": "Idle", "Stressed": "Stressed", "Panic": "Panic"}
sorgu_bayraklari = {"Flag_Yol_Sirri_Acik": false, "Flag_Kimlik_Cozuldu": false, "Flag_Sir_Tamamen_Cozuldu": false, "Flag_Kilitlendi": false}
metinler = {"CLUE_CHR002_SAHTEMUSKA_BASLIK": "Boynundaki yıpranmış ham deri muska bağı", "CLUE_CHR002_SAHTEMUSKA_TANIM": "Boynundaki yıpranmış ham deri muska bağı. Tıklandığında kaba dikişlerin içinden dua yerine eşkıyanın kömür parçasıyla karaladığı \"suyu kurutana dek üç şafak daldır\" talimatı ve kaba bir kuyu krokisi çıkar.", "CLUE_CHR002_KARATOHUM_BASLIK": "Kucağında iki eliyle sımsıkı sardığı kaba kenevir torba", "CLUE_CHR002_KARATOHUM_TANIM": "Kucağında iki eliyle sımsıkı sardığı kaba kenevir torba. Tıklandığında torbadan bayıltıcı, acı badem ve çürük lahana benzeri zehirli bir rayiha yayılır; içinde parıldayan siyah küçük tohumlar görülür.", "CHR_002_DUGUM_00_REPLIK": "Kurban olayım nöbetçi ağa, kapıyı yüzüme kapama. Sazlıkova'yı sel aldı, mezramız çamura battı. Ben kötü biri değilim; bostan bellerim, kuyudan kova çekerim, ahır süpürürüm, yeter ki başımı sokacak bir dam verin.", "CHR_002_DUGUM_00_SEC_1_METIN": "Sazlıkova sele gittiyse o dağ patikalarına tek başına nasıl vurdun, seni buraya kim yolladı?", "CHR_002_DUGUM_00_SEC_2_METIN": "Rençber kızıyım dersin lakin gözlerinde bir şey saklar gibi telaşlı bir ürperti var. Mezrada kimin kızıydın sen?", "CHR_002_DUGUM_00_SEC_3_METIN": "Kucağındaki torbadan acı badem kokusu tütüyor, bileklerin de yara içinde! Göster o torbayı!", "CHR_002_DUGUM_1_1_REPLIK": "Dağ yolunda ak sakallı, pir derviş babalara denk geldim ağam. Halime acıdılar. 'Şu tepeyi aşınca ulu bir köy vardır, suyu mübarektir, var git oraya sığın' dediler, elime de azık verdiler.", "CHR_002_DUGUM_1_1_SEC_1_METIN": "Dervişler düşkünün elinden tutar, iyi insanlara rast gelmişsin.", "CHR_002_DUGUM_1_1_SEC_2_METIN": "Bu dağ başında derviş ne arar be kızım! O dediğin adamlar yolu tutan harami çakallarıdır, seni kandırmışlar!", "CHR_002_DUGUM_1_2_REPLIK": "Bana çok merhametli davrandılar ağam... Sırtımı sıvazladılar, hayır duaları ettiler. Ben de onların sözüne bel bağlayıp koştum geldim.", "CHR_002_DUGUM_1_2_SEC_1_METIN": "Neyse, niyetin iyiymiş madem, içeri girince bakarız.", "CHR_002_DUGUM_1_2_SEC_2_METIN": "Sırtını sıvazlayan o adamlar sana sadece yol duası mı etti? Gözlerini kaçırma benden, başka ne tembihlediler?", "CHR_002_DUGUM_1_2_BASK__REPLIK": "(Gözleri dolar, titreyerek geriye çekilir) Günahımı alma ağam! Onlar hak aşığı dervişlerdi! 'Köyün suyuna bereket getireceksin' dediler, yalan mı söyleyecekti nur yüzlü pirler?", "CHR_002_DUGUM_1_2_BASK__SEC_1_METIN": "Ağlama hemen, seni suçlamıyorum; sadece hakikati anlamaya çalışıyorum.", "CHR_002_DUGUM_1_2_BASK__SEC_2_METIN": "Kuyuya ne bereketi getirecekmişsin? Açık konuş, o adamlar sana ne yapmanı söyledi?", "CHR_002_DUGUM_1_3_REPLIK": "(Hıçkırıklarını tutamayarak) Dediler ki... 'Bu torbadaki kutsal tohumları köyün ana su kuyusuna dökersen, kırk gün sonra tarlalardan altın başaklar fışkırır, köyde kimse aç kalmaz.' Ben sadece iyilik etmek istedim!", "CHR_002_DUGUM_1_3_SEC_1_METIN": "Kuyudan altın başak fışkırmaz saf kızım... Seni büyük bir belaya alet etmişler. Şimdi şu geçmişini anlat.", "CHR_002_DUGUM_2_1_REPLIK": "Biz Balçıkbükü'nde üç öksüz kardeştik ağam. Babam bendi tamir ederken balçıkta can verdi. Ben evin en büyüğüyüm, kardeşlerime ben analık ederim.", "CHR_002_DUGUM_2_1_SEC_1_METIN": "Madem rençbersin, kış çıkarken tarlaya ne ekilir, çeltik tavasına ne vakit su verilir söyle bakalım?", "CHR_002_DUGUM_2_2_REPLIK": "(Parmaklarını kıvırır, telaşlanır) Kış çıkarken... arpa atılır toprağa... Çeltik bataklıkta yatar ağam, ama bizim tarlamız yoktu ki, beyin ortakçısıydık biz...", "CHR_002_DUGUM_2_2_SEC_1_METIN": "Zor zanaat ortakçılık, bilirim. Çektiğin çileyi yüzünden okuyorum, korkma benden.", "CHR_002_DUGUM_2_2_SEC_2_METIN": "Bataklıkta ortakçılık yapan kız kuyuya dökmek için derviş torbasıyla yola çıkmaz! Seni kim gönderdi Meryem, o adamlar seni neyle tehdit etti?", "CHR_002_DUGUM_2_3_REPLIK": "(Gözyaşlarını fistanının yenine siler) Adım Meryem'dir ağam... Kardeşlerim açlıktan tahta gibi kurudu mezrada. O adamlar 'Bu dediklerimizi yaparsan kardeşlerine bir çuval un, bir küp kavurma yollarız' dediler. Çaresiz kaldım!", "CHR_002_DUGUM_2_3_SEC_1_METIN": "Çaresizlik insanı ateşe sürer Meryem. Lakin o taşıdığın şeyin aslı nedir, ona bakalım.", "CHR_002_DUGUM_2_3_AGRESIF_REPLIK": "(Feryat ederek ağlar) Evet, kardeşlerim ölmesin diye yaptım! Dağdaki o silahlı adamlar tuttu yakamdan! 'Kuyuya bu tohumları saçmazsan o bebeleri bataklıkta boğarız' dediler! Ben katil değilim ağam, canımı alın kardeşlerime kıymayın!", "CHR_002_DUGUM_3_1_REPLIK": "(Dehşetle bileklerindeki mor kabarcıklara bakar, nefesi düğümlenir) Z-zehir mi? Derimdeki bu yaralar... tohum yüzünden mi oldu? Bana mübarek dediler... Günahıma girdiler ağam!", "CHR_002_DUGUM_3_1_SEC_1_METIN": "Gözünü aç kızım, seni bir köy dolusu insanı zehirlemeye alet etmişler!", "CHR_002_DUGUM_3_2_REPLIK": "", "CHR_002_DUGUM_3_3_REPLIK": "(Torbayı dehşet içinde yere fırlatır, diz çöküp saçını başını yolar) Allahım sen affet! Bilmiyordum... Köyün çeşmesini, kuzuları kurutacaklarmış! O adamlar 'Biz arkadan geleceğiz, ahali sayıklamaya başlayınca köye çökeceğiz' diye gülüşüyorlardı. Ben ne yaptım!", "CHR_002_DUGUM_3_3_SEC_1_METIN": "Hakikati anladın ya, mühim olan bu. Şimdi kalk ayağa, hakkında hüküm verilecek.", "CHR_002_DUGUM_FINAL_RET_REPLIK": "(Korkudan aklını yitirecek gibi olur, torbayı kucağına basıp duvara yapışır, tiz bir çığlık atar) Yaklaşma bana! Hepiniz beni kandırıyorsunuz! Derviş baba beni korur! Dokunursan kendimi kayalıktan atarım, kimseye bir şey demem gayrı!", "CHR_002_DUGUM_FINAL_RET_SEC_1_METIN": "Korkudan aklı başından gitti, artık laf anlatılamaz.", "CHR_002_DUGUM_KARAR_MENUSU_REPLIK": "Muhafız genç kızın titreyen omuzlarına bakar; acıma ile köyün emniyeti arasında son kararını tartar. Karar menüsü açılır."}
diyalog_dugumleri = {"00": {"replik_anahtari": &"CHR_002_DUGUM_00_REPLIK", "secenekler": [{"hedef": "1.1", "tansiyon_delta": 0, "kaynak": "Seçenek 1 (Dal 1 yol): \"Sazlıkova sele gittiyse o dağ patikalarına tek başına nasıl vurdun, seni buraya kim yolladı?\" -> [Hedef: Düğüm 1.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_00_SEC_1_METIN"}, {"hedef": "2.1", "tansiyon_delta": 0, "kaynak": "Seçenek 2 (Dal 2 geçmiş): \"Rençber kızıyım dersin lakin gözlerinde bir şey saklar gibi telaşlı bir ürperti var. Mezrada kimin kızıydın sen?\" -> [Hedef: Düğüm 2.1]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_00_SEC_2_METIN"}, {"hedef": "3.1", "tansiyon_delta": 2, "kaynak": "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR002_SahteMuska], [Clue_CHR002_KaraTohum] veya [Clue_Görsel_CHR002_BanotuYarasi] ipuçlarına dikkatle bakılır: Kucağındaki torbadan acı badem kokusu tütüyor, bileklerin de yara içinde! Göster o torbayı!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "gerekli_ipuclari": ["Clue_CHR002_SahteMuska", "Clue_CHR002_KaraTohum", "Clue_Görsel_CHR002_BanotuYarasi"], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_00_SEC_3_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Kurban olayım nöbetçi ağa, kapıyı yüzüme kapama. Sazlıkova'yı sel aldı, mezramız çamura battı. Ben kötü biri değilim; bostan bellerim, kuyudan kova çekerim, ahır süpürürüm, yeter ki başımı sokacak bir dam verin.\"", "Seçenek 1 (Dal 1 yol): \"Sazlıkova sele gittiyse o dağ patikalarına tek başına nasıl vurdun, seni buraya kim yolladı?\" -> [Hedef: Düğüm 1.1]", "Seçenek 2 (Dal 2 geçmiş): \"Rençber kızıyım dersin lakin gözlerinde bir şey saklar gibi telaşlı bir ürperti var. Mezrada kimin kızıydın sen?\" -> [Hedef: Düğüm 2.1]", "Seçenek 3 (Dal 3 kanıt): \"[Clue_CHR002_SahteMuska], [Clue_CHR002_KaraTohum] veya [Clue_Görsel_CHR002_BanotuYarasi] ipuçlarına dikkatle bakılır: Kucağındaki torbadan acı badem kokusu tütüyor, bileklerin de yara içinde! Göster o torbayı!\" (Tansiyon +2) -> [Hedef: Düğüm 3.1]", "", "Dal 1:"]}, "1.1": {"replik_anahtari": &"CHR_002_DUGUM_1_1_REPLIK", "secenekler": [{"hedef": "1.2", "tansiyon_delta": -1, "kaynak": "Seçenek inan: \"Dervişler düşkünün elinden tutar, iyi insanlara rast gelmişsin.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_1_SEC_1_METIN"}, {"hedef": "1.2_Baskı", "tansiyon_delta": 2, "kaynak": "Seçenek yalanı çürüt: \"Bu dağ başında derviş ne arar be kızım! O dediğin adamlar yolu tutan harami çakallarıdır, seni kandırmışlar!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]", "beceri": "blof", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_1_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Dağ yolunda ak sakallı, pir derviş babalara denk geldim ağam. Halime acıdılar. 'Şu tepeyi aşınca ulu bir köy vardır, suyu mübarektir, var git oraya sığın' dediler, elime de azık verdiler.\"", "Seçenek inan: \"Dervişler düşkünün elinden tutar, iyi insanlara rast gelmişsin.\" (Tansiyon -1) -> [Hedef: Düğüm 1.2]", "Seçenek yalanı çürüt: \"Bu dağ başında derviş ne arar be kızım! O dediğin adamlar yolu tutan harami çakallarıdır, seni kandırmışlar!\" (Tansiyon +2) -> [Hedef: Düğüm 1.2_Baskı]"]}, "1.2": {"replik_anahtari": &"CHR_002_DUGUM_1_2_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek kapat: \"Neyse, niyetin iyiymiş madem, içeri girince bakarız.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_2_SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek baskı: \"Sırtını sıvazlayan o adamlar sana sadece yol duası mı etti? Gözlerini kaçırma benden, başka ne tembihlediler? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Bana çok merhametli davrandılar ağam... Sırtımı sıvazladılar, hayır duaları ettiler. Ben de onların sözüne bel bağlayıp koştum geldim.\"", "Seçenek kapat: \"Neyse, niyetin iyiymiş madem, içeri girince bakarız.\" -> [Hedef: Düğüm 00]", "Seçenek baskı: \"Sırtını sıvazlayan o adamlar sana sadece yol duası mı etti? Gözlerini kaçırma benden, başka ne tembihlediler? (Yalnızca Tansiyon < 8 ise)\" -> [Hedef: Düğüm 1.3]"]}, "1.2_Baskı": {"replik_anahtari": &"CHR_002_DUGUM_1_2_BASK__REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": -1, "kaynak": "Seçenek geri çekil: \"Ağlama hemen, seni suçlamıyorum; sadece hakikati anlamaya çalışıyorum.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_2_BASK__SEC_1_METIN"}, {"hedef": "1.3", "tansiyon_delta": 0, "kaynak": "Seçenek sıkıştır: \"Kuyuya ne bereketi getirecekmişsin? Açık konuş, o adamlar sana ne yapmanı söyledi? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_2_BASK__SEC_2_METIN"}], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}], "bayraklar": [], "kaynak": ["NPC Replik: \"(Gözleri dolar, titreyerek geriye çekilir) Günahımı alma ağam! Onlar hak aşığı dervişlerdi! 'Köyün suyuna bereket getireceksin' dediler, yalan mı söyleyecekti nur yüzlü pirler?\"", "Seçenek geri çekil: \"Ağlama hemen, seni suçlamıyorum; sadece hakikati anlamaya çalışıyorum.\" (Tansiyon -1) -> [Hedef: Düğüm 00]", "Seçenek sıkıştır: \"Kuyuya ne bereketi getirecekmişsin? Açık konuş, o adamlar sana ne yapmanı söyledi? (Yalnızca Tansiyon 4-7 aralığında ise)\" -> [Hedef: Düğüm 1.3]", "(Eğer Tansiyon 8 veya üzerinde ise tek seçenek) -> [Hedef: Düğüm_Final_Ret]"]}, "1.3": {"replik_anahtari": &"CHR_002_DUGUM_1_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Kuyudan altın başak fışkırmaz saf kızım... Seni büyük bir belaya alet etmişler. Şimdi şu geçmişini anlat.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_1_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Yol_Sirri_Acik"], "kaynak": ["NPC Replik: \"(Hıçkırıklarını tutamayarak) Dediler ki... 'Bu torbadaki kutsal tohumları köyün ana su kuyusuna dökersen, kırk gün sonra tarlalardan altın başaklar fışkırır, köyde kimse aç kalmaz.' Ben sadece iyilik etmek istedim!\"", "Generate [Flag_Yol_Sirri_Acik]", "Seçenek: \"Kuyudan altın başak fışkırmaz saf kızım... Seni büyük bir belaya alet etmişler. Şimdi şu geçmişini anlat.\" -> [Hedef: Düğüm 00]", "", "Dal 2:"]}, "2.1": {"replik_anahtari": &"CHR_002_DUGUM_2_1_REPLIK", "secenekler": [{"hedef": "2.2", "tansiyon_delta": 1, "kaynak": "Test sorusu: \"Madem rençbersin, kış çıkarken tarlaya ne ekilir, çeltik tavasına ne vakit su verilir söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_2_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"Biz Balçıkbükü'nde üç öksüz kardeştik ağam. Babam bendi tamir ederken balçıkta can verdi. Ben evin en büyüğüyüm, kardeşlerime ben analık ederim.\"", "Test sorusu: \"Madem rençbersin, kış çıkarken tarlaya ne ekilir, çeltik tavasına ne vakit su verilir söyle bakalım?\" (Tansiyon +1) -> [Hedef: Düğüm 2.2]"]}, "2.2": {"replik_anahtari": &"CHR_002_DUGUM_2_2_REPLIK", "secenekler": [{"hedef": "2.3", "tansiyon_delta": -2, "kaynak": "Seçenek empati: \"Zor zanaat ortakçılık, bilirim. Çektiğin çileyi yüzünden okuyorum, korkma benden.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "beceri": "ikna", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_2_2_SEC_1_METIN"}, {"hedef": "2.3_Agresif", "tansiyon_delta": 3, "kaynak": "Seçenek sert yüzleşme: \"Bataklıkta ortakçılık yapan kız kuyuya dökmek için derviş torbasıyla yola çıkmaz! Seni kim gönderdi Meryem, o adamlar seni neyle tehdit etti? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]", "gerekli_ipuclari": [], "gerekli_bayraklar": ["Flag_Yol_Sirri_Acik"], "metin_anahtari": &"CHR_002_DUGUM_2_2_SEC_2_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["NPC Replik: \"(Parmaklarını kıvırır, telaşlanır) Kış çıkarken... arpa atılır toprağa... Çeltik bataklıkta yatar ağam, ama bizim tarlamız yoktu ki, beyin ortakçısıydık biz...\"", "Seçenek empati: \"Zor zanaat ortakçılık, bilirim. Çektiğin çileyi yüzünden okuyorum, korkma benden.\" (Tansiyon -2) -> [Hedef: Düğüm 2.3]", "Seçenek sert yüzleşme: \"Bataklıkta ortakçılık yapan kız kuyuya dökmek için derviş torbasıyla yola çıkmaz! Seni kim gönderdi Meryem, o adamlar seni neyle tehdit etti? (Yalnızca [Flag_Yol_Sirri_Acik] doğru ise, Tansiyon +3)\" -> [Hedef: Düğüm 2.3_Agresif]"]}, "2.3": {"replik_anahtari": &"CHR_002_DUGUM_2_3_REPLIK", "secenekler": [{"hedef": "00", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Çaresizlik insanı ateşe sürer Meryem. Lakin o taşıdığın şeyin aslı nedir, ona bakalım.\" -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_2_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Gözyaşlarını fistanının yenine siler) Adım Meryem'dir ağam... Kardeşlerim açlıktan tahta gibi kurudu mezrada. O adamlar 'Bu dediklerimizi yaparsan kardeşlerine bir çuval un, bir küp kavurma yollarız' dediler. Çaresiz kaldım!\"", "Generate [Flag_Kimlik_Cozuldu]", "Seçenek: \"Çaresizlik insanı ateşe sürer Meryem. Lakin o taşıdığın şeyin aslı nedir, ona bakalım.\" -> [Hedef: Düğüm 00]"]}, "2.3_Agresif": {"replik_anahtari": &"CHR_002_DUGUM_2_3_AGRESIF_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "00", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": ["Flag_Kimlik_Cozuldu"], "kaynak": ["NPC Replik: \"(Feryat ederek ağlar) Evet, kardeşlerim ölmesin diye yaptım! Dağdaki o silahlı adamlar tuttu yakamdan! 'Kuyuya bu tohumları saçmazsan o bebeleri bataklıkta boğarız' dediler! Ben katil değilim ağam, canımı alın kardeşlerime kıymayın!\"", "Generate [Flag_Kimlik_Cozuldu]", "(Eğer Tansiyon 8 veya üzerinde ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 00]", "", "Dal 3:"]}, "3.1": {"replik_anahtari": &"CHR_002_DUGUM_3_1_REPLIK", "secenekler": [{"hedef": "3.2", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Gözünü aç kızım, seni bir köy dolusu insanı zehirlemeye alet etmişler!\" -> [Hedef: Düğüm 3.2]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_3_1_SEC_1_METIN"}], "gecisler": [], "bayraklar": [], "kaynak": ["Koşul: [Clue_CHR002_SahteMuska], [Clue_CHR002_KaraTohum] veya [Clue_Görsel_CHR002_BanotuYarasi] ipuçlarından en az biri keşfedilmiş olmalıdır.", "Muhafız Replik: \"Muskanın içindeki o kömür karalaması [Clue_CHR002_SahteMuska], torbandaki acı badem kokulu tohumlar [Clue_CHR002_KaraTohum] ve bileklerindeki zehir kabarcıkları [Clue_Görsel_CHR002_BanotuYarasi]! O kucağındaki bereket tohumu değil, içeni kör edip telef eden yabani kara banotudur!\"", "NPC Replik: \"(Dehşetle bileklerindeki mor kabarcıklara bakar, nefesi düğümlenir) Z-zehir mi? Derimdeki bu yaralar... tohum yüzünden mi oldu? Bana mübarek dediler... Günahıma girdiler ağam!\"", "Seçenek: \"Gözünü aç kızım, seni bir köy dolusu insanı zehirlemeye alet etmişler!\" -> [Hedef: Düğüm 3.2]"]}, "3.2": {"replik_anahtari": &"CHR_002_DUGUM_3_2_REPLIK", "secenekler": [], "gecisler": [{"hedef": "Final_Ret", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": ">=", "deger": 8}}, {"hedef": "3.3", "tansiyon_delta": 0, "kaynak": "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "tansiyon_kosulu": {"operator": "<", "deger": 8}}], "bayraklar": [], "kaynak": ["(Eğer Tansiyon >= 8 ise) -> [Hedef: Düğüm_Final_Ret]", "(Eğer Tansiyon < 8 ise) -> [Hedef: Düğüm 3.3]"]}, "3.3": {"replik_anahtari": &"CHR_002_DUGUM_3_3_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Hakikati anladın ya, mühim olan bu. Şimdi kalk ayağa, hakkında hüküm verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_3_3_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Sir_Tamamen_Cozuldu"], "kaynak": ["NPC Replik: \"(Torbayı dehşet içinde yere fırlatır, diz çöküp saçını başını yolar) Allahım sen affet! Bilmiyordum... Köyün çeşmesini, kuzuları kurutacaklarmış! O adamlar 'Biz arkadan geleceğiz, ahali sayıklamaya başlayınca köye çökeceğiz' diye gülüşüyorlardı. Ben ne yaptım!\"", "Generate [Flag_Sir_Tamamen_Cozuldu]", "Seçenek: \"Hakikati anladın ya, mühim olan bu. Şimdi kalk ayağa, hakkında hüküm verilecek.\" -> [Hedef: Düğüm_Karar_Menusu]"]}, "Final_Ret": {"replik_anahtari": &"CHR_002_DUGUM_FINAL_RET_REPLIK", "secenekler": [{"hedef": "Karar_Menusu", "tansiyon_delta": 0, "kaynak": "Seçenek: \"Korkudan aklı başından gitti, artık laf anlatılamaz.\" -> [Hedef: Düğüm_Karar_Menusu]", "gerekli_ipuclari": [], "gerekli_bayraklar": [], "metin_anahtari": &"CHR_002_DUGUM_FINAL_RET_SEC_1_METIN"}], "gecisler": [], "bayraklar": ["Flag_Kilitlendi"], "kaynak": ["NPC Replik: \"(Korkudan aklını yitirecek gibi olur, torbayı kucağına basıp duvara yapışır, tiz bir çığlık atar) Yaklaşma bana! Hepiniz beni kandırıyorsunuz! Derviş baba beni korur! Dokunursan kendimi kayalıktan atarım, kimseye bir şey demem gayrı!\"", "Generate [Flag_Kilitlendi]", "Seçenek: \"Korkudan aklı başından gitti, artık laf anlatılamaz.\" -> [Hedef: Düğüm_Karar_Menusu]", ""]}, "Karar_Menusu": {"replik_anahtari": &"CHR_002_DUGUM_KARAR_MENUSU_REPLIK", "secenekler": [], "gecisler": [], "bayraklar": [], "kaynak": ["Son söz: Muhafız genç kızın titreyen omuzlarına bakar; acıma ile köyün emniyeti arasında son kararını tartar. Karar menüsü açılır.", ""]}}
karar_matrisi = {"kabul": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [{"stat_etkisi": {"Erzak": 2, "Moral": 2, "Saglik": 1}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": true}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] doğru ise zehirli tohumlar ocakta yakılır; Meryem Şifahane ve Bostan emrinde şifalı ot ayıklama ve çapalama işine verilir: derhal Erzak +2, Moral +2 ve Sağlık +1 kazanılır.", "muhafiz_akce": 0, "esyalar": []}, {"stat_etkisi": {}, "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 3'te Su Kuyusu binasında tohumlar suya karışır ve zehirlenir; Sağlık -5, Erzak -2 ve Moral -3 kaybedilir.", "muhafiz_akce": 0, "esyalar": []}]}, "zorunlu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Zehirli tohumlar müsadere edilip ateşe atılır, kız sınır dışına sürülür ve su kaynağı kurtarılır. Debuff: 3 tur boyunca Su Kuyusu başında kova çekme ve su denetimi işi aksar, köylünün işi zorlaşır; Sağlık +2 artarken Refah -1 düşer."}, "gonullu_ret": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Masum ve safdil bir yetim kış ayazında dağa geri kovulur. Debuff: 4 tur boyunca Köy Meydanı toplanma yerinde meclis kurup dedikodu etme işi başlar; Moral -3 ve Güvenlik -1 kaybedilir."}, "rusvet": {"stat_etkisi": {}, "muhafiz_akce": 0, "esyalar": ["1 gümüş düğme"], "varyantlar": [], "kosullar": {}, "kaynak": "Muhafız kızın boynundaki eski gümüş savatlı düğmeyi ve kenevir torbasını alır (Kişisel Kazanç: 1 gümüş düğme). Tur 4'te Su Kuyusu binasında sahipsiz kalan tohumlar suya dökülür; Sağlık -3 ve Moral -2 çürümesi yaşanır."}, "kisla": {"stat_etkisi": {"Guvenlik": 1, "Moral": -3}, "muhafiz_akce": 0, "esyalar": [], "varyantlar": [], "kosullar": {}, "kaynak": "Kız korkudan kışla zindanında baygın yatar. Masum bir yetimin hapsedilmesi sebebiyle Muhafız Kışlası nizamı bozulmaz ancak köyde tepki doğar: Güvenlik +1 kazanılırken, Moral -3 kaybedilir."}}
gecikmeli_etkiler = Array[Dictionary]([{"tur_offset": 4, "hedef_sistem": "bar", "alan": "Saglik", "deger": -3, "hedef_bina": "Su Kuyusu", "olay_id": "Bulanık Kova", "stat_etkisi": {"Saglik": -3}, "karar": "", "kosullar": {"Flag_Yol_Sirri_Acik": false}, "sure": 1, "kaynak": "Tur 4'te Su Kuyusu binasında 'Bulanık Kova' olayı yaşanır; Meryem tohumları bereket duasıyla kuyuya döker, içme suyundan zehirlenen köylüler sebebiyle Sağlık -3 kaybı meydana gelir."}, {"tur_offset": 6, "hedef_sistem": "dedikodu", "alan": "Moral", "deger": -2, "hedef_bina": "Şifahane", "olay_id": "Bataklık Humması Söylentisi", "stat_etkisi": {"Moral": -2}, "karar": "", "kosullar": {"Flag_Kimlik_Cozuldu": false}, "sure": 1, "kaynak": "Tur 6'da Şifahane binasında 'Bataklık Humması Söylentisi' olayı gerçekleşir; kızın rehin tutulan ailesi ve mezra dramı anlaşılamadığından köy içinde salgın korkusu başlar, Moral -2 azalır."}, {"tur_offset": 3, "hedef_sistem": "kuyu_zehri", "alan": "Saglik", "deger": -5, "hedef_bina": "Su Kuyusu", "olay_id": "CHR_002_Kabul and secret hidden", "stat_etkisi": {"Saglik": -5, "Erzak": -2, "Moral": -3}, "karar": "kabul", "kosullar": {"Flag_Sir_Tamamen_Cozuldu": false}, "sure": 1, "kaynak": "[Flag_Sir_Tamamen_Cozuldu] yanlış ise Tur 3'te Su Kuyusu binasında tohumlar suya karışır ve zehirlenir; Sağlık -5, Erzak -2 ve Moral -3 kaybedilir."}, {"tur_offset": 1, "hedef_sistem": "bar", "alan": "Saglik", "deger": 2, "hedef_bina": "Su Kuyusu", "olay_id": "CHR_002_Zorunlu ret", "stat_etkisi": {"Saglik": 2, "Refah": -1}, "karar": "zorunlu_ret", "kosullar": {}, "sure": 3, "kaynak": "Zehirli tohumlar müsadere edilip ateşe atılır, kız sınır dışına sürülür ve su kaynağı kurtarılır. Debuff: 3 tur boyunca Su Kuyusu başında kova çekme ve su denetimi işi aksar, köylünün işi zorlaşır; Sağlık +2 artarken Refah -1 düşer."}, {"tur_offset": 1, "hedef_sistem": "dedikodu", "alan": "Moral", "deger": -3, "hedef_bina": "Köy Meydanı", "olay_id": "CHR_002_Gönüllü ret", "stat_etkisi": {"Moral": -3, "Guve
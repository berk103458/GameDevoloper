              "anahtar": "dunya.haber.salgin.soylenti_2",
              "metin": "Aşağı vadideki su kaynaklarının başında ölü hayvan leşleri bulunmuş; hekimler kaynatılmamış su içilmemesini tembihliyor."
            }
          ]
        },
        "kesin_haber": {
          "gun": 50,

            {
              "konusmaci": "chr_006",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.salgin.kesin_1",
              "metin": "Kervansaray kapılarına kireç döküldü muhafız; salgın dalgası komşu kazalara sıçradı, ateşlenen yolcular yollarda kalıyor."
            },
            {
              "konusmaci": "chr_025",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.salgin.kesin_2",
              "metin": "Şifahanesi ve temiz suyu olmayan köylerde humma her haneye girmiş; rüzgar bile vadiden hastalık kokusu taşıyor."
            }
          ]

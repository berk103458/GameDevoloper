      "sira": 3,
      "ad_anahtari": "dunya.olay.bizans_uc_baskisi.ad",
      "kaynak_notu_anahtari": "dunya.olay.bizans_uc_baskisi.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 22,
          "replikler": [
            {
              "konusmaci": "chr_004",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.bizans.soylenti_1",
              "metin": "Batı sınırındaki İznik tekfuru akritai garnizonlarını takviye etmiş; sınır kalelerinde gece gündüz boru sesleri duyuluyormuş."
            },
            {
              "konusmaci": "chr_022",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.bizans.soylenti_2",
              "metin": "Uçtaki Rum ve Türkmen pazarlarında tekfurun tahsildarları görülmüş; geçit parası vermeyen köylerin sürülerine el koyacaklarmış."
            }
          ]
        },
        "kesin_haber": {
          "gun": 26,
          "replikler": [
            {
              "konusmaci": "chr_007",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.bizans.kesin_1",
              "metin": "Tekfurun zırhlı süvarileri batı geçidini tuttu; sınır boyundaki bütün uç köylerine ağır haraç fermanı gönderildi."
            },
            {
              "konusmaci": "chr_012",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.bizans.kesin_2",
              "metin": "Komşu vadi köyü tekfurun istediği haracı denkleştiremeyince bağlarını yakmışlar; sıra bizim boğaza geldi."
            }
          ]
        },
        "etki": {
          "gun": 28,
          "hedef_kapi": "harac",
          "carpan": 1.25,
          "rapor_anahtari": "dunya.rapor.bizans_uc_baskisi"

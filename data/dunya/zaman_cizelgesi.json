            {
              "konusmaci": "chr_008",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.kitlik.soylenti_1",
              "metin": "Güney ovalarında bahar yağmuru hiç düşmemiş; başaklar diz boyuna gelmeden sararıp kavrulmuş diyorlar."
            },
            {
              "konusmaci": "chr_016",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.kitlik.soylenti_2",
              "metin": "Pazar yerlerinde bir kile arpanın fiyatı iki katına fırlamış; köylüler tohumluk buğdayı bile değirmene taşımaya başlamış."
            }
          ]
        },
        "kesin_haber": {
          "gun": 38,
          "replikler": [
            {
              "konusmaci": "chr_010",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.kitlik.kesin_1",
              "metin": "Kızılırmak yayındaki kuyular çekildi, çekirge sürüsü kalan ekinleri de süpürdü; bütün sancakta büyük kıtlık yılı ilan edildi."
            },
            {
              "konusmaci": "chr_019",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.kitlik.kesin_2",
              "metin": "Kervanlar artık un ve zahire satmıyor; ambarındaki yedeği tutamayan köyler meşe palamudu öğütmeye düşmüş."
            }
          ]
        },
        "etki": {

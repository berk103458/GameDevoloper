{
  "olaylar": [
    {
      "id": "mogol_ilerleyisi",
      "sira": 1,
      "ad_anahtari": "dunya.olay.mogol_ilerleyisi.ad",
      "kaynak_notu_anahtari": "dunya.olay.mogol_ilerleyisi.kaynak_notu",
      "gun_kaynagi": "har02_sayaci",
      "evreler": {
        "erken_soylenti": {
          "gun_ofset": -6,
          "replikler": [
            {
              "konusmaci": "chr_005",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.mogol.soylenti_1",
              "metin": "Erzincan boğazından gelen kervancılar doğu ufkunda dumanların hiç sönmediğini, Baycu Noyan'ın öncü atlılarının Sivas çayırlarına indiğini fısıldıyor."
            },
            {
              "konusmaci": "chr_011",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.mogol.soylenti_2",
              "metin": "Yayladan inen çobanlar gece vakti demir nallı yüzlerce atın nal sesini duymuş; kuşlar bile doğu korularından batıya göçüyor."
            }
          ]
        },
        "kesin_haber": {
          "gun_ofset": -2,
          "replikler": [
            {
              "konusmaci": "chr_001",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.mogol.kesin_1",
              "metin": "Karahisar derbendindeki gözcü kulesi dün gece yakıldı muhafız; Moğol туğları vadi ağzında göründü, kaçabilen köylüler yollara döküldü."
            },
            {
              "konusmaci": "chr_003",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.mogol.kesin_2",
              "metin": "Sivas'tan çıkan son ulak atını çatlatarak geçti; doğu menzilleri kapandı, akıncı kolu doğrudan bizim boğaza yürüyor."
            }
          ]
        },
        "etki": {
          "gun_ofset": 0,
          "hedef_kapi": "tehdit_kapisi",
          "carpan": 1.25,
          "rapor_anahtari": "dunya.rapor.mogol_ilerleyisi"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "mogol_elcisi",

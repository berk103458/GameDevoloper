        "ret": "dunya.donus.mogol_elcisi.ret",
        "bekliyor": "dunya.donus.mogol_elcisi.bekliyor"
      }
    },
    {
      "id": "selcuklu_taht_kavgasi",
      "sira": 2,
      "ad_anahtari": "dunya.olay.selcuklu_taht_kavgasi.ad",
      "kaynak_notu_anahtari": "dunya.olay.selcuklu_taht_kavgasi.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 10,
          "replikler": [
            {
              "konusmaci": "chr_009",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.taht.soylenti_1",
              "metin": "Konya divanında iki sultan kardeşin emirleri birbirine kılıç çekmiş derler; kervansaraylarda hangi sultanın sikkesinin geçeceği tartışılıyor."
            },
            {
              "konusmaci": "chr_017",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.taht.soylenti_2",
              "metin": "Subaşı konaklarında mühürler değişmiş; bir gün İzzeddin Keykavus'un, ertesi gün Rükneddin Kılıç Arslan'ın fermanı okunuyormuş."
            }
          ]
        },
        "kesin_haber": {
          "gun": 14,
          "replikler": [
            {
              "konusmaci": "chr_002",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.taht.kesin_1",
              "metin": "Saltanat ordusu Aksaray ovasında ikiye bölündü; tımarlı sipahiler kalelerini bırakıp taht kavgasına çağrılınca iç vilayetlerin ahalisi uçlara kaçmaya başladı."
            },
            {
              "konusmaci": "chr_014",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.taht.kesin_2",
              "metin": "Konya'dan gelen mülteci kafileleri yollara sığmıyor; emirlerin müsaderesinden kaçan zanaatkâr ve köylüler güvenli boğaz arıyor."
            }
          ]
        },
        "etki": {
          "gun": 16,
          "hedef_kapi": "gelen_akisi",
          "carpan": 1.3,
          "rapor_anahtari": "dunya.rapor.selcuklu_taht_kavgasi"
        }
      },

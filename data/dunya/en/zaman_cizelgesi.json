{
  "olaylar": [
    {
      "id": "mogol_ilerleyisi",
      "sira": 1,
      "ad_anahtari": "dunya.olay.mogol_ilerleyisi.ad",
      "kaynak_notu_anahtari": "dunya.olay.mogol_ilerleyisi.kaynak_notu",
      "gun_kaynagi": "har02_sayaci",
      "evreler": {
        "erken_soylenti": {
          "gun_ofset": -6,
          "replikler": [
            {
              "konusmaci": "chr_005",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.mogol.soylenti_1",
              "metin": "Caravaneers from the Erzincan gorge whisper that smoke on the eastern horizon never fades, and Baiju Noyan's vanguard riders have descended into the Sivas meadows."
            },
            {
              "konusmaci": "chr_011",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.mogol.soylenti_2",
              "metin": "Shepherds coming down from the highlands heard hundreds of iron-shod horses in the night; even the birds are fleeing west from the eastern woods."
            }
          ]
        },
        "kesin_haber": {
          "gun_ofset": -2,
          "replikler": [
            {
              "konusmaci": "chr_001",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.mogol.kesin_1",
              "metin": "The watchtower at the Karahisar pass was burned last night, gatekeeper; Mongol standards appeared at the valley mouth and fleeing villagers fill the roads."
            },
            {
              "konusmaci": "chr_003",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.mogol.kesin_2",
              "metin": "The last courier out of Sivas rode his horse to exhaustion; the eastern halts have fallen and the raiding column marches straight toward our pass."
            }
          ]
        },
        "etki": {
          "gun_ofset": 0,
          "hedef_kapi": "tehdit_kapisi",
          "carpan": 1.25,
          "rapor_anahtari": "dunya.rapor.mogol_ilerleyisi"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "mogol_elcisi",
        "kabul": "dunya.donus.mogol_elcisi.kabul",
        "ret": "dunya.donus.mogol_elcisi.ret",
        "bekliyor": "dunya.donus.mogol_elcisi.bekliyor"
      }
    },
    {
      "id": "selcuklu_taht_kavgasi",
      "sira": 2,
      "ad_anahtari": "dunya.olay.selcuklu_taht_kavgasi.ad",
      "kaynak_notu_anahtari": "dunya.olay.selcuklu_taht_kavgasi.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 10,
          "replikler": [
            {
              "konusmaci": "chr_009",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.taht.soylenti_1",
              "metin": "They say the emirs of the two brother sultans drew swords in the Konya council; in the caravanserais men argue over which sultan's coin holds true."
            },
            {
              "konusmaci": "chr_017",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.taht.soylenti_2",
              "metin": "Seals have changed in the subashi mansions; one day the edict of Izzeddin Keykavus is read, the next day Rukneddin Kilij Arslan's."
            }
          ]
        },
        "kesin_haber": {
          "gun": 14,
          "replikler": [
            {
              "konusmaci": "chr_002",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.taht.kesin_1",
              "metin": "The royal army split in two on the Aksaray plain; as fief-holding cavalry were summoned from their forts to fight for the throne, inner-province folk began fleeing to the frontier."
            },
            {
              "konusmaci": "chr_014",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.taht.kesin_2",
              "metin": "Refugee convoys from Konya overflow the roads; artisans and peasants fleeing the emirs' confiscations seek a sheltered mountain pass."
            }
          ]
        },
        "etki": {
          "gun": 16,
          "hedef_kapi": "gelen_akisi",
          "carpan": 1.3,
          "rapor_anahtari": "dunya.rapor.selcuklu_taht_kavgasi"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "turkmen_ittifaki",
        "kabul": "dunya.donus.turkmen_ittifaki.kabul",
        "ret": "dunya.donus.turkmen_ittifaki.ret",
        "bekliyor": "dunya.donus.turkmen_ittifaki.bekliyor"
      }
    },
    {
      "id": "bizans_uc_baskisi",
      "sira": 3,
      "ad_anahtari": "dunya.olay.bizans_uc_baskisi.ad",
      "kaynak_notu_anahtari": "dunya.olay.bizans_uc_baskisi.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 22,
          "replikler": [
            {
              "konusmaci": "chr_004",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.bizans.soylenti_1",
              "metin": "The Nicaean tekfur on the western border has reinforced his akritai garrisons; horn blasts echo day and night from the border forts."
            },
            {
              "konusmaci": "chr_022",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.bizans.soylenti_2",
              "metin": "The tekfur's tax collectors were spotted in frontier markets; they threaten to seize the flocks of any village that refuses passage tribute."
            }
          ]
        },
        "kesin_haber": {
          "gun": 26,
          "replikler": [
            {
              "konusmaci": "chr_007",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.bizans.kesin_1",
              "metin": "The tekfur's armored cavalry seized the western pass; a heavy tribute decree has been dispatched to every frontier village along the border."
            },
            {
              "konusmaci": "chr_012",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.bizans.kesin_2",
              "metin": "When the neighboring valley village could not raise the tekfur's tribute, their vineyards were torched; our pass is next in line."
            }
          ]
        },
        "etki": {
          "gun": 28,
          "hedef_kapi": "harac",
          "carpan": 1.25,
          "rapor_anahtari": "dunya.rapor.bizans_uc_baskisi"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "tekfur_haraci",
        "kabul": "dunya.donus.tekfur_haraci.kabul",
        "ret": "dunya.donus.tekfur_haraci.ret",
        "bekliyor": "dunya.donus.tekfur_haraci.bekliyor"
      }
    },
    {
      "id": "kitlik_yili",
      "sira": 4,
      "ad_anahtari": "dunya.olay.kitlik_yili.ad",
      "kaynak_notu_anahtari": "dunya.olay.kitlik_yili.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 34,
          "replikler": [
            {
              "konusmaci": "chr_008",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.kitlik.soylenti_1",
              "metin": "No spring rain fell across the southern plains; they say the wheat ears yellowed and scorched before reaching knee height."
            },
            {
              "konusmaci": "chr_016",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.kitlik.soylenti_2",
              "metin": "The price of a bushel of barley has doubled in the markets; villagers have begun carrying even their seed grain to the mill."
            }
          ]
        },
        "kesin_haber": {
          "gun": 38,
          "replikler": [
            {
              "konusmaci": "chr_010",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.kitlik.kesin_1",
              "metin": "Wells along the Kizilirmak bend ran dry and locust swarms stripped the remaining crops; a great famine year has been declared across the province."
            },
            {
              "konusmaci": "chr_019",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.kitlik.kesin_2",
              "metin": "Caravans no longer sell flour or grain; villages that failed to guard their granary reserves are grinding oak acorns for bread."
            }
          ]
        },
        "etki": {
          "gun": 40,
          "hedef_kapi": "tuketim",
          "carpan": 1.2,
          "rapor_anahtari": "dunya.rapor.kitlik_yili"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "tekfur_haraci",
        "kabul": "dunya.donus.tekfur_haraci.kabul",
        "ret": "dunya.donus.tekfur_haraci.ret",
        "bekliyor": "dunya.donus.tekfur_haraci.bekliyor"
      }
    },
    {
      "id": "salgin_dalgasi",
      "sira": 5,
      "ad_anahtari": "dunya.olay.salgin_dalgasi.ad",
      "kaynak_notu_anahtari": "dunya.olay.salgin_dalgasi.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 46,
          "replikler": [
            {
              "konusmaci": "chr_015",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.salgin.soylenti_1",
              "metin": "Muleteers arriving from the ports speak of black fever chills; at night they burn vinegar smoke inside the roadside inns."
            },
            {
              "konusmaci": "chr_020",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.salgin.soylenti_2",
              "metin": "Carcasses were found near the lower valley springs; physicians warn everyone not to drink unboiled water."
            }
          ]
        },
        "kesin_haber": {
          "gun": 50,
          "replikler": [
            {
              "konusmaci": "chr_006",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.salgin.kesin_1",
              "metin": "Lime has been poured across caravanserai gates, gatekeeper; the plague wave has leaped to neighboring districts and fevered travelers collapse along the roads."
            },
            {
              "konusmaci": "chr_025",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.salgin.kesin_2",
              "metin": "In villages without an infirmary or clean water, the fever has entered every home; even the valley wind carries the scent of sickness."
            }
          ]
        },
        "etki": {
          "gun": 52,
          "hedef_kapi": "saglik_yoneticisi",
          "carpan": 1.25,
          "rapor_anahtari": "dunya.rapor.salgin_dalgasi"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "mogol_elcisi",
        "kabul": "dunya.donus.mogol_elcisi.kabul",
        "ret": "dunya.donus.mogol_elcisi.ret",
        "bekliyor": "dunya.donus.mogol_elcisi.bekliyor"
      }
    },
    {
      "id": "ticaret_yolunun_kapanmasi",
      "sira": 6,
      "ad_anahtari": "dunya.olay.ticaret_yolunun_kapanmasi.ad",
      "kaynak_notu_anahtari": "dunya.olay.ticaret_yolunun_kapanmasi.kaynak_notu",
      "evreler": {
        "erken_soylenti": {
          "gun": 58,
          "replikler": [
            {
              "konusmaci": "chr_013",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.ticaret.soylenti_1",
              "metin": "Caravan masters report that bridges along the Erzurum-Sivas route have collapsed and brigands ambush every gorge."
            },
            {
              "konusmaci": "chr_021",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.ticaret.soylenti_2",
              "metin": "Mule trains laden with salt and iron are weeks overdue; merchants swear they will not set out without armed escorts."
            }
          ]
        },
        "kesin_haber": {
          "gun": 62,
          "replikler": [
            {
              "konusmaci": "chr_018",
              "konu": "yolda_ne_gordun",
              "anahtar": "dunya.haber.ticaret.kesin_1",
              "metin": "Rockslides and raids have completely closed the main trade road; caravanserai doors are padlocked and outside goods have ceased to arrive."
            },
            {
              "konusmaci": "chr_027",
              "konu": "koy_dedikodusu",
              "anahtar": "dunya.haber.ticaret.kesin_2",
              "metin": "Iron tools and salt have vanished into the black market along the frontier; villages without their own workshop and granary pay a fortune for a single nail."
            }
          ]
        },
        "etki": {
          "gun": 64,
          "hedef_kapi": "fiyat",
          "carpan": 1.3,
          "rapor_anahtari": "dunya.rapor.ticaret_yolunun_kapanmasi"
        }
      },
      "karar_kosulu": {
        "bagli_karar": "turkmen_ittifaki",

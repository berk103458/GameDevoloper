[gd_resource type="Resource" script_class="OlayVerisi" format=3]

[ext_resource type="Script" path="res://src/veri/olay_verisi.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"dugun"
baslik_anahtari = "olay.dugun.baslik"
metin_anahtari = "olay.dugun.metin"
kosullar = {"nufus_min": 6, "yas_grubu": "yetiskin", "yetiskin_hane_min": 2}
agirlik = 1.0
tek_sefer = true
secenek_anahtarlari = PackedStringArray("olay.dugun.secenek1", "olay.dugun.secenek2", "olay.dugun.secenek3")
secenek_etkileri = Array[Dictionary]([{"gerekli": {"akce": 3}, "bar": [2, 0, 1, 0]}, {"bar": [1, 0, 0, 0]}, {"bar": [-1, 0, 0, 1]}])
ses = &""
muzik = &"muzik_dugun_dongu"

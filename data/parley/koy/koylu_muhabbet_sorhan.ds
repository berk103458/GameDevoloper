{
  "title": "koylu_muhabbet_sorhan",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Sorhan",
      "text": "Esenlikler muhafız. Bozkırın rüzgârı atların yelesindedir. Ahırda tayları tımarlarım; ne sorarsın?"
    },
    {
      "id": "node:opt_normal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -180.0)",
      "character": "Muhafız",
      "text": "Sorhan, köyün binekleri ve yük hayvanları ne alemde?"
    },
    {
      "id": "node:opt_kriz",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 0.0)",
      "character": "Muhafız",
      "text": "Bozkırdan süvari yaklaşırsa atlarımız kaçışta yeter mi?"
    },
    {
      "id": "node:opt_karar",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 180.0)",
      "character": "Muhafız",
      "text": "Dün gelen seyyar nalbant hakkında ne dersin?"
    },
    {
      "id": "node:rep_normal",
      "type": "DIALOGUE",
      "position": "(1050.0, -180.0)",
      "character": "Sorhan",
      "text": "Atlar dert dinlemez, yürek dinler muhafız. İki yağız atın ayak tırnağını kestim, bozkır otuyla besledim. Köyün süvarisi gerekirse rüzgâr gibi uçar."
    },
    {
      "id": "node:rep_kriz",
      "type": "DIALOGUE",
      "position": "(1050.0, 0.0)",
      "character": "Sorhan",
      "text": "Kıpçak atı yorulmaz ağam. Süvari yaklaşırsa arkadan çevirir, vadide pusu kurarız. Atı iyi süren asker, er meydanında on yayaya bedeldir."
    },
    {
      "id": "node:rep_karar",
      "type": "DIALOGUE",
      "position": "(1050.0, 180.0)",
      "character": "Sorhan",
      "text": "Topuğu çivili nalbant ustası ahıra girdi. Haramilerin atlarını sakatladığını anlattı; nalları inceledim, haklı. Bizim aygırların hepsine hilal nal çaktı; hayvanlar gayrı tökezlemez."
    },
    {
      "id": "node:act_normal",
      "type": "ACTION",
      "position": "(1400.0, -180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:act_kriz",
      "type": "ACTION",
      "position": "(1400.0, 0.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",

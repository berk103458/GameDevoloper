{
  "title": "sekans_meydan_atesi",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:aydogdu",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Aydoğdu",
      "text": "Odunu harlı atın çocuklar, bu gece ayaz dağdan inecek. Boğazdaki çatırtıları duydunuz mu?"
    },
    {
      "id": "node:ayse",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "Ayşe Bacı",
      "text": "Duyduk Aydoğdu çavuş... Kurt uluması değil o, atlıların nal sesidir. Muhafızlar mazgalları boş bırakmasın."
    },
    {
      "id": "node:opt_guven",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Muhafız",
      "text": "Korkmayın, kulelerde nöbetçilerimiz uyanık, köyün suru sağlamdır."
    },
    {
      "id": "node:opt_dagil",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Muhafız",
      "text": "Herkes çadırına ve evine çekilsin, meydanda toplanıp tedirginlik yaratmayın."
    },
    {
      "id": "node:rep_guven",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Aydoğdu",
      "text": "Gözün arkada kalmasın muhafız, gerekirse biz de kazmaları kapıp kapıya dikiliriz."
    },
    {
      "id": "node:act_guven",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Dayanışma Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "3"
      ]
    },
    {
      "id": "node:rep_dagil",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "Ayşe Bacı",
      "text": "Peki muhafız, lakin dirlik bir arada durunca kuvvet bulur."
    },
    {
      "id": "node:end",
      "type": "END",
      "position": "(2100.0, 0.0)"
    }
  ],

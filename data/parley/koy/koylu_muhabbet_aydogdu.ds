{
  "title": "koylu_muhabbet_aydogdu",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Aydoğdu",
      "text": "Dur orada muhafız! Gözüm ovada, kulağım kirişte. Eski askerin istirahati mezardadır; neye baktın?"
    },
    {
      "id": "node:opt_normal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -180.0)",
      "character": "Muhafız",
      "text": "Çavuşum, köyün mazgalları ve nöbetçileri nasıl durur?"
    },
    {
      "id": "node:opt_kriz",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 0.0)",
      "character": "Muhafız",
      "text": "Kösedağ eteklerinde süvari tozu görülmüş; ne tedbir alalım?"
    },
    {
      "id": "node:opt_karar",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 180.0)",
      "character": "Muhafız",
      "text": "Dün içeri aldığımız neferler hakkında kanaatin nedir?"
    },
    {
      "id": "node:rep_normal",
      "type": "DIALOGUE",
      "position": "(1050.0, -180.0)",
      "character": "Aydoğdu",
      "text": "Gençler fazla gevşek! Dün gece devriyeyi denetledim; ikisi mazgal dibinde uyukluyordu, kargının sapıyla dürttüm. Nöbette uyuyan asker celladına davetiye çıkarır!"
    },
    {
      "id": "node:rep_kriz",
      "type": "DIALOGUE",
      "position": "(1050.0, 0.0)",
      "character": "Aydoğdu",
      "text": "Hendek menfezlerine kazık çaktıralım! Su arkının önüne kurt çukuru kazalım. Süvari atı çukura bastı mı süvari yerde kalır; kuledeki kemankeşler de işi bitirir."
    },
    {
      "id": "node:rep_karar",
      "type": "DIALOGUE",
      "position": "(1050.0, 180.0)",
      "character": "Aydoğdu",
      "text": "Sivaslı kargıcı ile kule borazancısını kışlaya aldım. Biri pusu noktalarını haritada gösterdi, diğeri borazanın sesini test etti. İkisi de cephe eri; kışlamıza güç kattılar."
    },
    {
      "id": "node:act_normal",
      "type": "ACTION",
      "position": "(1400.0, -180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "1"
      ]
    },
    {
      "id": "node:act_kriz",
      "type": "ACTION",
      "position": "(1400.0, 0.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {

{
  "title": "koylu_muhabbet_hasan_celebi",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Hasan Çelebi",
      "text": "Hürmetler muhafız ağa. Kamış kalemim divan defterini yazar, kulağım köyün asayişini tartar. Mühim bir tahrir mi var?"
    },
    {
      "id": "node:opt_normal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -180.0)",
      "character": "Muhafız",
      "text": "Kâtip efendi, köyün kayıtları ve nüfusu denk midir?"
    },
    {
      "id": "node:opt_kriz",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 0.0)",
      "character": "Muhafız",
      "text": "Sancaktan vergi tahsildarı veya harami baskısı gelirse ne yaparız?"
    },
    {
      "id": "node:opt_karar",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 180.0)",
      "character": "Muhafız",
      "text": "Dün hileli dirhemi kırılan kantarcıyı pazara aldık; defterine ne yazdın?"
    },
    {
      "id": "node:rep_normal",
      "type": "DIALOGUE",
      "position": "(1050.0, -180.0)",
      "character": "Hasan Çelebi",
      "text": "Giren çıkan her canı, ambara giren her kile tahılı deftere şerh düşerim ağam. Nizam olan yerde bereket olur; deftersiz köy haramilerin insafına kalır."
    },
    {
      "id": "node:rep_kriz",
      "type": "DIALOGUE",
      "position": "(1050.0, 0.0)",
      "character": "Hasan Çelebi",
      "text": "Koynumdaki gizli defter sayfasını saklarım ağam. Beyliğin usulsüzlüklerini kadıya sunacak delilim var. Kanunsuz vergiye karşı divanda sözümüz geçer; köyün hakkını yedirmem."
    },
    {
      "id": "node:rep_karar",
      "type": "DIALOGUE",
      "position": "(1050.0, 180.0)",
      "character": "Hasan Çelebi",
      "text": "Kantarcının hileli dirhemini kırıp tövbe ettirmeniz adalet hanesine yazıldı ağam. Köy pazarında artık tartı şaşmaz; esnaf da muhafızın adaletinden çekinir."
    },
    {
      "id": "node:act_normal",
      "type": "ACTION",
      "position": "(1400.0, -180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:act_kriz",
      "type": "ACTION",
      "position": "(1400.0, 0.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",

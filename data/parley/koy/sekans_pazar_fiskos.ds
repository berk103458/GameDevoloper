{
  "title": "sekans_pazar_fiskos",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:c1",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Hasan Çelebi",
      "text": "Yusuf oğul, elindeki Karabaş'ın ipini sıkı tut. Köy pazarında yabancılar dolaşır; kulağıma türlü türlü fısıltı gelir."
    },
    {
      "id": "node:c2",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "Yusuf",
      "text": "Korkmam Hasan kâtip emmi... Kapıdaki muhafız ağam adaletlidir. Dün gelenlerin heybesine baktı, haramiyi içeri sokmadı."
    },
    {
      "id": "node:opt1",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Muhafız",
      "text": "Adalet mülkün temelidir Yusuf. Köyün dirliği bozulmasın diye gece gündüz nöbet tutarız."
    },
    {
      "id": "node:opt2",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Muhafız",
      "text": "Dedikodulara kulak asmayın, herkes kendi işine baksın!"
    },
    {
      "id": "node:rep1",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Hasan Çelebi",
      "text": "Haklısın muhafız ağa. Defterime yalnız hakikati yazarım; dedikodu yapanı divan uyarır."
    },
    {
      "id": "node:rep2",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "Yusuf",
      "text": "Muhafız ağam doğru der Hasan emmi, köyümüzün nöbetçisi sağlamdır!"
    },
    {
      "id": "node:act1",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",

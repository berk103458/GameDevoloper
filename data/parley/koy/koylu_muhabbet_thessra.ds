{
  "title": "koylu_muhabbet_thessra",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Thessra",
      "text": "Selam muhafız. Taş ses verir, çekiç tartar. Sur bedenindeki çatlakları ölçerim; bir haber mi var?"
    },
    {
      "id": "node:opt_normal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -180.0)",
      "character": "Muhafız",
      "text": "Thessra Usta, köyün surları ve su arkları sağlam mıdır?"
    },
    {
      "id": "node:opt_kriz",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 0.0)",
      "character": "Muhafız",
      "text": "Surlar mancınık veya koçbaşı darbesine dayanır mı?"
    },
    {
      "id": "node:opt_karar",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 180.0)",
      "character": "Muhafız",
      "text": "Dün içeri aldığımız kireççi kale ırgatı sana yardım edebilir mi?"
    },
    {
      "id": "node:rep_normal",
      "type": "DIALOGUE",
      "position": "(1050.0, -180.0)",
      "character": "Thessra",
      "text": "Kuzey surunun ahşap kazıkları çürümeye yüz tutmuştu; taş temel örüp kireçle bağladım. Taş ocağından getirdiğimiz andezit blokları iki yüz yıl ayakta kalır."
    },
    {
      "id": "node:rep_kriz",
      "type": "DIALOGUE",
      "position": "(1050.0, 0.0)",
      "character": "Thessra",
      "text": "Dış bendi eğimli dizdim; atılan taş seker gider. Lakin kapı kanadının arkasına meşe payanda koymamız şart. Karaca Usta'dan dövme demir menteşe istedim."
    },
    {
      "id": "node:rep_karar",
      "type": "DIALOGUE",
      "position": "(1050.0, 180.0)",
      "character": "Thessra",
      "text": "O ırgat harç karmayı iyi bilir muhafız! Ellerindeki kireç yanıklarına baktım; usta eli. Hendek duvarını onunla birlikte örüyoruz, işimiz yarı yarıya hızlandı."
    },
    {
      "id": "node:act_normal",
      "type": "ACTION",
      "position": "(1400.0, -180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:act_kriz",
      "type": "ACTION",
      "position": "(1400.0, 0.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",

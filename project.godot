; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Uçta bir kapı."
config/version="0.2.0"
run/main_scene="res://src/arayuz/ana.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="KapiMuhafizi"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://data/ses/default_bus_layout.tres"

[autoload]

Ses="*res://src/sistemler/ses.gd"
AdayTema="*res://src/arayuz/ui_adaylari/bagla.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GdPAIAutoload="*res://addons/GdPlanningAI/gdpai_autoload.gd"

[dialogue_manager]

runtime/balloon_path="res://src/arayuz/diyalog/balon.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

script/search_in_file_extensions=PackedStringArray("gd", "gdshader", "dlg")

[editor_plugins]

enabled=PackedStringArray("res://addons/parley/plugin.cfg", "res://addons/Theatre/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/GdPlanningAI/plugin.cfg", "res://addons/proton_scatter/plugin.cfg")

[internationalization]

locale/translations=PackedStringArray("res://data/metin/metinler.tr.translation")
locale/translations_pot_files=PackedStringArray("res://data/diyalog/tuccar.dialogue", "res://data/diyalog/kapi_sorgu.en.dialogue", "res://data/diyalog/tuccar.en.dialogue", "res://data/diyalog/kapi_sorgu.dialogue")
locale/fallback="tr"

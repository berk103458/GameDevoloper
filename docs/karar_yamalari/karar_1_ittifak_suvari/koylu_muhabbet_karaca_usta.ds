{
  "title": "koylu_muhabbet_karaca_usta",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Karaca Usta",
      "text": "Selamünaleyküm muhafız. Körük harlıdır, demir tavındadır. Ahi ocağında boş lafa yer yoktur; derdin nedir?"
    },
    {
      "id": "node:opt_normal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -180.0)",
      "character": "Muhafız",
      "text": "Ocakta işler nasıl Karaca Usta? Sabanlar, kalkanlar ne durumda?"
    },
    {
      "id": "node:opt_kriz",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 0.0)",
      "character": "Muhafız",
      "text": "Dağda harami fısıltısı artar; silahımız ve kalkanımız yeter mi?"
    },
    {
      "id": "node:opt_karar",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 180.0)",
      "character": "Muhafız",
      "text": "Kapıdaki tüccarlar ve yolcular hakkında kulağına bir dedikodu geldi mi?"
    },
    {
      "id": "node:rep_normal",
      "type": "DIALOGUE",
      "position": "(1050.0, -180.0)",
      "character": "Karaca Usta",
      "text": "Kömürümüz yettikçe çekiç susmaz oğul! Köyün körelen baltalarını biledim, kışlanın mızrak temrenlerini sertleştirdim. Helal demir taşa çalsan kırılmaz."
    },
    {
      "id": "node:rep_kriz",
      "type": "DIALOGUE",
      "position": "(1050.0, 0.0)",
      "character": "Karaca Usta",
      "text": "Haramiler yaklaşırsa köyün oraklarını pusat yaparız! Kalkanların arkasına meşe tahtası çekerim. Ahi yiğitleri ocağını çiğnetmez; yeter ki muhafız kapıyı gevşek tutmasın!"
    },
    {
      "id": "node:rep_karar",
      "type": "DIALOGUE",
      "position": "(1050.0, 180.0)",
      "character": "Karaca Usta",
      "text": "Kulağıma haram akçe fısıltısı gelmesin oğul! Rüşvetle içeri giren olursa demirhanemin kapısını kilitlerim! Lakin Kayserili kumaşçıyla demirci kalfası Ahi nizamına uygun davranmış; kalfayı çırak aldım, körüğü çeker."
    },
    {
      "id": "node:act_normal",
      "type": "ACTION",
      "position": "(1400.0, -180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:act_kriz",
      "type": "ACTION",
      "position": "(1400.0, 0.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:act_karar",
      "type": "ACTION",
      "position": "(1400.0, 180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:end",
      "type": "END",
      "position": "(1750.0, 0.0)"
    },
    {
      "id": "node:opt_banu",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 360.0)",
      "character": "Muhafız",
      "text": "Banu Hatun'un 50 atlısıyla anlaştık Karaca Usta; vadi koruluğunda sınır nöbetine durdular."
    },
    {
      "id": "node:rep_banu",
      "type": "DIALOGUE",
      "position": "(1050.0, 360.0)",
      "character": "Karaca Usta",
      "text": "Babamın kan borcunu bu nöbetle ödeyeceksen, atlarınızın nalını, kılıçlarınızın eğrisini ben döverim Banu! 50 pusat köyün etrafında nöbetteyse körüğü gece gündüz yakarım Muhafız."
    },
    {
      "id": "node:act_banu",
      "type": "ACTION",
      "position": "(1400.0, 360.0)",
      "description": "Köy Savunması ve Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    }
  ],

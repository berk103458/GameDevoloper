{
  "title": "sekans_degirmen_kitlik",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:latif",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Latif",
      "text": "The millstone turns, yet no grain pours into the hopper, Idris! Have the farmers emptied the storehouse already?"
    },
    {
      "id": "node:idris",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "İdris",
      "text": "Hail battered the standing wheat on the plain, and the rest was seized for the Beylik tithe, Master Latif! This is the last sack in my cart; grind it without sifting the bran so it may yield more loaves."
    },
    {
      "id": "node:opt_teskin",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Gatekeeper",
      "text": "Calm yourselves! The village granary suffices for us all; we shall ration the flour with prudence."
    },
    {
      "id": "node:opt_sert",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Gatekeeper",
      "text": "If any man squanders a single grain, he shall answer to me; not a handful of flour shall be wasted!"
    },
    {
      "id": "node:rep_teskin",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Latif",
      "text": "If that is your command, we abide by your order, master guard. I will keep the water wheel turning through the night as well."
    },
    {
      "id": "node:act_teskin",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Köy Morali Artışı",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:rep_sert",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "İdris",
      "text": "We will not waste a grain, master; we know full well the solemn burden of every seed."
    },
    {
      "id": "node:end",
      "type": "END",
      "position": "(2100.0, 0.0)"
    }
  ],

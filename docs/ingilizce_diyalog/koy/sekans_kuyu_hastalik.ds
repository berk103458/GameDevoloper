{
  "title": "sekans_kuyu_hastalik",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:c1",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Miraen",
      "text": "Saruca Hatun... Meydan kuyusundan çekilen suda kükürt ve pas kokusu sezinledim. Çocuklara bu suyu kaynatmadan içirme."
    },
    {
      "id": "node:c2",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "Saruca Hatun",
      "text": "Aman Miraen kızım! Kış günü başımıza bir de salgın humması sarmayalım. Kuyuya kireç dökelim mi, ne dersin?"
    },
    {
      "id": "node:opt1",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Gatekeeper",
      "text": "Hemen sönmemiş kireç kuyusunu açıp üç ölçek kuyuya dökelim, iki gün dinlensin."
    },
    {
      "id": "node:opt2",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Gatekeeper",
      "text": "Kuyuyu kapatamayız, köylü susuz kalır; sadece şüpheli kovaları arıtalım."
    },
    {
      "id": "node:rep1",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Miraen",
      "text": "Doğru karar muhafız ağa. Kireç kuyunun zehrini kırar, iki güne su ayna gibi berraklaşır."
    },
    {
      "id": "node:rep2",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "Saruca Hatun",
      "text": "Öyleyse suları tandır ateşinde kaynatıp öyle dağıtacağız evlat; tedbiri elden bırakmayız."
    },
    {
      "id": "node:act1",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "3"
      ]
    },
    {
      "id": "node:act2",

{
  "title": "sekans_nobet_harami",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:c1",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Nogay",
      "text": "Sorhan... Gece orman sınırında dört at izi gördüm. Nalların çentikleri Kızıl Karga eşkıyasına aitti."
    },
    {
      "id": "node:c2",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "Sorhan",
      "text": "Biliyorum Nogay... Ahırdaki taylar da gece yarısı huzursuz kişnedi, kurt kokusu değil harami kokusu aldılar. Tetikte olmak gerek."
    },
    {
      "id": "node:opt1",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Gatekeeper",
      "text": "Kışladaki süvarileri ve kuledeki kemankeşleri alarma geçirin, gece devriyesini ikiye katlayın!"
    },
    {
      "id": "node:opt2",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Gatekeeper",
      "text": "Paniğe gerek yok, izleri takip edin amma ahaliyi ürkütmeyin."
    },
    {
      "id": "node:rep1",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Nogay",
      "text": "Hemen atımı eyerlerim muhafız! Bozkırda pusuyu ilk biz kuracağız, kapıya yaklaştırmayız."
    },
    {
      "id": "node:rep2",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "Sorhan",
      "text": "İz sürüp tuzak kurarım ağam. Çamlıkta bir çıt çıksa kargıyı saplarım."
    },
    {
      "id": "node:act1",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {

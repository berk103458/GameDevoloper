{
  "title": "koylu_muhabbet_ayse_baci",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Ayşe Bacı",
      "text": "Hoş geldin evlat. Bacıyan-ı Rum tezgâhında mekik dokuruz. Kadının emeği köyün direğidir."
    },
    {
      "id": "node:opt_normal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -180.0)",
      "character": "Gatekeeper",
      "text": "Ayşe Bacı, tezgâhlar ve aşevi nasıl gidiyor?"
    },
    {
      "id": "node:opt_kriz",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 0.0)",
      "character": "Gatekeeper",
      "text": "Kış yaklaşıyor, ambar daralırsa kadınlar ne yapar?"
    },
    {
      "id": "node:opt_karar",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 180.0)",
      "character": "Gatekeeper",
      "text": "What is your judgment regarding the newcomers admitted through the gate?"
    },
    {
      "id": "node:rep_normal",
      "type": "DIALOGUE",
      "position": "(1050.0, -180.0)",
      "character": "Ayşe Bacı",
      "text": "Kızlar yün eğirir, çorap örer. Aşevinde her akşam bir kazan kaynatırız; yetim de doyar garip de. Dayanışma sandığımızda beş kuruş kalsa dahi kimseyi aç yatırmayız."
    },
    {
      "id": "node:rep_kriz",
      "type": "DIALOGUE",
      "position": "(1050.0, 0.0)",
      "character": "Ayşe Bacı",
      "text": "Kadınlar çareyi taştan çıkarır evlat! Çörekotunu una katarız, kurutulmuş meyveleri aş yaparız. Yeter ki birlik bozulmasın; haramiye karşı da hançerimiz kuşağımızda saklıdır."
    },
    {
      "id": "node:rep_karar",
      "type": "DIALOGUE",
      "position": "(1050.0, 180.0)",
      "character": "Ayşe Bacı",
      "text": "O yetimleri kucağıma aldım evlat, gözlerindeki yaş dindi. Testideki bağ şırasını da berekete saydık. Merhamet gösteren kapı yıkılmaz; hayır duamız seninledir."
    },
    {
      "id": "node:act_normal",
      "type": "ACTION",
      "position": "(1400.0, -180.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {
      "id": "node:act_kriz",
      "type": "ACTION",
      "position": "(1400.0, 0.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {

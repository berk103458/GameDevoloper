{
  "title": "sekans_demirhane_pusat",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:c1",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Karaca Usta",
      "text": "Thessra usta! Kapı kanadının demir takviyeleri zayıf kalmış; süvari atı çarpsa menteşe fırlar!"
    },
    {
      "id": "node:c2",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "Thessra",
      "text": "Haklısın Karaca baba. Taş temel sağlam amma kapı kanadına çift sıra dövme perçinli demir kuşak çekmemiz şart. Kömürün yeter mi?"
    },
    {
      "id": "node:opt1",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Gatekeeper",
      "text": "Kömürü ben sağlarım, kalkanları ve kapıyı en sağlam çelikle donatacağız!"
    },
    {
      "id": "node:opt2",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Gatekeeper",
      "text": "İsraf yok! Yalnızca en zayıf mazgallara ve kapı göbeğine takviye yapın."
    },
    {
      "id": "node:rep1",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Karaca Usta",
      "text": "Emir baş üstüne muhafız ağa! Demirhane sabaha kadar tütecek, kapı kale kapısı gibi olacak."
    },
    {
      "id": "node:rep2",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "Thessra",
      "text": "Az kaynakla da olsa mühendislik hünerimizi konuştururuz ağam, surlar dimdik durur."
    },
    {
      "id": "node:act1",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",

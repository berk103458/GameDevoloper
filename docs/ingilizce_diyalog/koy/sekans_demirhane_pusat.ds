{
  "title": "sekans_demirhane_pusat",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:c1",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Karaca Usta",
      "text": "Master Thessra! The iron braces on the gate leaves are too frail; if a cavalry charge strikes, the hinge pins will snap!"
    },
    {
      "id": "node:c2",
      "type": "DIALOGUE",
      "position": "(700.0, 0.0)",
      "character": "Thessra",
      "text": "You speak truth, Father Karaca. The stone plinth is massive, but we must bolt double-riveted forged iron straps across the timber face. Have you enough charcoal?"
    },
    {
      "id": "node:opt1",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, -90.0)",
      "character": "Gatekeeper",
      "text": "I will provide the charcoal myself; we shall equip our bucklers and gate with the toughest steel!"
    },
    {
      "id": "node:opt2",
      "type": "DIALOGUE_OPTION",
      "position": "(1050.0, 90.0)",
      "character": "Gatekeeper",
      "text": "No waste! Reinforce only the weakest loopholes and the center hub of the gate leaf."
    },
    {
      "id": "node:rep1",
      "type": "DIALOGUE",
      "position": "(1400.0, -90.0)",
      "character": "Karaca Usta",
      "text": "Your command is honored, master guard! The forge shall blaze till dawn, and the portal shall be sturdy as a fortress gate."
    },
    {
      "id": "node:rep2",
      "type": "DIALOGUE",
      "position": "(1400.0, 90.0)",
      "character": "Thessra",
      "text": "Even with sparse materials we shall display our engineering craft, master; these ramparts will stand unyielding."
    },
    {
      "id": "node:act1",
      "type": "ACTION",
      "position": "(1750.0, -90.0)",
      "description": "Köy Morali",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "2"
      ]
    },
    {

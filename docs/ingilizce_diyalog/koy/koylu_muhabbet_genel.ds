{
  "title": "koylu_muhabbet_genel",
  "nodes": [
    {
      "id": "node:start",
      "type": "START",
      "position": "(0.0, 0.0)"
    },
    {
      "id": "node:selam",
      "type": "DIALOGUE",
      "position": "(350.0, 0.0)",
      "character": "Villager",
      "text": "Selamün aleyküm muhafız ağa. Bir emrin, bir sualin var mıdır?"
    },
    {
      "id": "node:opt_hal",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -270.0)",
      "character": "Gatekeeper",
      "text": "Hal hatır nasıldır? Keyfin yerinde mi?"
    },
    {
      "id": "node:opt_is",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, -90.0)",
      "character": "Gatekeeper",
      "text": "İşin gücün nasıl gidiyor? Görevinden memnun musun?"
    },
    {
      "id": "node:opt_havadis",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 90.0)",
      "character": "Gatekeeper",
      "text": "Köyde ne konuşulur? Kulağına bir havadis geldi mi?"
    },
    {
      "id": "node:opt_rica",
      "type": "DIALOGUE_OPTION",
      "position": "(700.0, 270.0)",
      "character": "Gatekeeper",
      "text": "Bana söyleyeceğin mühim bir meramın var mı?"
    },
    {
      "id": "node:cond_moral",
      "type": "CONDITION",
      "position": "(1050.0, -270.0)",
      "description": "Moral Kontrolü",
      "combiner": "ALL",
      "conditions": [
        {
          "fact_ref": "res://src/diyalog/facts/koylu_moral_fact.gd",
          "operator": 0,
          "value": "iyi"
        }
      ]
    },
    {
      "id": "node:rep_moral_iyi",
      "type": "DIALOGUE",
      "position": "(1400.0, -360.0)",
      "character": "Villager",
      "text": "Çok şükür ağam, başımızda çatımız, soframızda aşımız var. Ocağınız daim tütsün."
    },
    {
      "id": "node:rep_moral_kotu",
      "type": "DIALOGUE",
      "position": "(1400.0, -180.0)",
      "character": "Villager",
      "text": "Nasıl olsun muhafız... Bellerimiz ağrır, içimiz buruktur. Yine de şükür ayaktayız."
    },
    {
      "id": "node:act_moral_iyi",
      "type": "ACTION",
      "position": "(1750.0, -360.0)",
      "description": "Moral Artışı",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "1"
      ]
    },
    {
      "id": "node:rep_is",
      "type": "DIALOGUE",
      "position": "(1050.0, -90.0)",
      "character": "Villager",
      "text": "Gündüz tarlada ve tezgâhta alın teri dökeriz. Köyün işi bitmez; köylü çalışırsa köy doyar."
    },
    {
      "id": "node:cond_havadis",
      "type": "CONDITION",
      "position": "(1050.0, 90.0)",
      "description": "Havadis Kontrolü",
      "combiner": "ALL",
      "conditions": [
        {
          "fact_ref": "res://src/diyalog/facts/koy_havadis_fact.gd",
          "operator": 0,
          "value": "harami"
        }
      ]
    },
    {
      "id": "node:rep_havadis_tehdit",
      "type": "DIALOGUE",
      "position": "(1400.0, 0.0)",
      "character": "Villager",
      "text": "Dağ boğazında gece vakti meşale görmüşler ağam... Harami fırkası kol gezer derler, gözümüz kulağımız tetiktedir."
    },
    {
      "id": "node:rep_havadis_sakin",
      "type": "DIALOGUE",
      "position": "(1400.0, 180.0)",
      "character": "Villager",
      "text": "Ortalık şimdilik sakindir muhafız. Yalnız kışın ayazı erken inecek der ihtiyarlar."
    },
    {
      "id": "node:rep_rica",
      "type": "DIALOGUE",
      "position": "(1050.0, 270.0)",
      "character": "Villager",
      "text": "Sağlığın ve nizamın daim olsun muhafız ağa. Bizim derdimiz ekmektir, adaletiniz eksik olmasın."
    },
    {
      "id": "node:act_rica",
      "type": "ACTION",
      "position": "(1400.0, 270.0)",
      "description": "Adalet/Moral Etkisi",
      "action_type": "SCRIPT",
      "action_script_ref": "res://src/diyalog/actions/koy_moral_action.gd",
      "values": [
        "1"
      ]
    },
    {
      "id": "node:end",
      "type": "END",
      "position": "(2100.0, 0.0)"
    }
  ],

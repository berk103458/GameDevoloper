
# Godot
.godot/
data/metin/*.translation
tools/art/ham/
tools/art/yedek/
tools/art/gelen/*
!tools/art/gelen/.gitkeep
tools/model/durum.json
# Meshy: oyunda yalnız *_yuru.glb (iskelet + yürüme) kullanılır; ham ve iskelet kopyaları repoya girmez
assets/model/karakter/*.glb
!assets/model/karakter/*_yuru.glb
assets/model/**/*.jpg
assets/model/**/*.png
# Meshy hareket glb'leri (model+doku, ~3 MB) repoya girmez; animasyonları assets/model/hareket/*.res olarak ayıklanır
assets/model/karakter/*_bekle.glb.import
assets/model/karakter/*_konus.glb.import
assets/model/karakter/*_sevinc.glb.import
assets/model/karakter/*_ofke.glb.import
assets/model/karakter/*_panik.glb.import
assets/model/karakter/*_gergin.glb.import
assets/model/karakter/*_bekle_*.import
assets/model/karakter/*_konus_*.import
assets/model/karakter/*_sevinc_*.import
assets/model/karakter/*_ofke_*.import
assets/model/karakter/*_panik_*.import
__pycache__/

# Orman pişirme kaynakları (ağır; yalnız pişmiş atlas repoya girer)
assets/ph/model/fir_sapling_medium/
assets/ph/model/island_tree_02/

# Local Meshy API credential
/.meshy-api-key

# Local sanity-check logs
/work/sanity/
/work/tester/
